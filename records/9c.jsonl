{"affected":[{"assertion_role":"cna","defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"4.1.22","status":"affected","version":"0","versionType":"semver"}],"product":"Eventin – Event Calendar, Tickets, Registration, Booking & WooCommerce","provider":{"orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"vendor":"arraytics"}],"aliases":["CVE-2026-15667"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Eventin – Event Calendar, Event Registration, Tickets & Booking (AI Powered) plugin for WordPress is vulnerable to Local File Inclusion in all versions up to, and including, 4.1.22 via the 'event_layout' parameter parameter. This makes it possible for authenticated attackers, with contributor-level access and above, to include and execute arbitrary .php files on the server, allowing the execution of any PHP code in those files. This can be used to bypass access controls, obtain sensitive data, or achieve code execution in cases where .php file types can be uploaded and included. The etn_manage_event capability is assigned to Contributors by default, meaning any Contributor-level user can set the malicious event_layout value via the REST API without any additional configuration."}],"metrics":[{"cvssV3_1":{"baseScore":7.5,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:H/PR:L/UI:N/S:U/C:H/I:H/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-98","description":"CWE-98 Improper Control of Filename for Include/Require Statement in PHP Program ('PHP Remote File Inclusion')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-09T02:27:35.678Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"Eventin <= 4.1.22 - Authenticated (Contirbutor+) Local File Inclusion via 'event_layout' Parameter"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"dde9084bf76e541490761641fb150fc1df83a8ce8fdaf2937f94e4a84400c927","data_version":"5.2","descriptions":[{"lang":"en","value":"The Eventin – Event Calendar, Event Registration, Tickets & Booking (AI Powered) plugin for WordPress is vulnerable to Local File Inclusion in all versions up to, and including, 4.1.22 via the 'event_layout' parameter parameter. This makes it possible for authenticated attackers, with contributor-level access and above, to include and execute arbitrary .php files on the server, allowing the execution of any PHP code in those files. This can be used to bypass access controls, obtain sensitive data, or achieve code execution in cases where .php file types can be uploaded and included. The etn_manage_event capability is assigned to Contributors by default, meaning any Contributor-level user can set the malicious event_layout value via the REST API without any additional configuration."}],"first_seen_at":"2026-09-09T02:43:38Z","kind":"advisory","last_material_event_at":"2026-09-09T02:43:38Z","native_id":"CVE-2026-15667","provenance":[{"revision":"a92308bd9728e7ed02eefc692887fb0afd62c228","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-15667"},{"independent_evidence":true,"provider":{"dateUpdated":"2026-09-09T02:27:35.678Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","source_id":"cve"}],"published_at":"2026-09-09T02:27:35Z","record_id":"cve/CVE-2026-15667","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-09T02:27:35.678Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"url":"https://www.wordfence.com/threat-intel/vulnerabilities/id/c3001ec4-a1d8-43d7-8e0c-1fe2e4e7f314?source=cve"},{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-09T02:27:35.678Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"url":"https://plugins.trac.wordpress.org/browser/wp
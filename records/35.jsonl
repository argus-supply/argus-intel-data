{"affected":[{"assertion_role":"cna","defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"3.1.10","status":"affected","version":"0","versionType":"semver"}],"product":"FireBox – WooCommerce Popup Builder, Exit Intent Popup, Email Optin & Cart Abandonment","provider":{"orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"vendor":"fireplugins"}],"aliases":["CVE-2026-76801"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The FireBox – WooCommerce Popup Builder, Exit Intent Popup, Email Optin & Cart Abandonment plugin for WordPress is vulnerable to Remote Code Execution in all versions up to, and including, 3.1.10 via the value function. This is due to a trivially bypassable regex blacklist in Executer::allowedToRun() that fails to block WordPress core functions such as wp_insert_user, update_option, and file_put_contents, combined with no sanitization of PHP condition rule values stored via the firebox_meta REST endpoint. This makes it possible for authenticated attackers, with author-level access and above, to execute code on the server. On sites upgraded from a version prior to 3.1.10, the Migrator::preserveCampaignRoleAccess() function automatically grants the edit_fireboxes and publish_fireboxes capabilities to the Author role, lowering the effective entry point to Author-level access."}],"metrics":[{"cvssV3_1":{"baseScore":8.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-269","description":"CWE-269 Improper Privilege Management","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-09T02:27:34.997Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"FireBox <= 3.1.10 - Authenticated (Author+) Remote Code Execution to Privilege Escalation"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"50a1bad1a34fecf57edd20cce6285271d1cf07ac13c0c05b74b5e083823c7ba9","data_version":"5.2","descriptions":[{"lang":"en","value":"The FireBox – WooCommerce Popup Builder, Exit Intent Popup, Email Optin & Cart Abandonment plugin for WordPress is vulnerable to Remote Code Execution in all versions up to, and including, 3.1.10 via the value function. This is due to a trivially bypassable regex blacklist in Executer::allowedToRun() that fails to block WordPress core functions such as wp_insert_user, update_option, and file_put_contents, combined with no sanitization of PHP condition rule values stored via the firebox_meta REST endpoint. This makes it possible for authenticated attackers, with author-level access and above, to execute code on the server. On sites upgraded from a version prior to 3.1.10, the Migrator::preserveCampaignRoleAccess() function automatically grants the edit_fireboxes and publish_fireboxes capabilities to the Author role, lowering the effective entry point to Author-level access."}],"first_seen_at":"2026-09-09T02:43:38Z","kind":"advisory","last_material_event_at":"2026-09-09T02:43:38Z","native_id":"CVE-2026-76801","provenance":[{"revision":"a92308bd9728e7ed02eefc692887fb0afd62c228","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-76801"},{"independent_evidence":true,"provider":{"dateUpdated":"2026-09-09T02:27:34.997Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","source_id":"cve"}],"published_at":"2026-09-09T02:27:34Z","record_id":"cve/CVE-2026-76801","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-09T02:27:34.997Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"url":"https://www.wordfence.com/threat-intel/vulnerabilities/id/9c1d8ec3-de01-4496-8d8b-b9604f952b1e?source=cve"},{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-09T02:27:34.997Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"url":"https://plugins.trac.wordpress.org/browser/firebox/tags/3.1.10/Inc/Framework/Inc/Base/Conditions/Conditions/PHP.php#L36"},{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-09T02:27:34.997Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"url":"https://plugins.trac.wordpress.org/browser/firebox/tags/3.1.10/Inc/Framework/Inc/Base/Executer.php#L231"},{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-09T02:27:34.997Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"url":"https://plugins.trac.wordpress.org/browser/firebox/tags/3.1.10/Inc/Core/FB/Meta.php#L411"},{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-09T02:27:34.997Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"url":"https://plugins.trac.wordpress.org/browser/firebox/tags/3.1.10/Inc/Core/Migrator.php#L606"},{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-09T02:27:34.997Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"url":"https://plugins.trac.wordpress.org/changeset?reponame=&old=3666018%40firebox&new=3666018%40firebox"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-09-09T02:27:34Z","status":"active","title":"FireBox <= 3.1.10 - Authenticated (Author+) Remote Code Execution to Privilege Escalation"}

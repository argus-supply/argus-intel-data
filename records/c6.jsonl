{"affected":[{"original_ranges":null,"product":"Catalyst SD-WAN Controller and Manager","vendor":"Cisco"}],"aliases":["CVE-2026-20127"],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"41f8d0f257730fd81f3140f1aa88adb1972df945c79221cf3e99c6a545d38c59","first_seen_at":"2026-09-09T02:43:38Z","kev":true,"kev_added_at":"2026-02-25","kev_metadata":{"cveID":"CVE-2026-20127","cwes":["CWE-287"],"dateAdded":"2026-02-25","dueDate":"2026-02-27","forensicTriage":"No","knownRansomwareCampaignUse":"Unknown","notes":"CISA Mitigation Instructions: https://www.cisa.gov/news-events/directives/ed-26-03-mitigate-vulnerabilities-cisco-sd-wan-systems ; https://www.cisa.gov/news-events/directives/supplemental-direction-ed-26-03-hunt-and-hardening-guidance-cisco-sd-wan-systems ; https://sec.cloudapps.cisco.com/security/center/content/CiscoSecurityAdvisory/cisco-sa-sdwan-rpa-EHchtZk ; https://nvd.nist.gov/vuln/detail/CVE-2026-20127","product":"Catalyst SD-WAN Controller and Manager","requiredAction":"Please adhere to CISA’s guidelines to assess exposure and mitigate risks associated with Cisco SD-WAN devices as outlines in CISA’s Emergency Directive 26-03 (URL listed below in Notes) and CISA’s “Hunt & Hardening Guidance for Cisco SD-WAN Devices (URL listed below in Notes). Adhere to the applicable BOD 22-01 guidance for cloud services or discontinue use of the product if mitigations are not available.","shortDescription":"Cisco Catalyst SD-WAN Controller, formerly SD-WAN vSmart, and Cisco Catalyst SD-WAN Manager, formerly SD-WAN vManage, contain an authentication bypass vulnerability could allow an unauthenticated, remote attacker to bypass authentication and obtain administrative privileges on an affected system. This vulnerability exists because the peering authentication mechanism in an affected system is not working properly. An attacker could exploit this vulnerability by sending crafted requests to an affected system. A successful exploit could allow the attacker to log in to an affected Cisco Catalyst SD-WAN Controller as an internal, high-privileged, non-root user account. Using this account, the attacker could access NETCONF, which would then allow the attacker to manipulate network configuration for the SD-WAN fabric.","vendorProject":"Cisco","vulnerabilityName":"Cisco Catalyst SD-WAN Controller and Manager Authentication Bypass Vulnerability"},"kind":"advisory","known_exploited":true,"last_material_event_at":"2026-09-09T02:43:38Z","native_id":"CVE-2026-20127","provenance":[{"revision":"d1274a96dac793937335f1d5451d5e88ce760475","source_id":"kev","url":"https://www.cisa.gov/known-exploited-vulnerabilities-catalog"}],"published_at":"2026-02-25T00:00:00Z","record_id":"kev/CVE-2026-20127","references":[],"schema_version":"1.0","source_id":"kev","source_modified_at":"2026-02-25T00:00:00Z","status":"active","title":"Cisco Catalyst SD-WAN Controller and Manager Authentication Bypass Vulnerability"}

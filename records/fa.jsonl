{"affected":[{"assertion_role":"cna","original_ranges":[{"status":"affected","version":">= 0.6.1, < 0.6.2.6"}],"product":"cjose","provider":{"orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"vendor":"OpenIDC"}],"aliases":["CVE-2026-53939"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"OpenIDC/cjose is a C library implementing the Javascript Object Signing and Encryption (JOSE). In versions 0.6.1 through 0.6.2.5, when cjose encrypts a JWE using an AES-CBC-HMAC content-encryption algorithm (`A128CBC-HS256`, `A192CBC-HS384`, or `A256CBC-HS512`) together with any key-management algorithm that generates a fresh content-encryption key (CEK), the CEK is all zero bytes instead of being randomly generated. The resulting JWE is therefore encrypted and authenticated under a fixed, publicly known key, so anyone who obtains the JWE can recover the plaintext and forge or modify the content. This is fixed in version 0.6.2.6 by `_cjose_jwe_set_cek_aes_cbc()` generating the CEK from `RAND_bytes`. A regression test asserts that the `encrypted_key` differs across two encryptions for each AES-CBC-HMAC variant. Until upgrading, for data encrypted with cjose, three options are available. Use an AES-GCM `enc` (`A128GCM` / `A192GCM` / `A256GCM`) instead of an AES-CBC-HMAC `enc`,  use `alg=dir` with a caller-supplied CEK, or avoid using cjose for JWE encryption with the affected algorithm pair. These are mitigations for new ciphertexts only; data already encrypted under the zero key remains compromised and should be re-encrypted (and any secrets it contained rotated)."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":9.1,"baseSeverity":"CRITICAL","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-321","description":"CWE-321: Use of Hard-coded Cryptographic Key","lang":"en","type":"CWE"}]},{"descriptions":[{"cweId":"CWE-330","description":"CWE-330: Use of Insufficiently Random Values","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-08T23:36:13.668Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"OpenIDC/cjose uses all-zero Content Encryption Key for AES-CBC-HMAC JWE encryption"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"985a24e3ceb760456e7ca69d152e876d0285cacf29204ae7eac94db61d841d6c","data_version":"5.2","descriptions":[{"lang":"en","value":"OpenIDC/cjose is a C library implementing the Javascript Object Signing and Encryption (JOSE). In versions 0.6.1 through 0.6.2.5, when cjose encrypts a JWE using an AES-CBC-HMAC content-encryption algorithm (`A128CBC-HS256`, `A192CBC-HS384`, or `A256CBC-HS512`) together with any key-management algorithm that generates a fresh content-encryption key (CEK), the CEK is all zero bytes instead of being randomly generated. The resulting JWE is therefore encrypted and authenticated under a fixed, publicly known key, so anyone who obtains the JWE can recover the plaintext and forge or modify the content. This is fixed in version 0.6.2.6 by `_cjose_jwe_set_cek_aes_cbc()` generating the CEK from `RAND_bytes`. A regression test asserts that the `encrypted_key` differs across two encryptions for each AES-CBC-HMAC variant. Until upgrading, for data encrypted with cjose, three options are available. Use an AES-GCM `enc` (`A128GCM` / `A192GCM` / `A256GCM`) instead of an AES-CBC-HMAC `enc`,  use `alg=dir` with a caller-supplied CEK, or avoid using cjose for JWE encryption with the affected algorithm pair. These are mitigations for new ciphertexts only; data already encrypted under the zero key remains compromised and should be re-encrypted (and any secrets it contained rotated)."}],"first_seen_at":"2026-09-09T03:00:53Z","kind":"advisory","last_material_event_at":"2026-09-09T03:00:53Z","native_id":"CVE-2026-53939","provenance":[{"revision":"a92308bd9728e7ed02eefc692887fb0afd62c228","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-53939"},{"independent_evidence":true,"provider":{"dateUpdated":"2026-09-08T23:36:13.668Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","source_id":"cve"}],"published_at":"2026-09-08T23:36:13Z","record_id":"cve/CVE-2026-53939","references":[{"assertion_role":"cna","name":"https://github.com/OpenIDC/cjose/security/advisories/GHSA-f6wf-pqg3-6wqq","provider":{"dateUpdated":"2026-09-08T23:36:13.668Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"tags":["x_refsource_CONFIRM"],"url":"https://github.com/OpenIDC/cjose/security/advisories/GHSA-f6wf-pqg3-6wqq"},{"assertion_role":"cna","name":"https://github.com/OpenIDC/cjose/commit/2a6e5bd969fa20059fb00913fb9f57d77ea6a4d9","provider":{"dateUpdated":"2026-09-08T23:36:13.668Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"tags":["x_refsource_MISC"],"url":"https://github.com/OpenIDC/cjose/commit/2a6e5bd969fa20059fb00913fb9f57d77ea6a4d9"},{"assertion_role":"cna","name":"https://github.com/OpenIDC/cjose/releases/tag/v0.6.2.6","provider":{"dateUpdated":"2026-09-08T23:36:13.668Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"tags":["x_refsource_MISC"],"url":"https://github.com/OpenIDC/cjose/releases/tag/v0.6.2.6"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-09-08T23:36:13Z","status":"active","title":"OpenIDC/cjose uses all-zero Content Encryption Key for AES-CBC-HMAC JWE encryption"}

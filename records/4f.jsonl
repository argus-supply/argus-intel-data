{"affected":[{"assertion_role":"cna","original_ranges":[{"status":"affected","version":">= 2.38.0, < 2.38.2"},{"status":"affected","version":">= 2.0.0, < 2.37.7"},{"status":"affected","version":"< 1.123.76"}],"product":"n8n","provider":{"orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"vendor":"n8n-io"}],"aliases":["CVE-2026-86083"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"n8n is an open source workflow automation platform. Prior to 1.123.76, 2.37.7, and 2.38.2, the legacy expression engine generated source text by calling the mutable global JSON.stringify while printing synthetic string literals and interpolating timezone data. An expression could replace JSON.stringify and cause later generated source to contain executable attacker-controlled code. The affected code-generation paths include packages/@n8n/expression-runtime/src/bridge/isolated-vm-bridge.ts and packages/@n8n/tournament/src/ExpressionBuilder.ts, and the issue does not affect the vm expression engine. This issue is fixed in versions 1.123.76, 2.37.7 and 2.38.2."}],"metrics":[{"cvssV4_0":{"attackComplexity":"LOW","attackRequirements":"PRESENT","attackVector":"NETWORK","baseScore":7.7,"baseSeverity":"HIGH","privilegesRequired":"LOW","subAvailabilityImpact":"NONE","subConfidentialityImpact":"NONE","subIntegrityImpact":"NONE","userInteraction":"NONE","vectorString":"CVSS:4.0/AV:N/AC:L/AT:P/PR:L/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N","version":"4.0","vulnAvailabilityImpact":"HIGH","vulnConfidentialityImpact":"HIGH","vulnIntegrityImpact":"HIGH"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-94","description":"CWE-94: Improper Control of Generation of Code ('Code Injection')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-08T21:22:40.687Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"n8n: Expression Sandbox Escape via Shared Builtin Tampering and Code-Printer Injection Leads to Code Execution"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"2600f8037a74b50ed766ba6764889e6a00304e529c70d106c14fcbc138bb9b65","data_version":"5.2","descriptions":[{"lang":"en","value":"n8n is an open source workflow automation platform. Prior to 1.123.76, 2.37.7, and 2.38.2, the legacy expression engine generated source text by calling the mutable global JSON.stringify while printing synthetic string literals and interpolating timezone data. An expression could replace JSON.stringify and cause later generated source to contain executable attacker-controlled code. The affected code-generation paths include packages/@n8n/expression-runtime/src/bridge/isolated-vm-bridge.ts and packages/@n8n/tournament/src/ExpressionBuilder.ts, and the issue does not affect the vm expression engine. This issue is fixed in versions 1.123.76, 2.37.7 and 2.38.2."}],"first_seen_at":"2026-09-09T06:03:32Z","kind":"advisory","last_material_event_at":"2026-09-09T06:03:32Z","native_id":"CVE-2026-86083","provenance":[{"revision":"a92308bd9728e7ed02eefc692887fb0afd62c228","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-86083"},{"independent_evidence":true,"provider":{"dateUpdated":"2026-09-08T21:22:40.687Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","source_id":"cve"}],"published_at":"2026-09-08T21:22:40Z","record_id":"cve/CVE-2026-86083","references":[{"assertion_role":"cna","name":"https://github.com/n8n-io/n8n/security/advisories/GHSA-6xcw-7xm6-48c6","provider":{"dateUpdated":"2026-09-08T21:22:40.687Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"tags":["x_refsource_CONFIRM"],"url":"https://github.com/n8n-io/n8n/security/advisories/GHSA-6xcw-7xm6-48c6"},{"assertion_role":"cna","name":"https://github.com/n8n-io/n8n/releases/tag/n8n@1.123.76","provider":{"dateUpda
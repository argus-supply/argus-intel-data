{"affected":[{"assertion_role":"cna","defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"1.7.5","status":"affected","version":"0","versionType":"semver"}],"product":"Contact Form to DB by BestWebSoft – Messages Database Plugin For WordPress","provider":{"orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"vendor":"bestweblayout"}],"aliases":["CVE-2026-13359"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Contact Form to DB by BestWebSoft – Messages Database Plugin For WordPress plugin for WordPress is vulnerable to Stored Cross-Site Scripting via cntctfrm_contact_dropdown Parameter in all versions up to, and including, 1.7.5 due to insufficient input sanitization and output escaping. This makes it possible for unauthenticated attackers to inject arbitrary web scripts in pages that will execute whenever a user accesses an injected page. The injected payload executes in the context of an administrator's browser session when they visit the plugin's message manager page at /wp-admin/admin.php?page=cntctfrmtdb_manager, making it possible to compromise administrator-level sessions via a simple unauthenticated contact form submission."}],"metrics":[{"cvssV3_1":{"baseScore":7.2,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:L/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-79","description":"CWE-79 Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-09T02:27:34.646Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"Contact Form to DB by BestWebSoft <= 1.7.5 - Unauthenticated Stored Cross-Site Scripting via cntctfrm_contact_dropdown Parameter"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"ff6cdf4cb0d20d13b4670f1e429f756cc6ab5de8d9207cef77eb8c661f34ac8a","data_version":"5.2","descriptions":[{"lang":"en","value":"The Contact Form to DB by BestWebSoft – Messages Database Plugin For WordPress plugin for WordPress is vulnerable to Stored Cross-Site Scripting via cntctfrm_contact_dropdown Parameter in all versions up to, and including, 1.7.5 due to insufficient input sanitization and output escaping. This makes it possible for unauthenticated attackers to inject arbitrary web scripts in pages that will execute whenever a user accesses an injected page. The injected payload executes in the context of an administrator's browser session when they visit the plugin's message manager page at /wp-admin/admin.php?page=cntctfrmtdb_manager, making it possible to compromise administrator-level sessions via a simple unauthenticated contact form submission."}],"first_seen_at":"2026-09-09T02:43:38Z","kind":"advisory","last_material_event_at":"2026-09-09T02:43:38Z","native_id":"CVE-2026-13359","provenance":[{"revision":"a92308bd9728e7ed02eefc692887fb0afd62c228","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-13359"},{"independent_evidence":true,"provider":{"dateUpdated":"2026-09-09T02:27:34.646Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","source_id":"cve"}],"published_at":"2026-09-09T02:27:34Z","record_id":"cve/CVE-2026-13359","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-09T02:27:34.646Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"url":"https://www.wordfence.com/threat-intel/vulnerabilities/id/838dd2f9-22e3-4833-9f55-09bd729fd6ed?source=cve"},{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-09T02:27:34.646Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"url":"https://plugins.trac.wordpress.org/browser/contact-form-to-db/tags/1.7.4/contact_form_to_db.php#L2035"},{"assertion_role":"cna","
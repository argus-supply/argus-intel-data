{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"unknown","version":"consult Xen advisory XSA-509"}],"product":"Xen","vendor":"Xen"}],"aliases":["CVE-2026-62437"],"assertions":[{"affected_indices":[0],"configurations":[{"lang":"en","value":"All Xen versions from at least 3.2 onwards are affected.  Older versions\nhave not been inspected.\n\nOnly HVM guests with assigned PCI devices can leverage the vulnerability."}],"datePublic":"2026-09-08T12:00:00.000Z","descriptions":[{"lang":"en","value":"When guests are terminated, various pieces of cleanup need carrying out.\nThe cleaning up of PCI devices which were assigned to guests, and the\nassociated removal of tracking structures for IRQs used by the devices\noccurs relatively early in the process.  Unfortunately after that point\nthe guest about to be terminated could cause its device model (DM) to\nre-establish such tracking structures, by having it bind one or more IRQs\nanew.  While some of those tracking structures would still be cleaned up\nlater on, at least one would not be."}],"provider":{"dateUpdated":"2026-09-08T12:10:52.643Z","orgId":"23aa2041-22e1-471f-9209-9b7396fa234f","shortName":"XEN"},"role":"cna","title":"x86: DMs may cause mem leak by IRQ binding"},{"affected_indices":[],"provider":{"dateUpdated":"2026-09-08T17:08:26.757Z","orgId":"af854a3a-2127-422b-91ae-364da2661108","shortName":"CVE"},"role":"adp","title":"CVE Program Container"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"905d3bcaa49627be308a0debd8b89f7ae4a11df11c7d498100193860289d8a70","data_version":"5.2","first_seen_at":"2026-09-09T08:45:09Z","kind":"advisory","last_material_event_at":"2026-09-09T08:45:09Z","native_id":"CVE-2026-62437","provenance":[{"revision":"a92308bd9728e7ed02eefc692887fb0afd62c228","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-20
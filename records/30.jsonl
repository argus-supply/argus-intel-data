{"affected":[{"assertion_role":"cna","defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"4.1.22","status":"affected","version":"0","versionType":"semver"}],"product":"Eventin – Event Calendar, Tickets, Registration, Booking & WooCommerce","provider":{"orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"vendor":"arraytics"}],"aliases":["CVE-2026-12956"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The WP Event Solution (Eventin) plugin for WordPress is vulnerable to Missing Authorization in versions up to, and including, 4.1.22 via the create_item() handler for the /wp-json/eventin/v2/orders REST endpoint. The endpoint's create_item_permissions_check() function only verifies a wp_rest nonce (which is leaked to every visitor through the etn-public script's localized_data_obj on every frontend page) and accepts a user-supplied 'status' value in prepare_item_for_database() with no whitelist validation. This makes it possible for unauthenticated attackers to create etn-order posts with status='completed' that are counted as sold by etn_get_sold_tickets_by_event(); because the auto-cleanup wp_schedule_single_event() in create_item() only fires for status='pending' orders, the forged completed orders persist indefinitely and exhaust ticket inventory."}],"metrics":[{"cvssV3_1":{"baseScore":5.3,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-862","description":"CWE-862 Missing Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-09T02:27:34.017Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"Eventin <= 4.1.22 - Missing Authorization to Unauthenticated Arbitrary Order Creation and Status Manipulation via 'status' Parameter"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"3c179c366ab4e61743cc52b26f0f544c7e44aeef678ab3bcb67b67b633783add","data_version":"5.2","descriptions":[{"lang":"en","value":"The WP Event Solution (Eventin) plugin for WordPress is vulnerable to Missing Authorization in versions up to, and including, 4.1.22 via the create_item() handler for the /wp-json/eventin/v2/orders REST endpoint. The endpoint's create_item_permissions_check() function only verifies a wp_rest nonce (which is leaked to every visitor through the etn-public script's localized_data_obj on every frontend page) and accepts a user-supplied 'status' value in prepare_item_for_database() with no whitelist validation. This makes it possible for unauthenticated attackers to create etn-order posts with status='completed' that are counted as sold by etn_get_sold_tickets_by_event(); because the auto-cleanup wp_schedule_single_event() in create_item() only fires for status='pending' orders, the forged completed orders persist indefinitely and exhaust ticket inventory."}],"first_seen_at":"2026-09-09T02:43:38Z","kind":"advisory","last_material_event_at":"2026-09-09T02:43:38Z","native_id":"CVE-2026-12956","provenance":[{"revision":"a92308bd9728e7ed02eefc692887fb0afd62c228","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-12956"},{"independent_evidence":true,"provider":{"dateUpdated":"2026-09-09T02:27:34.017Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","source_id":"cve"}],"published_at":"2026-09-09T02:27:34Z","record_id":"cve/CVE-2026-12956","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-09T02:27:34.017Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"url":"https://www.wordfence.com/threat-intel/vulnerabilities/id/5e87a9ac-e7c6-4622-b3e5-6e17e7664317?source=cve"},{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-09T02:27:34.017Z","orgId":"b15e7b5b-3da4-40a
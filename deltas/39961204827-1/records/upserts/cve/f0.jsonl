{"affected":[{"original_ranges":[{"status":"affected","version":">= 4.5.87, < 4.6.59"}],"product":"PraisonAI","vendor":"MervinPraison"}],"aliases":["CVE-2026-56838"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"PraisonAI is a multi-agent teams system. From version 4.5.87 to before version 4.6.59, PraisonAI recipe execution blocks default-denied dangerous tools unless the caller explicitly passes allow_dangerous_tools=True. The normal recipe.run() path enforces this with _check_tool_policy(). The streaming path, recipe.run_stream(), loads the same recipe, checks dependencies, and then calls _execute_recipe() without running the dangerous-tool policy check. As a result, a recipe that honestly declares execute_command in TEMPLATE.yaml requires.tools is denied by recipe.run(), but reaches the execution engine through recipe.run_stream() with allow_dangerous_tools=False. This issue has been patched in version 4.6.59."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"LOCAL","availabilityImpact":"HIGH","baseScore":7.8,"baseSeverity":"HIGH","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"REQUIRED","vectorString":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-78","description":"CWE-78: Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')","lang":"en","type":"CWE"}]},{"descriptions":[{"cweId":"CWE-693","description":"CWE-693: Protection Mechanism Failure","lang":"en","type":"CWE"}]},{"descriptions":[{"cweId":"CWE-863","description":"CWE-863: Incorrect Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-23T11:58:01.475Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"PraisonAI recipe.run_stream skips dangerous-tool policy enforcement"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"5287f8a1b6324ff7472da9ed2da7667cfdb784e5f94e4bcb46aa373d1f01812a","data_version":"5.2","first_seen_at":"2026-10-23T13:27:23Z","kind":"advisory","last_material_event_at":"2026-10-23T13:27:23Z","native_id":"CVE-2026-56838","provenance":[{"revision":"0129aaf9454eda60133f80b77c7cadf4c83bcc8d","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-56838"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-23T11:58:01Z","record_encoding":{"expanded_bytes":4201,"expanded_sha256":"67123d85806bfcfeb70d7b8829695bf7064a4a43564129d7f3f083b21b43d0e0","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-56838","references":[{"assertion_role":"cna","name":"https://github.com/MervinPraison/PraisonAI/security/advisories/GHSA-v847-hxxw-3pxg","provider":{"dateUpdated":"2026-10-23T11:58:01.475Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"tags":["x_refsource_CONFIRM"],"url":"https://github.com/MervinPraison/PraisonAI/security/advisories/GHSA-v847-hxxw-3pxg"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-23T11:58:01Z","status":"active","title":"PraisonAI recipe.run_stream skips dangerous-tool policy enforcement"}

{"affected":[{"original_ranges":[{"status":"affected","version":">= 4.5.126, < 4.6.59"}],"product":"PraisonAI","vendor":"MervinPraison"}],"aliases":["CVE-2026-57114"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"PraisonAI is a multi-agent teams system. From version 4.5.126 to before version 4.6.59, PraisonAI's Async Jobs API validates webhook_url when a job request is parsed and again when the internal Job object is constructed. That validation blocks direct loopback/private targets, but it is not bound to the later network request. When a job completes, _send_webhook() passes the original hostname to httpx.AsyncClient.post() with no send-time validation, IP pinning, or guarded transport. An attacker-controlled hostname can therefore resolve to a public IP during Pydantic validation and later resolve to loopback/private/cloud-metadata infrastructure during webhook delivery. This bypasses the intended SSRF guard in current supported releases. This appears to be an incomplete fix / patch bypass for GHSA-8frj-8q3m-xhgm. This issue has been patched in version 4.6.59."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":7.2,"baseSeverity":"HIGH","confidentialityImpact":"LOW","integrityImpact":"LOW","privilegesRequired":"NONE","scope":"CHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:L/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-367","description":"CWE-367: Time-of-check Time-of-use (TOCTOU) Race Condition","lang":"en","type":"CWE"}]},{"descriptions":[{"cweId":"CWE-918","description":"CWE-918: Server-Side Request Forgery (SSRF)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-23T12:04:29.966Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"PraisonAI: Jobs webhook SSRF protection bypass via DNS rebinding"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"8352a455509de8fa63249e17a1d99f480cd27441fc9b912a4055f7bee1948122","data_version":"5.2","first_seen_at":"2026-10-23T13:27:23Z","kind":"advisory","last_material_event_at":"2026-10-23T13:27:23Z","native_id":"CVE-2026-57114","provenance":[{"revision":"0129aaf9454eda60133f80b77c7cadf4c83bcc8d","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-57114"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-23T12:04:29Z","record_encoding":{"expanded_bytes":4350,"expanded_sha256":"154087c152cb5d4654f5eb546ff3ff1e1f8422b1379662f64fa656cd432ac20b","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-57114","references":[{"assertion_role":"cna","name":"https://github.com/MervinPraison/PraisonAI/security/advisories/GHSA-rjvw-7vvw-549v","provider":{"dateUpdated":"2026-10-23T12:04:29.966Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"tags":["x_refsource_CONFIRM"],"url":"https://github.com/MervinPraison/PraisonAI/security/advisories/GHSA-rjvw-7vvw-549v"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-23T12:04:29Z","status":"active","title":"PraisonAI: Jobs webhook SSRF protection bypass via DNS rebinding"}

{"affected":[{"original_ranges":[{"status":"affected","version":">= 3.8.1, < 4.6.59"}],"product":"PraisonAI","vendor":"MervinPraison"}],"aliases":["CVE-2026-56833"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"PraisonAI is a multi-agent teams system. From version 3.8.1 to before version 4.6.59, PraisonAI's Dynamic Context module provides filesystem-backed history and terminal-log storage. The module also exports agent-callable tool factories. Those tools accept run_id and agent_id arguments from the tool caller. The underlying stores join those values into filesystem paths without rejecting absolute paths or .. traversal. Because run_id can be an absolute path and agent_id can contain traversal, a lower-trust prompt/user that can call these tools can read .jsonl and .log files outside the configured Dynamic Context base directory. This issue has been patched in version 4.6.59."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":7.5,"baseSeverity":"HIGH","confidentialityImpact":"HIGH","integrityImpact":"NONE","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:N/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-22","description":"CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')","lang":"en","type":"CWE"}]},{"descriptions":[{"cweId":"CWE-200","description":"CWE-200: Exposure of Sensitive Information to an Unauthorized Actor","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-23T11:56:09.502Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"PraisonAI Dynamic Context history and terminal tools read files outside configured storage via path traversal"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"248229cd8c6b0ae2939c8ee530e59226356d32e5f4db83ae834a780c413e0acc","data_version":"5.2","first_seen_at":"2026-10-23T13:27:23Z","kind":"advisory","last_material_event_at":"2026-10-23T13:27:23Z","native_id":"CVE-2026-56833","provenance":[{"revision":"0129aaf9454eda60133f80b77c7cadf4c83bcc8d","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-56833"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-23T11:56:09Z","record_encoding":{"expanded_bytes":4117,"expanded_sha256":"dec7f5f756fb7db3a9255c05c11f6f3a078bb90abdaf3aef96f288f8807c67e4","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-56833","references":[{"assertion_role":"cna","name":"https://github.com/MervinPraison/PraisonAI/security/advisories/GHSA-22cj-m4wf-fv2c","provider":{"dateUpdated":"2026-10-23T11:56:09.502Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"tags":["x_refsource_CONFIRM"],"url":"https://github.com/MervinPraison/PraisonAI/security/advisories/GHSA-22cj-m4wf-fv2c"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-23T11:56:09Z","status":"active","title":"PraisonAI Dynamic Context history and terminal tools read files outside configured storage via path traversal"}

{"affected":[{"original_ranges":[{"status":"affected","version":"<= 1.0.0"}],"product":"eventschedule","vendor":"eventschedule"}],"aliases":["CVE-2026-55190"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Event Schedule is an open-source platform to share events, sell tickets and bring communities together. In versions 1.0.0 and prior, App\\Utils\\UrlUtils::isUrlSafe() is the SSRF guard applied to user-supplied import URLs. It can be bypassed two ways, both reaching internal/localhost services when the URL is later fetched by ImportCuratorEvents (Http::get($url) then the response body is parsed and imported as events, and file_get_contents($ogImage)). At time of publication, there are no publicly available patches."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":6.5,"baseSeverity":"MEDIUM","confidentialityImpact":"HIGH","integrityImpact":"NONE","privilegesRequired":"LOW","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:N/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-918","description":"CWE-918: Server-Side Request Forgery (SSRF)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-23T12:24:27.295Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"Event Schedule Vulnerable to SSRF: isUrlSafe() bypassable via bracketed IPv6 literals (parse_url keeps the brackets so the IPv6 guard never matches) and a v4-only-resolver fail-open; reaches internal/localhost services on event import"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"4f4966d468d549496569dc2261ad6df7b076eea323e3d666a5a51aef975e7753","data_version":"5.2","first_seen_at":"2026-10-23T13:27:23Z","kind":"advisory","last_material_event_at":"2026-10-23T13:27:23Z","native_id":"CVE-2026-55190","provenance":[{"revision":"0129aaf9454eda60133f80b77c7cadf4c83bcc8d","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-55190"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-23T12:24:27Z","record_encoding":{"expanded_bytes":3860,"expanded_sha256":"92e5024f23c4e38dc6c0e439f57d1d9ae831b25b712efc2056b2e3a4dcd1ef8b","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-55190","references":[{"assertion_role":"cna","name":"https://github.com/eventschedule/eventschedule/security/advisories/GHSA-664j-55hw-p8fm","provider":{"dateUpdated":"2026-10-23T12:24:27.295Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"tags":["x_refsource_CONFIRM"],"url":"https://github.com/eventschedule/eventschedule/security/advisories/GHSA-664j-55hw-p8fm"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-23T12:24:27Z","status":"active","title":"Event Schedule Vulnerable to SSRF: isUrlSafe() bypassable via bracketed IPv6 literals (parse_url keeps the brackets so the IPv6 guard never matches) and a v4-only-resolver fail-open; reaches internal/localhost services on event import"}

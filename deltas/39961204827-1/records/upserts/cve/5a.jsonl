{"affected":[{"original_ranges":[{"status":"affected","version":">= 4.5.115, < 4.6.61"}],"product":"PraisonAI","vendor":"MervinPraison"}],"aliases":["CVE-2026-57146"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"PraisonAI is a multi-agent teams system. From version 4.5.115 to before version 4.6.61, the published A2U advisory GHSA-f292-66h9-fpmf says unauthenticated A2U event streaming was fixed in praisonai 4.5.115. Current head still exposes the same A2U subscription and event routes without authentication when the operator starts the documented CLI entrypoint. The current CLI wrapper does not expose --api-key, does not install the common API-key middleware, and does not generate a token for A2U. It calls create_a2u_routes(app) directly. That helper only enforces auth if A2U_AUTH_TOKEN is already present; if the variable is missing, _authenticate_request() returns None and treats auth as disabled. This issue has been patched in version 4.6.61."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":7.5,"baseSeverity":"HIGH","confidentialityImpact":"HIGH","integrityImpact":"NONE","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:N/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-200","description":"CWE-200: Exposure of Sensitive Information to an Unauthorized Actor","lang":"en","type":"CWE"}]},{"descriptions":[{"cweId":"CWE-306","description":"CWE-306: Missing Authentication for Critical Function","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-23T12:08:16.479Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"PraisonAI A2U incomplete authentication fix leaves current serve command unauthenticated by default"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"33409b1837b5abc61a5edbe70d9af2b4eb59a1e2334a962cc22e33b6bae0abdd","data_version":"5.2","first_seen_at":"2026-10-23T13:27:23Z","kind":"advisory","last_material_event_at":"2026-10-23T13:27:23Z","native_id":"CVE-2026-57146","provenance":[{"revision":"0129aaf9454eda60133f80b77c7cadf4c83bcc8d","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-57146"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-23T12:08:16Z","record_encoding":{"expanded_bytes":4201,"expanded_sha256":"6e125831c82ac1ec08869377dc11f02cf06e1c541de5af68969499e6009e2f85","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-57146","references":[{"assertion_role":"cna","name":"https://github.com/MervinPraison/PraisonAI/security/advisories/GHSA-jxcw-qp4h-6jfq","provider":{"dateUpdated":"2026-10-23T12:08:16.479Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"tags":["x_refsource_CONFIRM"],"url":"https://github.com/MervinPraison/PraisonAI/security/advisories/GHSA-jxcw-qp4h-6jfq"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-23T12:08:16Z","status":"active","title":"PraisonAI A2U incomplete authentication fix leaves current serve command unauthenticated by default"}

{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["HTTP::Parser::XS"],"original_ranges":[{"lessThan":"0.18","status":"affected","version":"0","versionType":"custom"}],"packageName":"HTTP-Parser-XS","packageURL":"pkg:cpan/HTTP-Parser-XS","programFiles":["XS.xs"],"programRoutines":[{"name":"HTTP::Parser::XS::parse_http_request"}],"repo":"https://github.com/kazuho/p5-http-parser-xs"}],"aliases":["CVE-2026-116130"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"HTTP::Parser::XS versions before 0.18 for Perl truncate PATH_INFO at an encoded NUL byte in parse_http_request.\n\nThe XS parser URL-decodes the request path and measures the result with strlen(), so PATH_INFO ends at the first byte decoded from %00. The pure-Perl backend is not affected.\n\nA remote attacker can send a path that a proxy or filter checks in full while the application routes on a shorter one."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-626","description":"CWE-626 Null Byte Interaction Error (Poison Null Byte)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-30T12:38:27.038Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"HTTP::Parser::XS versions before 0.18 for Perl truncate PATH_INFO at an encoded NUL byte in parse_http_request"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"5605c8bc8ac0b103790464ee23172b1e43efd6d6fc07b8d0b1c6521998e749c9","data_version":"5.2","first_seen_at":"2026-10-30T12:56:09Z","kind":"advisory","last_material_event_at":"2026-10-30T12:56:09Z","native_id":"CVE-2026-116130","provenance":[{"revision":"cb14bf1b43b0c9f05f7f40eae2246263fd430780","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-116130"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-30T12:38:27Z","record_encoding":{"expanded_bytes":3504,"expanded_sha256":"863fb17bb9fa1f645a9ce936a229e09ae4510656b43b3a74362e02966a3b967d","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-116130","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-30T12:38:27.038Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"tags":["patch"],"url":"https://github.com/kazuho/p5-http-parser-xs/commit/f388b9d7994722b01edd03d57de7d2fb819e1aae.patch"},{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-30T12:38:27.038Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"tags":["release-notes"],"url":"https://metacpan.org/release/KAZUHO/HTTP-Parser-XS-0.18/changes"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-30T12:38:27Z","status":"active","title":"HTTP::Parser::XS versions before 0.18 for Perl truncate PATH_INFO at an encoded NUL byte in parse_http_request"}

{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["Business::GoCardless"],"original_ranges":[{"lessThan":"1.01","status":"affected","version":"0","versionType":"custom"}],"packageName":"Business-GoCardless","packageURL":"pkg:cpan/Business-GoCardless","programFiles":["lib/Business/GoCardless/Utils.pm"],"programRoutines":[{"name":"Business::GoCardless::Utils::signature_valid"}],"repo":"https://github.com/payprop/business-gocardless"}],"aliases":["CVE-2026-119037"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Business::GoCardless versions before 1.01 for Perl accept forged webhooks when a configured webhook secret is undef or empty.\n\nsignature_valid uses each configured secret as the HMAC key, and nothing rejects undef or an empty string, both of which Digest::SHA treats as an empty key. A secret read from an unset environment variable, or an empty entry in a list of rotated secrets, is used as is.\n\nA remote attacker can sign a forged webhook with an empty key and have it accepted as sent by GoCardless."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-347","description":"CWE-347 Improper Verification of Cryptographic Signature","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-30T12:56:27.922Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"Business::GoCardless versions before 1.01 for Perl accept forged webhooks when a configured webhook secret is undef or empty"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"64e054cadd71793364c5a9aef508d18a5a0f5db981352d23a7bf729da43e14e9","data_version":"5.2","first_seen_at":"2026-10-30T12:56:09Z","kind":"advisory","last_material_event_at":"2026-10-30T12:56:09Z","native_id":"CVE-2026-119037","provenance":[{"revision":"cb14bf1b43b0c9f05f7f4
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"4.2.3","status":"affected","version":"4.1.4","versionType":"semver"}],"product":"Enable Media Replace","vendor":"Unknown"}],"aliases":["CVE-2026-114422"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Enable Media Replace WordPress plugin before 4.2.3 does not restrict the classes allowed when deserializing stored metadata during its media replace-and-update-links routine, allowing unauthenticated users to inject a PHP object that is instantiated when a user with upload access performs a routine media replacement, resulting in PHP Object Injection and local file inclusion of existing PHP/HTML files, which can be escalated to remote code execution where an attacker-influenced PHP or HTML file is present on the server.\nThis is a regression of CVE-2023-4643, which was fixed in 4.1.3 and reintroduced in 4.1.4."}],"problemTypes":[{"descriptions":[{"description":"CWE-502 Deserialization of Untrusted Data","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-30T06:00:22.558Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Enable Media Replace 4.1.4 - 4.2.2 - Unauthenticated PHP Object Injection via Metadata Replacer"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"06e2c6059a9a34d2e10f8a397450a1ee929439d3ffa4923ce7b70379002b284d","data_version":"5.2","first_seen_at":"2026-10-30T12:56:09Z","kind":"advisory","last_material_event_at":"2026-10-30T12:56:09Z","native_id":"CVE-2026-114422","provenance":[{"revision":"cb14bf1b43b0c9f05f7f40eae2246263fd430780","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-114422"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-30T06:00:22Z","record_encoding":{"expanded_bytes":3392,"expanded_sha256":"9fd115ee4543ea1fd1f82892e62738b99fc76d1fc45380668204b397550ecf27","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-114422","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-30T06:00:22.558Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"tags":["exploit","vdb-entry","technical-description"],"url":"https://wpscan.com/vulnerability/e0fa983d-19b6-438b-96c1-7ae6e8ccace4/"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-30T06:00:22Z","status":"active","title":"Enable Media Replace 4.1.4 - 4.2.2 - Unauthenticated PHP Object Injection via Metadata Replacer"}

{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"3.1.2","status":"affected","version":"0","versionType":"semver"}],"product":"Gravity Forms","vendor":"Gravity Forms"}],"aliases":["CVE-2026-97645"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Gravity Forms plugin for WordPress is vulnerable to Stored Cross-Site Scripting via List Field in all versions up to, and including, 3.1.2 due to insufficient input sanitization and output escaping. This makes it possible for unauthenticated attackers to inject arbitrary web scripts in pages that will execute whenever a user accesses an injected page. Successful exploitation requires the administrator to click the injected link in the entry detail view and confirm a dialog, which triggers the admin JavaScript bundle's delegated data-dialog-callback handler to invoke the attacker-supplied function reference."}],"metrics":[{"cvssV3_1":{"baseScore":7.2,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:L/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-79","description":"CWE-79 Improper Neutralization of Input During Web Page Generation","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-30T06:47:31.434Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"Gravity Forms <= 3.1.2 - Unauthenticated Stored Cross-Site Scripting via List Field"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"e0bf27ac3b66e9f46015bb1df9aeb7f2317e97ddcf6cbc8a24e0136bbb080357","data_version":"5.2","first_seen_at":"2026-10-30T12:56:09Z","kind":"advisory","last_material_event_at":"2026-10-30T12:56:09Z","native_id":"CVE-2026-97645","provenance":[{"revision":"cb14bf1b43b0c9f05f7f40eae2246263fd430780","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-97645"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-30T06:47:31Z","record_encoding":{"expanded_bytes":3726,"expanded_sha256":"5920ec4bcd48d45059552600a11713783734136824af8cfa897292007e54f333","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-97645","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-30T06:47:31.434Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"url":"https://www.wordfence.com/threat-intel/vulnerabilities/id/9889e718-381b-4d11-a234-0278037c61c4?source=cve"},{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-30T06:47:31.434Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"url":"https://docs.gravityforms.com/"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-30T06:47:31Z","status":"active","title":"Gravity Forms <= 3.1.2 - Unauthenticated Stored Cross-Site Scripting via List Field"}

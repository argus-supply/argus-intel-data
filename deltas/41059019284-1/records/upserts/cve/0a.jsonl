{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"4.3.14","status":"affected","version":"0","versionType":"semver"}],"product":"User Frontend","vendor":"Unknown"}],"aliases":["CVE-2026-115277"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The User Frontend  WordPress plugin before 4.3.14 does not sanitise and escape some user-supplied values before reflecting them into HTML attributes in a publicly reachable AJAX response, leading to Reflected Cross-Site Scripting. The affected action is gated by an anonymous nonce that only validates for logged-out requests, so the payload executes against logged-out visitors rather than authenticated users."}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Cross-Site Scripting (XSS)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-30T06:00:23.167Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"WP User Frontend < 4.3.14 - Reflected XSS via 'field_attr' Parameter"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"8fa945e9cbf46e5bb25212894668f29bc814d1775a036f23204d33df45d78ba4","data_version":"5.2","first_seen_at":"2026-10-30T12:56:09Z","kind":"advisory","last_material_event_at":"2026-10-30T12:56:09Z","native_id":"CVE-2026-115277","provenance":[{"revision":"cb14bf1b43b0c9f05f7f40eae2246263fd430780","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-115277"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-30T06:00:23Z","record_encoding":{"expanded_bytes":2900,"expanded_sha256":"d0d77ce76cc7999032d44e0e7379854659a30ac903937d5945e24c50f9340cb0","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-115277","referenc
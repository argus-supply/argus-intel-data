{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["Starlet"],"original_ranges":[{"lessThan":"0.33","status":"affected","version":"0.20","versionType":"custom"}],"packageName":"Starlet","packageURL":"pkg:cpan/Starlet","programFiles":["lib/Starlet/Server.pm"],"programRoutines":[{"name":"Starlet::Server::handle_connection"}],"repo":"https://github.com/kazuho/Starlet"}],"aliases":["CVE-2026-116128"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Starlet versions from 0.20 before 0.33 for Perl allow memory exhaustion via unbounded buffering when decoding chunked request bodies.\n\nThe decoder adds each read to one buffer of unconsumed input. Nothing limits the length of a chunk-size line, so a line without a CRLF grows the buffer for as long as the client keeps sending, and the read timeout restarts after every read. The data of a large chunk is also held in the buffer until the whole chunk has arrived.\n\nA remote attacker can exhaust a worker's memory with a single request."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-770","description":"CWE-770 Allocation of Resources Without Limits or Throttling","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-30T12:46:30.844Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"Starlet versions from 0.20 before 0.33 for Perl allow memory exhaustion via unbounded buffering when decoding chunked request bodies"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"629dba2781dc2ab25220d48e9446929a82b9e63b4ee5ad02cc2819351043f1c6","data_version":"5.2","first_seen_at":"2026-10-30T12:56:09Z","kind":"advisory","last_material_event_at":"2026-10-30T12:56:09Z","native_id":"CVE-2026-116128","provenance":[{"revision":"cb14bf1b43b0c9f05f7f40eae2246263fd430780","so
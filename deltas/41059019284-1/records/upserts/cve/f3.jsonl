{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["DateTime::Lite"],"original_ranges":[{"lessThan":"0.8.1","status":"affected","version":"0","versionType":"custom"}],"packageName":"DateTime-Lite","packageURL":"pkg:cpan/DateTime-Lite","programFiles":["DateTime-Lite.xs","lib/DateTime/Lite/PP.pm"],"programRoutines":[{"name":"DateTime::Lite::_normalize_leap_seconds"},{"name":"DateTime::Lite::add"}],"repo":"https://gitlab.com/deguest/DateTime-Lite"}],"aliases":["CVE-2026-87768"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"DateTime::Lite versions before 0.8.1 for Perl allow CPU exhaustion via a per-day loop when adding seconds.\n\n_normalize_leap_seconds crosses day boundaries one day at a time, so add(seconds => $n) on an object with a non-floating time zone takes about |$n|/86400 iterations, and nothing limits $n. The XS implementation and the pure-Perl fallback both have the loop.\n\nAn attacker who controls the number of seconds added can keep the process busy for as long as they choose."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-407","description":"CWE-407 Inefficient Algorithmic Complexity","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-30T12:25:21.054Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"DateTime::Lite versions before 0.8.1 for Perl allow CPU exhaustion via a per-day loop when adding seconds"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"47f7e119ebb6a2b720159940c5d908f2f5d5cba50147bc7c62569189bc340fbd","data_version":"5.2","first_seen_at":"2026-10-30T12:56:09Z","kind":"advisory","last_material_event_at":"2026-10-30T12:56:09Z","native_id":"CVE-2026-87768","provenance":[{"revision":"cb14bf1b43b0c9f05f7f40eae2246263fd430780","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-87768"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-30T12:25:21Z","record_encoding":{"expanded_bytes":3407,"expanded_sha256":"02e3e4588893419dc7308b26f7c7d777636faad6d5bd9e39422824aaae9cb483","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-87768","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-30T12:25:21.054Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"tags":["release-notes"],"url":"https://metacpan.org/release/JDEGUEST/DateTime-Lite-v0.8.1/changes"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-30T12:25:21Z","status":"active","title":"DateTime::Lite versions before 0.8.1 for Perl allow CPU exhaustion via a per-day loop when adding seconds"}

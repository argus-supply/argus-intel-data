{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-79589"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The WIFI4 N300 router (Model: T1 Pro) v1.0.0 by U-speed contains an insecure access control flaw that allows an attacker to gain unauthenticated root shell. The vulnerability is caused by the exposure of the UART debugging interface having a lack of authentication, authorization and access control functionality. Once the interface is soldered and connected to the attacker, they gain root privilege to the system."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-10-29T14:02:04.041Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"98a773f172256ed46753586db508c6a772886fbfb0d2b15a815684c33f717847","data_version":"5.2","first_seen_at":"2026-10-29T19:38:40Z","kind":"advisory","last_material_event_at":"2026-10-29T19:38:40Z","native_id":"CVE-2026-79589","provenance":[{"revision":"420a4ed93f3dbc2b6b88a57c9b1feda3ad018699","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-79589"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-29T00:00:00Z","record_encoding":{"expanded_bytes":2960,"expanded_sha256":"58e1a887197c239ef6f24aee9cb13145d1ce287ca04b40b804180b04c62de822","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-79589","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-29T14:02:04.041Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"url":"https://www.u-speed.com.cn/en/produc
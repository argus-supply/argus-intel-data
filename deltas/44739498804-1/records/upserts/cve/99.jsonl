{"affected":[{"original_ranges":[{"lessThan":"8.8.0","status":"affected","version":"0","versionType":"custom"}],"product":"Splunk SOAR","vendor":"Splunk"}],"aliases":["CVE-2026-131282"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-18T00:00:00.000Z","descriptions":[{"lang":"en","value":"In Splunk SOAR versions below 8.8.0, a user who holds the \"Observer\" Splunk SOAR role could access a password-reset credential in a diagnostic log bundle and reset the password for an active local account.\nThe vulnerability is possible because Splunk SOAR does not redact password-reset email bodies before it logs communications between product processes."}],"metrics":[{"cvssV3_1":{"baseScore":8.1,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-532","description":"Information written to log files can be of a sensitive nature and give valuable guidance to an attacker or expose sensitive user information.","lang":"en","type":"cwe"}]}],"provider":{"dateUpdated":"2026-11-19T19:56:33.166Z","orgId":"d1c1063e-7a18-46af-9102-31f8928bc633","shortName":"cisco"},"role":"cna","title":"Information Exposure through the REST API in Splunk SOAR"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-131282","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-11-19T00:00:00+00:00","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-11-20T04:56:59.876Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"3bf0586153a47fc4d4de25348d7399444a291154fddf755723
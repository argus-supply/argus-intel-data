{"affected":[{"original_ranges":[{"lessThan":"8.8.0","status":"affected","version":"0","versionType":"custom"}],"product":"Splunk SOAR","vendor":"Splunk"}],"aliases":["CVE-2026-131255"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-18T00:00:00.000Z","descriptions":[{"lang":"en","value":"In Splunk SOAR versions below 8.8.0, an unauthenticated user could gain administrator privileges through a user account that receives an unintended role. A user that holds a role with permission to create or modify users and assign roles must assign the target account a role with a numeric name through the user-management Representational State Transfer (REST) API.\nThe vulnerability is possible because the API resolves a numeric role name as a role identifier instead of preserving the requested role name."}],"metrics":[{"cvssV3_1":{"baseScore":7.5,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:R/S:U/C:H/I:H/A:H","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-706","description":"The software uses a name or reference to access a resource, but the name/reference resolves to a resource that is outside of the intended control sphere.","lang":"en","type":"cwe"}]}],"provider":{"dateUpdated":"2026-11-19T19:56:17.473Z","orgId":"d1c1063e-7a18-46af-9102-31f8928bc633","shortName":"cisco"},"role":"cna","title":"Privilege Escalation through REST API User Role Assignment in Splunk SOAR"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-131255","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-11-19T00:00:00+00:00","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-11-20T04:57:03.098Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confide
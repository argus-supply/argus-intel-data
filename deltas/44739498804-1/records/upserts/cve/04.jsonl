{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"1.3.12","status":"affected","version":"1.3.0","versionType":"semver"}],"product":"Mqtt Datasource","vendor":"Grafana"}],"aliases":["CVE-2026-87956"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-19T12:34:51.492Z","descriptions":[{"lang":"en","value":"When Private data source connect (PDC) or a secure SOCKS proxy is used, the MQTT data source plugin does not apply TLS to broker connections for the tls, ssl, tcps, mqtts and mqtt+ssl schemes. The configured TLS settings are ignored, and the broker username and password are sent unencrypted on the hop between the proxy and the broker. The server certificate is not verified, and a configured client certificate is not sent."}],"metrics":[{"cvssV3_1":{"baseScore":6.1,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:A/AC:H/PR:N/UI:N/S:C/C:H/I:N/A:N","version":"3.1"}}],"provider":{"dateUpdated":"2026-11-20T08:33:38.282Z","orgId":"57da9224-a3e2-4646-9d0e-c4dc2e05e7da","shortName":"GRAFANA"},"role":"cna","title":"CVE-2026-87956 CVE Record"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-87956","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-11-19T16:31:56.914783Z","version":"2.0.3"},"type":"ssvc"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-319","description":"CWE-319 Cleartext Transmission of Sensitive Information","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-19T16:40:01.266Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"9be15e544f13c5e02252e1dd7397cbc23bd7836b29388691565ffa4d797ae9f0","data_version":"5.2","first_seen_at":"2026-11
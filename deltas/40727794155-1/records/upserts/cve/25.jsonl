{"affected":[{"collectionURL":"https://wordpress.org/plugins","defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.0.2","status":"affected","version":"0","versionType":"semver"}],"product":"Smart Popup by Supsystic","vendor":"Unknown"}],"aliases":["CVE-2026-115223"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Smart Popup by Supsystic WordPress plugin before 2.0.2 does not prevent template-injection payloads from being stored in a popup text block and later evaluated by its template engine, because the filter meant to strip template delimiters runs before a decoding step that reconstructs them, allowing an authenticated administrator to execute arbitrary template expressions server-side and read PHP constants such as the site's database credentials and authentication keys."}],"metrics":[{"cvssV3_1":{"baseScore":4.9,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:U/C:H/I:N/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"description":"CWE-1336 Improper Neutralization of Special Elements Used in a Template Engine","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T10:45:14.251Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Smart Popup by Supsystic < 2.0.2 - Admin+ SSTI via Popup Text Block"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"e3cc46acd79dd942720197aacd72787fb35ceb4b3477588c0cc9e677e2ff6be4","data_version":"5.2","first_seen_at":"2026-10-28T16:38:29Z","kind":"advisory","last_material_event_at":"2026-10-28T16:38:29Z","native_id":"CVE-2026-115223","provenance":[{"revision":"242fd0d586b5be32763abaaca79d338f73834fd1","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-115223"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_a
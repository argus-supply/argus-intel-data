{"affected":[{"original_ranges":[{"status":"affected","version":"< 2026.9.2410"}],"product":"App","vendor":"topluyo"}],"aliases":["CVE-2026-115904"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Topluyo is a social networking platform. A vulnerability exists in Topluyo Desktop for Linux prior to version 2026.9.2410 where user-controlled URLs are unsafely processed, leading to OS Command Injection via the `openExternalLinks()` routine in `utils.js`. An attacker who controls a target URL can execute arbitrary operating system commands with the privileges of the user running the application upon opening the link. Version 2026.9.2410 patches the issue."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"HIGH","baseScore":9.6,"baseSeverity":"CRITICAL","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"NONE","scope":"CHANGED","userInteraction":"REQUIRED","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:H/I:H/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-78","description":"CWE-78: Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T12:55:04.432Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"Topluyo Desktop for Linux has an OS Command Injection issue"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"7de13333dd17a4e5e5de29ad333cf3ac627639e082599645b54401bd0cd3cd45","data_version":"5.2","first_seen_at":"2026-10-28T16:38:29Z","kind":"advisory","last_material_event_at":"2026-10-28T16:38:29Z","native_id":"CVE-2026-115904","provenance":[{"revision":"242fd0d586b5be32763abaaca79d338f73834fd1","source_id":"cve","url":"https://www.cve.org/CVERecord?id
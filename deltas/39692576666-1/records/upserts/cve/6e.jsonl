{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["Rex"],"original_ranges":[{"lessThanOrEqual":"1.16.1","status":"affected","version":"0","versionType":"custom"}],"packageName":"Rex","packageURL":"pkg:cpan/Rex","programFiles":["lib/Rex/Commands/Rsync.pm"],"programRoutines":[{"name":"Rex::Commands::Rsync::sync"}],"repo":"https://github.com/RexOps/Rex"}],"aliases":["CVE-2026-94140"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Rex versions through 1.16.1 for Perl accept an unknown SSH host key for remote rsync transfers because sync hardcodes StrictHostKeyChecking=no.\n\nEvery remote branch of sync builds its ssh command with that option, for password authentication, for private-key authentication and for the fallback. The ssh options a caller sets through set_openssh_opt reach the OpenSSH transport but not this command, so there is no configuration that restores host key checking for the transfer.\n\nAn attacker who can redirect the connection before the real host key is known presents their own and the transfer proceeds: under password authentication sync sends the connection password to that server, an upload writes the selected local files to it, and a download writes what it returns to the local destination."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-322","description":"CWE-322 Key Exchange without Entity Authentication","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-21T21:22:19.577Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"Rex versions through 1.16.1 for Perl accept an unknown SSH host key for remote rsync transfers because sync hardcodes StrictHostKeyChecking=no"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"efb1ff4f3a4ecf408093685efb669af1e982396057b722a2b5e2d192af30f00c","data_version":"5.2","first_seen_at":"2026-10-21T23:19:30Z","kind":"advisory","last_material_event_at":"2026-10-21T23:19:30Z","native_id":"CVE-2026-94140","provenance":[{"revision":"e664773b94503eccc934cc682798bcda46013848","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-94140"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-21T21:22:19Z","record_encoding":{"expanded_bytes":4062,"expanded_sha256":"ef85dce0145a62ad7d1c628e572f59e6792b21d10d4ebd113085bd1481f0a710","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-94140","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-21T21:22:19.577Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"tags":["technical-description"],"url":"https://metacpan.org/release/FERKI/Rex-1.16.1/source/lib/Rex/Commands/Rsync.pm"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-21T21:22:19Z","status":"active","title":"Rex versions through 1.16.1 for Perl accept an unknown SSH host key for remote rsync transfers because sync hardcodes StrictHostKeyChecking=no"}

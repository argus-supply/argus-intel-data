{"affected":[{"original_ranges":[{"lessThanOrEqual":"2026.8.19","status":"affected","version":"0","versionType":"custom"}],"product":"Hermes Agent","vendor":"Nous Research"}],"aliases":["CVE-2026-114463"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The webhook platform gateway in Nous Research Hermes Agent versions builds the session chat_id as webhook:{route_name}:{delivery_id} and re-derives the authorizing route by splitting that string, so a route name containing a \":\" resolves toolset authorization to a different, higher-privileged prefix route than the one authenticated, which allows a remote attacker with the target HMAC to gain that higher-privileged route's toolsets."}],"problemTypes":[{"descriptions":[{"description":"CWE-863 Incorrect Authorization","lang":"en"}]}],"provider":{"dateUpdated":"2026-10-21T19:25:04.202Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"role":"cna","title":"CVE-2026-114463"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"f31ba89a97edd0a17fa98f16d30935087fe0907c0dc3c2641f8454dfd8b2f2ab","data_version":"5.2","first_seen_at":"2026-10-21T18:39:58Z","kind":"advisory","last_material_event_at":"2026-10-21T18:39:58Z","native_id":"CVE-2026-114463","provenance":[{"revision":"e664773b94503eccc934cc682798bcda46013848","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-114463"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-21T15:01:02Z","record_encoding":{"expanded_bytes":3217,"expanded_sha256":"95c1efa22e20fa7b47db979101d0a57fa8d84c8d7fa78c08dddc603b0f72a3e0","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-114463","references":[{"assertion_role":"cna","provider":{"dateUpdated":"
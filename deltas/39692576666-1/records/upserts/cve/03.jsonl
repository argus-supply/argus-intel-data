{"affected":[{"original_ranges":[{"lessThan":"8.7.0","status":"affected","version":"0","versionType":"custom"}],"product":"Splunk SOAR","vendor":"Splunk"}],"aliases":["CVE-2026-76530"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-21T00:00:00.000Z","descriptions":[{"lang":"en","value":"As part of Cisco's ongoing commitment to proactive security and product quality, Cisco has conducted a comprehensive internal security review. This review resulted in a software hardening release that addresses multiple internally discovered vulnerabilities. The vulnerabilities tracked by CVE-2026-76530 are related to use of non-canonical URL paths for authorization decisions and are grouped under the Common Weakness Enumeration (CWE) CWE-647."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-647","description":"The software defines policy namespaces and makes authorization decisions based on the assumption that a URL is canonical. This can allow a non-canonical URL to bypass the authorization.","lang":"en","type":"cwe"}]}],"provider":{"dateUpdated":"2026-10-21T22:52:19.125Z","orgId":"d1c1063e-7a18-46af-9102-31f8928bc633","shortName":"cisco"},"role":"cna","title":"Use of Non-Canonical URL Paths for Authorization Decisions in Splunk SOAR"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"504f5cd78edbf896b42b5ef0bc386c308b9cf90b932faf71d2b3ef43ef6ef295","data_version":"5.2","first_seen_at":"2026-10-21T23:19:30Z","kind":"advisory","last_material_event_at":"2026-10-21T23:19:30Z","native_id":"CVE-2026-76530","provenance":[{"revision":"e664773b94503eccc934cc682798bcda46013848","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-76530"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-21T22:52:19Z","record_encoding":{"expanded_bytes":3078,"expanded_sha256":"68a39be918f
{"affected":[{"modules":["REST API"],"original_ranges":[{"lessThan":"8.7.0","status":"affected","version":"0","versionType":"custom"}],"product":"Splunk SOAR","vendor":"Splunk"}],"aliases":["CVE-2026-76406"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-21T00:00:00.000Z","descriptions":[{"lang":"en","value":"In Splunk SOAR versions below 8.7.0, an unauthenticated user with access to encrypted credential data from an affected Splunk SOAR instance could submit Basic authentication data to the Representational State Transfer (REST) API to expose and decrypt that encrypted credential data.\nThe vulnerability is possible because Splunk SOAR decrypts encrypted Basic authentication values before completing authentication checks.\nThe attack requires the unauthenticated user to have encrypted credential data from an affected Splunk SOAR instance. The unauthenticated user should not be able to exploit the vulnerability at will.\nFor more information see Using the REST API reference for Splunk SOAR (On-premises) (https://help.splunk.com/en/splunk-soar/soar-on-premises/rest-api-reference/8.5.0/using-the-splunk-soar-rest-api/using-the-rest-api-reference-for-splunk-soar-on-premises) in the Splunk documentation."}],"metrics":[{"cvssV3_1":{"baseScore":5.9,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:N/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-203","description":"The product behaves differently or sends different responses under different circumstances in a way that is observable to an unauthorized actor, which exposes security-relevant information about the state of the product, such as whether a particular operation was successful or not.","lang":"en","type":"cwe"}]}],"provider":{"dateUpdated":"2026-10-21T22:52:12.496Z","orgId":"d1c1063e-7a18-46af-9102-31f8928bc633","shortName":"cisco"},"role":"cna","title":"Information Disclosure through REST API Authentication in Splunk SOAR"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"060d97857d2367d93485119f50dc30e98ec4dd04bf39930078308c0bdd41ee5f","data_version":"5.2","first_seen_at":"2026-10-21T23:19:30Z","kind":"advisory","last_material_event_at":"2026-10-21T23:19:30Z","native_id":"CVE-2026-76406","provenance":[{"revision":"e664773b94503eccc934cc682798bcda46013848","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-76406"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-21T22:52:12Z","record_encoding":{"expanded_bytes":4317,"expanded_sha256":"6d44e5bfe3889bd733f0b294161bcd1cbc56bf5176d5a7adf51d6d7568c18da5","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-76406","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-21T22:52:12.496Z","orgId":"d1c1063e-7a18-46af-9102-31f8928bc633","shortName":"cisco"},"url":"https://advisory.splunk.com/advisories/SVD-2026-1010"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-21T22:52:12Z","status":"active","title":"Information Disclosure through REST API Authentication in Splunk SOAR"}

{"affected":[{"original_ranges":[{"lessThan":"8.7.0","status":"affected","version":"0","versionType":"custom"}],"product":"Splunk SOAR","vendor":"Splunk"}],"aliases":["CVE-2026-76526"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-21T00:00:00.000Z","descriptions":[{"lang":"en","value":"As part of Cisco's ongoing commitment to proactive security and product quality, Cisco has conducted a comprehensive internal security review. This review resulted in a software hardening release that addresses multiple internally discovered vulnerabilities. The vulnerabilities tracked by CVE-2026-76526 are related to improper neutralization and are grouped under the Common Weakness Enumeration (CWE) CWE-707."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-707","description":"The product does not ensure or incorrectly ensures that structured messages or data are well-formed and that certain security properties at met before being read from an upstream component or sent to a downstream component.","lang":"en","type":"cwe"}]}],"provider":{"dateUpdated":"2026-10-21T22:52:15.442Z","orgId":"d1c1063e-7a18-46af-9102-31f8928bc633","shortName":"cisco"},"role":"cna","title":"Improper Neutralization in Splunk SOAR"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"6b16dba4dccbd6869828f853ddd37e2888a661c562941fb31549d820f0bdf91e","data_version":"5.2","first_seen_at":"2026-10-21T23:19:30Z","kind":"advisory","last_material_event_at":"2026-10-21T23:19:30Z","native_id":"CVE-2026-76526","provenance":[{"revision":"e664773b94503eccc934cc682798bcda46013848","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-76526"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-21T22:52:15Z","record_encoding":{"expanded_bytes":2976,"expanded_sha256":"48c3b4c927ea7269c924da8889b8278c148ac5c7977
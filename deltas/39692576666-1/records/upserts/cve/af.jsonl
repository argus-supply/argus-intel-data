{"affected":[{"modules":["Splunk Web"],"original_ranges":[{"lessThan":"10.4.4","status":"affected","version":"10.4","versionType":"custom"},{"lessThan":"10.2.8","status":"affected","version":"10.2","versionType":"custom"},{"lessThan":"10.0.11","status":"affected","version":"10.0","versionType":"custom"},{"lessThan":"9.4.16","status":"affected","version":"9.4","versionType":"custom"}],"product":"Splunk Enterprise","vendor":"Splunk"}],"aliases":["CVE-2026-76288"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-21T00:00:00.000Z","descriptions":[{"lang":"en","value":"In Splunk Enterprise versions below 10.4.4, 10.2.8, 10.0.11, and 9.4.16, an unauthenticated user could send a single crafted request to the Splunk Web JavaScript logger endpoint and cause Splunk Web to stop responding to requests. Splunk Web remains unavailable until Splunk Enterprise is restarted.\nThe vulnerability is possible because Splunk Web does not limit request-header parsing before processing the request."}],"metrics":[{"cvssV3_1":{"baseScore":7.5,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-400","description":"The software does not properly control the allocation and maintenance of a limited resource thereby enabling an actor to influence the amount of resources consumed, eventually leading to the exhaustion of available resources.","lang":"en","type":"cwe"}]}],"provider":{"dateUpdated":"2026-10-21T22:51:50.487Z","orgId":"d1c1063e-7a18-46af-9102-31f8928bc633","shortName":"cisco"},"role":"cna","title":"Denial of Service (DoS) through Splunk Web Content-Type Header Parsing in Splunk Enterprise"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"4b5bb1df1edc0a67d9f92d734eac
{"affected":[{"collectionURL":"https://pypi.org/project/ansible-core/","defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.23.0","status":"affected","version":"2.19.0","versionType":"semver"}],"packageName":"ansible-core","product":"ansible-core","vendor":"Red Hat"}],"aliases":["CVE-2026-123036"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A flaw was found in ansible-core. When a task marked `no_log: true` fails, the task result is censored before being emitted, but the `exception` field is retained because it is present in the PRESERVE allow-list in lib/ansible/_internal/_task.py, and the default stdout callback prints it through CallbackBase._handle_exception. As a result, sensitive values the operator explicitly asked to hide can be disclosed: module argument-validation errors echo the argument value, templating errors print an Origin source snippet (the failing line plus the two preceding lines of the variables file, exposing neighbouring secrets from an -e @secrets.yml file), and fail/assert messages are printed in full. Secret material supplied as extra variables or variables files can therefore leak to terminal output, CI logs, and the stdout logs of any automation wrapping ansible-playbook, even though every task touching the secrets is marked no_log: true. This is a regression introduced with the ansible-core 2.19 data-tagging/templating rework; the behaviour does not occur on 2.16, where the error text is correctly censored."}],"metrics":[{"cvssV3_1":{"baseScore":5.5,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:N/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-209","description":"CWE-209 Generation of Error Message Containing Sensitive Information","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-05T09:38:31.304Z","orgId":"53f830b8-0a3f-465b-8143-3b8a9948e749","shortName":"redhat"},"role":"cna"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-123036","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-11-05T16:41:30.073071Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-11-05T19:04:44.264Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"8ef770d3015b7aab5f17420cb33a6498b5be39168db849308fdc67212412806f","data_version":"5.2","first_seen_at":"2026-11-05T18:01:02Z","kind":"advisory","last_material_event_at":"2026-11-05T23:38:36Z","native_id":"CVE-2026-123036","provenance":[{"revision":"2dd4796b36e7d6eb5f84a8f3c36b9191ab17defb","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-123036"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"},{"assertion_index":1,"independent_evidence":false,"source_id":"cve"}],"published_at":"2026-11-05T09:38:31Z","record_encoding":{"expanded_bytes":5021,"expanded_sha256":"747e3818d651ea5b44be0a7d91ecdfe2eb6f52ba041a10b4aa46790a30a6cb14","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-123036","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-05T09:38:31.304Z","orgId":"53f830b8-0a3f-465b-8143-3b8a9948e749","shortName":"redhat"},"url":"https://access.redhat.com/security/cve/CVE-2026-123036"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-11-05T19:04:44Z","status":"active","title":"CVE-2026-123036"}

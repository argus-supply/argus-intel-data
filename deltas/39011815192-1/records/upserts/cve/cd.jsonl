{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"7.4","status":"affected","version":"0","versionType":"custom"}],"product":"Guardicore Platform Agent","vendor":"Akamai"}],"aliases":["CVE-2026-50215"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A use-after-free exists in the Windows WFP packet-capture driver shipped with Akamai Guardicore Platform Agent (GPA) before 7.4. When an IPv6 proxy/redirect rule is active, a local attacker with Administrator privileges can send a single crafted outbound IPv6 packet via a raw IPV6_HDRINCL socket to trigger this at DISPATCH_LEVEL, resulting in an immediate system crash."}],"metrics":[{"cvssV3_1":{"baseScore":4.4,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:L/AC:L/PR:H/UI:N/S:U/C:N/I:N/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-416","description":"CWE-416 Use After Free","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-14T05:12:51.661Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-50215","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-10-17T00:54:05.340202Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-10-17T00:54:14.593Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"7529d5b2b6fa52f425be26bc436a608576494ae72f296bb64c04e6ee220692dc","data_version":"5.2","first_seen_at":"2026-10-14T07:38:52Z","kind":"advisory","last_material_event_at":"2026-10-17T06:58:10Z","native_id":"CVE-2026-50215","provenance":[{"revision":"9346c7941d5e912a234a27ed1e2d26c9e
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"7.6.12","status":"affected","version":"0","versionType":"semver"}],"product":"CTX Feed Pro","vendor":"CTX"}],"aliases":["CVE-2026-10026"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The CTX Feed Pro plugin for WordPress is vulnerable to Code Injection in all versions up to, and including, 7.6.12. This is due to insufficient input validation on the 'Feed Config' field which is passed directly to the eval() function. This makes it possible for authenticated attackers, with Administrator-level access and above, to execute arbitrary PHP code on the server."}],"metrics":[{"cvssV3_1":{"baseScore":7.2,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:U/C:H/I:H/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-94","description":"CWE-94 Improper Control of Generation of Code ('Code Injection')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-02T04:27:11.832Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"CTX Feed Pro <= 7.6.12 - Authenticated (Administrator+) Remote Code Execution"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"f892573cda953561f46545ce7c37933b9c0efb54256d0c0887fb215a0c1bed2c","data_version":"5.2","first_seen_at":"2026-10-02T05:37:59Z","kind":"advisory","last_material_event_at":"2026-10-02T05:37:59Z","native_id":"CVE-2026-10026","provenance":[{"revision":"a899bd58d1e364a7b99ea938d899e68aebb1e9eb","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-10026"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-02T04:27:11Z","record_encoding":{"expanded_bytes":3246,"expanded_sha256":"d8d5c0048ccaee10d6770ca5d13f7da8f0f96fd4c64103ed5768c1d74c
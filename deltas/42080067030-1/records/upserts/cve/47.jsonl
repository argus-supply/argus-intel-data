{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"3.3.0","status":"affected","version":"1","versionType":"semver"}],"product":"PostgreSQL Anonymizer","vendor":"DALIBO"}],"aliases":["CVE-2026-105615"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"PostgreSQL's optimized statistics on a table are visible as long as you have SELECT privilege on said table. A masked role can therefore read a limited subset of the data through the statistics view's histograms and mcvs. The vulnerability is resolved in PostgreSQL Anonymizer 3.3.0 and later versions."}],"metrics":[{"cvssV3_1":{"baseScore":3.5,"baseSeverity":"LOW","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:R/S:U/C:L/I:N/A:N","version":"3.1"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-202","description":"Exposure of Sensitive Information Through Data Queries","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T17:31:46.771Z","orgId":"f86ef6dc-4d3a-42ad-8f28-e6d5547a5007","shortName":"PostgreSQL"},"role":"cna","title":"PostgreSQL Anonymizer: Masked roles can read the statistics of masked columns in pg_stats"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-105615","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-11-05T16:59:03.951287Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-11-05T16:59:14.585Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"47b1f086c2d8fb1786d02301b9b79e291e06e811b8f893bcb5f3b3ff5017f073","data_version":"5.2","first_seen_at":"2026-10-28T22:35:26Z","kind":"advisory","last_material_event_at":"2026-11-05T18:01:02Z","native_
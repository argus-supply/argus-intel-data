{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"24.09.08","status":"affected","version":"0","versionType":"semver"}],"product":"Apache OFBiz","vendor":"Apache Software Foundation"}],"aliases":["CVE-2026-68524"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","supportingMedia":[{"base64":false,"type":"text/html","value":"<p>An unauthenticated attacker can exploit temporary-file handling, access an open file descriptor, and inject a \"file:\" URI to cause OFBiz to load an attacker-controlled Screen definition.</p><p>This issue affects Apache OFBiz: before 24.09.08.</p><p>Users are recommended to upgrade to version 24.09.08, which fixes the issue.</p>"}],"value":"An unauthenticated attacker can exploit temporary-file handling, access an open file descriptor, and inject a \"file:\" URI to cause OFBiz to load an attacker-controlled Screen definition.\n\n\n\nThis issue affects Apache OFBiz: before 24.09.08.\n\n\n\nUsers are recommended to upgrade to version 24.09.08, which fixes the issue."}],"metrics":[{"other":{"content":{"text":"important"},"type":"Textual description of severity"},"scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-94","description":"CWE-94 Improper Control of Generation of Code ('Code Injection')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-05T14:11:35.683Z","orgId":"f0158376-9dc2-43b6-827c-5f631a4d8d09","shortName":"apache"},"role":"cna","title":"Apache OFBiz: Pre-Authentication Remote Code Execution via Attacker-Controlled Screen Definition Loading"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"921534de281b2fe422455b2dc02397213c371d9643bd223c7d5c0c8dccebd212","data_version":"5.2","first_seen_at":"2026-11-05T18:01:02Z","kind":"advisory","last_material_event_at":"2026-11-05T18:01:02Z","na
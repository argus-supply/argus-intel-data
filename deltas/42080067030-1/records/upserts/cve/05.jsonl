{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"3.3.0","status":"affected","version":"1","versionType":"semver"}],"product":"PostgreSQL Anonymizer","vendor":"DALIBO"}],"aliases":["CVE-2026-105614"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"PostgreSQL Anonymizer's `anon.image_blur()` function doesn't check the declared dimension of the provided image, allowing an attacker to provide a small image with enormous declared dimensions. This vulnerability can be exploited to exhaust the memory of a backend and OOM-kill it (when ovecommit is on), which results in a cluster-wide crash recovery. The problem is resolved in PostgreSQL Anonymizer 3.3.0 and later versions."}],"metrics":[{"cvssV3_1":{"baseScore":4.7,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:N/I:N/A:L","version":"3.1"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-789","description":"Memory Allocation with Excessive Size Value","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T17:31:45.821Z","orgId":"f86ef6dc-4d3a-42ad-8f28-e6d5547a5007","shortName":"PostgreSQL"},"role":"cna","title":"PostgreSQL Anonymizer: Unbounded image-decode memory allocation (DoS) in anon.image_blur()"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-105614","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-11-05T16:59:33.240187Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-11-05T16:59:44.513Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"f702bce30590a407bd1fe805f9b1cd629fe7798f5bb634b1fd781d5bc6aec886","data_version":"
{"affected":[{"defaultStatus":"unknown","modules":["kqueue"],"original_ranges":[{"lessThan":"p4","status":"affected","version":"15.1-RELEASE","versionType":"release"}],"product":"FreeBSD","vendor":"FreeBSD"}],"aliases":["CVE-2026-58100"],"assertions":[{"affected_indices":[0],"datePublic":"2026-09-29T20:30:00.000Z","descriptions":[{"lang":"en","value":"kqueue_fork_copy_knote() indexed into the child's file descriptor table using a knote's file descriptor number without a bounds check.  Because the child's table is copied before knotes are transferred, a concurrent thread in the parent could grow the parent's table and register knotes with file descriptor numbers beyond the end of the child's table, causing an out-of-bounds read.\n\nAn unprivileged local user may be able to exploit these races to escalate privileges."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-362","description":"CWE-362: Concurrent Execution using Shared Resource with Improper Synchronization ('Race Condition')","lang":"en","type":"CWE"},{"cweId":"CWE-125","description":"CWE-125: Out-of-bounds Read","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-15T06:31:27.858Z","orgId":"63664ac6-956c-4cba-a5d0-f46076e16109","shortName":"freebsd"},"role":"cna","title":"Memory safety bugs in kqueue copy-on-fork implementation"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-58100","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-10-15T00:00:00+00:00","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-10-16T03:56:55.795Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"0485aa9a6e1447b702e844eca6a22844435e1c61a
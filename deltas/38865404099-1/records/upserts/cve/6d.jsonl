{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.12.2","status":"affected","version":"0","versionType":"semver"}],"product":"MB Custom Post Types & Custom Taxonomies","vendor":"Unknown"}],"aliases":["CVE-2026-109982"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The MB Custom Post Types & Custom Taxonomies WordPress plugin before 2.12.2 does not perform a capability check or validate a nonce on its migration actions, allowing any authenticated user, such as a subscriber, to trigger a one-way migration that creates published records and permanently deletes a companion MB Custom Post Types & Custom Taxonomies WordPress plugin before 2.12.2's entire post-type and taxonomy configuration."}],"problemTypes":[{"descriptions":[{"description":"CWE-862 Missing Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-16T06:00:14.108Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"MB Custom Post Types & Custom Taxonomies < 2.12.2 - Subscriber+ Missing Authorization via CPT UI Migration"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"f0c00ac80beb02913699267699575013b5a80ea5eb6fcb0105ab62ad93295d2b","data_version":"5.2","first_seen_at":"2026-10-16T07:10:07Z","kind":"advisory","last_material_event_at":"2026-10-16T07:10:07Z","native_id":"CVE-2026-109982","provenance":[{"revision":"8ce10d8b4751d19c32030339d28051ac96db1f37","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-109982"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-16T06:00:14Z","record_encoding":{"expanded_bytes":3035,"expanded_sha256":"9a7291d96814058d511a464eab4d851aecd71c3c641cf7b06697c05733d58e38","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_d
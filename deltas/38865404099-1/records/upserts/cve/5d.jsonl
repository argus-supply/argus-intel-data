{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"3.8.9","status":"affected","version":"0","versionType":"semver"}],"product":"affiliate-toolkit","vendor":"Unknown"}],"aliases":["CVE-2026-110179"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The affiliate-toolkit  WordPress plugin before 3.8.9 does not validate a user-supplied sort value against an allowlist before using it in a database query, and the affected administrative list screen requires only a lower-privilege capability rather than an administrator one, so users with editor-level access and above can perform SQL injection and read arbitrary information from the database. On multisite a sub-site editor can read the network-global users table, including the super administrator's password hash."}],"problemTypes":[{"descriptions":[{"description":"CWE-89 SQL Injection","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-16T06:00:15.410Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"affiliate-toolkit < 3.8.9 - Editor+ SQL Injection via orderby Parameter"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"91f5dc967678a4c15e0ab295c1594357bc7551cb9dde93bc2c1789fb564bac35","data_version":"5.2","first_seen_at":"2026-10-16T07:10:07Z","kind":"advisory","last_material_event_at":"2026-10-16T07:10:07Z","native_id":"CVE-2026-110179","provenance":[{"revision":"8ce10d8b4751d19c32030339d28051ac96db1f37","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-110179"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-16T06:00:15Z","record_encoding":{"expanded_bytes":3112,"expanded_sha256":"9829ac4c0c4fe6ef1e22fa26713a16014dca4e49eb1747baf121c70ca9cdec34","format":"cve-indexed-assertions-v1","top_descriptions_ass
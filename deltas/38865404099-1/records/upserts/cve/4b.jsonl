{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"10.31.9","status":"affected","version":"0","versionType":"semver"}],"product":"Salon Booking System","vendor":"Unknown"}],"aliases":["CVE-2026-110013"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Salon Booking System  WordPress plugin before 10.31.9 does not generate its booking-API access tokens from a secure random source, instead deriving them from a value hardcoded in the Salon Booking System  WordPress plugin before 10.31.9 and the second at which a token was issued. An attacker able to constrain when a staff or administrator token was issued can compute a valid token and access the booking API as that user, including an administrator."}],"problemTypes":[{"descriptions":[{"description":"CWE-287 Improper Authentication","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-16T06:00:14.481Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Salon Booking System < 10.31.9 - Unauthenticated Salon REST API Access via Predictable Access-Token"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"56395507884008da72b897fbda4e005e5f8171ab99ada17eb4a9b33e66cfbd1d","data_version":"5.2","first_seen_at":"2026-10-16T07:10:07Z","kind":"advisory","last_material_event_at":"2026-10-16T07:10:07Z","native_id":"CVE-2026-110013","provenance":[{"revision":"8ce10d8b4751d19c32030339d28051ac96db1f37","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-110013"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-16T06:00:14Z","record_encoding":{"expanded_bytes":3058,"expanded_sha256":"efed7f0b1771962f04648ca71f3e258bbf433d9a19d57b1c73f12317511a1bda","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"to
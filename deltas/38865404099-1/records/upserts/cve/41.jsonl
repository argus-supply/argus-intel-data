{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"7.2.1","status":"affected","version":"0","versionType":"semver"}],"product":"Theme My Login","vendor":"jfarthing84"}],"aliases":["CVE-2026-89079"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Theme My Login plugin for WordPress is vulnerable to privilege escalation via account takeover in versions up to, and including, 7.2.1. This is due to the plugin not properly validating a user's identity prior to updating their password. This makes it possible for unauthenticated attackers to change arbitrary user's passwords on multi-site setups in certain configurations."}],"metrics":[{"cvssV3_1":{"baseScore":9.8,"baseSeverity":"CRITICAL","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-269","description":"CWE-269 Improper Privilege Management","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-16T05:30:22.643Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"Theme My Login <= 7.2.1 - Unauthenticated Privilege Escalation via 'user_pass1' POST Parameter in wp_pre_insert_user_data Filter"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"dfea6f244dba8491d362a887842d7ba0e147e52995630e7c8d3855a63ddc5b26","data_version":"5.2","first_seen_at":"2026-10-16T07:10:07Z","kind":"advisory","last_material_event_at":"2026-10-16T07:10:07Z","native_id":"CVE-2026-89079","provenance":[{"revision":"8ce10d8b4751d19c32030339d28051ac96db1f37","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-89079"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-16T05:30:22Z","record_encoding":{"expanded_bytes":3350,"expanded_sha256":"a962c57ae70e18a62
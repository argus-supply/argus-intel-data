{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.7.3","status":"affected","version":"0","versionType":"semver"}],"product":"OTP Login & Register Woocommerce","vendor":"Unknown"}],"aliases":["CVE-2026-110135"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The OTP Login & Register Woocommerce WordPress plugin before 2.7.3 does not adequately limit one-time-password verification attempts, because the attempt limit is tracked against a value the client itself supplies and can change freely, allowing an unauthenticated attacker to bypass the limit and brute-force the short numeric login code to take over an account without its password."}],"problemTypes":[{"descriptions":[{"description":"CWE-287 Improper Authentication","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-16T06:00:15.231Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"OTP Login & Register Woocommerce < 2.7.3 - Unauthenticated Account Takeover via OTP Brute Force"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"71f951e87cad20271128a64e468de2861ca7d82bf13a43b3ee2e5e8b6f095c42","data_version":"5.2","first_seen_at":"2026-10-16T07:10:07Z","kind":"advisory","last_material_event_at":"2026-10-16T07:10:07Z","native_id":"CVE-2026-110135","provenance":[{"revision":"8ce10d8b4751d19c32030339d28051ac96db1f37","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-110135"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-16T06:00:15Z","record_encoding":{"expanded_bytes":2916,"expanded_sha256":"93ef385e7b17aa4ffa8cec032646058958bacdc5f0572fc5ccf86fa451990bad","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-1
{"affected":[{"original_ranges":[{"status":"affected","version":">= 1.15.0, <= 8.2610.0"}],"product":"rsyslog","vendor":"rsyslog"}],"aliases":["CVE-2026-92709"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Rsyslog is a rocket-fast system for log processing. From versions 1.15.0 to 8.2610.0, rsyslog's omfile dynaFile facility intentionally allows templates to generate flexible output paths. This supports valid deployments that route logs into different directories or use dynamically generated file names. A deployment becomes unsafe when a dynaFile template uses a value influenced by untrusted input as a path component without explicit secure-path handling. In that configuration, the rendered path can escape the operator's intended log directory. This is not limited to the RFC5424 HOSTNAME field. Any untrusted value that reaches a dynaFile path component can create the condition. At time of publication, there are no publicly available patches."}],"metrics":[{"cvssV3_1":{"attackComplexity":"HIGH","attackVector":"NETWORK","availabilityImpact":"HIGH","baseScore":8.1,"baseSeverity":"HIGH","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-22","description":"CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')","lang":"en","type":"CWE"}]},{"descriptions":[{"cweId":"CWE-73","description":"CWE-73: External Control of File Name or Path","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-22T13:32:56.695Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"Rsyslog: DynFile Path Traversal → Arbitrary File Write as Root → RCE"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"531875effbe631eac6c2a52a1e9e77251673c8a1cd72289de3ba20b55d9f0973","data_version":"5.2","first_seen_at":"2026-10-22T17:11:30Z","kind":"advisory","last_material_event_at":"2026-10-22T17:11:30Z","native_id":"CVE-2026-92709","provenance":[{"revision":"3c6a34fcaca23c88f6df1b7fb1cbeedb595d324c","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-92709"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-22T13:32:56Z","record_encoding":{"expanded_bytes":4141,"expanded_sha256":"57e4110d64795b677f7d56c2212d0ce46f3426866537bc0cf18f00f2a8f35794","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-92709","references":[{"assertion_role":"cna","name":"https://github.com/rsyslog/rsyslog/security/advisories/GHSA-xmp9-244p-5ggv","provider":{"dateUpdated":"2026-10-22T13:32:56.695Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"tags":["x_refsource_CONFIRM"],"url":"https://github.com/rsyslog/rsyslog/security/advisories/GHSA-xmp9-244p-5ggv"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-22T13:32:56Z","status":"active","title":"Rsyslog: DynFile Path Traversal → Arbitrary File Write as Root → RCE"}

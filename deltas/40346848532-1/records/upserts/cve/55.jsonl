{"affected":[{"original_ranges":[{"lessThan":"2.15.3","status":"affected","version":"2.15.0","versionType":"custom"}],"product":"Harbor","vendor":"Harbor"},{"original_ranges":[{"lessThan":"2.14.5","status":"affected","version":"2.14.0","versionType":"custom"}],"product":"Harbor","vendor":"Harbor"},{"original_ranges":[{"lessThan":"2.13.6","status":"affected","version":"1.7.0","versionType":"custom"}],"product":"Harbor","vendor":"Harbor"}],"aliases":["CVE-2026-111590"],"assertions":[{"affected_indices":[0,1,2],"descriptions":[{"lang":"en","value":"A wide range of Harbor versions allow SSRF via its webhook delivery component which does not properly validate web hook target addresses, allowing usage of private and link-local IP ranges. An authenticated attacker with ProjectAdmin permissions can configure a webhook policy pointing to a private internal address. When a project event fires, Harbor jobservice makes unauthenticated outbound HTTP POST requests to the target. If the target answers with an error status, the response body is written to the webhook execution log, which project members can read, potentially exposing cloud metadata or other network-restricted resources."}],"problemTypes":[{"descriptions":[{"description":"CWE-918 Server-Side Request Forgery (SSRF)","lang":"en"}]}],"provider":{"dateUpdated":"2026-10-26T13:39:48.420Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"role":"cna","title":"SSRF in Harbor webhook delivery allows ProjectAdmin to reach internal services"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"9b8f46846e73958909434b78f2f38078ffc5b76103b288fc86ad429d41eff3f2","data_version":"5.2","first_seen_at":"2026-10-26T15:12:15Z","kind":"advisory","last_material_event_at":"2026-10-26T15:12:15Z","native_id":"CVE-2026-111590","provenance":[{"revision":"f5902483f5ce9cf87b665
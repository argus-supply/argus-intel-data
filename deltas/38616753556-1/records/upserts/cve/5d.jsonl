{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.26.1","status":"affected","version":"1.17.0","versionType":"semver"}],"product":"PgBouncer","vendor":"n/a"}],"aliases":["CVE-2026-107350"],"assertions":[{"affected_indices":[0],"configurations":[{"lang":"en","value":"The attacker knows the password of a user that has its password stored in auth_file, and SCRAM authentication is used for both that user and the impersonated user (auth_type = scram-sha-256, auth_type = md5 with SCRAM secrets, or matching hba rules). The impersonated user can be loaded from either auth_file or auth_query."}],"descriptions":[{"lang":"en","value":"Improper authentication in PgBouncer 1.17.0 through 1.26.0 allows a remote attacker who knows the password of a user listed in auth_file to log in as any other user that authenticates using SCRAM, including PgBouncer admin users and backend superusers. A second StartupMessage sent during SCRAM authentication against a non-existent database is not rejected and switches the user being logged in as, while the SCRAM exchange is still verified against the keys of the first user."}],"metrics":[{"cvssV3_1":{"baseScore":8.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","version":"3.1"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-287","description":"Improper Authentication","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-14T17:34:39.009Z","orgId":"f86ef6dc-4d3a-42ad-8f28-e6d5547a5007","shortName":"PostgreSQL"},"role":"cna","title":"Authentication bypass via second StartupMessage during SCRAM authentication in PgBouncer"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"5a638b7fb23b35432c6baeeab904ec72e62482f9c4ed67d7ee3030b2b85265f4","data_version":"5.2","first_seen_at":"2026-10-14T18:38:37Z","kind":"advisory","last_material_event_at":"2026-10-14T18:38:37Z","native_id":"CVE-2026-107350","provenance":[{"revision":"d6796553a4943cf834bec77b5e4367b361d641a9","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-107350"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-14T17:34:39Z","record_encoding":{"expanded_bytes":3536,"expanded_sha256":"d8774a0ff055aa33b489b738307138dedb1b2a0890ec9a505016e32d57a1043b","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-107350","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-14T17:34:39.009Z","orgId":"f86ef6dc-4d3a-42ad-8f28-e6d5547a5007","shortName":"PostgreSQL"},"url":"https://www.pgbouncer.org/changelog.html"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-14T17:34:39Z","status":"active","title":"Authentication bypass via second StartupMessage during SCRAM authentication in PgBouncer"}

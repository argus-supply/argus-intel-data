{"affected":[{"defaultStatus":"unknown","modules":["Translation system"],"original_ranges":[{"lessThanOrEqual":"4.7.2","status":"affected","version":"1.0.0","versionType":"semver"}],"product":"Godot Engine","programFiles":["core/string/optimized_translation.cpp"],"programRoutines":[{"name":"OptimizedTranslation::get_message"}],"repo":"https://github.com/godotengine/godot","vendor":"godotengine"}],"aliases":["CVE-2026-110736"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Godot Engine through 4.7.2 has an out-of-bounds read in the optimized translation loader (core/string/optimized_translation.cpp, OptimizedTranslation::get_message). Offsets read from the hash table of a crafted .translation resource are used as indices into the bucket table without bounds validation; only a single sentinel value is rejected. A crafted file can point an index far past the allocated buffer. Depending on the values, the result is a crash, or a string lookup (tr()) returns raw bytes from elsewhere in the process heap as the translated string, disclosing process memory. The defect is reached when the product or an exported game loads and performs lookups in a crafted translation file. NOTE: the Supplier's position is that the research has identified \"no security issues\" because the required attacker access is outside of the current Godot Engine threat model."}],"metrics":[{"cvssV3_1":{"attackComplexity":"HIGH","attackVector":"LOCAL","availabilityImpact":"LOW","baseScore":3.6,"baseSeverity":"LOW","confidentialityImpact":"LOW","integrityImpact":"NONE","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"REQUIRED","vectorString":"CVSS:3.1/AV:L/AC:H/PR:N/UI:R/S:U/C:L/I:N/A:L","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-1285","description":"CWE-1285 Improper Validation of Specified Index, Position, or Offset in Input","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-14T15:53:29.653Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"60eaacce5132f6dc49f2b40a295dfb770fbf539c7b7ad7a76cfd7ea69d2701f8","data_version":"5.2","first_seen_at":"2026-10-14T18:38:37Z","kind":"advisory","last_material_event_at":"2026-10-14T18:38:37Z","native_id":"CVE-2026-110736","provenance":[{"revision":"d6796553a4943cf834bec77b5e4367b361d641a9","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-110736"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-14T15:53:29Z","record_encoding":{"expanded_bytes":4579,"expanded_sha256":"d85101302ab98bfbffbbee9df68ac3858f4f8050a008ba58bcb915d58c297e7b","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-110736","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-14T15:53:29.653Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"url":"https://github.com/godotengine/godot/issues/123608"},{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-14T15:53:29.653Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"url":"https://axeghost.offprint.app/a/3mvs6zo4blo23-three-memory-safety-bugs-in-godots-untrusted-file-parsers"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-14T15:53:29Z","status":"active","title":"CVE-2026-110736"}

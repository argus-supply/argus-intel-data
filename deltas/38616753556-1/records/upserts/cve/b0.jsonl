{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"1.26.4","status":"affected","version":"0","versionType":"semver"}],"packageName":"code.gitea.io/gitea","product":"Gitea","vendor":"Gitea"}],"aliases":["CVE-2026-78231"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"When OpenID sign-in is enabled, Gitea processes unauthenticated assertion parameters and sends an HTTP POST request to the caller-supplied OpenID provider endpoint during verification. An attacker controls the destination and much of the form body, allowing interaction with internal HTTP services reachable from the Gitea server. The response is not returned to the attacker, so the issue is blind SSRF; its impact depends on the services and network addresses the server can reach."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-918","description":"CWE-918: Server-Side Request Forgery (SSRF)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-14T14:38:10.532Z","orgId":"88ee5874-cf24-4952-aea0-31affedb7ff2","shortName":"Gitea"},"role":"cna","title":"Gitea blind SSRF through OpenID assertion verification"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"b93c97460ad94fa3d120f06e8421d14f8fa3bca9490b81a5ff21b8ea259012be","data_version":"5.2","first_seen_at":"2026-10-14T18:38:37Z","kind":"advisory","last_material_event_at":"2026-10-14T18:38:37Z","native_id":"CVE-2026-78231","provenance":[{"revision":"d6796553a4943cf834bec77b5e4367b361d641a9","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-78231"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-14T14:38:10Z","record_encoding":{"expanded_bytes":3098,"expanded_sha256":"fc9d0a2d27f27f5e6ebfe69e88e2d63d6ba6a57c150f203965556e4fabb48c11","format":"cve-indexed-assertions-v1","top_de
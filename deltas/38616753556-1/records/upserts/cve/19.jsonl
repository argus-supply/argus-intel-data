{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"4.15.3","status":"affected","version":"4.10.0","versionType":"semver"}],"product":"NSD","vendor":"NLnet Labs"}],"aliases":["CVE-2026-101338"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-14T12:00:00.000Z","descriptions":[{"lang":"en","value":"When a SVCB or HTTPS RR has filled the wire format RDATA up to the brim, another ECH parameter may overwrite the stack, and once beyond the limit, the base64 decoder can write attacker controlled data of unlimited size.  Zone files which are written out by NSD itself, such as for zones for which the NSD instance is secondary, will not be formatted like this. The zone file must be fed to NSD directly, (but it could come, for example, from an operator controlled provisioning system)."}],"metrics":[{"cvssV4_0":{"baseScore":8.7,"baseSeverity":"HIGH","vectorString":"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N","version":"4.0"},"format":"CVSS","scenarios":[{"lang":"en","value":"When reading zone files, a specially crafted and format SVCB or HTTPS record cancause an out of bounds stack overwrite which can be exploited for execution of arbitrary commands."}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-121","description":"CWE-121 Stack-based Buffer Overflow","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-14T10:56:28.223Z","orgId":"206fc3a0-e175-490b-9eaa-a5738056c9f6","shortName":"NLnet Labs"},"role":"cna","title":"Stack overwrite from a specially crafted and formatted SVCB or HTTPS RR"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-101338","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-10-14T14:09:10.026829Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-10-14T14:09:20.163Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vuln
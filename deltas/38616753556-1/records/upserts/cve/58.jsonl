{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"1.00","versionType":"SerTec"}],"product":"SerTec","vendor":"ServiceNext"}],"aliases":["CVE-2026-79957"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"ServiceNext contains an insecure direct object reference (IDOR) in the /api/Usuario/GetUsuarios endpoint, which accepts a user-controlled numeric ID in the request body without verifying that the authenticated token belongs to the requested account (CWE-639). Any authenticated user can iterate the ID parameter to retrieve the full profile record of every other user, including passwords stored in cleartext (CWE-256), enabling account takeover and credential-stuffing attacks."}],"metrics":[{"cvssV3_1":{"baseScore":8.1,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-639","description":"CWE-639 Authorization Bypass Through User-Controlled Key","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-14T18:01:51.493Z","orgId":"27b6da8a-f51d-48d9-9eef-9b7f3405d20d","shortName":"BLSOPS"},"role":"cna","title":"ServiceNext Insecure Direct Object Reference via GetUsarios"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"88431339ca81dd362dba1a4b90cb7e16567917ef45eb86aeb0a914dfc7abaf2d","data_version":"5.2","first_seen_at":"2026-10-14T18:38:37Z","kind":"advisory","last_material_event_at":"2026-10-14T18:38:37Z","native_id":"CVE-2026-79957","provenance":[{"revision":"d6796553a4943cf834bec77b5e4367b361d641a9","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-79957"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-14T18:01:51Z","record
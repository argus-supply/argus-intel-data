{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.26.1","status":"affected","version":"1.21.0","versionType":"semver"}],"product":"PgBouncer","vendor":"n/a"}],"aliases":["CVE-2026-107348"],"assertions":[{"affected_indices":[0],"configurations":[{"lang":"en","value":"max_packet_size is set to 2147483649 or higher. The default max_packet_size of 2147483647 is not affected."}],"descriptions":[{"lang":"en","value":"Integer overflow in the message buffer growth logic (mbuf_make_room) in PgBouncer 1.21.0 through 1.26.0 allows a remote attacker to cause a denial of service when max_packet_size is configured above 2147483648. A packet header declaring a length above 2^31 makes the buffer size computation overflow, leaving the growth loop unable to terminate. Because PgBouncer serves all clients from a single process, this saturates a CPU core and stalls every pooled connection until the process is restarted. Since 1.23.0 the overflow is reachable before authentication with a five-byte packet header."}],"metrics":[{"cvssV3_1":{"baseScore":5.9,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:N/A:H","version":"3.1"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-190","description":"Integer Overflow or Wraparound","lang":"en","type":"CWE"}]},{"descriptions":[{"cweId":"CWE-835","description":"Loop with Unreachable Exit Condition ('Infinite Loop')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-14T17:34:29.838Z","orgId":"f86ef6dc-4d3a-42ad-8f28-e6d5547a5007","shortName":"PostgreSQL"},"role":"cna","title":"Integer overflow causes an infinite loop in message buffer growth in PgBouncer"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"216d2242de0a3ed7d6a926d4c84db14bbc5c90f25336eb19d15fbd89e9b3f6cb","data_version":"5.2","first_seen_at":"2026-10-14T18:38:37Z","kind":"advisory","last_material_event_at":"2026-10-14T18:38:37Z","native_id":"CVE-2026-107348","provenance":[{"revision":"d6796553a4943cf834bec77b5e4367b361d641a9","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-107348"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-14T17:34:29Z","record_encoding":{"expanded_bytes":3669,"expanded_sha256":"8b95c3f04d84450a56105f2b9c884991857292505ccae06570bdc0ca457aeab8","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-107348","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-14T17:34:29.838Z","orgId":"f86ef6dc-4d3a-42ad-8f28-e6d5547a5007","shortName":"PostgreSQL"},"url":"https://www.pgbouncer.org/changelog.html"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-14T17:34:29Z","status":"active","title":"Integer overflow causes an infinite loop in message buffer growth in PgBouncer"}

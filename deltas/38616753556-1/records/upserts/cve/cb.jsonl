{"affected":[{"defaultStatus":"unknown","modules":["Binary resource loader"],"original_ranges":[{"lessThanOrEqual":"4.7.2","status":"affected","version":"1.0.0","versionType":"semver"}],"product":"Godot Engine","programFiles":["core/io/resource_format_binary.cpp"],"programRoutines":[{"name":"ResourceLoaderBinary::get_unicode_string"}],"repo":"https://github.com/godotengine/godot","vendor":"godotengine"}],"aliases":["CVE-2026-110735"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Godot Engine through 4.7.2 has a heap out-of-bounds write exists in the binary resource loader (core/io/resource_format_binary.cpp, ResourceLoaderBinary::get_unicode_string). A string length is read from the resource file into a signed 32-bit integer and compared against the destination buffer size with a signed comparison, which conditionally resizes the buffer. A negative length value skips the resize; the same value is then passed to the copy routine as an unsigned byte count, where it sign-extends to a huge value, copying file-controlled data far past the undersized heap allocation. The defect is reached when the product or an exported game loads a crafted binary resource file (.res). NOTE: the Supplier's position is that the research has identified \"no security issues\" because the required attacker access is outside of the current Godot Engine threat model."}],"metrics":[{"cvssV3_1":{"attackComplexity":"HIGH","attackVector":"LOCAL","availabilityImpact":"NONE","baseScore":2.5,"baseSeverity":"LOW","confidentialityImpact":"NONE","integrityImpact":"LOW","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"REQUIRED","vectorString":"CVSS:3.1/AV:L/AC:H/PR:N/UI:R/S:U/C:N/I:L/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-195","description":"CWE-195 Signed to Unsigned Conversion Error","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-14T16:01:14.478Z"
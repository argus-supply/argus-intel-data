{"affected":[{"original_ranges":[{"status":"affected","version":"0.0.25"}],"product":"h-ui","vendor":"jonssonyan"}],"aliases":["CVE-2026-107202"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A command injection vulnerability exists in the h-ui (version v0.0.25 and below) administrative API due to improper validation of the listen configuration field. When an authenticated administrator submits a value containing shell metacharacters, the application constructs nftables/iptables rule strings using fmt.Sprintf and executes them via bash -c as root. Because the listen field lacks port or format validation, arbitrary OS commands can be injected and executed with root privileges."}],"problemTypes":[{"descriptions":[{"description":"CWE-78 Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')","lang":"en"}]}],"provider":{"dateUpdated":"2026-10-07T14:26:49.905Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"role":"cna","title":"CVE-2026-107202"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"d2ace8d6a8cb43f9f34288430ee5ddbe215be87bb8c471257a1c3f7b464efabb","data_version":"5.2","first_seen_at":"2026-10-07T17:26:06Z","kind":"advisory","last_material_event_at":"2026-10-07T17:26:06Z","native_id":"CVE-2026-107202","provenance":[{"revision":"faf225c8f194453d4ef4f23e16adb6279298dbc9","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-107202"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-07T14:26:49Z","record_encoding":{"expanded_bytes":2843,"expanded_sha256":"c6a7af1c1637590a5619cc1d3f4e55675810ade9fc8536b53e5ac94c4f8572c0","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-107202","re
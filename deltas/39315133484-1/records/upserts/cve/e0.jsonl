{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["Cpanel::JSON::XS"],"original_ranges":[{"lessThan":"4.80","status":"affected","version":"0","versionType":"custom"}],"packageName":"Cpanel-JSON-XS","packageURL":"pkg:cpan/Cpanel-JSON-XS","programFiles":["XS.xs"],"programRoutines":[{"name":"decode_tag"}],"repo":"https://github.com/rurban/Cpanel-JSON-XS"}],"aliases":["CVE-2026-110673"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Cpanel::JSON::XS versions before 4.80 for Perl allow stack exhaustion via nested tagged values under allow_tags in decode_tag.\n\nWith allow_tags, \"(\" starts a tagged value. Its tag and value are decoded recursively, and each can start another tagged value. Unlike arrays and objects, this nesting is not counted against max_depth.\n\nA run of \"(\" bytes exhausts the C stack and triggers an uncatchable segmentation fault regardless of max_depth."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-674","description":"CWE-674 Uncontrolled Recursion","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-19T18:11:15.412Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"Cpanel::JSON::XS versions before 4.80 for Perl allow stack exhaustion via nested tagged values under allow_tags in decode_tag"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"57c11e531aaa7c7933abf5f702c535e466173278e47d6375a06600479f49b980","data_version":"5.2","first_seen_at":"2026-10-19T19:57:28Z","kind":"advisory","last_material_event_at":"2026-10-19T19:57:28Z","native_id":"CVE-2026-110673","provenance":[{"revision":"c4e85f65f7321a285d709a8713199bb6a3df677c","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-110673"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-19T18:11:15Z","record_encoding":{"expanded_bytes":3556,"expanded_sha256":"08229eb39ccbcbbe2c4604f2e0feaf8697e8a44cb951188df72dd0c4f9cbde71","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-110673","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-19T18:11:15.412Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"tags":["patch"],"url":"https://github.com/rurban/Cpanel-JSON-XS/commit/995eb484a9351753e2a8ec3317918b5b4a4e086a.patch"},{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-19T18:11:15.412Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"tags":["release-notes"],"url":"https://metacpan.org/release/RURBAN/Cpanel-JSON-XS-4.80/changes"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-19T18:11:15Z","status":"active","title":"Cpanel::JSON::XS versions before 4.80 for Perl allow stack exhaustion via nested tagged values under allow_tags in decode_tag"}

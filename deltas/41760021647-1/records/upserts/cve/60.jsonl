{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"8.2.0"}],"product":"Foglight for Databases","vendor":"Quest"}],"aliases":["CVE-2026-92197"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-03T21:56:44.270Z","descriptions":[{"lang":"en","value":"Quest Foglight for Databases unzipFile Directory Traversal Remote Code Execution Vulnerability. This vulnerability allows remote attackers to execute arbitrary code on affected installations of Quest Foglight for Databases. Authentication is required to exploit this vulnerability.\n\nThe specific flaw exists within the unzipFile method. The issue results from the lack of proper validation of a user-supplied path prior to using it in file operations. An attacker can leverage this vulnerability to execute code in the context of SYSTEM. Was ZDI-CAN-29901."}],"metrics":[{"cvssV3_0":{"baseScore":8.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-22","description":"CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-03T23:51:23.789Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"Quest Foglight for Databases unzipFile Directory Traversal Remote Code Execution Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"4ec8c7111858a0c837757ac17f88577eae9d59235e3ec26443144a9a79fe0239","data_version":"5.2","first_seen_at":"2026-11-04T02:20:41Z","kind":"advisory","last_material_event_at":"2026-11-04T02:20:41Z","native_id":"CVE-2026-92197","provenance":[{"revision":"ddfa066593c89b18bf3e08e09fca8cb943ae1480","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026
{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"8.2.0"}],"product":"Foglight for Databases","vendor":"Quest"}],"aliases":["CVE-2026-92199"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-03T21:56:52.793Z","descriptions":[{"lang":"en","value":"Quest Foglight for Databases EncryptionUtil Hardcoded Encyption Key Local Privilege Escalation Vulnerability. This vulnerability allows local attackers to escalate privileges on affected installations of Quest Foglight for Databases. An attacker must first obtain the ability to execute low-privileged code on the target system in order to exploit this vulnerability.\n\nThe specific flaw exists within the symmetricDecrypt method. The issue results from the use of a hard-coded cryptographic key. An attacker can leverage this vulnerability to escalate privileges and execute arbitrary code in the context of SYSTEM. Was ZDI-CAN-29967."}],"metrics":[{"cvssV3_0":{"baseScore":7.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-321","description":"CWE-321: Use of Hard-coded Cryptographic Key","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-03T23:51:45.350Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"Quest Foglight for Databases EncryptionUtil Hardcoded Encyption Key Local Privilege Escalation Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"6da76fed049233bc0b98614ef861cbd8397fc1667d54f8afae5104d0aec91cdf","data_version":"5.2","first_seen_at":"2026-11-04T02:20:41Z","kind":"advisory","last_material_event_at":"2026-11-04T02:20:41Z","native_id":"CVE-2026-92199","provenance":[{"revision":"ddfa066593c89b18bf3e08e09fca8cb943ae1480","source_id":"cv
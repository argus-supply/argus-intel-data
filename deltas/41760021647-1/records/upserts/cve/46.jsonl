{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"v26.03"}],"product":"OpenUSD","vendor":"Pixar Animation Studio"}],"aliases":["CVE-2026-92211"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-26T19:15:05.552Z","descriptions":[{"lang":"en","value":"Pixar Animation Studio OpenUSD Crate File Parsing Double Free Remote Code Execution Vulnerability. This vulnerability allows remote attackers to execute arbitrary code on affected installations of Pixar Animation Studio OpenUSD. Interaction with this library is required to exploit this vulnerability but attack vectors may vary depending on the implementation.\n\nThe specific flaw exists within the parsing of USDC and USDZ files. The issue results from the lack of validating the existence of an object prior to performing further free operations on the object. An attacker can leverage this vulnerability to execute code in the context of the current process. Was ZDI-CAN-30428."}],"metrics":[{"cvssV3_0":{"baseScore":7.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-415","description":"CWE-415: Double Free","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-03T23:49:08.403Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"Pixar Animation Studio OpenUSD Crate File Parsing Double Free Remote Code Execution Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"b5ce125540517fe66b52daf9f2d79c58486b4cb55e07c9466d8d437fbf6f7b24","data_version":"5.2","first_seen_at":"2026-11-04T02:20:41Z","kind":"advisory","last_material_event_at":"2026-11-04T02:20:41Z","native_id":"CVE-2026-92211","provenance":[{"revision":"ddfa066593c89b18bf3e08e09fca8cb943ae1480","
{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"3.14.0"}],"product":"MLflow","vendor":"MLflow"}],"aliases":["CVE-2026-118626"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-29T19:05:14.961Z","descriptions":[{"lang":"en","value":"MLflow Tracking Server Issues Missing Authorization Privilege Escalation Vulnerability. This vulnerability allows remote attackers to escalate privileges on affected installations of MLflow. Authentication is required to exploit this vulnerability.\n\nThe specific flaw exists within the configuration of the BEFORE_REQUEST_HANDLERS. The issue results from the lack of authorization prior to allowing access to functionality. An attacker can leverage this vulnerability to escalate privileges to resources normally protected from the user. Was ZDI-CAN-32108."}],"metrics":[{"cvssV3_0":{"baseScore":5.4,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.0/AV:N/AC:L/PR:L/UI:N/S:U/C:L/I:L/A:N","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-862","description":"CWE-862: Missing Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-03T23:45:50.030Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"MLflow Tracking Server Issues Missing Authorization Privilege Escalation Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"4cc748d0ce0b97d6e46725196d86c0e500a00c7f51aa18aa8408a0116a784cc9","data_version":"5.2","first_seen_at":"2026-11-04T02:20:41Z","kind":"advisory","last_material_event_at":"2026-11-04T02:20:41Z","native_id":"CVE-2026-118626","provenance":[{"revision":"ddfa066593c89b18bf3e08e09fca8cb943ae1480","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-118626"},{"assertion_index":0,"independent_evidence":true,"source_id":"c
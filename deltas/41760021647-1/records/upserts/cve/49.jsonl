{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"9.7.3"}],"product":"NoMachine","vendor":"NoMachine"}],"aliases":["CVE-2026-114549"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-23T01:47:05.259Z","descriptions":[{"lang":"en","value":"NoMachine nxwebrunner Heap-based Buffer Overflow Remote Code Execution Vulnerability. This vulnerability allows remote attackers to execute arbitrary code on affected installations of NoMachine. Authentication is not required to exploit this vulnerability.\n\nThe specific flaw exists within the web service, which listens on TCP port 4443 by default. The issue results from the lack of proper validation of the length of user-supplied data prior to copying it to a heap-based buffer. An attacker can leverage this vulnerability to execute code in the context of the service account. Was ZDI-CAN-30685."}],"metrics":[{"cvssV3_0":{"baseScore":9.8,"baseSeverity":"CRITICAL","vectorString":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-122","description":"CWE-122: Heap-based Buffer Overflow","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-03T23:46:39.428Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"NoMachine nxwebrunner Heap-based Buffer Overflow Remote Code Execution Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"2453b2beb47a798d2941009f1204886a131053488bfad1da7249de4791dcb65e","data_version":"5.2","first_seen_at":"2026-11-04T02:20:41Z","kind":"advisory","last_material_event_at":"2026-11-04T02:20:41Z","native_id":"CVE-2026-114549","provenance":[{"revision":"ddfa066593c89b18bf3e08e09fca8cb943ae1480","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-114549"},{"asserti
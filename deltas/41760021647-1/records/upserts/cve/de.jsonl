{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"3.8.0"}],"product":"MLflow","vendor":"MLflow"}],"aliases":["CVE-2026-118628"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-29T19:05:29.302Z","descriptions":[{"lang":"en","value":"MLflow get-artifacts Server-Side Request Forgery Information Disclosure Vulnerability. This vulnerability allows remote attackers to disclose sensitive information on affected installations of MLflow. Authentication is not required to exploit this vulnerability.\n\nThe specific flaw exists within the get-artifacts function. The issue results from the lack of proper validation of a URI prior to accessing resources. An attacker can leverage this vulnerability to disclose information in the context of the server. Was ZDI-CAN-28192."}],"metrics":[{"cvssV3_0":{"baseScore":8.2,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:L/A:N","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-918","description":"CWE-918: Server-Side Request Forgery (SSRF)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-03T23:46:07.128Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"MLflow get-artifacts Server-Side Request Forgery Information Disclosure Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"73fd9841872a74282a04f6fa6495a722d6e40b5b9292e3bb926adf8a9ff0cccf","data_version":"5.2","first_seen_at":"2026-11-04T02:20:41Z","kind":"advisory","last_material_event_at":"2026-11-04T02:20:41Z","native_id":"CVE-2026-118628","provenance":[{"revision":"ddfa066593c89b18bf3e08e09fca8cb943ae1480","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-118628"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"publishe
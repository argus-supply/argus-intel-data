{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"8.2.0"}],"product":"Foglight for Databases","vendor":"Quest"}],"aliases":["CVE-2026-92185"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-03T21:56:49.860Z","descriptions":[{"lang":"en","value":"Quest Foglight for Databases AbstractParser XML External Entity Processing Information Disclosure Vulnerability. This vulnerability allows remote attackers to disclose sensitive information on affected installations of Quest Foglight for Databases. Authentication is not required to exploit this vulnerability.\n\nThe specific flaw exists within the AbstractParser class. Due to the improper restriction of XML External Entity (XXE) references, a crafted document specifying a URI causes the XML parser to access the URI and embed the contents back into the XML document for further processing. An attacker can leverage this vulnerability to disclose information in the context of SYSTEM. Was ZDI-CAN-28929."}],"metrics":[{"cvssV3_0":{"baseScore":7.2,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:C/C:L/I:N/A:L","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-611","description":"CWE-611: Improper Restriction of XML External Entity Reference ('XXE')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-03T23:51:31.399Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"Quest Foglight for Databases AbstractParser XML External Entity Processing Information Disclosure Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"f2af68f18970ff133d853a836d504daf8103d7bdeb4d84ef3603e13f1b506121","data_version":"5.2","first_seen_at":"2026-11-04T02:20:41Z","kind":"advisory","last_material_event_at":"2026-11-04T02:20:41Z","native_id":"
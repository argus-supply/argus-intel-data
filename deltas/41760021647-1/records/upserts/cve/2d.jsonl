{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"8.2.0"}],"product":"Foglight for Databases","vendor":"Quest"}],"aliases":["CVE-2026-92190"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-03T21:56:16.938Z","descriptions":[{"lang":"en","value":"Quest Foglight for Databases baseRmiServiceExporter Deserialization of Untrusted Data Remote Code Execution Vulnerability. This vulnerability allows remote attackers to execute arbitrary code on affected installations of Quest Foglight for Databases. Authentication is not required to exploit this vulnerability.\n\nThe specific flaw exists within the configuration of the baseRmiServiceExporter bean. The issue results from the lack of proper validation of user-supplied data prior to deserializing it. An attacker can leverage this vulnerability to execute code in the context of SYSTEM. Was ZDI-CAN-29170."}],"metrics":[{"cvssV3_0":{"baseScore":9.8,"baseSeverity":"CRITICAL","vectorString":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-502","description":"CWE-502: Deserialization of Untrusted Data","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-03T23:50:48.578Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"Quest Foglight for Databases baseRmiServiceExporter Deserialization of Untrusted Data Remote Code Execution Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"5efbf3cf37a8e113681dc18d2fffdf1633e921d39357977acc3e259a577c2dea","data_version":"5.2","first_seen_at":"2026-11-04T02:20:41Z","kind":"advisory","last_material_event_at":"2026-11-04T02:20:41Z","native_id":"CVE-2026-92190","provenance":[{"revision":"ddfa066593c89b18bf3e08e09fca8cb943ae1480","source_id":"cve","url":"htt
{"affected":[{"collectionURL":"https://pkg.go.dev","defaultStatus":"unaffected","original_ranges":[{"lessThan":"0.16.0","status":"affected","version":"0.10.0","versionType":"semver"}],"packageName":"github.com/gittuf/gittuf","product":"gittuf","repo":"https://github.com/gittuf/gittuf","vendor":"gittuf"}],"aliases":["CVE-2026-128037"],"assertions":[{"affected_indices":[0],"datePublic":"2026-09-04T22:19:45.000Z","descriptions":[{"lang":"en","value":"In gittuf 0.10.0 through 0.15.0, when a minimum threshold global rule and a policy rule protect the same namespace, verification gives the global rule's check over all trusted users in the policy precedence over the policy rule's own authorized users. A user listed in the policy file but not authorized by the policy rule, or fewer users than the rule's threshold, can make changes to the protected namespace that pass verification."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":6.5,"baseSeverity":"MEDIUM","confidentialityImpact":"NONE","integrityImpact":"HIGH","privilegesRequired":"LOW","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:H/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-863","description":"CWE-863 Incorrect Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-13T15:20:38.824Z","orgId":"7fefd608-56a6-419f-a002-fd8543c0710a","shortName":"Akrites"},"role":"cna","title":"gittuf: Policy rules bypassed in the presence of global rules"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"27739e56f2759cdd00486db238793468bc8658159ddc3e071a712a459fe12056","data_version":"5.2","first_seen_at":"2026-11-13T17:44:42Z","kind":"advisory","last_materia
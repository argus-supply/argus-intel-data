{"affected":[{"collectionURL":"https://pkg.go.dev","defaultStatus":"unaffected","original_ranges":[{"lessThan":"0.18.0","status":"affected","version":"0.10.0","versionType":"semver"}],"packageName":"github.com/gittuf/gittuf","product":"gittuf","repo":"https://github.com/gittuf/gittuf","vendor":"gittuf"}],"aliases":["CVE-2026-128035"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-12T19:52:16.000Z","descriptions":[{"lang":"en","value":"In gittuf 0.10.0 through 0.17.0, the verification workflow does not load policy updates that are propagated from an upstream (controller) repository and recorded in the reference state log after the first entry being verified. Only the propagated policy in effect at the start of verification is applied, so later controller changes to global rules, such as threshold requirements and force-push blocks, are ignored and changes that these rules should block pass verification."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"LOCAL","availabilityImpact":"NONE","baseScore":5.5,"baseSeverity":"MEDIUM","confidentialityImpact":"NONE","integrityImpact":"HIGH","privilegesRequired":"LOW","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:N/I:H/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-863","description":"CWE-863 Incorrect Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-13T15:20:36.628Z","orgId":"7fefd608-56a6-419f-a002-fd8543c0710a","shortName":"Akrites"},"role":"cna","title":"gittuf: Propagated controller policies not loaded during verification"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"482f36ed281c7ce55683318d8f10836f73300c2eb46eef2a4e4059cbc1237286","data_version":"5.2","first_seen_at":"2026
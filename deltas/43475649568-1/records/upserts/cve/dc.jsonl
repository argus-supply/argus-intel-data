{"affected":[{"collectionURL":"https://pkg.go.dev","defaultStatus":"unaffected","original_ranges":[{"lessThan":"0.17.0","status":"affected","version":"0.4.0","versionType":"semver"}],"packageName":"github.com/gittuf/gittuf","product":"gittuf","repo":"https://github.com/gittuf/gittuf","vendor":"gittuf"}],"aliases":["CVE-2026-128036"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-19T18:16:47.000Z","descriptions":[{"lang":"en","value":"In gittuf 0.4.0 through 0.16.0, when a policy update appears within the range of reference state log entries being verified, verification checks only the root of trust signatures of the new policy and not the signatures of its other metadata (rule files). A user trusted to push to the repository who bypasses gittuf policy apply and writes the policy reference and reference state log directly can make an invalid policy apply during verification, weakening or strengthening the rules for later changes. The update is still recorded in the reference state log."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"LOCAL","availabilityImpact":"NONE","baseScore":2.3,"baseSeverity":"LOW","confidentialityImpact":"NONE","integrityImpact":"LOW","privilegesRequired":"HIGH","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:L/AC:L/PR:H/UI:N/S:U/C:N/I:L/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-863","description":"CWE-863 Incorrect Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-13T15:20:37.714Z","orgId":"7fefd608-56a6-419f-a002-fd8543c0710a","shortName":"Akrites"},"role":"cna","title":"gittuf: Invalid intermediate policies trusted when the policy apply workflow is bypassed"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"b8fcccc8
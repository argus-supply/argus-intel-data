{"affected":[{"collectionURL":"https://pkg.go.dev","defaultStatus":"unaffected","original_ranges":[{"lessThan":"0.18.0","status":"affected","version":"0","versionType":"semver"}],"packageName":"github.com/gittuf/gittuf","product":"gittuf","repo":"https://github.com/gittuf/gittuf","vendor":"gittuf"}],"aliases":["CVE-2026-128034"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-12T19:51:57.000Z","descriptions":[{"lang":"en","value":"In gittuf before 0.18.0, verification of file protection rules uses the quoted, escaped pathnames that Git prints by default for files with special characters (for example non-ASCII characters) instead of the raw paths. Such paths do not match patterns like file:internal/*, so the files are treated as unprotected, and a user who is not authorized by a file protection rule can change a protected file whose name contains special characters and still pass verification."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"LOCAL","availabilityImpact":"NONE","baseScore":5.5,"baseSeverity":"MEDIUM","confidentialityImpact":"NONE","integrityImpact":"HIGH","privilegesRequired":"LOW","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:N/I:H/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-863","description":"CWE-863 Incorrect Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-13T15:20:35.569Z","orgId":"7fefd608-56a6-419f-a002-fd8543c0710a","shortName":"Akrites"},"role":"cna","title":"gittuf: File protection rules bypassed for filenames with special characters"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"d9caac95f4b81cb829128427daae4c1146cb9615a165c84975ed042f814525cf","data_version":"5.2","first_seen_at":"2026-11-
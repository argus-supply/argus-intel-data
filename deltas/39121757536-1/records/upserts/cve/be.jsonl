{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"10.31.11","status":"affected","version":"0","versionType":"semver"}],"product":"Salon Booking System","vendor":"Unknown"}],"aliases":["CVE-2026-110033"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Salon Booking System  WordPress plugin before 10.31.11 does not validate a user-supplied image URL before fetching it server-side and writing the response to a publicly accessible location under an attacker-chosen filename, allowing users with the Salon Staff role or higher to force the server to read internal-only resources and disclose them, and to store a malicious SVG that runs arbitrary scripts in the site's origin for anyone who opens it."}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Cross-Site Scripting (XSS)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-18T06:00:15.557Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Salon Booking System < 10.31.11 - Salon Staff+ Stored XSS and SSRF via Salon REST 'image_url'"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"280e90fa119bbf10a6d7d05a067d06e8f53658597bea6006fc1c08be699afd9c","data_version":"5.2","first_seen_at":"2026-10-18T11:05:10Z","kind":"advisory","last_material_event_at":"2026-10-18T11:05:10Z","native_id":"CVE-2026-110033","provenance":[{"revision":"73e6aa8002020640db5e5e51a536fac72c65680d","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-110033"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-18T06:00:15Z","record_encoding":{"expanded_bytes":3041,"expanded_sha256":"e55df0783b90daa7146f8ebb116954e5cbcb0cd3ac7f788a132ad891d60020cf","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descr
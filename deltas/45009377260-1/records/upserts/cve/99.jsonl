{"affected":[{"defaultStatus":"unknown","original_ranges":[{"lessThanOrEqual":"4.16.2","status":"affected","version":"0","versionType":"semver"}],"product":"Mooberry Book Manager","vendor":"Unknown"}],"aliases":["CVE-2026-107592"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Mooberry Book Manager WordPress plugin through 4.16.2 does not perform any capability or nonce check in one of its AJAX actions, allowing any authenticated user with a minimal role such as Subscriber to change the publisher assigned to any book, including books created by other users, and to create new book records. The missing nonce check also makes the action exploitable via CSRF against any logged-in user."}],"problemTypes":[{"descriptions":[{"description":"CWE-862 Missing Authorization","lang":"en","type":"CWE"}]},{"descriptions":[{"description":"CWE-352 Cross-Site Request Forgery (CSRF)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-22T06:00:07.253Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Mooberry Book Manager <= 4.16.2 - Subscriber+ Book Publisher Update via bulk_quick_save_bulk_edit"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"1006593007a03a932e065e10bd4d1ddbd7d5ce9fd27e4378d2a85f4dbf962004","data_version":"5.2","first_seen_at":"2026-11-22T09:50:04Z","kind":"advisory","last_material_event_at":"2026-11-22T09:50:04Z","native_id":"CVE-2026-107592","provenance":[{"revision":"6eaa7aa0e9e064e1fbacae0f6265fdabb480871a","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-107592"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-22T06:00:07Z","record_encoding":{"expanded_bytes":3080,"expanded_sha256":"37b8ac62555d4694b4187f489a85e68bd8fe79dc3c39015f6b7da5563295b14a","format":"cve
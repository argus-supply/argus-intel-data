{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.6.2","status":"affected","version":"1.5.4","versionType":"semver"}],"product":"Event Tickets Manager for WooCommerce","vendor":"Unknown"}],"aliases":["CVE-2026-123136"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Event Tickets Manager for WooCommerce WordPress plugin before 1.6.2 does not check that the ticket type and price chosen through one of its unauthenticated AJAX actions belong to the event ticket later added to the cart, and stores them site-wide, allowing unauthenticated visitors to buy an event ticket at the lower ticket-type price configured on a different event."}],"problemTypes":[{"descriptions":[{"description":"CWE-863 Incorrect Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-22T06:00:08.471Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Event Tickets Manager for WooCommerce 1.5.4 - 1.6.1 - Unauthenticated Cross-Product Ticket Price Manipulation"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"ec5b92bfc25928bf47ee3477e94f11adc1702aeee8131c8188f6ddb5767bcb25","data_version":"5.2","first_seen_at":"2026-11-22T09:50:04Z","kind":"advisory","last_material_event_at":"2026-11-22T09:50:04Z","native_id":"CVE-2026-123136","provenance":[{"revision":"6eaa7aa0e9e064e1fbacae0f6265fdabb480871a","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-123136"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-22T06:00:08Z","record_encoding":{"expanded_bytes":2929,"expanded_sha256":"a776e8e1568824e290e118b649661e8937629ed90abad6e348549ec776e11e11","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"28.9","status":"affected","version":"0","versionType":"semver"}],"product":"Yoast SEO","vendor":"Unknown"}],"aliases":["CVE-2026-120413"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Yoast SEO  WordPress plugin before 28.9 does not check that content is publicly viewable before returning its SEO metadata through a public REST endpoint, allowing unauthenticated users who know or can guess the URL of a private post, page or custom post type item to read its title, author, publication date and an excerpt of its content."}],"problemTypes":[{"descriptions":[{"description":"CWE-200 Information Exposure","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-22T06:00:08.037Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Yoast SEO < 28.9 - Unauthenticated Private Content Disclosure via Headless REST Head Endpoint"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"39792596deff1418eb85f39df2166bd94315a52f01317a0bfdd0a14c7b6a549f","data_version":"5.2","first_seen_at":"2026-11-22T09:50:04Z","kind":"advisory","last_material_event_at":"2026-11-22T09:50:04Z","native_id":"CVE-2026-120413","provenance":[{"revision":"6eaa7aa0e9e064e1fbacae0f6265fdabb480871a","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-120413"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-22T06:00:08Z","record_encoding":{"expanded_bytes":2803,"expanded_sha256":"b83f60be83ce934de7989c8298264e51060d665d69f3787679167901922306f3","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-120413","references":[{"assertion_role":"cna","provider":{"dateUpdated"
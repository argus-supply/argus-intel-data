{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"5.1.0","status":"affected","version":"0","versionType":"semver"}],"product":"Front User Submit","vendor":"Unknown"}],"aliases":["CVE-2026-123068"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Front User Submit  WordPress plugin before 5.1.0 does not validate the content of files uploaded through one of its unauthenticated endpoints and later serves them back with a Content-Type derived from the file's bytes and an inline disposition, allowing unauthenticated attackers to store an HTML or SVG payload and obtain a same-origin URL that executes arbitrary JavaScript in the browser of any user who opens it, including an administrator."}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Cross-Site Scripting (XSS)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-22T06:00:08.252Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Front Editor < 5.1.0 - Unauthenticated Stored XSS via Uploaded File Content-Type Sniffing"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"2021650b71e29240084f6763e193025f4c59812d9c15539d40c9d0b8f65689d0","data_version":"5.2","first_seen_at":"2026-11-22T09:50:04Z","kind":"advisory","last_material_event_at":"2026-11-22T09:50:04Z","native_id":"CVE-2026-123068","provenance":[{"revision":"6eaa7aa0e9e064e1fbacae0f6265fdabb480871a","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-123068"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-22T06:00:08Z","record_encoding":{"expanded_bytes":3021,"expanded_sha256":"e18b68603c6095edf72963f9b0ae6a35aee3f7791fb9eb39b57d8da49fa3d698","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_sourc
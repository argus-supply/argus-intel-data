{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.2.0","status":"affected","version":"0","versionType":"semver"}],"product":"Cart Abandonment Recovery for WooCommerce","vendor":"Unknown"}],"aliases":["CVE-2026-96901"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Cart Abandonment Recovery for WooCommerce  WordPress plugin before 2.2.0 does not verify the integrity of its cart-recovery token before acting on it and still accepts an unsigned legacy token format, allowing unauthenticated attackers who know a victim's cart session identifier to modify that victim's abandoned-cart record, for example unsubscribing them from recovery emails or applying an arbitrary coupon to their restored cart."}],"problemTypes":[{"descriptions":[{"description":"CWE-287 Improper Authentication","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-21T06:00:26.262Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Cart Abandonment Recovery for WooCommerce < 2.2.0 - Unauthenticated Authentication Bypass via Unsigned Recovery Token"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"bec2fb3f364a05cfab8ccef2bd7bc2cbd873f076347e01a7a2a0f80f89872e25","data_version":"5.2","first_seen_at":"2026-10-21T07:40:14Z","kind":"advisory","last_material_event_at":"2026-10-21T07:40:14Z","native_id":"CVE-2026-96901","provenance":[{"revision":"61fdd4b530c4f075c3ae7296fd9a9a97088f2086","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-96901"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-21T06:00:26Z","record_encoding":{"expanded_bytes":3073,"expanded_sha256":"74a0d758607b95a1eaa36bb12dc57af43a0c3d5d4cb183d5f2ad883e779633bc","format":"cve-indexed-assertions-v1","top_descriptions_assert
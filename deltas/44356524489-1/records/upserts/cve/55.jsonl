{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"100.0.9693.29286"}],"product":"SmarterMail","vendor":"SmarterTools"}],"aliases":["CVE-2026-126966"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-13T22:13:48.972Z","descriptions":[{"lang":"en","value":"SmarterTools SmarterMail Missing Authorization Privilege Escalation Vulnerability. This vulnerability allows remote attackers to escalate privileges on affected installations of SmarterTools SmarterMail. Authentication is required to exploit this vulnerability.\n\nThe specific flaw exists within the svcDomainAdmin.asmx endpoint. The issue results from the lack of authorization prior to allowing access to functionality. An attacker can leverage this vulnerability to escalate privileges to resources normally protected from the user. Was ZDI-CAN-33566."}],"metrics":[{"cvssV3_0":{"baseScore":8.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-862","description":"CWE-862: Missing Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-17T23:14:00.747Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"SmarterTools SmarterMail Missing Authorization Privilege Escalation Vulnerability"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-126966","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-11-18T17:02:59.472707Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-11-18T17:03:13.238Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown
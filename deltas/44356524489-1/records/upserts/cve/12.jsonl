{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"100.0.9693.29286"}],"product":"SmarterMail","vendor":"SmarterTools"}],"aliases":["CVE-2026-126968"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-13T22:13:55.597Z","descriptions":[{"lang":"en","value":"SmarterTools SmarterMail Missing Authorization Information Disclosure Vulnerability. This vulnerability allows remote attackers to disclose sensitive information on affected installations of SmarterTools SmarterMail. Authentication is required to exploit this vulnerability.\n\nThe specific flaw exists within the handling of email attachments. The issue results from the lack of authorization prior to allowing access to functionality. An attacker can leverage this vulnerability to disclose sensitive information in the context of a target user. Was ZDI-CAN-33567."}],"metrics":[{"cvssV3_0":{"baseScore":6.5,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.0/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:N/A:N","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-862","description":"CWE-862: Missing Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-17T23:14:17.380Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"SmarterTools SmarterMail Missing Authorization Information Disclosure Vulnerability"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-126968","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-11-18T17:03:56.464931Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-11-18T17:04:08.007Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"re
{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-39430"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"On HP Poly EagleEye Cube USB 1.3.1-001267 devices, the administrator authentication flow is broken: session management and access controls are not enforced device-side. Thus, an unauthenticated user can change administrator-level settings (without logging in) via a modified client that bypasses the login step or via a custom client to make the underlying administrator API calls. This allows unauthenticated users to perform administrative actions too such as exporting configuration files that include the internal device credentials for the administrator user and other network systems."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-11-04T14:14:17.187Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"8d9a4e4a3a11c5fd84359f5a3158bfda57f8254b8aa0745a143899e1bc5f2827","data_version":"5.2","first_seen_at":"2026-11-04T19:45:38Z","kind":"advisory","last_material_event_at":"2026-11-04T19:45:38Z","native_id":"CVE-2026-39430","provenance":[{"revision":"41b86094fdc3a3bd4ace7429975a21885467994f","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-39430"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-04T00:00:00Z","record_encoding":{"expanded_bytes":3442,"expanded_sha256":"f1ceea8cf58f18f46c912f2e0283209e974ce36fae5c8dcc7a21c55e22fe4686","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-39430","references":[{"assertion_r
{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-117373"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Janus WebRTC Server 1.2.3 through 1.4.0 is vulnerable to Directory Traversal. The application accepts a caller supplied media path when an ondemand stream is created. The path is validated only by checking whether it contains one of the audio extensions and is then passed to the file source which opens it. No canonicalization is performed and no directory allowlist is enforced, so an unauthenticated caller can make the server open an arbitrary local file and use it as a media source, with the content delivered to viewers as RTP audio."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-11-11T17:36:51.985Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"79dc930e8b6e85b96027306049015acccc3773403b472bf621176ec7e7520f1a","data_version":"5.2","first_seen_at":"2026-11-11T17:54:17Z","kind":"advisory","last_material_event_at":"2026-11-11T17:54:17Z","native_id":"CVE-2026-117373","provenance":[{"revision":"8d3f4ea0a99d311b8179ff7e261f17feb05c9761","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-117373"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-11T00:00:00Z","record_encoding":{"expanded_bytes":3440,"expanded_sha256":"b53184295bb4fc9c41775e8c259a6265543c7fd78d57e7a82b5efc855bb5ac33","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-117373","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"v2026.11.09.00","status":"affected","version":"v0.0.0.0","versionType":"semver"}],"product":"proxygen","vendor":"Facebook"}],"aliases":["CVE-2026-119237"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"In proxygen's HTTP/3 session, when a HEADERS block referenced QPACK dynamic table entries that had not yet been received, header decoding for that stream was paused, but the session continued to read the stream from the QUIC transport. The unread data bypassed the session's ingress buffer limit, returned flow-control credit to the peer, and was re-scanned in full on every read. With QPACK blocked streams enabled (the default), a remote, unauthenticated HTTP/3 peer could send a HEADERS block that references a dynamic table insert it never sends, followed by a continuous stream of data, causing memory growth until the request timed out and CPU usage that grows quadratically, leading to denial of service. This issue affects proxygen versions prior to v2026.11.09.00."}],"problemTypes":[{"descriptions":[{"description":"Allocation of Resources Without Limits or Throttling (CWE-770)","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-11T16:55:20.571Z","orgId":"4fc57720-52fe-4431-a0fb-3d2c8747b827","shortName":"Meta"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"9c2fd1456f57471a9d4f509cc72565205f0402a54fc4b7437b6970c063592665","data_version":"5.2","first_seen_at":"2026-11-11T17:54:17Z","kind":"advisory","last_material_event_at":"2026-11-11T17:54:17Z","native_id":"CVE-2026-119237","provenance":[{"revision":"8d3f4ea0a99d311b8179ff7e261f17feb05c9761","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-119237"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":
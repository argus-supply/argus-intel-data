{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"v2026.11.09.00","status":"affected","version":"v0.0.0.0","versionType":"semver"}],"product":"proxygen","vendor":"Facebook"}],"aliases":["CVE-2026-119235"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"proxygen's QPACK decoder enforced its size limit on a string literal in an encoder-stream instruction only after the entire literal had been received. A remote, unauthenticated HTTP/3 peer could send an insert instruction on the QPACK encoder stream that declares an arbitrarily large literal and then keep sending data, causing the decoder to buffer it without bound for the lifetime of the connection and exhaust memory, leading to denial of service. The issue occurs regardless of the advertised QPACK dynamic table capacity, including when the dynamic table is disabled. This issue affects proxygen versions prior to v2026.11.09.00."}],"problemTypes":[{"descriptions":[{"description":"Allocation of Resources Without Limits or Throttling (CWE-770)","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-11T16:54:58.688Z","orgId":"4fc57720-52fe-4431-a0fb-3d2c8747b827","shortName":"Meta"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"d824676de01bbabd5e2bd1d6e3c23e87df0caaef36897985dc567610f0ddea8d","data_version":"5.2","first_seen_at":"2026-11-11T17:54:17Z","kind":"advisory","last_material_event_at":"2026-11-11T17:54:17Z","native_id":"CVE-2026-119235","provenance":[{"revision":"8d3f4ea0a99d311b8179ff7e261f17feb05c9761","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-119235"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-11T16:54:58Z","record_encoding":{"expanded_bytes":3465,"expanded_sha256":"fcd55272ef692ba5b33d1e0e2e5f55aee7ca74faa6e9fb461c97e7
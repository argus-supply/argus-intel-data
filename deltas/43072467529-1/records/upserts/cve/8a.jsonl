{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"v2026.11.09.00","status":"affected","version":"v0.0.0.0","versionType":"semver"}],"product":"mvfst","vendor":"Facebook"}],"aliases":["CVE-2026-119236"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"An mvfst QUIC server retained CRYPTO frame data received at an encryption level (Initial or Handshake) that the TLS handshake had already moved past. Because the transport treated this data as delivered, it did not count against the CRYPTO stream buffer limit. A remote, unauthenticated client could complete a handshake, withhold its acknowledgment of the server's HANDSHAKE_DONE frame so that Handshake keys stay in use, and keep sending Handshake-level CRYPTO data at increasing offsets, causing unbounded memory growth on the server and leading to denial of service. This issue affects mvfst versions prior to v2026.11.09.00."}],"problemTypes":[{"descriptions":[{"description":"Allocation of Resources Without Limits or Throttling (CWE-770)","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-11T16:55:09.288Z","orgId":"4fc57720-52fe-4431-a0fb-3d2c8747b827","shortName":"Meta"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"3804aded79f9839bbd10c50326e36cbeaeab26f5f29150264f60b32a85cc55f8","data_version":"5.2","first_seen_at":"2026-11-11T17:54:17Z","kind":"advisory","last_material_event_at":"2026-11-11T17:54:17Z","native_id":"CVE-2026-119236","provenance":[{"revision":"8d3f4ea0a99d311b8179ff7e261f17feb05c9761","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-119236"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-11T16:55:09Z","record_encoding":{"expanded_bytes":3445,"expanded_sha256":"196756f91b28588a695aebd1a8db62189056b96544501303a1f29f143d0dbaa8
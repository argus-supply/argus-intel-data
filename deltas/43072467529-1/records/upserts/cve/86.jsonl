{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"6.0.8","status":"affected","version":"0","versionType":"semver"}],"product":"Adserver","vendor":"Revive"}],"aliases":["CVE-2026-108559"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A reflected cross-site scripting vulnerability in the iframe invocation options of Revive Adserver 6.0.8 and earlier allows an unauthenticated attacker to execute JavaScript in an authenticated user's browser by persuading them to visit a crafted URL. When generating invocation tags for an any-size zone, the frame_width and frame_height request parameters are included in HTML attributes without appropriate encoding. The issue is fixed in Revive Adserver 6.0.9 by HTML-encoding the affected values in the invocation-option form fields."}],"metrics":[{"cvssV3_0":{"baseScore":6.1,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.0/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N","version":"3.0"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-79","description":"CWE-79 Cross-site Scripting (XSS) - Reflected","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-11T17:30:37.689Z","orgId":"36234546-b8fa-4601-9d6f-f4e334aa8ea1","shortName":"hackerone"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"297e1a005e79ff47438015f636ea121d9e9b2e96ddbc189a782e0ee75ab1de7e","data_version":"5.2","first_seen_at":"2026-11-11T17:54:17Z","kind":"advisory","last_material_event_at":"2026-11-11T17:54:17Z","native_id":"CVE-2026-108559","provenance":[{"revision":"8d3f4ea0a99d311b8179ff7e261f17feb05c9761","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-108559"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-11T17:30:37Z","record_encoding":{"expanded_bytes":3120,"expanded_sha256":"
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"v2026.11.09.00","status":"affected","version":"v0.0.0.0","versionType":"semver"}],"product":"proxygen","vendor":"Facebook"}],"aliases":["CVE-2026-119233"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"proxygen's HTTP/3 codec buffered an incomplete non-DATA frame, such as a control-stream frame, a frame of an unknown or reserved type, or a HEADERS frame, until its entire declared length had arrived, without limiting that length, and re-scanned all buffered data each time more bytes arrived. A remote, unauthenticated HTTP/3 peer could declare a very large frame and deliver it slowly, causing unbounded memory growth and CPU usage that grows quadratically with the number of fragments, leading to denial of service. This issue affects proxygen versions prior to v2026.11.09.00."}],"problemTypes":[{"descriptions":[{"description":"Allocation of Resources Without Limits or Throttling (CWE-770)","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-11T16:54:35.006Z","orgId":"4fc57720-52fe-4431-a0fb-3d2c8747b827","shortName":"Meta"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"32ee25bfc5b70b7a941b6369158f203c7de21ff364090d713a0f71548940c7ef","data_version":"5.2","first_seen_at":"2026-11-11T17:54:17Z","kind":"advisory","last_material_event_at":"2026-11-11T17:54:17Z","native_id":"CVE-2026-119233","provenance":[{"revision":"8d3f4ea0a99d311b8179ff7e261f17feb05c9761","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-119233"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-11T16:54:35Z","record_encoding":{"expanded_bytes":3353,"expanded_sha256":"55f90b2e8734a2ac523cb85a6d281d67caa8af14294acd93bee3e46ef885158b","format":"cve-indexed-assertions-v1","top_de
{"affected":[{"original_ranges":[{"lessThan":"20260813_c2169ea5","status":"affected","version":"0","versionType":"custom"}],"product":"Rooxis RXR-12","vendor":"Rooxis"}],"aliases":["CVE-2026-126723"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Rooxis RXR-12 Wi-Fi router contains an authenticated command injection vulnerability in the LuCI white_list RPC handler (/usr/lib/lua/luci/data/white_list_plt.lua), where unsanitized user-supplied MAC addresses are concatenated into os.execute() without validation, yielding root command execution via a malformed mac parameter. Firmware 20260813_c2169ea5 fixes the vulnerability, and users can update their router through the local web interface."}],"problemTypes":[{"descriptions":[{"description":"CWE-78 Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')","lang":"en"}]},{"descriptions":[{"description":"CWE-77 Improper Neutralization of Special Elements used in a Command ('Command Injection')","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-11T16:41:28.727Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"role":"cna","title":"CVE-2026-126723"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"c7d1b1b144af610d6424db8dcc8ffb1021e89e02500ea05f27ab2770917ad6f9","data_version":"5.2","first_seen_at":"2026-11-11T17:54:17Z","kind":"advisory","last_material_event_at":"2026-11-11T17:54:17Z","native_id":"CVE-2026-126723","provenance":[{"revision":"8d3f4ea0a99d311b8179ff7e261f17feb05c9761","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-126723"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-11T16:41:28Z","record_encoding":{"expanded_bytes":3189,"expanded_sha256":"0fd6564e6e7fa8d65126601dd661f1870a93a71518888ca55775cc15d112791b","for
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"6.0.8","status":"affected","version":"0","versionType":"semver"}],"product":"Adserver","vendor":"Revive"}],"aliases":["CVE-2026-68485"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"An authorization bypass in website-index.php in Revive Adserver 6.0.8 and earlier allows an authenticated manager restricted to one agency to view another agency's website listing by changing the agencyid request parameter. Disclosed information includes website names, identifiers and timestamps. Detailed website pages continue to enforce ownership checks. The issue is fixed in Revive Adserver 6.0.9 by obtaining the agency identifier from the authenticated account rather than the request."}],"metrics":[{"cvssV3_0":{"baseScore":4.3,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.0/AV:N/AC:L/PR:L/UI:N/S:U/C:L/I:N/A:N","version":"3.0"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-639","description":"CWE-639 Insecure Direct Object Reference (IDOR)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-11T17:30:37.801Z","orgId":"36234546-b8fa-4601-9d6f-f4e334aa8ea1","shortName":"hackerone"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"202fb2539f5906c71081d57dee56a94da324e0b8daeebcf029ed9e4963d1995b","data_version":"5.2","first_seen_at":"2026-11-11T17:54:17Z","kind":"advisory","last_material_event_at":"2026-11-11T17:54:17Z","native_id":"CVE-2026-68485","provenance":[{"revision":"8d3f4ea0a99d311b8179ff7e261f17feb05c9761","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-68485"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-11T17:30:37Z","record_encoding":{"expanded_bytes":3028,"expanded_sha256":"56819dd82cde75fbd2a58d4b3c19419d20da937a3701d
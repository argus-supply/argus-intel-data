{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"v2026.11.09.00","status":"affected","version":"v0.0.0.0","versionType":"semver"}],"product":"proxygen","vendor":"Facebook"}],"aliases":["CVE-2026-121737"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"When a remote, unauthenticated HTTP/1.1 client pipelined the start of a second request and then stopped reading, proxygen's coroutine-based HTTP session could free that pipelined stream while resetting the connection's streams on the resulting write timeout, then go on to use it. This can crash the server, leading to denial of service, and may allow memory corruption with further impact. This issue affects proxygen versions prior to v2026.11.09.00."}],"problemTypes":[{"descriptions":[{"description":"Use After Free (CWE-416)","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-11T16:55:44.734Z","orgId":"4fc57720-52fe-4431-a0fb-3d2c8747b827","shortName":"Meta"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"48b6634fa666dcd551d6aef333c2bf8df645818897ad2c6c82829c6954a85bf4","data_version":"5.2","first_seen_at":"2026-11-11T17:54:17Z","kind":"advisory","last_material_event_at":"2026-11-11T17:54:17Z","native_id":"CVE-2026-121737","provenance":[{"revision":"8d3f4ea0a99d311b8179ff7e261f17feb05c9761","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-121737"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-11T16:55:44Z","record_encoding":{"expanded_bytes":3059,"expanded_sha256":"04f842b0fa9bc92f828019d96d34713236dd5847b330cab6973c433b425135d5","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-121737","references":[{"assertion_role":"cna","provider":{"dateUpdat
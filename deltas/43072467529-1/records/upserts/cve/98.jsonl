{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"23c061f4e804a51badd5f85227e65185651253b5","status":"affected","version":"0","versionType":"git"}],"product":"HHVM","vendor":"Facebook"}],"aliases":["CVE-2026-119723"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"When parsing request variables such as query-string and form parameters, HHVM did not check that appending a nested array succeeded before descending into it. A remote, unauthenticated attacker could send a GET or POST request which would crash the HHVM server process before any application code runs, leading to denial of service. This issue affected HHVM prior to 23c061f4e804a51badd5f85227e65185651253b5."}],"problemTypes":[{"descriptions":[{"description":"Access of Resource Using Incompatible Type (CWE-843)","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-11T16:57:01.125Z","orgId":"4fc57720-52fe-4431-a0fb-3d2c8747b827","shortName":"Meta"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"c4100013ca644d62daaa5a9087168ad81596d708c3e83a7fcb8163c6e91e41ab","data_version":"5.2","first_seen_at":"2026-11-11T17:54:17Z","kind":"advisory","last_material_event_at":"2026-11-11T17:54:17Z","native_id":"CVE-2026-119723","provenance":[{"revision":"8d3f4ea0a99d311b8179ff7e261f17feb05c9761","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-119723"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-11T16:57:01Z","record_encoding":{"expanded_bytes":3007,"expanded_sha256":"5a44a1a28b02929d6fbc0224eeeecd3c22830f593e3a8ad25141f0055be63894","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-119723","references":[{"assertion_role":"cna","provider":{"dateUpdated":
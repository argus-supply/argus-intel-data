{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"v2026.11.09.0","status":"affected","version":"v0.0.0.0","versionType":"semver"}],"product":"mvfst","vendor":"Facebook"}],"aliases":["CVE-2026-119234"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"mvfst did not adequately merge or compact out-of-order STREAM frame data, and a small received fragment could keep a much larger receive buffer alive. QUIC flow control limits the number of buffered stream bytes, but not this per-fragment memory and bookkeeping. A remote, unauthenticated QUIC peer could send many small, non-contiguous stream fragments to make an endpoint consume memory far in excess of its advertised receive window and spend increasing CPU time reassembling stream data, leading to denial of service. This issue affects mvfst versions prior to v2026.11.09.0."}],"problemTypes":[{"descriptions":[{"description":"Allocation of Resources Without Limits or Throttling (CWE-770)","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-11T16:54:48.304Z","orgId":"4fc57720-52fe-4431-a0fb-3d2c8747b827","shortName":"Meta"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"cacbcb82a8a28f3cffeb577c38a955f09a4799edf7bb3b0bb94a6e4cc30ce7cf","data_version":"5.2","first_seen_at":"2026-11-11T17:54:17Z","kind":"advisory","last_material_event_at":"2026-11-11T17:54:17Z","native_id":"CVE-2026-119234","provenance":[{"revision":"8d3f4ea0a99d311b8179ff7e261f17feb05c9761","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-119234"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-11T16:54:48Z","record_encoding":{"expanded_bytes":3344,"expanded_sha256":"9c15e4aa1b2fe8c3a3af8d38dfa12b406d088dcaff8b9fdb64d30e06dc900592","format":"cve-indexed-assertions-v1","top_descrip
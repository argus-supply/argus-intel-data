{"affected":[{"original_ranges":[{"status":"affected","version":"0"}],"product":"Rooxis RXR-12","vendor":"Rooxis"}],"aliases":["CVE-2026-126720"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Rooxis RXR-12 Wi-Fi router contains an unauthenticated remote code execution vulnerability in /usr/bin/cloud_manage, where a server-controlled JSON diagnoseParameter field is passed unsanitized to popen(), enabling arbitrary command execution as root over cleartext HTTP when an attacker is positioned on-path and has access to the hard-coded cloud endpoint. Firmware 20260813_c2169ea5 fixes the vulnerability, and your router can be updated through the local web interface."}],"problemTypes":[{"descriptions":[{"description":"CWE-78 Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')","lang":"en"}]},{"descriptions":[{"description":"CWE-79 Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-11T16:41:07.539Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"role":"cna","title":"CVE-2026-126720"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"8bb4648e99e806c3cc82511a8dd801fc1a34937326a7053aba8ded34e8adcf12","data_version":"5.2","first_seen_at":"2026-11-11T17:54:17Z","kind":"advisory","last_material_event_at":"2026-11-11T17:54:17Z","native_id":"CVE-2026-126720","provenance":[{"revision":"8d3f4ea0a99d311b8179ff7e261f17feb05c9761","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-126720"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-11T16:41:07Z","record_encoding":{"expanded_bytes":3190,"expanded_sha256":"2326a67909fbe88dc4ed9f44c3d7bafedd1d3b2c03562b4daad7c90eba6fb18c","format":"cve-indexed-assertio
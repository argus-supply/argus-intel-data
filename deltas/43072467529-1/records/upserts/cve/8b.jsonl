{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"6.0.8","status":"affected","version":"0","versionType":"semver"}],"product":"Adserver","vendor":"Revive"}],"aliases":["CVE-2026-108563"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Spreadsheet formula injection in conversion-tracking report exports in Revive Adserver 6.0.8 and earlier allows an unauthenticated attacker to submit conversion values that are written as formulas instead of text in an XLS workbook. When a user opens the exported report in a spreadsheet application, attacker-supplied formulas can be evaluated. The confirmed impact is formula execution within the workbook; disclosure of information to the attacker has not been established. The issue is fixed in Revive Adserver 6.0.9 by sanitising conversion values before writing them to the affected XLS report sections."}],"metrics":[{"cvssV3_0":{"baseScore":4.7,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.0/AV:N/AC:L/PR:N/UI:R/S:C/C:N/I:L/A:N","version":"3.0"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-94","description":"CWE-94 Code Injection","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-11T17:30:37.737Z","orgId":"36234546-b8fa-4601-9d6f-f4e334aa8ea1","shortName":"hackerone"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"ed4a8100f3013f8db5bb3e3089eaa23443003445c8ba0d5d259af66164b4c2a8","data_version":"5.2","first_seen_at":"2026-11-11T17:54:17Z","kind":"advisory","last_material_event_at":"2026-11-11T17:54:17Z","native_id":"CVE-2026-108563","provenance":[{"revision":"8d3f4ea0a99d311b8179ff7e261f17feb05c9761","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-108563"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-11T17:30:37Z","record_encod
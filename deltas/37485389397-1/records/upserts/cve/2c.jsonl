{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"2.0.66","status":"affected","version":"0","versionType":"semver"}],"product":"ACPT (Premium)","vendor":"Mauro Cassani"}],"aliases":["CVE-2026-105701"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The ACPT (Premium) plugin for WordPress is vulnerable to Remote Code Execution in all versions up to, and including, 2.0.66 via the render function. This is due to missing capability check on the REST API form creation endpoint and unsandboxed Twig environment rendering email templates. This makes it possible for authenticated attackers, with subscriber-level access and above, to execute code on the server. The exploit requires the attacker to first create a form with malicious email_settings via the REST API endpoint, then trigger form submission to execute the injected Twig expressions."}],"metrics":[{"cvssV3_1":{"baseScore":8.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-434","description":"CWE-434 Unrestricted Upload of File with Dangerous Type","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-06T06:42:03.471Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"ACPT (Premium) <= 2.0.66 - Authenticated (Subscriber+) Remote Code Execution via REST API Email Template"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"17a99656ec034faf574e380a00148ddfd2f30562ce49a417840a424c1d767fd1","data_version":"5.2","first_seen_at":"2026-10-06T15:12:57Z","kind":"advisory","last_material_event_at":"2026-10-06T15:12:57Z","native_id":"CVE-2026-105701","provenance":[{"revision":"a057479aaa4206f7f41b81e677410826ab9ae355","source_id":"cve","url":"https://www.cve.org/CVE
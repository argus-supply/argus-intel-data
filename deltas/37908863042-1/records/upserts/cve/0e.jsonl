{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"3.10.0","status":"affected","version":"0","versionType":"semver"}],"product":"Code Snippets","vendor":"Unknown"}],"aliases":["CVE-2026-106095"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Code Snippets WordPress plugin before 3.10.0 does not perform a capability check on one of its snippet-management actions and derives the network scope of the targeted snippet from the request instead of from the stored record, allowing an administrator of a single subsite on a multisite network to activate, deactivate and reprioritise network-scoped snippets that run across every site in the network."}],"problemTypes":[{"descriptions":[{"description":"CWE-862 Missing Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-09T06:00:08.896Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Code Snippets < 3.10.0 - Admin+ Network-Scoped Snippet Activation and Deactivation via update_code_snippet"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"6f80a12bed6e7ad36e360efd5160e951cb2c5b0c5ba3ac7b1dd54f73fa61e867","data_version":"5.2","first_seen_at":"2026-10-09T09:04:44Z","kind":"advisory","last_material_event_at":"2026-10-09T09:04:44Z","native_id":"CVE-2026-106095","provenance":[{"revision":"f2057c3164b32ac9319eba22ad5e79571f261fb6","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-106095"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-09T06:00:08Z","record_encoding":{"expanded_bytes":2966,"expanded_sha256":"1b530a34be4d9251651edf227b6e1556f3facd92e31e4c71cb0198ab26b0ad1e","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":
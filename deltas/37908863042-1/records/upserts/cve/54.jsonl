{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"3.10.0","status":"affected","version":"0","versionType":"semver"}],"product":"Code Snippets","vendor":"Unknown"}],"aliases":["CVE-2026-106097"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Code Snippets WordPress plugin before 3.10.0 does not sanitise and escape a user-supplied parameter before using it in a SQL query in some of its snippet-migration import endpoints, which are accessible to any user holding site-administration capabilities; on a WordPress Multisite network those belong to subsite Administrators, allowing a subsite Administrator who is not a network Super Admin to perform UNION-based SQL injection against shared network tables and disclose network-wide data such as other users' password hashes."}],"problemTypes":[{"descriptions":[{"description":"CWE-89 SQL Injection","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-09T06:00:09.067Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Code Snippets < 3.10.0 - Admin+ SQLi in Migration Importers Leading to Network-Wide Credential Disclosure (Multisite)"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"6bddb34453406990ec8f5a8cad312d2a7a3943e25cd42f3b899c6681c785042d","data_version":"5.2","first_seen_at":"2026-10-09T09:04:44Z","kind":"advisory","last_material_event_at":"2026-10-09T09:04:44Z","native_id":"CVE-2026-106097","provenance":[{"revision":"f2057c3164b32ac9319eba22ad5e79571f261fb6","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-106097"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-09T06:00:09Z","record_encoding":{"expanded_bytes":3233,"expanded_sha256":"71492f6f0d75ec155da9f24c639299345af6629d1a07512e5c979611d10cf602"
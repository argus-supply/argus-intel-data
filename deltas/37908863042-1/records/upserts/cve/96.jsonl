{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"4.5.11","status":"affected","version":"0","versionType":"semver"}],"product":"Redux Framework","vendor":"davidanderson"}],"aliases":["CVE-2025-14123"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Redux Framework plugin for WordPress is vulnerable to privilege escalation in all versions up to, and including, 4.5.11. This is due to the plugin saving arbitrary meta keys under a registered option name without sufficient capability checks or key allowlist / restrictions. This makes it possible for authenticated attackers, with Subscriber-level access and above, to set an arbitrary role (e.g., Administrator) when performing a profile update if a plugin or theme using this framework has added at least one user profile field that leverages Redux_Users::set_profile/set_section/set_field."}],"metrics":[{"cvssV3_1":{"baseScore":6.8,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:H/PR:L/UI:N/S:U/C:H/I:H/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-269","description":"CWE-269 Improper Privilege Management","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-09T07:41:48.079Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"Redux Framework <= 4.5.11 – Authenticated (Subscriber+) Privilege Escalation via Users Extension"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"4f5f1e678e25568f3b80ec4d47f0a59b3a1261880b6f93f258b20a352807e538","data_version":"5.2","first_seen_at":"2026-10-09T09:04:44Z","kind":"advisory","last_material_event_at":"2026-10-09T09:04:44Z","native_id":"CVE-2025-14123","provenance":[{"revision":"f2057c3164b32ac9319eba22ad5e79571f261fb6","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2025-1412
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.4.20","status":"affected","version":"1.4.8","versionType":"semver"}],"product":"CUPS","repo":"https://github.com/OpenPrinting/cups","vendor":"OpenPrinting"}],"aliases":["CVE-2026-107886"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"OpenPrinting CUPS before 2.4.20 contains a double-free in printer-class management. When CUPS-Add-Modify-Class replaces an existing class member list, add_class() frees pclass->printers without clearing the pointer. If subsequent validation fails, the class retains the dangling pointer; CUPS-Delete-Class subsequently frees the same allocation in cupsdDeletePrinter(). A client authorized to modify and delete classes can cause scheduler-wide denial of service. The default policy requires @SYSTEM privileges."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"LOCAL","availabilityImpact":"LOW","baseScore":2.3,"baseSeverity":"LOW","confidentialityImpact":"NONE","integrityImpact":"NONE","privilegesRequired":"HIGH","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:L/AC:L/PR:H/UI:N/S:U/C:N/I:N/A:L","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-415","description":"CWE-415: Double Free","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-09T04:00:29.308Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"72e3b19bb48c0434306cdd53cbca39261756ddd3bf27d5f72527197e8c19d3b6","data_version":"5.2","first_seen_at":"2026-10-09T09:04:44Z","kind":"advisory","last_material_event_at":"2026-10-09T09:04:44Z","native_id":"CVE-2026-107886","provenance":[{"revision":"f2057c3164b32ac9319eba22ad5e7957
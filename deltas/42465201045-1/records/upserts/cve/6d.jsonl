{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"6.2.4","status":"affected","version":"6.2","versionType":"semver"}],"product":"Contact Form 7","vendor":"Unknown"}],"aliases":["CVE-2026-114432"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Contact Form 7 WordPress plugin before 6.2.4 does not validate the type or extension of files uploaded through a form file field, and a flaw in its temporary-file cleanup leaves the uploaded file on disk, allowing unauthenticated users to upload arbitrary files to the site. On a stock Debian or Ubuntu Apache configuration, which lists directory contents and maps .phar to the PHP handler, the stored file can be located and executed, leading to Remote Code Execution. On other configurations, including nginx and Apache with .htaccess overrides enabled, the issue is limited to an arbitrary file written into the uploads directory, which may still be served as active content such as HTML or SVG from the site's own origin."}],"problemTypes":[{"descriptions":[{"description":"CWE-434 Unrestricted Upload of File with Dangerous Type","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-08T06:00:29.249Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Contact Form 7 6.2 - 6.2.3 - Unauthenticated Arbitrary File Upload via Invalid UTF-8 Filename"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"ab2156d6336d4937d9154912fd6291f40d4dacd621d993b5c0bb602dfeaab336","data_version":"5.2","first_seen_at":"2026-11-08T08:59:59Z","kind":"advisory","last_material_event_at":"2026-11-08T08:59:59Z","native_id":"CVE-2026-114432","provenance":[{"revision":"e517f08b1a9ff8c03eac994104f4b47b138f3409","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-114432"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-08T06:00:29Z","record_encoding":{"expanded_bytes":3610,"expanded_sha256":"f72f9b181b699b9862d4ca0c8eb3fa4da33ed537af8c1b83783af0b7ce99578d","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-114432","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-08T06:00:29.249Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"tags":["exploit","vdb-entry","technical-description"],"url":"https://wpscan.com/vulnerability/6b0a5d1f-84fb-425f-8d37-ddde5703937c/"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-11-08T06:00:29Z","status":"active","title":"Contact Form 7 6.2 - 6.2.3 - Unauthenticated Arbitrary File Upload via Invalid UTF-8 Filename"}

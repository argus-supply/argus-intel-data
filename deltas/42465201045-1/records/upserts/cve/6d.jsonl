{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"6.9.8","status":"affected","version":"0","versionType":"semver"}],"product":"Secure Custom Fields","vendor":"Unknown"}],"aliases":["CVE-2026-97193"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Secure Custom Fields WordPress plugin before 6.9.8 does not verify that a user is allowed to edit the target object before writing to it during bidirectional relationship synchronization, allowing users with contributor-level access and above to add or remove a reference to their own object on arbitrary posts, users, or terms they cannot otherwise edit."}],"problemTypes":[{"descriptions":[{"description":"CWE-639 Authorization Bypass Through User-Controlled Key","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-08T06:00:28.198Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Secure Custom Fields < 6.9.8 - Contributor+ Relationship Field Update on Arbitrary Objects via IDOR"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"badc39d8d7868e9f47eccf53991b66ec7d04feb1318fa9bb8c23e0daa35d04df","data_version":"5.2","first_seen_at":"2026-11-08T08:59:59Z","kind":"advisory","last_material_event_at":"2026-11-08T08:59:59Z","native_id":"CVE-2026-97193","provenance":[{"revision":"e517f08b1a9ff8c03eac994104f4b47b138f3409","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-97193"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-08T06:00:28Z","record_encoding":{"expanded_bytes":2883,"expanded_sha256":"4e3534987b6154472292ef7b41c1422a30f95a7a43656ad17e5cafaa9a3ac31f","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-97193","refe
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"6.9.8","status":"affected","version":"0","versionType":"semver"}],"product":"Secure Custom Fields","vendor":"Unknown"}],"aliases":["CVE-2026-97195"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Secure Custom Fields WordPress plugin before 6.9.8 does not sanitize a persisted field definition before emitting part of it as an HTML attribute name, allowing a user able to configure its fields to store a payload that executes as JavaScript in the browser of any user who views a page rendering the affected field, which on multisite lets a site administrator who lacks the unfiltered_html capability inject script into other users' sessions."}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Cross-Site Scripting (XSS)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-08T06:00:28.542Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Secure Custom Fields < 6.9.8 - Admin+ Stored XSS via HTML Attribute Name Injection into Field Definition"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"885f2dee95e6ddc9ca7d59d53ade5242e883de448b4b6697db2ad396fb245ea2","data_version":"5.2","first_seen_at":"2026-11-08T08:59:59Z","kind":"advisory","last_material_event_at":"2026-11-08T08:59:59Z","native_id":"CVE-2026-97195","provenance":[{"revision":"e517f08b1a9ff8c03eac994104f4b47b138f3409","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-97195"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-08T06:00:28Z","record_encoding":{"expanded_bytes":3050,"expanded_sha256":"97e3cfff5dce0150ad7e18c7538213882994255fd89b517d5ce8954f529fee40","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_des
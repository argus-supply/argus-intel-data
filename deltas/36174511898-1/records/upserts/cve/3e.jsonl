{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-88389"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Espruino 2v29 (commit bffc6d0) contains a NULL pointer dereference vulnerability in jslGetRawString() in src/jslex.c. Crafted raw/binary string input can cause the lexer to pass a NULL iterator target to jsvLockAgain(). In RELEASE/NO_ASSERT builds, the missing assertion guard allows a write through the NULL pointer, resulting in memory corruption and application termination or denial of service."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-09-25T14:07:39.290Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"724aeb158bfe5275be297d816825d9a9fa179f7bcc5fc6835e82af16d3cdafa4","data_version":"5.2","first_seen_at":"2026-09-25T18:37:34Z","kind":"advisory","last_material_event_at":"2026-09-25T18:37:34Z","native_id":"CVE-2026-88389","provenance":[{"revision":"81d28fcac6cc6b8c109d7c5b1d3a4dc3c9354229","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-88389"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-25T00:00:00Z","record_encoding":{"expanded_bytes":2782,"expanded_sha256":"836f94246204547ab84340f183430bb7cd8a221e3cd449ea07c4eccaf9bc6f84","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-88389","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-25T14:07:39.290Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"url":"https://github.com/espruino/Espruino/issues/2745"},{"
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"3.2.3","status":"affected","version":"1","versionType":"semver"}],"product":"PostgreSQL Anonymizer","vendor":"DALIBO"}],"aliases":["CVE-2026-97469"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"PostgreSQL Anonymizer contains a vulnerability that allows unprivileged masked users to repeatedly call the anon.hash() function and collects (seed, hash_output) pairs to perform an offline brute-force attack and deduce the salt. A masked role can run a RESTRICTED function when the call is placed inside the sub-select. The problem is resolved in PostgreSQL Anonymizer 3.2.3 and later versions"}],"metrics":[{"cvssV3_1":{"baseScore":4.3,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:L/I:N/A:N","version":"3.1"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-328","description":"Use of Weak Hash","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-25T15:40:45.207Z","orgId":"f86ef6dc-4d3a-42ad-8f28-e6d5547a5007","shortName":"PostgreSQL"},"role":"cna","title":"PostgreSQL Anonymizer: RESTRICTED functions are reachable through a subLink"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-97469","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-09-25T16:06:34.584396Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-09-25T16:06:42.100Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"b1c6e9d69f13bd076132882ca48a102c3e7a8f210386b123dd3717732d6b949b","data_version":"5.2","first_seen_at":"2026-09-25T18:37:34Z","kind":"advisory","last_material_
{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-88385"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Mini-XML 4.0.5 contains a memory leak vulnerability in mxml_load_data() during malformed XML parsing. Specially crafted XML input can cause text nodes allocated by mxmlNewText() to become unlinked before a parse error transfers control to the cleanup path. These orphaned nodes are not released, resulting in a persistent memory leak on each parsing attempt. Repeated attacker-controlled requests can cause cumulative memory exhaustion and denial of service."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-09-24T16:21:51.598Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"55f4064da92ea6f9576e4dd8627a797da348aca7fa54a32bbafb462197a89ce5","data_version":"5.2","first_seen_at":"2026-09-24T17:11:48Z","kind":"advisory","last_material_event_at":"2026-09-24T17:11:48Z","native_id":"CVE-2026-88385","provenance":[{"revision":"70c2ef40ba53e74b5d1ef77e4008542f2f190e8b","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-88385"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-24T00:00:00Z","record_encoding":{"expanded_bytes":2903,"expanded_sha256":"b922a002008cd9396ac8977298187f6e3e13e8ba89bcee01b4443c6ed013387f","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-88385","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-24T16:21:51.598Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},
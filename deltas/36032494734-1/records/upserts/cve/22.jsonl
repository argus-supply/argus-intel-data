{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-88360"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"libvips 8.19.0 contains a memory access vulnerability when processing little-endian PFM images. If the PFM text header length is not a multiple of four bytes, the mmap-based loader can expose pixel data at an address that is not properly aligned for float access. vips_avg_scan() subsequently dereferences the buffer through a float pointer, resulting in undefined behavior and process termination on strict-alignment architectures or UBSan-instrumented builds, leading to denial of service."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-09-24T14:04:26.549Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"1481a5238412fe7fab2de33cae16ba3903c3204adf946876ee2ec0cbd5c95736","data_version":"5.2","first_seen_at":"2026-09-24T17:11:48Z","kind":"advisory","last_material_event_at":"2026-09-24T17:11:48Z","native_id":"CVE-2026-88360","provenance":[{"revision":"70c2ef40ba53e74b5d1ef77e4008542f2f190e8b","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-88360"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-24T00:00:00Z","record_encoding":{"expanded_bytes":2727,"expanded_sha256":"098a2f801d2045e847261034c15b0c6d0d022489f9843b5b2c42d568d54174c6","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-88360","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-24T14:04:26.549Z","orgId":"8254265b-2729-46b6-b9e3-3d
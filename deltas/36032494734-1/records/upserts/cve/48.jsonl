{"affected":[{"original_ranges":[{"status":"affected","version":"N/A"}],"product":"door access control","vendor":"Norwegian Cruise Line"}],"aliases":["CVE-2026-75907"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The door access control on a Norwegian Cruise Line asset grants entry based only on the credential's static 7-byte UID stored on an NTAG212 NFC chip. A UID is a manufacturer serial number sent in the clear on every read and is not intended to be secret or to authenticate the holder. Validating on the UID of the NTAG212 NFC chip alone is identification, not authentication, and the credential has no challenge-response capability that would resist copying."}],"problemTypes":[{"descriptions":[{"description":"CWE-287 Improper Authentication","lang":"en"}]},{"descriptions":[{"description":"CWE-294 Authentication Bypass by Capture-replay","lang":"en"}]},{"descriptions":[{"description":"CWE-613 Insufficient Session Expiration","lang":"en"}]}],"provider":{"dateUpdated":"2026-09-24T15:56:08.200Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"role":"cna","title":"CVE-2026-75907"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"035a9372886ebfe68ced85102febf5d3751d53c412f7d0c28d6a946ecd4dfd1f","data_version":"5.2","first_seen_at":"2026-09-24T17:11:48Z","kind":"advisory","last_material_event_at":"2026-09-24T17:11:48Z","native_id":"CVE-2026-75907","provenance":[{"revision":"70c2ef40ba53e74b5d1ef77e4008542f2f190e8b","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-75907"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-24T15:56:08Z","record_encoding":{"expanded_bytes":2910,"expanded_sha256":"cb6d91018036e063f356696db2034c47f7353fedd4c6817417d0678b92f176df","format":"cve-indexed-assertions-v1","top_descrip
{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-88373"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"libde265 commit 4d45a6b contains a NULL pointer dereference vulnerability in the NAL parsing path. When de265_push_NAL() is called with a zero-length NAL unit, the resulting NAL_unit may retain a NULL backing buffer, which is subsequently passed as the destination argument to memcpy() in NAL_unit::set_data(). Although the copy length is zero, this violates the nonnull requirement of memcpy() and results in undefined behavior, causing process termination in UBSan-instrumented builds and denial of service."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-09-24T16:35:04.592Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"225dde344c3c42f32eb592d0b4a3697c270c180c4a7d7c35d7d11c5c914c246e","data_version":"5.2","first_seen_at":"2026-09-24T17:11:48Z","kind":"advisory","last_material_event_at":"2026-09-24T17:11:48Z","native_id":"CVE-2026-88373","provenance":[{"revision":"70c2ef40ba53e74b5d1ef77e4008542f2f190e8b","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-88373"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-24T00:00:00Z","record_encoding":{"expanded_bytes":3007,"expanded_sha256":"b783c565ae8ebb354829d955f19c865cd89a19107859954078fb3825923608e8","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-88373","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-24T16:35:04.592Z","orgId":"8254265b
{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-88376"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Bento4 1.6.0.0 contains an integer underflow vulnerability in AP4_AvccAtom::Create() and AP4_HvccAtom::Create(). A specially crafted MP4 file containing an avcC or hvcC atom with a declared size smaller than the atom header size can cause the payload-size calculation to wrap to a large unsigned value. The resulting invalid buffer allocation and copy operations can cause application termination, leading to denial of service."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-09-24T16:28:45.998Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"abcbecaea39b9fee95e637df81e3cec149f3d3430f9b0f42c65d328a4a68816e","data_version":"5.2","first_seen_at":"2026-09-24T17:11:48Z","kind":"advisory","last_material_event_at":"2026-09-24T17:11:48Z","native_id":"CVE-2026-88376","provenance":[{"revision":"70c2ef40ba53e74b5d1ef77e4008542f2f190e8b","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-88376"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-24T00:00:00Z","record_encoding":{"expanded_bytes":2608,"expanded_sha256":"329e0c1b241db4f94dc3fed431465139df2e144b8f388f3aea3f05fb1f200ea8","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-88376","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-24T16:28:45.998Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"url":"https://github.com/axiom
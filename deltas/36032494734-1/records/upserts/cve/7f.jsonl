{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-88367"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"NanoSVG 239e102ec contains an incorrect numeric conversion vulnerability in nsvg__curveDivs() during SVG stroke rasterization. A specially crafted SVG document containing an extremely large stroke-width can cause floating-point rounding to produce a zero subdivision angle. The subsequent arc division yields infinity, which is converted to int without range validation, resulting in undefined behavior and process termination, leading to denial of service."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-09-24T16:04:43.818Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"13d0105042b384f154732a9cb6606dc75eb9a14b68cdb24ee1bc610aea4f6223","data_version":"5.2","first_seen_at":"2026-09-24T17:11:48Z","kind":"advisory","last_material_event_at":"2026-09-24T17:11:48Z","native_id":"CVE-2026-88367","provenance":[{"revision":"70c2ef40ba53e74b5d1ef77e4008542f2f190e8b","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-88367"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-24T00:00:00Z","record_encoding":{"expanded_bytes":2660,"expanded_sha256":"a41b01beeebabc1beee9e746d770c246ca7caac023a61e89310572c9eeb5b07a","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-88367","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-24T16:04:43.818Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"
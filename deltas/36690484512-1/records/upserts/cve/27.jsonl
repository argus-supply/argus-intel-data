{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"11.9.0","status":"affected","version":"0","versionType":"semver"}],"product":"Content Egg","vendor":"Unknown"}],"aliases":["CVE-2026-92424"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Content Egg  WordPress plugin before 11.9.0 does not verify that a user running its bulk content-import feature is authorized for the import preset they select, and switches to the preset author's identity before creating the resulting post, allowing users with contributor-level access and above to store arbitrary web scripts unfiltered under a privileged user's account, executing in the context of anyone who later views that content."}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Cross-Site Scripting (XSS)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-30T06:00:25.073Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Content Egg < 11.9.0 - Contributor+ Stored XSS via Import Queue"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"e275d14ca5c9cdffc6ae928d1b55b6c5b92a0b3716e45cd18722ca8f3408cb5a","data_version":"5.2","first_seen_at":"2026-09-30T08:34:48Z","kind":"advisory","last_material_event_at":"2026-09-30T08:34:48Z","native_id":"CVE-2026-92424","provenance":[{"revision":"f4346f520e9377aba97f9ce9dc5f39fbd539157e","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-92424"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-30T06:00:25Z","record_encoding":{"expanded_bytes":2946,"expanded_sha256":"5d7f0a7fef8a985ab4603739ca5a405d07ea6b67154fd549bb86684fdcde0b20","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2
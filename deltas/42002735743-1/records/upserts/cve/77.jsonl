{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"5.3.3","status":"affected","version":"0","versionType":"semver"}],"product":"Dokan: AI Powered WooCommerce Multivendor Marketplace Solution","vendor":"Unknown"}],"aliases":["CVE-2026-107774"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Dokan: AI Powered WooCommerce Multivendor Marketplace Solution  WordPress plugin before 5.3.3 does not use a trusted site-owned sender address when relaying its store contact form, instead placing the unauthenticated submitter's supplied address directly in the message's From header rather than a Reply-To, allowing unauthenticated attackers to make the site email its own vendors with the sender spoofed to an address at the site's own domain (such as its administrator), aligned with the domain's own SPF/DKIM."}],"problemTypes":[{"descriptions":[{"description":"CWE-290 Authentication Bypass by Spoofing","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-05T06:00:29.218Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Dokan < 5.3.3 - Unauthenticated Email Sender Spoofing via Store Contact Form"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"863c3adb51df97335af09c1fa76f2c7ee3cbfc348108eb2e754f92f3b528cabf","data_version":"5.2","first_seen_at":"2026-11-05T09:29:59Z","kind":"advisory","last_material_event_at":"2026-11-05T09:29:59Z","native_id":"CVE-2026-107774","provenance":[{"revision":"ccd9ea4bc338ef2631b7a8da2eef7d8edca0ae31","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-107774"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-05T06:00:29Z","record_encoding":{"expanded_bytes":3184,"expanded_sha256":"de1e004236e0f2a920dd9621c2a41b911c43ce9194ce5418dfe91cd
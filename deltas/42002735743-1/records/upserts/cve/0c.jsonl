{"affected":[{"defaultStatus":"unaffected","modules":["middlewared"],"original_ranges":[{"lessThan":"25.10.8","status":"affected","version":"0","versionType":"custom"}],"product":"TrueNAS SCALE","repo":"https://github.com/truenas/middleware","vendor":"iXsystems"}],"aliases":["CVE-2026-123033"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Authentication bypass in the HA heartbeat origin check in middlewared in TrueNAS SCALE before 25.10.8 (and in release trains before their respective fixes) allows an attacker on the same network segment to achieve unauthenticated full-administrator API access and execute commands as root. middlewared registers the HA peer-authentication hook (ha_permission) unconditionally, with no failover-licence or heartbeat-interface check. An unauthenticated connection whose TCP peer address is a hardcoded HA heartbeat address (169.254.10.1 or 169.254.10.2) and whose peer port is <= 1024 is granted a node credential that is authorized for every API method and treated as full administrator. Both conditions are properties of the attacker's own socket, and thus an attacker on the same layer-2 segment satisfies them without forging anything. The hook is present on non-HA, unlicensed, single-node Community Edition installations. The fix additionally requires that the connection terminate on the HA heartbeat listener (a local address/port the attacker cannot control)."}],"metrics":[{"cvssV3_1":{"attackComplexity":"HIGH","attackVector":"ADJACENT_NETWORK","availabilityImpact":"HIGH","baseScore":8.3,"baseSeverity":"HIGH","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"NONE","scope":"CHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:A/AC:H/PR:N/UI:N/S:C/C:H/I:H/A:H","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-290","description":"CWE-290 Authentication Bypass by Spoofing","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-05T06:58:31.785Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"051fdb7399d134e72c751dfc5b2e289c4465b38373b3dc7a848c52d686eea743","data_version":"5.2","first_seen_at":"2026-11-05T09:29:59Z","kind":"advisory","last_material_event_at":"2026-11-05T09:29:59Z","native_id":"CVE-2026-123033","provenance":[{"revision":"ccd9ea4bc338ef2631b7a8da2eef7d8edca0ae31","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-123033"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-05T06:58:31Z","record_encoding":{"expanded_bytes":4544,"expanded_sha256":"709bb0f10f3ca9bcb483d08e04f62e41af15aa3fa06953a6f58748e371acfb9a","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-123033","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-05T06:58:31.785Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"url":"https://security.truenas.com/scale/impact-statements/ha-node-auth-bypass/"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-11-05T06:58:31Z","status":"active","title":"CVE-2026-123033"}

{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"8.9.1","status":"affected","version":"8.7.4","versionType":"semver"}],"product":"EWWW Image Optimizer","vendor":"Unknown"}],"aliases":["CVE-2026-91049"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The EWWW Image Optimizer WordPress plugin before 8.9.1 does not properly sanitize and restrict a value in post content before using it to dynamically load and execute a script in the page, allowing authenticated attackers with author-level access and above to inject arbitrary web scripts that run in the session of any user who views the affected page, including administrators.\n\nThis is an incomplete fix of CVE-2026-15446: the origin and path restrictions added from 8.7.4 onward were each bypassable, so versions 8.7.4 through 8.9.0 remain affected."}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Cross-Site Scripting (XSS)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-05T06:00:27.687Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"EWWW Image Optimizer 8.7.4 - 8.9.0 - Author+ Stored XSS via 'data-script' Lazy Load Attribute"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"8a57aede034536d83020935209733bfa8470cc48d8cad768157f146e51083396","data_version":"5.2","first_seen_at":"2026-11-05T09:29:59Z","kind":"advisory","last_material_event_at":"2026-11-05T09:29:59Z","native_id":"CVE-2026-91049","provenance":[{"revision":"ccd9ea4bc338ef2631b7a8da2eef7d8edca0ae31","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-91049"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-05T06:00:27Z","record_encoding":{"expanded_bytes":3244,"expanded_sha256":"e16ce5789888991cb10c9e4c6f82b5bcdea760c6fe9414798
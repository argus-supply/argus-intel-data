{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"8.2.0"}],"product":"Foglight for Databases","vendor":"Quest"}],"aliases":["CVE-2026-92197"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-03T21:56:44.270Z","descriptions":[{"lang":"en","value":"Quest Foglight for Databases unzipFile Directory Traversal Remote Code Execution Vulnerability. This vulnerability allows remote attackers to execute arbitrary code on affected installations of Quest Foglight for Databases. Authentication is required to exploit this vulnerability.\n\nThe specific flaw exists within the unzipFile method. The issue results from the lack of proper validation of a user-supplied path prior to using it in file operations. An attacker can leverage this vulnerability to execute code in the context of SYSTEM. Was ZDI-CAN-29901."}],"metrics":[{"cvssV3_0":{"baseScore":8.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-22","description":"CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-03T23:51:23.789Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"Quest Foglight for Databases unzipFile Directory Traversal Remote Code Execution Vulnerability"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-92197","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-11-06T18:59:54.971417Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-11-06T19:00:08.709Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protoco
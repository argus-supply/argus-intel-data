{"affected":[{"original_ranges":[{"status":"affected","version":">= 1.25.2, < 1.25.4"}],"product":"ddev","vendor":"ddev"}],"aliases":["CVE-2026-108262"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"DDEV is an open-source tool for running local web development environments for PHP and Node.js. From 1.25.2 until 1.25.4, Untar in pkg/archive/archive.go validates an absolute tar symlink target after rebasing it beneath dest, but creates the symlink with the raw absolute Linkname. A crafted archive can therefore plant a host-absolute symlink and use a following regular-file entry to write outside the extraction directory. The flaw is reachable through remote add-on retrieval and database or file imports, and overwriting shell startup files, Git hooks, or cron entries can lead to code execution in the DDEV user's context. Unzip is not affected. This issue is fixed in version 1.25.4."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":6.5,"baseSeverity":"MEDIUM","confidentialityImpact":"NONE","integrityImpact":"HIGH","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"REQUIRED","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:U/C:N/I:H/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-22","description":"CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')","lang":"en","type":"CWE"}]},{"descriptions":[{"cweId":"CWE-59","description":"CWE-59: Improper Link Resolution Before File Access ('Link Following')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-06T18:29:49.225Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"DDEV incomplete tar symlink traversal fix allows host file overwrite - Incomplete fix of CVE-2026-32885"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"c197fe0ba98a4e2804a8a368ab2d21615cc056f71f534d2a2086d834dc6bad21","data_version":"5.2","first_seen_at":"2026-11-06T21:30:03Z","kind":"advisory","last_material_event_at":"2026-11-06T21:30:03Z","native_id":"CVE-2026-108262","provenance":[{"revision":"2dc2e60416b3ae8e8ea52b3310133156a18be29e","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-108262"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-06T18:29:49Z","record_encoding":{"expanded_bytes":4100,"expanded_sha256":"137a8ecd0741f106a8a0dbbbb2c04ea38595d2bc93f2c420935c282f7f8fd873","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-108262","references":[{"assertion_role":"cna","name":"https://github.com/ddev/ddev/security/advisories/GHSA-9hq4-hm3j-jmph","provider":{"dateUpdated":"2026-11-06T18:29:49.225Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"tags":["x_refsource_CONFIRM"],"url":"https://github.com/ddev/ddev/security/advisories/GHSA-9hq4-hm3j-jmph"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-11-06T18:29:49Z","status":"active","title":"DDEV incomplete tar symlink traversal fix allows host file overwrite - Incomplete fix of CVE-2026-32885"}

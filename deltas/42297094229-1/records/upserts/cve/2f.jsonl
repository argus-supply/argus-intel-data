{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"0.34.1","status":"affected","version":"0","versionType":"semver"}],"product":"BuildKit","repo":"https://github.com/moby/buildkit","vendor":"Moby"}],"aliases":["CVE-2026-121520"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"In BuildKit versions prior to v0.34.1, a malicious client with access to the BuildKit control APIs can submit a build request that sets an extended attribute on a file outside the BuildKit state directory. Extended attributes in the trusted. or security. namespaces may also be set, potentially giving a program on the host elevated privileges. This issue affects build services that accept build requests from untrusted users. The issue is fixed in v0.34.1."}],"metrics":[{"cvssV4_0":{"baseScore":4.5,"baseSeverity":"MEDIUM","vectorString":"CVSS:4.0/AV:L/AC:L/AT:P/PR:H/UI:N/VC:N/VI:N/VA:N/SC:N/SI:H/SA:H","version":"4.0"},"format":"CVSS","scenarios":[{"lang":"en","value":"Host security-label modification"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-61","description":"CWE-61: UNIX Symbolic Link (Symlink) Following","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-03T22:11:57.202Z","orgId":"686469e6-3ff6-451b-ab8b-cf5b9e89401e","shortName":"Docker"},"role":"cna","title":"Malicious client could set xattr value outside of BuildKit state directory"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-121520","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-11-06T19:30:46.298631Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-11-06T19:31:00.151Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"re
{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"10.59"}],"product":"MailEnable","vendor":"MailEnable"}],"aliases":["CVE-2026-114551"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-27T20:36:55.300Z","descriptions":[{"lang":"en","value":"MailEnable Auth Cleartext Storage Information Disclosure Vulnerability. This vulnerability allows remote attackers to disclose sensitive information on affected installations of MailEnable. Authentication is not required to exploit this vulnerability.\n\nThe specific flaw exists within the handling of mailbox credentials. The issue results from storing sensitive information in plaintext. An attacker can leverage this in conjunction with other vulnerabilities to disclose stored credentials, leading to further compromise. Was ZDI-CAN-34478."}],"metrics":[{"cvssV3_0":{"baseScore":5.9,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.0/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:N/A:N","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-312","description":"CWE-312: Cleartext Storage of Sensitive Information","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-03T23:47:41.100Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"MailEnable Auth Cleartext Storage Information Disclosure Vulnerability"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-114551","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-11-06T18:56:00.847788Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-11-06T18:56:12.480Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content
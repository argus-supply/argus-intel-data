{"affected":[{"original_ranges":[{"status":"affected","version":"6.2.4_6.2.5_0.614.0"}],"product":"FrodoBots EarthRover Mini+ firmware","vendor":"FrodoBots"}],"aliases":["CVE-2026-121686"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"FrodoBots EarthRover Mini+ firmware (version 6.2.4_6.2.5_0.614.0) is vulnerable to unauthenticated, remote code execution via MQTT. A firmware method accepts arbitrary shell commands delivered via Amazon Web Services Internet of Things Message Queuing Telemetry Transport (AWS IoT MQTT) messages and executes them as root. Access is gated only by shared Internet of Things (IoT) credentials, with no per‑device authentication, enabling remote code execution as root across the fleet."}],"problemTypes":[{"descriptions":[{"description":"CWE-78 Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-09T16:24:04.920Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"role":"cna","title":"CVE-2026-121686"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"e65a8d48e9032e278449055dd4774aac63f006b07de4eb93101541f326db185c","data_version":"5.2","first_seen_at":"2026-11-09T20:44:04Z","kind":"advisory","last_material_event_at":"2026-11-09T20:44:04Z","native_id":"CVE-2026-121686","provenance":[{"revision":"1043b7c6fc84a2e11e5ae43eed5cbc7b24593ac0","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-121686"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-09T16:24:04Z","record_encoding":{"expanded_bytes":3241,"expanded_sha256":"d3986cd980df4272a7d70c69b4ad330236df8d6423404a4f50ec26a1d6f392a8","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"re
{"affected":[{"original_ranges":[{"status":"affected","version":"6.2.4_6.2.5_0.614.0"}],"product":"FrodoBots EarthRover Mini+ firmware","vendor":"FrodoBots"}],"aliases":["CVE-2026-121688"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"FrodoBots EarthRover Mini+ firmware (version 6.2.4_6.2.5_0.614.0) contains an insecure STM32 firmware update mechanism. The STM32 motor‑controller firmware is fetched over unencrypted HTTP. Integrity is validated only via MD5, with the hash provided in the same unprotected response. No code‑signing mechanism is implemented, allowing firmware to be replaced with potentially malicious code."}],"problemTypes":[{"descriptions":[{"description":"CWE-494 Download of Code Without Integrity Check","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-09T16:25:50.773Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"role":"cna","title":"CVE-2026-121688"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"189a250b885a6920d1991a9d6b0836b103ca6cd8b0c5053d599bde34f3257fd6","data_version":"5.2","first_seen_at":"2026-11-09T20:44:04Z","kind":"advisory","last_material_event_at":"2026-11-09T20:44:04Z","native_id":"CVE-2026-121688","provenance":[{"revision":"1043b7c6fc84a2e11e5ae43eed5cbc7b24593ac0","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-121688"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-09T16:25:50Z","record_encoding":{"expanded_bytes":3012,"expanded_sha256":"807f37fdbba0764bacb58c7d5d78914e2f02564999b5e7593f6c609d2868b341","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-121688","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-09T16:25:50.773Z","orgId":"37e5125f-f
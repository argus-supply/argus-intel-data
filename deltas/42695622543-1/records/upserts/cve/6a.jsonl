{"affected":[{"original_ranges":[{"lessThanOrEqual":"2.1.1","status":"affected","version":"2.0.7","versionType":"custom"}],"product":"Voyager","vendor":"Spotify"},{"original_ranges":[{"lessThanOrEqual":"0.9.0","status":"affected","version":"0.5.0","versionType":"custom"}],"product":"hnswlib","vendor":"hnswlib"}],"aliases":["CVE-2026-124959"],"assertions":[{"affected_indices":[0,1],"descriptions":[{"lang":"en","value":"The loadIndex function in nmslib hnswlib and Spotify Voyager does not verify that the element count in a serialized HNSW index is within the stored capacity used to allocate the heap buffer. An attacker can supply a crafted index file with an element count greater than the stored capacity, causing the loader to write beyond the allocated buffer and potentially crash the application when it loads the file."}],"problemTypes":[{"descriptions":[{"description":"CWE-787 Out-of-bounds Write","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-09T15:04:38.649Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"role":"cna","title":"Nmaslib Hnswlib and Spotify Voyager HNSW Index Deserialization Heap Out-of-Bounds Write"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"a67404be0045eb25c53c4c86918462b0b9b3e52068d3e8537d8e59267e9fcd23","data_version":"5.2","first_seen_at":"2026-11-09T20:44:04Z","kind":"advisory","last_material_event_at":"2026-11-09T20:44:04Z","native_id":"CVE-2026-124959","provenance":[{"revision":"1043b7c6fc84a2e11e5ae43eed5cbc7b24593ac0","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-124959"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-09T15:04:38Z","record_encoding":{"expanded_bytes":3463,"expanded_sha256":"5a8559671c3d26bc974604e0830ea48d258ede1501d783fb54b448530fffd99e","format":"cve-indexed-assertions-v1
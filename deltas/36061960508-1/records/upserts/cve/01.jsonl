{"affected":[{"original_ranges":[{"status":"affected","version":"< 0.22.6"}],"product":"dbhub","vendor":"bytebase"}],"aliases":["CVE-2026-61788"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"DBHub is a database MCP server for Postgres, MySQL, SQL Server, Oracle, MariaDB, SQLite. Prior to version 0.22.6, setting `readonly = true` on the `execute_sql` tool does not make the connection read-only. The connectors are written to set PostgreSQL `default_transaction_read_only=on` (and open SQLite in `readOnly` mode), but that code is gated on a config value that is never populated, so it never runs. The only thing left enforcing read-only is a classifier that inspects the first keyword of each statement. Any `SELECT` that writes or has side effects through a function call passes it. With an ordinary role this allows sequence tampering; with a privileged role it allows writing arbitrary files on the server (`lo_export`), reading arbitrary host files (`pg_read_file`), and remote code execution (`dblink` + `COPY ... TO PROGRAM`). The HTTP transport is unauthenticated and binds to `0.0.0.0` by default, so this is reachable by any network caller of `/mcp`. Version 0.22.6 patches the issue."}],"metrics":[{"cvssV3_1":{"attackComplexity":"HIGH","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":7.4,"baseSeverity":"HIGH","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-184","description":"CWE-184: Incomplete List of Disallowed Inputs","lang":"en","type":"CWE"}]},{"descriptions":[{"cweId":"CWE-636","description":"CWE-636: Not Failing Securely ('Failing Open')","lang":"en","type":"CWE"}]},{"descriptions":[{"cweId":"CWE-863","description":"CWE-863: Incorrect Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-24T17:37:40.409Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"@bytebase/dbhub's read-only mode does not prevent database writes"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"fd3310599d52006be5c90ea49272345d0bb6250d5ecbde5268dc961ee23edb35","data_version":"5.2","first_seen_at":"2026-09-24T21:31:54Z","kind":"advisory","last_material_event_at":"2026-09-24T21:31:54Z","native_id":"CVE-2026-61788","provenance":[{"revision":"92e97eac00453e5e99773913e8a0da5aefded2f6","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-61788"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-24T17:37:40Z","record_encoding":{"expanded_bytes":4695,"expanded_sha256":"913c14b01f3f928c8aeb9d70a537a4c23dad4bc78aac7d24207718871073ff59","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-61788","references":[{"assertion_role":"cna","name":"https://github.com/bytebase/dbhub/security/advisories/GHSA-mwwr-p57h-56pf","provider":{"dateUpdated":"2026-09-24T17:37:40.409Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"tags":["x_refsource_CONFIRM"],"url":"https://github.com/bytebase/dbhub/security/advisories/GHSA-mwwr-p57h-56pf"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-09-24T17:37:40Z","status":"active","title":"@bytebase/dbhub's read-only mode does not prevent database writes"}

{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-88388"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Espruino 2v29 (commit bffc6d0) contains a stack-based buffer overflow vulnerability in the JavaScript error stack-trace handling path on 64-bit builds. A remote attacker can supply JavaScript input that triggers an exception and reaches jslPrintTokenLineMarker(), which passes the address of a 4-byte int column variable to jsvGetLineAndCol() as a size_t pointer. jsvGetLineAndCol() performs an 8-byte write through the mismatched pointer, overwriting adjacent stack memory."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-09-24T20:42:22.561Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"d7b01e8eb726c1b38580eaa428c5e96ecec4952d35df0673d32356afee1ef70b","data_version":"5.2","first_seen_at":"2026-09-24T21:31:54Z","kind":"advisory","last_material_event_at":"2026-09-24T21:31:54Z","native_id":"CVE-2026-88388","provenance":[{"revision":"92e97eac00453e5e99773913e8a0da5aefded2f6","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-88388"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-24T00:00:00Z","record_encoding":{"expanded_bytes":2731,"expanded_sha256":"8c3884ed178e4eb6b956a83a7883b7e135a6d925479152e71264f06e6a0dd378","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-88388","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-24T20:42:22.561Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shor
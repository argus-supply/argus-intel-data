{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-88387"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"LibRaw 0.22.0 contains an incorrect numeric conversion vulnerability in LibRaw::parse_tiff_ifd() when processing TIFF tag 0x00fe (NewSubfileType). A specially crafted RAW, TIFF, or DNG file can supply an attacker-controlled NewSubfileType value outside the range of a signed int. The parser converts this value and narrows it to int without performing range validation. This out-of-range conversion triggers undefined behavior, resulting in process termination and denial of service."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-09-24T20:39:09.998Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"c82f4bb508cdec3732070e4e0e353b0e5ba1f106dd7d6af4df8390640f1c6d2e","data_version":"5.2","first_seen_at":"2026-09-24T21:31:54Z","kind":"advisory","last_material_event_at":"2026-09-24T21:31:54Z","native_id":"CVE-2026-88387","provenance":[{"revision":"92e97eac00453e5e99773913e8a0da5aefded2f6","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-88387"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-24T00:00:00Z","record_encoding":{"expanded_bytes":3139,"expanded_sha256":"69fc23319e646c01dbb381c759b92a3ab3ee2a2d45ff597544c728016c681962","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-88387","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-24T20:39:09.998Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bf
{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"14.0.2.4"}],"product":"NetVault Backup","vendor":"Quest"}],"aliases":["CVE-2026-13270"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-06T22:17:13.546Z","descriptions":[{"lang":"en","value":"Quest NetVault Backup nvpmgr Integer Underflow Denial-of-Service Vulnerability. This vulnerability allows remote attackers to create a denial-of-service condition on affected installations of Quest NetVault Backup. Authentication is not required to exploit this vulnerability.\n\nThe specific flaw exists within the nvpmgr service, which listens on UDP port 20031 by default. The issue results from the lack of proper validation of user-supplied data, which can result in an integer underflow before allocating a buffer. An attacker can leverage this vulnerability to create a denial-of-service condition on the system. Was ZDI-CAN-28744."}],"metrics":[{"cvssV3_0":{"baseScore":7.5,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-191","description":"CWE-191: Integer Underflow (Wrap or Wraparound)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-12T02:49:34.234Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"Quest NetVault Backup nvpmgr Integer Underflow Denial-of-Service Vulnerability"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-13270","options":[{"Exploitation":"none"},{"Automatable":"yes"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-11-16T20:15:57.351664Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-11-16T20:16:11.690Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configura
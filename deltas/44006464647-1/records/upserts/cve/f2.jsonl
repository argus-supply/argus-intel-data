{"affected":[{"defaultStatus":"affected","original_ranges":[{"lessThan":"2026.03","status":"affected","version":"0","versionType":"custom"}],"product":"chyrp-lite","vendor":"xenocrat"}],"aliases":["CVE-2026-130206"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-16T00:00:00.000Z","descriptions":[{"lang":"en","value":"Chyrp Lite (xenocrat/chyrp-lite) contains a missing brute-force protection vulnerability in the main_login() function that allows remote attackers to repeatedly submit login attempts against the admin account without any attempt counter, lockout, delay, or CAPTCHA enforcement. Attackers can send unlimited password guesses via POST requests to the login action until a correct credential is found, gaining full administrative control including post publishing, user management, and file uploads."}],"metrics":[{"cvssV3_1":{"attackComplexity":"HIGH","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":5.9,"baseSeverity":"MEDIUM","confidentialityImpact":"HIGH","integrityImpact":"NONE","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:N/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-307","description":"Improper Restriction of Excessive Authentication Attempts","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-16T21:43:27.707Z","orgId":"83251b91-4cc7-4094-a5c7-464a1b83ea10","shortName":"VulnCheck"},"role":"cna","title":"Chyrp Lite Admin Login Brute-Force via main_login()"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"bf046e3f3d1a693146587d69c6193e39eb7edf33ef9ad39bef9bfc02f9253ee7","data_version":"5.2","first_seen_at":"2026-11-17T02:56:05Z","kind":"advisory","last_material_event_at":"2026-11-17T02:56:05Z","n
{"affected":[{"defaultStatus":"unaffected","modules":["RXAPI"],"original_ranges":[{"lessThan":"5.2.0","status":"affected","version":"4.0.0","versionType":"semver"}],"product":"ooRexx","programFiles":["rexxapi/server/QueueManager.cpp"],"programRoutines":[{"name":"void DataQueue::add(ServiceMessage &message)"}],"repo":"https://sourceforge.net/projects/oorexx/","vendor":"Open Object Rexx"}],"aliases":["CVE-2026-130290"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"In Open Object Rexx (ooRexx) before 5.2.0, RXAPI has a heap buffer over-read in a QueueManager DataQueue::addmethod. In particular, the code blindly trusts the message.parameter1 value provided by the client as the size used to fill the data from the queueData heap buffer. An attacker sends a large parameter1 value in an ADD_TO_SESSION_QUEUE or ADD_TO_NAMED_QUEUE message and then retrieves data with a PULL_FROM_SESSION_QUEUE message. (A very large value causes a process crash.)"}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"LOCAL","availabilityImpact":"LOW","baseScore":7.9,"baseSeverity":"HIGH","confidentialityImpact":"HIGH","integrityImpact":"NONE","privilegesRequired":"NONE","scope":"CHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:L/AC:L/PR:N/UI:N/S:C/C:H/I:N/A:L","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-130","description":"CWE-130 Improper Handling of Length Parameter Inconsistency","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-16T22:12:44.296Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"9443624a202f07250f0dd94e2d5e7c129f7ea813d4b94dd716de2a44edcf0799","data_version":"5.2","first_seen_at":"2026-11-17T
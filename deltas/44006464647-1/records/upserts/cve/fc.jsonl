{"affected":[{"original_ranges":[{"status":"affected","version":"ECFM32.2"}],"product":"Phison E12","vendor":"Phison Electronics"}],"aliases":["CVE-2026-129190"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A vulnerability in the Phison SSD controller firmware Phison E12; ECFM32.2 allows a local attacker with administrative privileges to bypass the \"Security Access\" handshake by leveraging leaked RSA parameters found in vendor utility binaries. By successfully completing the authentication, an attacker can access vendor-specific commands that permit arbitrary memory read and write operations. Because the firmware's code regions lack protection, these primitives can be used to overwrite existing handlers and achieve volatile code execution on the SSD controller."}],"problemTypes":[{"descriptions":[{"description":"CWE-287 Improper Authentication","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-16T21:35:51.056Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"role":"cna","title":"CVE-2026-129190"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"db853cc8a1a6c10f940a1c97baa0a005558452a30a03d6f1bc2ec4484668dc14","data_version":"5.2","first_seen_at":"2026-11-17T02:56:05Z","kind":"advisory","last_material_event_at":"2026-11-17T02:56:05Z","native_id":"CVE-2026-129190","provenance":[{"revision":"5d5a4e4fdee065291aacfec49e4356f868b3ba0f","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-129190"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-16T21:35:51Z","record_encoding":{"expanded_bytes":2946,"expanded_sha256":"23b1109e4011f92dbbb92e0c4b00068642fb361d4703f1118d63a8c287191348","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"
{"affected":[{"original_ranges":[{"status":"affected","version":"EIFK51.2"}],"product":"Phison E18","vendor":"Phison Electronics"},{"original_ranges":[{"status":"affected","version":"EIFM80.0"}],"product":"Phison E18","vendor":"Phison Electronics"}],"aliases":["CVE-2026-126828"],"assertions":[{"affected_indices":[0,1],"descriptions":[{"lang":"en","value":"A vulnerability in Phison SSD controller firmwares (Phison E18; EIFM80.0, Phison E18; EIFK51.2) allows a local attacker with administrative privileges to bypass the \"Security Access\" handshake by leveraging leaked RSA parameters found in vendor utility binaries. By successfully completing the authentication, an attacker can access vendor-specific commands that permit arbitrary memory read and write operations. Because the firmware's code regions lack protection, these primitives can be used to overwrite existing handlers and achieve volatile code execution on the SSD controller."}],"problemTypes":[{"descriptions":[{"description":"CWE-287 Improper Authentication","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-16T21:35:58.495Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"role":"cna","title":"CVE-2026-126828"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"b1968e76b4caa7341ba3a759421875f8ce007f9d5cb83385f01896820294f0da","data_version":"5.2","first_seen_at":"2026-11-17T02:56:05Z","kind":"advisory","last_material_event_at":"2026-11-17T02:56:05Z","native_id":"CVE-2026-126828","provenance":[{"revision":"5d5a4e4fdee065291aacfec49e4356f868b3ba0f","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-126828"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-16T21:35:40Z","record_encoding":{"expanded_bytes":3212,"expanded_sha256":"04988db9e0ec54642bf5a7d5523610fd19beb00d7e748b8655a4bc
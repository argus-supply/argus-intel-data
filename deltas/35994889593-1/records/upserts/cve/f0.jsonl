{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"7.0.10","status":"affected","version":"0","versionType":"semver"}],"product":"YOP Poll","vendor":"yourownprogrammer"}],"aliases":["CVE-2026-85682"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The YOP Poll plugin for WordPress is vulnerable to Origin Validation Error in all versions up to, and including, 7.0.10. This is due to the plugin transmitting a wp_rest nonce to window.opener via postMessage() with a wildcard targetOrigin. This makes it possible for unauthenticated attackers to steal a REST nonce scoped to a logged-in Administrator and use it to change the Administrator's email address and password, resulting in full account takeover. The Administrator must open an attacker-controlled page in order to exploit this vulnerability."}],"metrics":[{"cvssV3_1":{"baseScore":8.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-346","description":"CWE-346 Origin Validation Error","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-24T08:27:32.067Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"YOP Poll <= 7.0.10 - Unauthenticated Origin Validation Error to Administrator Account Takeover via '/auth/wp-login-redirect' REST Route"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"b5e4cab8e98bb5f89a8be04d4e5d3913f0329f0429bc91fbbbcfbf6bbcdbe835","data_version":"5.2","first_seen_at":"2026-09-24T11:46:39Z","kind":"advisory","last_material_event_at":"2026-09-24T11:46:39Z","native_id":"CVE-2026-85682","provenance":[{"revision":"4957d0288de7478ca75410dabacd262755ce9982","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-85682"},{"assertion_i
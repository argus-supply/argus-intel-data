{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"6.0.8","status":"affected","version":"0","versionType":"semver"}],"product":"Adserver","vendor":"Revive"}],"aliases":["CVE-2026-108565"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A reflected cross-site scripting vulnerability in the popup invocation options of Revive Adserver 6.0.8 and earlier allows an unauthenticated attacker to execute JavaScript in an authenticated user's browser by persuading them to visit a crafted URL. The top, left, timeout and delay request parameters are included in HTML attributes without appropriate encoding. Exploitation requires an existing popup zone, which can be created through the administrator API but is not offered by the normal zone-creation interface. The issue is fixed in Revive Adserver 6.0.9 by HTML-encoding the affected popup option values."}],"metrics":[{"cvssV3_0":{"baseScore":4.7,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.0/AV:N/AC:H/PR:N/UI:R/S:C/C:L/I:L/A:N","version":"3.0"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-79","description":"CWE-79 Cross-site Scripting (XSS) - Reflected","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-11T17:30:37.731Z","orgId":"36234546-b8fa-4601-9d6f-f4e334aa8ea1","shortName":"hackerone"},"role":"cna"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-108565","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-11-17T14:20:31.118678Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-11-17T14:20:41.979Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"94f68b6a47fc72a13c
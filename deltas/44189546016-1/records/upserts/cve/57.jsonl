{"affected":[{"original_ranges":[{"status":"affected","version":"EIFK51.2"}],"product":"Phison E18","vendor":"Phison Electronics"},{"original_ranges":[{"status":"affected","version":"EIFM80.0"}],"product":"Phison E18","vendor":"Phison Electronics"}],"aliases":["CVE-2026-126828"],"assertions":[{"affected_indices":[0,1],"descriptions":[{"lang":"en","value":"A vulnerability in Phison SSD controller firmwares (Phison E18; EIFM80.0, Phison E18; EIFK51.2) allows a local attacker with administrative privileges to bypass the \"Security Access\" handshake by leveraging leaked RSA parameters found in vendor utility binaries. By successfully completing the authentication, an attacker can access vendor-specific commands that permit arbitrary memory read and write operations. Because the firmware's code regions lack protection, these primitives can be used to overwrite existing handlers and achieve volatile code execution on the SSD controller."}],"problemTypes":[{"descriptions":[{"description":"CWE-287 Improper Authentication","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-16T21:35:58.495Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"role":"cna","title":"CVE-2026-126828"},{"affected_indices":[],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"LOCAL","availabilityImpact":"HIGH","baseScore":6.7,"baseSeverity":"MEDIUM","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"HIGH","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:L/AC:L/PR:H/UI:N/S:U/C:H/I:H/A:H","version":"3.1"}},{"other":{"content":{"id":"CVE-2026-126828","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-11-17T18:17:26.425432Z","version":"2.0.3"},"type":"ssvc"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-287","description":"CWE-287 Improper Authentication","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-17T18:17:33.819Z","or
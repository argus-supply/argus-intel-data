{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["Spreadsheet::XLSX"],"original_ranges":[{"lessThan":"0.19","status":"affected","version":"0","versionType":"custom"}],"packageName":"Spreadsheet-XLSX","packageURL":"pkg:cpan/Spreadsheet-XLSX","programFiles":["lib/Spreadsheet/XLSX/Utility2007.pm"],"programRoutines":[{"name":"Spreadsheet::XLSX::Utility2007::ExcelFmt"}],"repo":"https://github.com/asb-capfan/Spreadsheet-XLSX"}],"aliases":["CVE-2026-115943"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Spreadsheet::XLSX versions before 0.19 for Perl allow code execution via string eval of number format conditions in ExcelFmt.\n\nWhen a number format has a condition such as [>100], ExcelFmt chooses the format section by passing the condition and the cell value to a string eval. Both come from the workbook, and the eval runs while Spreadsheet::XLSX->new parses it.\n\nAn attacker who supplies an XLSX file can run arbitrary Perl code."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-95","description":"CWE-95 Improper Neutralization of Directives in Dynamically Evaluated Code ('Eval Injection')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-29T21:37:40.697Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"Spreadsheet::XLSX versions before 0.19 for Perl allow code execution via string eval of number format conditions in ExcelFmt"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"3f97195771a0394f81ea0913e8671fbfb7adf335703f6201f95b3526c532cf9c","data_version":"5.2","first_seen_at":"2026-10-29T23:57:21Z","kind":"advisory","last_material_event_at":"2026-10-29T23:57:21Z","native_id":"CVE-2026-115943","provenance":[{"revision":"588a645474981b079fd01ee1ef3d296c8dc4d858","source_id":"cve","url":
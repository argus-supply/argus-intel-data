{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.4.1","status":"affected","version":"0","versionType":"semver"}],"product":"Bricks Theme","vendor":"Bricks"}],"aliases":["CVE-2026-119325"],"assertions":[{"affected_indices":[0],"datePublic":"2026-09-22T00:00:00.000Z","descriptions":[{"lang":"en","value":"Bricks Theme 2.4 and before for WordPress contains an unauthenticated broken access control vulnerability in the load_popup_content REST endpoint that allows anonymous attackers to read draft and unpublished page content by supplying a popupId parameter without any status or capability checks. Attackers can obtain a public nonce via the bricks_regenerate_query_nonce action and then increment the popupId value in requests to the /wp-json/bricks/v1/load_popup_content endpoint to enumerate and disclose confidential content from any unpublished post on the site."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":7.5,"baseSeverity":"HIGH","confidentialityImpact":"HIGH","integrityImpact":"NONE","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:N/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-639","description":"Authorization Bypass Through User-Controlled Key","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-29T20:34:52.827Z","orgId":"83251b91-4cc7-4094-a5c7-464a1b83ea10","shortName":"VulnCheck"},"role":"cna","title":"Bricks Theme Broken Access Control via load_popup_content"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"9b582494e3bc1fd96e1ae1e87514bc6b452a18f520928ac187aa4894cd43b585","data_version":"5.2","first_seen_at":"2026-10-29T23:57:21Z","kind"
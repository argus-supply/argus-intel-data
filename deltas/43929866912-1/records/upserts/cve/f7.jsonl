{"affected":[{"original_ranges":[{"lessThan":"15V24","status":"affected","version":"0","versionType":"custom"}],"product":"IndraWorks","vendor":"Bosch Rexroth"},{"original_ranges":[{"lessThan":"v33.0.0.0","status":"affected","version":"0","versionType":"custom"}],"product":"OPC DA Client","vendor":"Bosch Rexroth"}],"aliases":["CVE-2026-102448"],"assertions":[{"affected_indices":[0,1],"descriptions":[{"lang":"en","value":"A vulnerability has been identified in Rexroth IndraWorks. This flaw allows an attacker to execute arbitrary code on the user’s system by parsing a manipulated file, because the file parser fails to properly sanitize the path name(s) or references embedded in the manipulated file. Exploitation requires user interaction, specifically opening a specially crafted file, which then causes the application to traverse outside the target directory and to write files in unauthorized locations, eventually enabling Remote Code Execution (RCE). This can lead to a complete compromise of the system running Rexroth IndraWorks."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"LOCAL","availabilityImpact":"HIGH","baseScore":7.8,"baseSeverity":"HIGH","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"REQUIRED","vectorString":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-22","description":"CWE-22 Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')","lang":"en-US"}]}],"provider":{"dateUpdated":"2026-11-16T09:35:33.627Z","orgId":"c95f66b2-7e7c-41c5-8f09-6f86ec68659c","shortName":"bosch"},"role":"cna"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-102448","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-11-16T13:48:20.368199Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated"
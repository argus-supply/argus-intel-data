{"affected":[{"collectionURL":"https://wordpress.org/plugins","defaultStatus":"unaffected","original_ranges":[{"lessThan":"3.7.5","status":"affected","version":"0","versionType":"semver"}],"product":"Burst Statistics","vendor":"Unknown"}],"aliases":["CVE-2026-124672"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Burst Statistics WordPress plugin before 3.7.5 does not verify that a request is actually being routed to its own REST API before unloading every other active plugin for that request, allowing unauthenticated attackers to have requests processed with other plugins' protections (such as REST access restrictions, hidden login pages and two-factor authentication) switched off, and to cause other plugins' scheduled tasks to be discarded."}],"metrics":[{"cvssV3_1":{"baseScore":7.3,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:L/I:L/A:L","version":"3.1"}}],"problemTypes":[{"descriptions":[{"description":"CWE-20 Improper Input Validation","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-16T08:27:56.682Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Burst Statistics < 3.7.5 - Unauthenticated Plugin Load Suppression via Crafted Request Path"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-124672","options":[{"Exploitation":"none"},{"Automatable":"yes"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-11-16T11:29:08.380691Z","version":"2.0.3"},"type":"ssvc"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-20","description":"CWE-20 Improper Input Validation","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-16T11:40:03.349Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":n
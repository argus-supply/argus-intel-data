{"affected":[{"collectionURL":"https://github.com/ManageIQ/manageiq","defaultStatus":"affected","original_ranges":[{"status":"affected","version":"0","versionType":"custom"}],"packageName":"manageiq","product":"ManageIQ","vendor":"ManageIQ"},{"defaultStatus":"affected","original_ranges":[{"status":"affected","version":"0","versionType":"custom"}],"packageName":"manageiq","product":"Red Hat CloudForms","vendor":"Red Hat"}],"aliases":["CVE-2026-52903"],"assertions":[{"affected_indices":[0,1],"descriptions":[{"lang":"en","value":"A deserialization of untrusted data vulnerability was found in ManageIQ. The YamlLoadAliases module overrides YAML.safe_load to silently fall back to YAML.unsafe_load in production when a Psych::DisallowedClass error occurs. An authenticated attacker with dialog import access can exploit this to achieve remote code execution by uploading a crafted YAML payload that triggers the fallback and deserializes arbitrary Ruby objects.\n\nRed Hat CloudForms, which was based on ManageIQ, has reached End of Life and is no longer supported. No errata or patches will be issued. This CVE is being assigned for the benefit of the ManageIQ community and downstream consumers."}],"metrics":[{"cvssV3_1":{"baseScore":8.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","version":"3.1"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-502","description":"CWE-502: Deserialization of Untrusted Data","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-12T12:16:00.508Z","orgId":"53f830b8-0a3f-465b-8143-3b8a9948e749","shortName":"redhat"},"role":"cna","title":"YAML safe_load production fallback to unsafe_load enables RCE via deserialization"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"73d2f0646865c22cb95735167016f4e7b2ade5f41bc1fc32af26d1034954c672","
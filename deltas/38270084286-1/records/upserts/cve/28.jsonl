{"affected":[{"original_ranges":[{"lessThanOrEqual":"2.6.0","status":"affected","version":"0","versionType":"custom"}],"product":"Thelia","vendor":"Thelia"}],"aliases":["CVE-2026-103528"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Thelia 2.6.0 uses Smarty for email templates without properly restricting access to dangerous PHP functions. An authenticated administrator can inject malicious Smarty expressions into email templates via the messages configuration interface, and when the template is previewed or rendered, functions such as system(), exec(), file_put_contents(), and file_get_contents() can be executed with the privileges of the web process. This allows arbitrary OS command execution, file read/write operations, and RCE on the underlying server."}],"problemTypes":[{"descriptions":[{"description":"CWE-1336 Improper Neutralization of Special Elements Used in a Template Engine","lang":"en"}]}],"provider":{"dateUpdated":"2026-10-12T14:55:14.883Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"role":"cna","title":"CVE-2026-103528"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"8be0935c4ee5c45b2db6bc0e0b0c54493875ff957c27b04c02c9ff62a2e771d0","data_version":"5.2","first_seen_at":"2026-10-12T15:26:04Z","kind":"advisory","last_material_event_at":"2026-10-12T15:26:04Z","native_id":"CVE-2026-103528","provenance":[{"revision":"d0b8b50b94cccf7ccd06e2ae24d1b45695840a9f","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-103528"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-12T14:55:14Z","record_encoding":{"expanded_bytes":2948,"expanded_sha256":"fb22b720f112ffdc926a01b73b6cebf13ec678bac400d426f84746f97cb8c1e6","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-103528","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-12T14:55:14.883Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"url":"https://kb.cert.org/vuls/id/162329"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-12T14:55:14Z","status":"active","title":"CVE-2026-103528"}
{"affected":[{"original_ranges":[{"lessThanOrEqual":"2.6.1","status":"affected","version":"0","versionType":"custom"}],"product":"Thelia","vendor":"Thelia"}],"aliases":["CVE-2026-103537"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Thelia 2.6.1 contains an absolute path traversal vulnerability in its Smarty template handling that enables SSTI and remote code execution. The `checkTemplate()` validation restricts relative directory traversal sequences such as `../` but does not reject absolute paths, allowing an authorized user to supply an arbitrary filesystem path as a template. Smarty then loads and compiles the referenced file without an effective security policy, so depending on filesystem layout and deployment configuration, template code in the file can be executed with the web server's privileges."}],"problemTypes":[{"descriptions":[{"description":"CWE-1336 Improper Neutralization of Special Elements Used in a Template Engine","lang":"en"}]},{"descriptions":[{"description":"CWE-22 Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')","lang":"en"}]}],"provider":{"dateUpdated":"2026-10-12T14:56:21.364Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"role":"cna","title":"CVE-2026-103537"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"ca83de7e8b7aa047376dfc653c59ca51248eed4ff37276c55b0f8e60aff4e760","data_version":"5.2","first_seen_at":"2026-10-12T15:26:04Z","kind":"advisory","last_material_event_at":"2026-10-12T15:26:04Z","native_id":"CVE-2026-103537","provenance":[{"revision":"d0b8b50b94cccf7ccd06e2ae24d1b45695840a9f","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-103537"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-12T14:56:21Z","record_encoding":{"expanded_by
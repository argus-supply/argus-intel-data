{"affected":[{"original_ranges":[{"lessThanOrEqual":"2.6.1","status":"affected","version":"0","versionType":"custom"}],"product":"Thelia","vendor":"Thelia"}],"aliases":["CVE-2026-103535"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Thelia v2.6.1 contains path traversal and PHP code injection vulnerabilities in its translation editor that can be chained to achieve remote code execution. The `item_name` parameter, used to build the translation file's write path, does not sanitize directory traversal sequences such as `../`. This enables an authenticated user with `UPDATE`-level permissions on `admin.configuration.language` to write files outside the expected `templates/` directory, including to web‑accessible paths. Separately, the translation‑writing logic does not escape `\\` in user‑supplied values, allowing inputs to break out of the PHP string literal and inject executable code into the translation file. Chained together, these flaws allow a malicious PHP file to be written to a web-accessible path and executed with the web‑server’s privileges."}],"problemTypes":[{"descriptions":[{"description":"CWE-22 Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')","lang":"en"}]},{"descriptions":[{"description":"CWE-94 Improper Control of Generation of Code ('Code Injection')","lang":"en"}]}],"provider":{"dateUpdated":"2026-10-12T14:55:58.210Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"role":"cna","title":"CVE-2026-103535"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"3d0b3e887f45b16616e2e8a0b3a5afa6d79e5f621dbe2e55b2ed00346d1b5522","data_version":"5.2","first_seen_at":"2026-10-12T15:26:04Z","kind":"advisory","last_material_event_at":"2026-10-12T15:26:04Z","native_id":"CVE-2026-103535","provenance":[{"revision":"d0b8b50b94cccf7ccd06e
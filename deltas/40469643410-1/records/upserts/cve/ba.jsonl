{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"6.2.5","status":"affected","version":"0","versionType":"semver"}],"product":"Kirki – Freeform Page Builder, Website Builder & Customizer","vendor":"themeum"}],"aliases":["CVE-2026-75891"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Kirki plugin for WordPress is vulnerable to Privilege Escalation via PHP Object Injection in all versions up to, and including, 6.2.5 via deserialization of untrusted input through the 'get-single-symbol' branch of the kirki_post_apis() AJAX dispatcher due to a missing capability check. This makes it possible for authenticated attackers, with Subscriber-level access and above, to inject a PHP Object. The additional presence of a POP chain allows attackers to overwrite an administrator's password and gain administrative access."}],"metrics":[{"cvssV3_1":{"baseScore":8.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-502","description":"CWE-502 Deserialization of Untrusted Data","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-27T06:40:42.359Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"Kirki <= 6.2.5 - Authenticated (Subscriber+) PHP Object Injection to Administrator Account Takeover via 'get-single-symbol' AJAX Endpoint"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"4c6b8e0e90c73e5c000ba9c533036e7153427ad5ffea5afa99db7a90e0586a91","data_version":"5.2","first_seen_at":"2026-10-27T07:52:04Z","kind":"advisory","last_material_event_at":"2026-10-27T07:52:04Z","native_id":"CVE-2026-75891","provenance":[{"revision":"aaaa675b0f73a8bcd41e0de81c5ae7d0cd505d08","source_id":"cve","url":"https://www.cve.org/CVEReco
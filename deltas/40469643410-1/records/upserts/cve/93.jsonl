{"affected":[{"defaultStatus":"unknown","original_ranges":[{"lessThanOrEqual":"4.0.1","status":"affected","version":"0","versionType":"semver"}],"product":"Payment Integration Wompi","vendor":"Unknown"}],"aliases":["CVE-2026-103312"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Payment Integration Wompi WordPress plugin through 4.0.1 does not verify the authenticity of incoming payment notifications on a stock install, because the callback's checksum is keyed on a merchant secret that is empty until it is manually configured, allowing an unauthenticated attacker to forge a notification and mark an arbitrary order as paid."}],"problemTypes":[{"descriptions":[{"description":"CWE-287 Improper Authentication","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-27T06:00:20.103Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Payment Integration Wompi <= 4.0.1 - Unauthenticated Payment Confirmation Forgery via IPN Callback"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"9035a502f9b27ff78f31d21203f57495119868fd777a4e8478ac0ed97bfe609d","data_version":"5.2","first_seen_at":"2026-10-27T07:52:04Z","kind":"advisory","last_material_event_at":"2026-10-27T07:52:04Z","native_id":"CVE-2026-103312","provenance":[{"revision":"aaaa675b0f73a8bcd41e0de81c5ae7d0cd505d08","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-103312"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-27T06:00:20Z","record_encoding":{"expanded_bytes":2859,"expanded_sha256":"9233c211dce5e57a6af51f14585b09474eb767660b9f0f6cc5a4d3bdb5846dbb","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-103312","references":[{"asserti
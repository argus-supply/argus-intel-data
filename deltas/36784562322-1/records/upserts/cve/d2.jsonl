{"affected":[{"original_ranges":[{"status":"affected","version":"<= 0.2.247"}],"product":"security","vendor":"Soft-Machine-io"}],"aliases":["CVE-2026-55176"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Soft Machine is a Virtual Machine–based agentic development environment / Cloud OS. In versions 0.2.247 and prior, two authentication helpers in /app/server.js — verifyContainerAuth() and authenticateWorkspaceHttp() — accept the global CONTAINER_SHARED_SECRET as a bearer token without verifying which workspace the caller belongs to. Because that secret is set identically on every container in the Fly app and is reachable from the user-facing process environment inside each workspace, any tenant can use it to authenticate to any other tenant's workspace API. The result is cross-workspace read, write, and destructive-restore primitives reachable from any paying customer's shell. The existing per-workspace token check (workspaceTokenMatches) protects the user-facing per-workspace token path, but the shared-secret bearer path bypasses it entirely. At time of publication, there are no publicly known patches."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"ADJACENT_NETWORK","availabilityImpact":"HIGH","baseScore":9,"baseSeverity":"CRITICAL","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"LOW","scope":"CHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:A/AC:L/PR:L/UI:N/S:C/C:H/I:H/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-863","description":"CWE-863: Incorrect Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-30T16:30:42.729Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"Soft Machine: Cross-tenant workspace API auth bypass via shared `CONTAINER_SHARED_SECRET` bearer token"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"bce8d7b2e6f3628c63cfbab2c2bbf28e45c1affbfcd011d210829515f65c0b15","data_version":"5.2","first_seen_at":"2026-09-30T22:16:59Z","kind":"advisory","last_material_event_at":"2026-09-30T22:16:59Z","native_id":"CVE-2026-55176","provenance":[{"revision":"38e7e058ecd98e8689404683b52de0073ac485ec","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-55176"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-30T16:30:42Z","record_encoding":{"expanded_bytes":4391,"expanded_sha256":"93c5d5c24408d49dbfc185069ad02179e73915db56f15e33f35601e6815f5007","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-55176","references":[{"assertion_role":"cna","name":"https://github.com/Soft-Machine-io/security/security/advisories/GHSA-63gh-vp9f-vxhj","provider":{"dateUpdated":"2026-09-30T16:30:42.729Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"tags":["x_refsource_CONFIRM"],"url":"https://github.com/Soft-Machine-io/security/security/advisories/GHSA-63gh-vp9f-vxhj"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-09-30T16:30:42Z","status":"active","title":"Soft Machine: Cross-tenant workspace API auth bypass via shared `CONTAINER_SHARED_SECRET` bearer token"}

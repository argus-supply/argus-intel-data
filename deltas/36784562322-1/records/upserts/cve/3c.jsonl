{"affected":[{"defaultStatus":"unknown","original_ranges":[{"lessThan":"9.5.1","status":"affected","version":"0","versionType":"custom"},{"status":"unaffected","version":"9.5.1"}],"product":"Secure Data Forms","vendor":"Kiteworks"}],"aliases":["CVE-2026-102109"],"assertions":[{"affected_indices":[0],"datePublic":"2026-09-30T00:00:00.000Z","descriptions":[{"lang":"en","value":"A SQL injection vulnerability existed in Kiteworks Secure Data Forms, where a value derived from the authenticated user's stored account data was incorporated into a database query without proper sanitization. An authenticated user could potentially influence that value to inject SQL. Exploitation requires an authenticated session and applies only to deployments where a specific optional feature is in use."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":7.1,"baseSeverity":"HIGH","confidentialityImpact":"HIGH","integrityImpact":"LOW","privilegesRequired":"LOW","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-89","description":"CWE-89 Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-30T20:23:36.117Z","orgId":"9119a7d8-5eab-497f-8521-727c672e3725","shortName":"cisa-cg"},"role":"cna","title":"Kiteworks Secure Data Forms SQL injection"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"c47f22ccc718eeb687b2383efe07c0d3cf058dbc2f48110539b163245a31b22f","data_version":"5.2","first_seen_at":"2026-09-30T22:16:59Z","kind":"advisory","last_material_event_at":"2026-09-30T22:16:59Z","native_id":"CVE-2026-102109","provenance":[{"revision":"38e7e058ecd98e8689404683b52de00
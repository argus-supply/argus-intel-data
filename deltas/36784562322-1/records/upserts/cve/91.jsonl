{"affected":[{"defaultStatus":"unknown","original_ranges":[{"lessThan":"9.5.0","status":"affected","version":"0","versionType":"custom"},{"status":"unaffected","version":"9.5.0"}],"product":"Email Protection Gateway","vendor":"Kiteworks"}],"aliases":["CVE-2026-102094"],"assertions":[{"affected_indices":[0],"datePublic":"2026-09-30T00:00:00.000Z","descriptions":[{"lang":"en","value":"Kiteworks Email Protection Gateway before version 9.5.0 is vulnerable to Unsafe Reflection and does not sufficiently restrict the code that the mail-processing pipeline could load from an imported rule configuration. An authenticated administrator with mail-rule configuration privileges could cause the gateway to load and execute code beyond the approved set of mail-processing components, potentially in the context of the mail-gateway service account."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"HIGH","baseScore":7.2,"baseSeverity":"HIGH","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"HIGH","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:U/C:H/I:H/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-470","description":"CWE-470 Use of Externally-Controlled Input to Select Classes or Code ('Unsafe Reflection')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-30T20:07:06.939Z","orgId":"9119a7d8-5eab-497f-8521-727c672e3725","shortName":"cisa-cg"},"role":"cna","title":"Kiteworks Email Protection Gateway unsafe reflection"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"1cb0f8d937ff3f44c135f2aec163338255a43292a3810bb703ed12e63dad8f37","data_version":"5.2","first_seen_at":"2026-09-30T22:16:59Z","kind":"advisory","last_material_event_at":"2026-09-30T22:16:59Z","native_id":"CVE-2026-
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"8.7.7","status":"affected","version":"0","versionType":"semver"}],"product":"Soledad","vendor":"pencidesign"}],"aliases":["CVE-2026-121684"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Soledad theme for WordPress is vulnerable to unauthenticated Remote Code Execution in versions up to, and including, 8.7.7 The public penci_more_post_ajax AJAX action feeds infeedads[ads_code] (base64+urldecoded) to penci_safe_shortcode(), whose allowlist regex inspects only the hyphen-truncated outer shortcode name (e.g. 'adinserter') and never the nested [elementor-element k=.. data=..] tag, so do_shortcode() renders an attacker-chosen Elementor element. The rendered penci-featured-sliders widget passes its unsanitized 'style' setting to include dirname(__FILE__).\"/{$style}.php\", a path-traversal local file inclusion."}],"metrics":[{"cvssV3_1":{"baseScore":8.1,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-74","description":"CWE-74 Improper Neutralization of Special Elements in Output Used by a Downstream Component","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-17T04:43:47.529Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"Soledad - Multi-Concept Blog/Magazine WordPress Theme <= 8.7.7 - Unauthenticated Remote Code Execution via penci_more_post_ajax Shortcode-Allowlist Bypass and Featured-Sliders Local File Inclusion"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"461a0bf6869933584e6a03453c64018b2943b3aa24bec7cd52109f46f5b9f37d","data_version":"5.2","first_seen_at":"2026-11-17T13:26:40Z","kind":"advisory","last_material_event_at":"2026-11-17T13:
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"4.7.0","status":"affected","version":"0","versionType":"semver"}],"product":"Video Conferencing with Zoom","vendor":"Unknown"}],"aliases":["CVE-2026-114436"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Video Conferencing with Zoom WordPress plugin before 4.7.0 does not check that a requested Zoom meeting's recordings were published on the site before fetching them with the site's connected Zoom account, allowing unauthenticated users who know a meeting ID to retrieve that meeting's cloud recording details, including its topic, share link, passcode when returned by Zoom, and direct play and download links."}],"problemTypes":[{"descriptions":[{"description":"CWE-200 Information Exposure","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-21T06:00:07.068Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Video Conferencing with Zoom < 4.7.0 - Unauthenticated Zoom Cloud Recording Disclosure"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"98ee83c8c85d8bfc24bce7866d8d26b9754eddf3600992451327c01d59b0d6cf","data_version":"5.2","first_seen_at":"2026-11-21T12:39:14Z","kind":"advisory","last_material_event_at":"2026-11-21T12:39:14Z","native_id":"CVE-2026-114436","provenance":[{"revision":"64e945170590bd533bc3a8f1880e480db3bc6a1d","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-114436"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-21T06:00:07Z","record_encoding":{"expanded_bytes":2951,"expanded_sha256":"8cb7aa5e56b39aac664913a2dfea20eee35a8bc31cf7c865b89f107583635dc0","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"
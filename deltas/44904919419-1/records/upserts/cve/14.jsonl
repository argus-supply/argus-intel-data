{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"9.1","status":"affected","version":"0","versionType":"semver"}],"product":"WPBakery Page Builder","vendor":"wpbakery"}],"aliases":["CVE-2026-122161"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The plugin for WordPress is vulnerable to Stored Cross-Site Scripting via the 'hover_custom_background' parameter in all versions up to, and including, 9.1 due to insufficient input sanitization and output escaping. This makes it possible for authenticated attackers, with contributor-level access and above, to inject arbitrary web scripts in pages that will execute whenever a user accesses an injected page. wp_kses_post applied to post content on save does not parse shortcode attribute text, allowing injected double-quotes to survive storage and break out of the style attribute context at render time."}],"metrics":[{"cvssV3_1":{"baseScore":6.4,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:C/C:L/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-79","description":"CWE-79 Improper Neutralization of Input During Web Page Generation","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-21T06:46:16.570Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"WPBakery Page Builder <= 9.1 - Authenticated (Contributor+) Stored Cross-Site Scripting via 'hover_custom_background' Shortcode Attribute"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"06758c86f3f22e5bfc1583d5c0013589d06bab850f266fb0141c17e55b675ad3","data_version":"5.2","first_seen_at":"2026-11-21T12:39:14Z","kind":"advisory","last_material_event_at":"2026-11-21T12:39:14Z","native_id":"CVE-2026-122161","provenance":[{"revision":"64e945170590bd533bc3a8f1880e480db
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.26.16.26","status":"affected","version":"2.0.0","versionType":"semver"}],"product":"UpdraftPlus: WP Backup & Migration Plugin","vendor":"Unknown"},{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.26.16","status":"affected","version":"0","versionType":"semver"}],"product":"UpdraftPlus: WP Backup & Migration Plugin","vendor":"Unknown"}],"aliases":["CVE-2026-121150"],"assertions":[{"affected_indices":[0,1],"descriptions":[{"lang":"en","value":"The UpdraftPlus: WP Backup & Migration Plugin WordPress plugin before 2.26.16.26, UpdraftPlus: WP Backup & Migration Plugin WordPress plugin before 1.26.16 do not correctly handle comment-like content found in the middle of a long SQL statement when restoring a database backup, allowing users with a role as low as Subscriber who have stored crafted content in their own profile to have SQL executed when an administrator later restores a backup, and so escalate their account to administrator.\n\nThis is a different code path from the backup restore issue fixed in 1.26.10, and it does not depend on the database server's maximum packet size."}],"problemTypes":[{"descriptions":[{"description":"CWE-269 Improper Privilege Management","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-21T06:00:07.633Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"UpdraftPlus (Free & Pro) - Subscriber+ Privilege Escalation via Backup Restore Comment Discard SQLi"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"26bed91b787a9e72ac1a0089f51962849758a7f7f673b59904d41ae786af8f9d","data_version":"5.2","first_seen_at":"2026-11-21T12:39:14Z","kind":"advisory","last_material_event_at":"2026-11-21T12:39:14Z","native_id":"CVE-2026-121150","provenance":[{"revision":
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"9.4.0","status":"affected","version":"0","versionType":"semver"}],"product":"Newsletter","vendor":"Unknown"}],"aliases":["CVE-2026-130891"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Newsletter  WordPress plugin before 9.4.0 does not check that a visitor is really the subscriber before showing them newsletters marked as private, and accepts a weaker subscriber identifier that anyone can obtain by submitting a known subscriber's email address to the public subscription form, allowing unauthenticated attackers who know a subscriber's email address to read every private newsletter sent to that subscriber."}],"problemTypes":[{"descriptions":[{"description":"CWE-200 Information Exposure","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-21T06:00:09.234Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Newsletter < 9.4.0 - Unauthenticated Private Newsletter Disclosure via Subscriber Email"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"32d23b9d69bc8c6ed16ca40660e1a97f032bea0673699c241890fda35a4a2475","data_version":"5.2","first_seen_at":"2026-11-21T12:39:14Z","kind":"advisory","last_material_event_at":"2026-11-21T12:39:14Z","native_id":"CVE-2026-130891","provenance":[{"revision":"64e945170590bd533bc3a8f1880e480db3bc6a1d","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-130891"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-21T06:00:09Z","record_encoding":{"expanded_bytes":2967,"expanded_sha256":"ba18b39fd3372ae44f4d819a607dc1207bce2cf137027e2ba646e71ec6ef05b4","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"c
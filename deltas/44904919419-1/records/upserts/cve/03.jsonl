{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.26.10","status":"affected","version":"1.26.9","versionType":"semver"}],"product":"UpdraftPlus: WP Backup & Migration Plugin","vendor":"Unknown"},{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.26.10.26","status":"affected","version":"2.26.9.26","versionType":"semver"}],"product":"UpdraftPlus: WP Backup & Migration Plugin","vendor":"Unknown"}],"aliases":["CVE-2026-111067"],"assertions":[{"affected_indices":[0,1],"descriptions":[{"lang":"en","value":"The UpdraftPlus: WP Backup & Migration Plugin WordPress plugin before 1.26.10, UpdraftPlus: WP Backup & Migration Plugin WordPress plugin before 2.26.10.26 does not guard all execution paths of its database restore process against second-order SQL injection, allowing a Subscriber-level user who has stored crafted content in their own account to escalate to administrator when an administrator later restores a backup.\nThis is due to an incomplete fix of CVE-2026-108761 in 1.26.9: the fix guards only one of the restore routine's execution paths, and a second path remains exploitable."}],"problemTypes":[{"descriptions":[{"description":"CWE-269 Improper Privilege Management","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-21T06:00:06.365Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"UpdraftPlus (Free & Pro) - Subscriber+ Privilege Escalation via Backup Restore SQLi"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"d8efd93f1cb773b980ac0ffe2baf445edcac1d87e998058c203ed5615ab12769","data_version":"5.2","first_seen_at":"2026-11-21T12:39:14Z","kind":"advisory","last_material_event_at":"2026-11-21T12:39:14Z","native_id":"CVE-2026-111067","provenance":[{"revision":"64e945170590bd533bc3a8f1880e480db3bc6a1d","source_id":"cve","ur
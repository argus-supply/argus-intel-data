{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"3.2.1","status":"affected","version":"0","versionType":"semver"}],"product":"SOES","vendor":"RT-Labs AB"}],"aliases":["CVE-2026-129811"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The PDO mapping bit lengths stored in the mapping objects are writable by the master via SDO. sizeOfPDO summed them without checking the total against the size of the rxpdo[] or txpdo[] process data buffers. A master can craft a mapping whose total bit count exceeds those buffers, causing COE_pdoPack and COE_pdoUnpack to write past their ends during each process data cycle after the PREOP to SAFEOP transition."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"ADJACENT_NETWORK","availabilityImpact":"HIGH","baseScore":8.8,"baseSeverity":"HIGH","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:A/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-787","description":"CWE-787 Out-of-bounds Write","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-21T12:03:24.613Z","orgId":"4b71179a-3b92-4a9d-b9fc-af8b8ed579ee","shortName":"rt-labs"},"role":"cna","title":"CoE PDO Mapping Size Exceeds Process Data Buffer Out-of-Bounds Write"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"85baba665c65ecc6dd4cf636df63712a988f3a2e7326a0981ed8f6bee0a066b3","data_version":"5.2","first_seen_at":"2026-11-21T12:39:14Z","kind":"advisory","last_material_event_at":"2026-11-21T12:39:14Z","native_id":"CVE-2026-129811","provenance":[{"revision":"64e945170590bd533bc3a8f1880e480db3bc6a1d","source_id":"cve","url":"https://www.cv
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.13.0","status":"affected","version":"0","versionType":"semver"}],"product":"FluentCommunity","vendor":"Unknown"}],"aliases":["CVE-2026-131983"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The FluentCommunity  WordPress plugin before 2.13.0 does not apply the per-link visibility rules of space sidebar links when listing spaces in its space discovery feature, allowing unauthenticated visitors to retrieve the titles and URLs of links restricted to logged-in users or specific memberships, as well as disabled links, for every public and private space."}],"problemTypes":[{"descriptions":[{"description":"CWE-200 Information Exposure","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-21T06:00:11.036Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"FluentCommunity < 2.13.0 - Unauthenticated Restricted Space Link Disclosure"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"75ff40b24ada6640e16a2488b5b66cde682b329a1916baca1208bad22a24f9bf","data_version":"5.2","first_seen_at":"2026-11-21T12:39:14Z","kind":"advisory","last_material_event_at":"2026-11-21T12:39:14Z","native_id":"CVE-2026-131983","provenance":[{"revision":"64e945170590bd533bc3a8f1880e480db3bc6a1d","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-131983"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-21T06:00:11Z","record_encoding":{"expanded_bytes":2817,"expanded_sha256":"aa6137c8e92fc9f25abe7972474b79981f6b92adea94c8cb683460b8a0d146c1","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-131983","references":[{"assertion_role":"cna","provider":{"d
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"7.9.1","status":"affected","version":"0","versionType":"semver"}],"product":"Shortcodes Ultimate","vendor":"Unknown"}],"aliases":["CVE-2026-131979"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Shortcodes Ultimate  WordPress plugin before 7.9.1 does not restrict the content type of its lightbox shortcode, allowing users with the contributor role and above to make the lightbox fetch HTML from an attacker-controlled server and insert it into the page unsanitised, leading to Stored Cross-Site Scripting when a user opens the lightbox."}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Cross-Site Scripting (XSS)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-21T06:00:10.864Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Shortcodes Ultimate < 7.9.1 - Contributor+ Stored XSS via su_lightbox Shortcode"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"b7868140f7b6fd2ae4296283a178a729c0d4eb56cb81b30b2df8533b99652603","data_version":"5.2","first_seen_at":"2026-11-21T12:39:14Z","kind":"advisory","last_material_event_at":"2026-11-21T12:39:14Z","native_id":"CVE-2026-131979","provenance":[{"revision":"64e945170590bd533bc3a8f1880e480db3bc6a1d","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-131979"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-21T06:00:10Z","record_encoding":{"expanded_bytes":2797,"expanded_sha256":"a82aacb5764bffe003cc1711d9249984eec065639ff9a49adc619c6e0aea8720","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-131979","references":[{"assertion_role":"cna","provider":{"dateUpd
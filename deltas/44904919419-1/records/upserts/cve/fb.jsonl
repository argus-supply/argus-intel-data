{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.13.0","status":"affected","version":"0","versionType":"semver"}],"product":"FluentCommunity","vendor":"Unknown"}],"aliases":["CVE-2026-131985"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The FluentCommunity  WordPress plugin before 2.13.0 does not verify that a referenced media item belongs to the user, or is not already attached elsewhere, before re-linking it to their own content, and its media identifiers are predictable from public post data, allowing users with a role as low as Subscriber to take over and delete media uploaded by other users, including administrators."}],"problemTypes":[{"descriptions":[{"description":"CWE-639 Authorization Bypass Through User-Controlled Key","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-21T06:00:11.379Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"FluentCommunity < 2.13.0 - Subscriber+ Cross-Owner Media Deletion via IDOR"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"0154fb820ccfe25687b49e57646cd3193f6be1e7539e37b0da0c2addb473003b","data_version":"5.2","first_seen_at":"2026-11-21T12:39:14Z","kind":"advisory","last_material_event_at":"2026-11-21T12:39:14Z","native_id":"CVE-2026-131985","provenance":[{"revision":"64e945170590bd533bc3a8f1880e480db3bc6a1d","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-131985"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-21T06:00:11Z","record_encoding":{"expanded_bytes":2899,"expanded_sha256":"314167250b36bf47e87f8308af69a82e40781e8dbafcf6ee35716bdfda7db18d","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-13198
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"7.5.5","status":"affected","version":"0","versionType":"semver"}],"product":"Titan Anti-spam & Security","vendor":"Unknown"}],"aliases":["CVE-2026-132081"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Titan Anti-spam & Security  WordPress plugin before 7.5.5 does not protect or remove the diagnostic archive it writes to the uploads folder when an administrator exports its logs, and names it after the export date alone, allowing unauthenticated visitors to download the Titan Anti-spam & Security  WordPress plugin before 7.5.5's logs, including visitor IP addresses, and the site's system information."}],"problemTypes":[{"descriptions":[{"description":"CWE-200 Information Exposure","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-21T06:00:12.085Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Titan Anti-spam & Security < 7.5.5 - Unauthenticated Diagnostic Archive Disclosure"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"33faf37705bfa835ccdec9b7274d328605afdfda13c73efb2cb515b5c9f2d406","data_version":"5.2","first_seen_at":"2026-11-21T12:39:14Z","kind":"advisory","last_material_event_at":"2026-11-21T12:39:14Z","native_id":"CVE-2026-132081","provenance":[{"revision":"64e945170590bd533bc3a8f1880e480db3bc6a1d","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-132081"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-21T06:00:12Z","record_encoding":{"expanded_bytes":2929,"expanded_sha256":"180c3b536915985c75bbdba0bfb6af087a444127a22540385a3c9f0f7ded9234","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"9.4.0","status":"affected","version":"0","versionType":"semver"}],"product":"Newsletter","vendor":"Unknown"}],"aliases":["CVE-2026-132089"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Newsletter  WordPress plugin before 9.4.0 does not keep a subscriber's secret key out of the redirect it returns after a subscription request when double opt-in is enabled, allowing unauthenticated attackers to confirm a subscription for any email address without access to its mailbox and, when the address already has an unconfirmed subscription, to reset that record with their own details."}],"problemTypes":[{"descriptions":[{"description":"CWE-287 Improper Authentication","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-21T06:00:13.550Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Newsletter < 9.4.0 - Unauthenticated Unconfirmed Subscriber Takeover via Re-subscription Token Disclosure"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"9c7b2f5ae9dfebe0ef2c72e446e850dc8f86f896e971687ea51b011eac4773f4","data_version":"5.2","first_seen_at":"2026-11-21T12:39:14Z","kind":"advisory","last_material_event_at":"2026-11-21T12:39:14Z","native_id":"CVE-2026-132089","provenance":[{"revision":"64e945170590bd533bc3a8f1880e480db3bc6a1d","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-132089"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-21T06:00:13Z","record_encoding":{"expanded_bytes":2940,"expanded_sha256":"9a8d8fb8d7bacf97a4c409b40655076956ba38ded89e3dd41edb476578aa71a4","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-
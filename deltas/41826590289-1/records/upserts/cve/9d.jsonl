{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.2.0","status":"affected","version":"0","versionType":"semver"}],"product":"WP Remote Users Sync","vendor":"Unknown"}],"aliases":["CVE-2026-111962"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The WP Remote Users Sync WordPress plugin before 2.2.0 does not adequately restrict access to the user export files it writes beneath the public web root, relying on an Apache access-control file that other web servers such as Nginx ignore, which allows an unauthenticated attacker who requests the export's predictable file name while it is present to retrieve the exported users' personal data."}],"problemTypes":[{"descriptions":[{"description":"CWE-200 Information Exposure","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-04T06:00:25.740Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"WP Remote Users Sync < 2.2.0 - Unauthenticated Sensitive Data Disclosure via Public User Export File"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"71574789f13498315c63469631b03a1288997dd0ecfb3eb0f73c72a133a9f32b","data_version":"5.2","first_seen_at":"2026-11-04T12:08:39Z","kind":"advisory","last_material_event_at":"2026-11-04T12:08:39Z","native_id":"CVE-2026-111962","provenance":[{"revision":"7836aa8e3123546cf080213ebe300a5e4eeffb33","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-111962"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-04T06:00:25Z","record_encoding":{"expanded_bytes":2935,"expanded_sha256":"72da260bac4fe25135a01845b1e82dacf40768456955f0929f8a7dbc4cd1c918","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026
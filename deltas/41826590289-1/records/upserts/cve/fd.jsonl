{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"unknown","version":"consult Xen advisory XSA-523"}],"product":"Xen","vendor":"Xen"}],"aliases":["CVE-2026-102704"],"assertions":[{"affected_indices":[0],"configurations":[{"lang":"en","value":"All Xen versions from 4.6 onwards are vulnerable.  Xen versions 4.5 and\nearlier are not vulnerable."}],"datePublic":"2026-11-03T12:00:00.000Z","descriptions":[{"lang":"en","value":"[This CNA information record relates to multiple CVEs; the\ntext explains which aspects/vulnerabilities correspond to which CVE.]\n\nA common access pattern is a batch of Grant Copy operations acting on\nadjacent address ranges in the same source or destination page.  For\nperformance reasons, Xen caches details internally to reuse already\nvalidated data.  The conditions on when to re-validate the internal data\nwere not correct in some cases:\n\n - Frame numbers and grant references could wrongly be mixed up.  This\n   is CVE-2026-102703.\n\n - Copying by frame number (rather than grant reference) is permitted\n   only when operating on the caller's own memory.  The check to enforce\n   this restriction was misplaced.  This is CVE-2026-102704."}],"provider":{"dateUpdated":"2026-11-04T10:30:00.837Z","orgId":"23aa2041-22e1-471f-9209-9b7396fa234f","shortName":"XEN"},"role":"cna","title":"arbitrary read/write via grant copy"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"c8ed5a410b46e39c4e0966218c5e0dc54a57e2c336353196f1377e474a96f4ac","data_version":"5.2","first_seen_at":"2026-11-04T12:08:39Z","kind":"advisory","last_material_event_at":"2026-11-04T12:08:39Z","native_id":"CVE-2026-102704","provenance":[{"revision":"7836aa8e3123546cf080213ebe300a5e4eeffb33","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-102704"},{"assertion_index":0,"independent_evidence":tru
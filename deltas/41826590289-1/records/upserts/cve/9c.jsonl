{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"0.9.137","status":"affected","version":"0.9.117","versionType":"semver"}],"product":"WPvivid — Backup, Migration & Staging","vendor":"Unknown"}],"aliases":["CVE-2026-115243"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The WPvivid — Backup, Migration & Staging WordPress plugin before 0.9.137 does not validate the extension of the file it actually stores when handling an import upload: it checks the extension of a separate request field while saving the uploaded file itself with WordPress's upload type-checking disabled, so an authenticated administrator can store a file with an arbitrary extension, including a PHP file, in the WPvivid — Backup, Migration & Staging WordPress plugin before 0.9.137's import directory. This is an incomplete fix of CVE-2025-5961, whose extension check was applied to the wrong value."}],"problemTypes":[{"descriptions":[{"description":"CWE-434 Unrestricted Upload of File with Dangerous Type","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-04T06:00:26.847Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"WPvivid Backup & Migration 0.9.117 - 0.9.136 - Admin+ Arbitrary File Upload via wpvivid_upload_import_files"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"cb016ef9b410109009db8b3d68d4495960d88bd92eff0347a4179a6e9010f665","data_version":"5.2","first_seen_at":"2026-11-04T12:08:39Z","kind":"advisory","last_material_event_at":"2026-11-04T12:08:39Z","native_id":"CVE-2026-115243","provenance":[{"revision":"7836aa8e3123546cf080213ebe300a5e4eeffb33","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-115243"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-04T06:00:26Z","
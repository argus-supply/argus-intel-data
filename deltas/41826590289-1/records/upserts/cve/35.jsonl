{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"0.9.137","status":"affected","version":"0","versionType":"semver"}],"product":"WPvivid — Backup, Migration & Staging","vendor":"Unknown"}],"aliases":["CVE-2026-115241"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The WPvivid — Backup, Migration & Staging WordPress plugin before 0.9.137 does not verify that a submitted snapshot identifier names a snapshot it actually created before using it as a database table-name prefix, so an authenticated administrator can supply the site's table prefix, or any other string, and cause the WPvivid — Backup, Migration & Staging WordPress plugin before 0.9.137 to drop every matching table, including the core WordPress tables, destroying the site's database."}],"problemTypes":[{"descriptions":[{"description":"CWE-284 Improper Access Control","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-04T06:00:26.503Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"WPvivid Backup & Migration < 0.9.137 - Admin+ Arbitrary Database Table Deletion via Snapshot ID"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"6efef5e6cca42200d1ce01b078099ea5213f9e4e1a178b421376577005290647","data_version":"5.2","first_seen_at":"2026-11-04T12:08:39Z","kind":"advisory","last_material_event_at":"2026-11-04T12:08:39Z","native_id":"CVE-2026-115241","provenance":[{"revision":"7836aa8e3123546cf080213ebe300a5e4eeffb33","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-115241"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-04T06:00:26Z","record_encoding":{"expanded_bytes":3137,"expanded_sha256":"76fb9e8d1391e0a79807ba46b08c34d8a134794b26ca436194106d12a855b3cc","format":"cve-indexed-assertions-v
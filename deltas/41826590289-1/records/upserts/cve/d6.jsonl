{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.2.2","status":"affected","version":"0","versionType":"semver"}],"product":"Text Typing","vendor":"Unknown"}],"aliases":["CVE-2026-115250"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Text Typing  WordPress plugin before 2.2.2 does not properly sanitize and escape a block attribute before storing it and later outputting it into a page element that is read and rendered by client-side script, allowing users with the Contributor role and above to perform Stored Cross-Site Scripting attacks that execute in the browser of anyone viewing the affected page."}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Cross-Site Scripting (XSS)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-04T06:00:27.029Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Text Typing < 2.2.2 - Contributor+ Stored XSS"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"a6d16c13dd70cb131f9fff5565b7741fc79b9f2b200ad5779a6d77e5a726e01f","data_version":"5.2","first_seen_at":"2026-11-04T12:08:39Z","kind":"advisory","last_material_event_at":"2026-11-04T12:08:39Z","native_id":"CVE-2026-115250","provenance":[{"revision":"7836aa8e3123546cf080213ebe300a5e4eeffb33","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-115250"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-04T06:00:27Z","record_encoding":{"expanded_bytes":2781,"expanded_sha256":"f79ebd7d303f2923d32e6bcbca320284bee5dbbe885d27ddbf64dce7808cf36f","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-115250","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-
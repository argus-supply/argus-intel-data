{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"2.1.2","status":"affected","version":"0","versionType":"semver"}],"product":"Product Designer for WooCommerce WordPress | Lumise","vendor":"King-Theme"}],"aliases":["CVE-2026-15323"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Product Designer for WooCommerce WordPress | Lumise plugin for WordPress is vulnerable to Directory Traversal in all versions up to, and including, 2.1.2 via the process_checkout function. This makes it possible for unauthenticated attackers to read the contents of arbitrary files on the server, which can contain sensitive information. The lumise_security nonce required to reach the vulnerable /?lumise=cart endpoint is freely obtainable by any unauthenticated visitor via the /?lumise=ajax action=init handler, making this exploitable with no prior access or credentials."}],"metrics":[{"cvssV3_1":{"baseScore":7.5,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:N/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-22","description":"CWE-22 Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T05:33:31.729Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"Product Designer for WooCommerce WordPress | Lumise <= 2.1.2 - Unauthenticated Arbitrary File Read via 'design.stages[*].image' Parameter in Cart JSON Upload"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"7e6c0f20f329eb28fa2f9ad30792fe35b4fc9fb77b56006652f642c0db06e064","data_version":"5.2","first_seen_at":"2026-10-28T08:32:32Z","kind":"advisory","last_material_event_at":"2026-10-28T08:32:32Z","native_id":"CVE-2026-15323","provenance":[{"revi
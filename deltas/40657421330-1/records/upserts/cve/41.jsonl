{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"3.42","status":"affected","version":"0","versionType":"semver"}],"product":"Media Library Assistant","vendor":"Unknown"}],"aliases":["CVE-2026-113485"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Media Library Assistant WordPress plugin before 3.42 does not consistently validate its CSRF nonce on the Media Library bulk-action handler, checking the nonce only when its field is present, so a forged request that omits the field can cause a logged-in user with the Author role or above to trash or delete attachments."}],"problemTypes":[{"descriptions":[{"description":"CWE-352 Cross-Site Request Forgery (CSRF)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T06:00:25.578Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Media Library Assistant < 3.42 - Bulk Attachment Deletion via CSRF"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"687db9e399620b01de886215f39e6bf838d1e3c2d716da64d1afc7debe03b140","data_version":"5.2","first_seen_at":"2026-10-28T08:32:32Z","kind":"advisory","last_material_event_at":"2026-10-28T08:32:32Z","native_id":"CVE-2026-113485","provenance":[{"revision":"8813370343fecff596e2aca238915e2bb0607c7a","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-113485"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-28T06:00:25Z","record_encoding":{"expanded_bytes":2740,"expanded_sha256":"d84652766c51ff4acebe6b059e66318958d6143ca1082f95a500f505e785ef23","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-113485","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-28T06:00
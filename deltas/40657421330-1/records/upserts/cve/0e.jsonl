{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.5.10","status":"affected","version":"0","versionType":"semver"}],"product":"Royal MCP","vendor":"Unknown"}],"aliases":["CVE-2026-111961"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Royal MCP  WordPress plugin before 1.5.10 does not perform an object-level permission check before duplicating a requested page, relying on a generic capability, which allows users with contributor-level access to read the full content of any private or draft page and to publish it without holding the publish capability."}],"problemTypes":[{"descriptions":[{"description":"CWE-639 Authorization Bypass Through User-Controlled Key","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T06:00:25.225Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Royal MCP < 1.5.10 - Contributor+ Private and Draft Content Disclosure and publish_posts Bypass via elementor_clone_page"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"898b78db6be23e9785fc6ac4115fba6692f733f04c309a1c218428d203723e6e","data_version":"5.2","first_seen_at":"2026-10-28T08:32:32Z","kind":"advisory","last_material_event_at":"2026-10-28T08:32:32Z","native_id":"CVE-2026-111961","provenance":[{"revision":"8813370343fecff596e2aca238915e2bb0607c7a","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-111961"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-28T06:00:25Z","record_encoding":{"expanded_bytes":2853,"expanded_sha256":"714d5c20b8a428c5c3f2a740a54094369ba89f37f9cfcf1461be633069d2a6fa","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-111961","references":[{"asserti
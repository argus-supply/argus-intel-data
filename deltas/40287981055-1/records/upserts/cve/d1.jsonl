{"affected":[{"collectionURL":"https://wordpress.org/plugins","defaultStatus":"unknown","original_ranges":[{"lessThanOrEqual":"2.1.1","status":"affected","version":"0","versionType":"semver"}],"product":"Eurobank WooCommerce Payment Gateway","vendor":"Unknown"}],"aliases":["CVE-2026-103300"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Eurobank WooCommerce Payment Gateway WordPress plugin through 2.1.1 does not verify that a payment-confirmation request genuinely originates from the payment provider, and ships with the secret that would authenticate it empty by default, allowing unauthenticated attackers to mark any pending order as paid, and to force any order into a failed status without any secret at all."}],"metrics":[{"cvssV3_1":{"baseScore":5.3,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"description":"CWE-345 Insufficient Verification of Data Authenticity","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-26T07:05:40.577Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Eurobank WooCommerce Payment Gateway <= 2.1.1 - Unauthenticated Order Payment Forgery via Unverified Callback"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"67cc19c40165e3fcae7d5166d085fcbf45912d52fa136a0fe29254af71e47631","data_version":"5.2","first_seen_at":"2026-10-26T07:48:23Z","kind":"advisory","last_material_event_at":"2026-10-26T07:48:23Z","native_id":"CVE-2026-103300","provenance":[{"revision":"7a81251d4ca695703882ebe2a797c0f35c0e9a4b","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-103300"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-26T07:05:40Z","record_encoding":{"expanded_byt
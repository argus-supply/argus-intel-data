{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"3.0.4","status":"affected","version":"0","versionType":"semver"}],"product":"Online Payments with iK Pay Gateway","vendor":"Unknown"}],"aliases":["CVE-2026-103306"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Online Payments with iK Pay Gateway WordPress plugin before 3.0.4 does not properly verify the authenticity of its payment gateway callback on a default installation, allowing unauthenticated attackers to forge a successful payment notification and mark arbitrary orders as paid without any payment being made, and to mark arbitrary unprocessed orders as failed."}],"problemTypes":[{"descriptions":[{"description":"CWE-287 Improper Authentication","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-26T06:00:18.216Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"iKhokha Payment Gateway < 3.0.4 - Unauthenticated Order Payment Forgery via Callback"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"cbc960b9cd58871521a56c7df237b3d917c27c4b7c891ee1856e92411400abff","data_version":"5.2","first_seen_at":"2026-10-26T07:48:23Z","kind":"advisory","last_material_event_at":"2026-10-26T07:48:23Z","native_id":"CVE-2026-103306","provenance":[{"revision":"7a81251d4ca695703882ebe2a797c0f35c0e9a4b","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-103306"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-26T06:00:18Z","record_encoding":{"expanded_bytes":2861,"expanded_sha256":"d2386d92938b56988a7d3ddbb5a03320a7473d23cf8fca54456fe513ef3e203c","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-103306","references":[{"ass
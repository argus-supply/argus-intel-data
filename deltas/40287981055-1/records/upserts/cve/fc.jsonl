{"affected":[{"defaultStatus":"unknown","original_ranges":[{"lessThanOrEqual":"3.1","status":"affected","version":"0","versionType":"semver"}],"product":"CCAvenue Payment Gateway for WooCommerce","vendor":"Unknown"}],"aliases":["CVE-2026-103298"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The CCAvenue Payment Gateway for WooCommerce WordPress plugin through 3.1 does not verify that a payment-confirmation request genuinely originates from the payment provider, and derives its verification key from a value that is empty on a default install, allowing unauthenticated attackers to forge a confirmation and mark any WooCommerce order as paid without payment."}],"problemTypes":[{"descriptions":[{"description":"CWE-284 Improper Access Control","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-26T06:00:18.034Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"CCAvenue Payment Gateway for WooCommerce <= 3.1 - Unauthenticated Order Payment Completion via Webhook Forgery"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"0d82d36dfbd5f9f27ddb28525ab1458440c6422695ce5119dc60da9c5e1dd92e","data_version":"5.2","first_seen_at":"2026-10-26T07:48:23Z","kind":"advisory","last_material_event_at":"2026-10-26T07:48:23Z","native_id":"CVE-2026-103298","provenance":[{"revision":"7a81251d4ca695703882ebe2a797c0f35c0e9a4b","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-103298"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-26T06:00:18Z","record_encoding":{"expanded_bytes":2928,"expanded_sha256":"4c8ff3892fdd7b5032a48a6a7dd82c4af8d152098e680d41db568a4873ea32e1","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve
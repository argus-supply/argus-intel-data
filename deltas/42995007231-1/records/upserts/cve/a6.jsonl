{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"7.2.4","status":"affected","version":"0","versionType":"semver"}],"product":"ARforms","vendor":"n/a"}],"aliases":["CVE-2026-111190"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The ARForms plugin for WordPress is vulnerable to arbitrary file upload in all versions up to, and including, 7.2.4 via its form file-upload handler. The name of the stored file is taken from an attacker-controlled request header and is not adequately restricted to safe file types, and the plugin's file-type and content-safety checks can be evaded, allowing files that contain executable PHP code to be written to a publicly accessible directory. This makes it possible for unauthenticated attackers to upload malicious files to the affected site's server, which may make remote code execution possible. Exploitation requires a published form containing a File field to be publicly accessible on the site."}],"metrics":[{"cvssV3_1":{"baseScore":8.1,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-434","description":"CWE-434 Unrestricted Upload of File with Dangerous Type","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-11T07:26:41.208Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"ARForms <= 7.2.4 - Unauthenticated Arbitrary File Upload to Remote Code Execution via X-FILENAME Header"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"a29a1b6ecd563064648a5534b1ef7c4f822056190a45f860d7b8fce558e26e39","data_version":"5.2","first_seen_at":"2026-11-11T09:26:00Z","kind":"advisory","last_material_event_at":"2026-11-11T09:26:00Z","native_id":"CVE-2026-111190","provenance":[{"revision
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.3.1","status":"affected","version":"0","versionType":"semver"}],"product":"Dynific Addons for Elementor (formerly Anywhere Elementor)","vendor":"Unknown"}],"aliases":["CVE-2026-117521"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Dynific Addons for Elementor (formerly Anywhere Elementor) WordPress plugin before 1.3.1 does not escape a user-controlled profile value before outputting it in a quoted attribute in one of its Elementor widgets, allowing authenticated users with the Author role to store a payload that executes in the session of anyone, including an administrator, who views a post the attacker authored, resulting in Stored Cross-Site Scripting."}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Cross-Site Scripting (XSS)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-11T06:00:07.628Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Dynific Addons for Elementor < 1.3.1 - Author+ Stored XSS via Display Name in Post Author Widget"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"02ee90e63033f189c003f92b1f59a3c7959924430e6cb73d0a8a79abd8f4bdc2","data_version":"5.2","first_seen_at":"2026-11-11T09:26:00Z","kind":"advisory","last_material_event_at":"2026-11-11T09:26:00Z","native_id":"CVE-2026-117521","provenance":[{"revision":"4c07ec36f2902d5d14707eb349fb9509074b68c2","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-117521"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-11T06:00:07Z","record_encoding":{"expanded_bytes":3048,"expanded_sha256":"2a2f025abf3e48464f5b0347bab9f815fd54d002bda384da6d1578832977377e","format":"cve-indexed-assertions-v1","top_descriptions_assertio
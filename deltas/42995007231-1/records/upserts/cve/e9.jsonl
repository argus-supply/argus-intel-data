{"affected":[{"defaultStatus":"unknown","original_ranges":[{"lessThanOrEqual":"1.0.16","status":"affected","version":"0","versionType":"semver"}],"product":"Security For WooCommerce","vendor":"Unknown"}],"aliases":["CVE-2026-123702"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Security For WooCommerce WordPress plugin through 1.0.16 does not check that the requester is authorised before regenerating the secret keys and salts in the site's configuration file, allowing unauthenticated users to log out every user and, on servers that cannot reach the WordPress.org API, corrupt the configuration file and take the whole site offline."}],"problemTypes":[{"descriptions":[{"description":"CWE-862 Missing Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-11T06:00:15.281Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Security For WooCommerce <= 1.0.16 - Unauthenticated wp-config Keys and Salts Reset and Denial of Service"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"6fc1fe92be5360679d202959de4389ce856c769d88bf23c1a4ed90c20e011a19","data_version":"5.2","first_seen_at":"2026-11-11T09:26:00Z","kind":"advisory","last_material_event_at":"2026-11-11T09:26:00Z","native_id":"CVE-2026-123702","provenance":[{"revision":"4c07ec36f2902d5d14707eb349fb9509074b68c2","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-123702"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-11T06:00:15Z","record_encoding":{"expanded_bytes":2887,"expanded_sha256":"5d87b5fc001ae5ec4b2863f9ff1e07b02a48ebd6849b93e96a11776372d02125","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-123702","reference
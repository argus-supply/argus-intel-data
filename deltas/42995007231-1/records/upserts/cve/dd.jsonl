{"affected":[{"defaultStatus":"unknown","original_ranges":[{"lessThanOrEqual":"1.0.5","status":"affected","version":"0","versionType":"semver"}],"product":"Pay with a tweet","vendor":"Unknown"}],"aliases":["CVE-2026-115734"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Pay with a tweet WordPress plugin through 1.0.5 does not validate a file path before deleting it, nor does it restrict access to the relevant administration screens, allowing users with a role as low as Subscriber to delete arbitrary files on the server, which can lead to a full site compromise."}],"problemTypes":[{"descriptions":[{"description":"CWE-73 External Control of File Name or Path","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-11T06:00:07.276Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Pay With a Tweet <= 1.0.5 - Subscriber+ Arbitrary File Deletion via Button Download Path"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"e6646df9f0829358c7e95ba28a7e936cf38d59c98b6663950ebdc0e75160413d","data_version":"5.2","first_seen_at":"2026-11-11T09:26:00Z","kind":"advisory","last_material_event_at":"2026-11-11T09:26:00Z","native_id":"CVE-2026-115734","provenance":[{"revision":"4c07ec36f2902d5d14707eb349fb9509074b68c2","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-115734"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-11T06:00:07Z","record_encoding":{"expanded_bytes":2735,"expanded_sha256":"1328248e544ac1273c35d981be84ec4c009bd61994c4269d0860d3c09ebccbc9","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-115734","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-11T06:00:0
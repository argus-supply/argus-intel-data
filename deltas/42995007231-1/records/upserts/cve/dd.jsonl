{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"6.0.8","status":"affected","version":"0","versionType":"semver"}],"product":"AutomatorWP","vendor":"Unknown"}],"aliases":["CVE-2026-121472"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The AutomatorWP  WordPress plugin before 6.0.8 does not bind the requests that complete its Zoom and AWeber integration connections to the administrator who started them, allowing attackers to make a logged-in administrator replace the stored integration credentials with the attacker's own via a CSRF attack, diverting the data the site sends to those services into an account the attacker controls. Exploitation requires the integration to already be connected and knowledge of the site's OAuth client identifier."}],"problemTypes":[{"descriptions":[{"description":"CWE-352 Cross-Site Request Forgery (CSRF)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-11T06:00:10.898Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"AutomatorWP < 6.0.8 - Zoom/AWeber Integration Connection Hijack via CSRF"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"cb503ebd78ba64074905cab07d1628402bb4dfd369c4a4f6273b317387dc2d3f","data_version":"5.2","first_seen_at":"2026-11-11T09:26:00Z","kind":"advisory","last_material_event_at":"2026-11-11T09:26:00Z","native_id":"CVE-2026-121472","provenance":[{"revision":"4c07ec36f2902d5d14707eb349fb9509074b68c2","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-121472"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-11T06:00:10Z","record_encoding":{"expanded_bytes":3121,"expanded_sha256":"014116b93e344cb3881d1ad87a12f9d7600e3ac26ce5fdc36966b738dc7367e1","format":"cve-indexed-assertions-v1","top_desc
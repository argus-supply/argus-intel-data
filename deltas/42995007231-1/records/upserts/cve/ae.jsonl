{"affected":[{"defaultStatus":"unknown","original_ranges":[{"lessThanOrEqual":"4.39.0","status":"affected","version":"0","versionType":"semver"}],"product":"YITH WooCommerce Gift Cards","vendor":"Unknown"}],"aliases":["CVE-2026-88813"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The YITH WooCommerce Gift Cards WordPress plugin through 4.39.0 does not reconcile the value of a gift card it issues against the amount actually paid for it, instead crediting the new card with the item's pre-discount price, which allows customers to apply an ordinary store coupon at checkout and receive a gift card worth more than they paid."}],"problemTypes":[{"descriptions":[{"description":"CWE-284 Improper Access Control","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-11T06:00:15.978Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"YITH WooCommerce Gift Cards <= 4.39.0 - Unauthenticated Gift Card Balance Inflation via Discounted Purchase"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"0d7633439d7e6d92c5a8fcd9facd7fc7ef7720b3d94158b86409c6ab95a3f5c1","data_version":"5.2","first_seen_at":"2026-11-11T09:26:00Z","kind":"advisory","last_material_event_at":"2026-11-11T09:26:00Z","native_id":"CVE-2026-88813","provenance":[{"revision":"4c07ec36f2902d5d14707eb349fb9509074b68c2","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-88813"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-11T06:00:15Z","record_encoding":{"expanded_bytes":2858,"expanded_sha256":"7ffd15b2f09c6fbfef88f8bdf53ef828730bafc6b2fdf77a150da97bbee8cd10","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-88813","references":[{"assertio
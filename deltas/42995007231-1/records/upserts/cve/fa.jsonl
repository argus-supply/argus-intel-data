{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.1.24","status":"affected","version":"0","versionType":"semver"}],"product":"Live Composer","vendor":"Unknown"}],"aliases":["CVE-2026-119531"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Live Composer  WordPress plugin before 2.1.24 does not escape several attributes of one of its page-builder shortcodes before outputting them inside HTML tag attributes, allowing users with the Contributor role and above to store a payload that executes in the browser of anyone who views the post, including an administrator reviewing the pending submission."}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Cross-Site Scripting (XSS)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-11T06:00:10.726Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Live Composer < 2.1.24 - Contributor+ Stored XSS via Module Area Shortcode"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"9e87e654c056e6b8557466660aa1d706fa472ebd5a98dfdceed02c6c8f546de9","data_version":"5.2","first_seen_at":"2026-11-11T09:26:00Z","kind":"advisory","last_material_event_at":"2026-11-11T09:26:00Z","native_id":"CVE-2026-119531","provenance":[{"revision":"4c07ec36f2902d5d14707eb349fb9509074b68c2","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-119531"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-11T06:00:10Z","record_encoding":{"expanded_bytes":2816,"expanded_sha256":"9c9ee52766f57d830f92ea4a55836262a1987a835ff8a74ba4ab4e1165f40b2a","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-119531","references":[{"assertion_role":"cna","provider":{"
{"affected":[{"original_ranges":[{"status":"affected","version":"<= 3.15.2"}],"product":"waline","vendor":"walinejs"}],"aliases":["CVE-2026-64671"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Waline is a comment system with backend support. In versions 3.15.2 and prior, the @waline/client UserList widget builds its DOM by concatenating server-returned commenter fields directly into root.innerHTML with no HTML escaping. The commenter nick and link are stored and returned verbatim by the server (only the comment body is sanitized), and the link field is never sent to the spam filter. So an unauthenticated visitor who posts a comment with link = x\"><img src=x onerror=...> achieves stored cross-site scripting that executes, with no interaction, in the browser of every visitor to a page that embeds the UserList widget. At time of publication, there are no publicly available patches."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":7.2,"baseSeverity":"HIGH","confidentialityImpact":"LOW","integrityImpact":"LOW","privilegesRequired":"NONE","scope":"CHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:L/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-79","description":"CWE-79: Improper Neutralization of Input During Web Page Generation","lang":"en","type":"CWE"}]},{"descriptions":[{"cweId":"CWE-116","description":"CWE-116: Improper Encoding or Escaping of Output","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-11T03:42:13.103Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"Stored XSS in the @waline/client UserList widget via an unescaped commenter link field"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"769eee1022f40753431a247d2494480be01ebee76ef0bdd0fd1a1452887f4050","data_version":"5.2","first_seen_at":"2026-11-11T09:26:00Z","kind":"advisory","last_material_event_at":"2026-11-11T09:26:00Z","native_id":"CVE-2026-64671","provenance":[{"revision":"4c07ec36f2902d5d14707eb349fb9509074b68c2","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-64671"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-11T03:42:13Z","record_encoding":{"expanded_bytes":4036,"expanded_sha256":"c5e78a1b9a57b1c50315e104f28b205fa92fb8484f9497187db068151c1e8437","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-64671","references":[{"assertion_role":"cna","name":"https://github.com/walinejs/waline/security/advisories/GHSA-7w94-hxwm-gg99","provider":{"dateUpdated":"2026-11-11T03:42:13.103Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"tags":["x_refsource_CONFIRM"],"url":"https://github.com/walinejs/waline/security/advisories/GHSA-7w94-hxwm-gg99"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-11-11T03:42:13Z","status":"active","title":"Stored XSS in the @waline/client UserList widget via an unescaped commenter link field"}

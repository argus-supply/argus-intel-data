{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.2.4","status":"affected","version":"0","versionType":"semver"}],"product":"iChart","vendor":"Unknown"}],"aliases":["CVE-2026-121998"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The iChart  WordPress plugin before 2.2.4 does not perform capability or ownership checks in several of its AJAX actions, relying only on a nonce that any logged-in user can obtain, allowing users with a role as low as Subscriber to read, modify and permanently delete arbitrary posts and to overwrite a site-wide option."}],"problemTypes":[{"descriptions":[{"description":"CWE-639 Authorization Bypass Through User-Controlled Key","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-11T06:00:12.022Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"iChart < 2.2.4 - Subscriber+ Arbitrary Post Read, Update and Deletion via IDOR"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"8583620261247dcc0caa65ebd27c0669d7a8f18b8682cff7ae6b59413cf71f22","data_version":"5.2","first_seen_at":"2026-11-11T09:26:00Z","kind":"advisory","last_material_event_at":"2026-11-11T09:26:00Z","native_id":"CVE-2026-121998","provenance":[{"revision":"4c07ec36f2902d5d14707eb349fb9509074b68c2","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-121998"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-11T06:00:12Z","record_encoding":{"expanded_bytes":2755,"expanded_sha256":"304b6684acebab1968db663db164084ea48c598caa113acd5f630e7e6e71df87","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-121998","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-1
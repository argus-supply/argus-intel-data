{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.3.1","status":"affected","version":"0","versionType":"semver"}],"product":"Dynific Addons for Elementor (formerly Anywhere Elementor)","vendor":"Unknown"}],"aliases":["CVE-2026-117522"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Dynific Addons for Elementor (formerly Anywhere Elementor) WordPress plugin before 1.3.1 does not escape the post title before outputting it in a quoted HTML attribute in one of its Elementor widgets, allowing authenticated users with the Author role to publish a post whose title executes as script in the session of anyone, including an administrator, who views it, resulting in Stored Cross-Site Scripting."}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Cross-Site Scripting (XSS)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-11T06:00:07.799Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Dynific Addons for Elementor < 1.3.1 - Author+ Stored XSS via Post Title in Post Image Widget"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"ec615e660997fb84ee5456158eb2df4490322b7840ccf4e7197899d9ac99401b","data_version":"5.2","first_seen_at":"2026-11-11T09:26:00Z","kind":"advisory","last_material_event_at":"2026-11-11T09:26:00Z","native_id":"CVE-2026-117522","provenance":[{"revision":"4c07ec36f2902d5d14707eb349fb9509074b68c2","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-117522"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-11T06:00:07Z","record_encoding":{"expanded_bytes":2998,"expanded_sha256":"092344b07c7b04cbeaff69247c9ccebc16e2622dfb404804a30df6319098c8ce","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descripti
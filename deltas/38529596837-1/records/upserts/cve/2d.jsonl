{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"5.3.2","status":"affected","version":"0","versionType":"semver"}],"product":"Product Feed for Google Shopping, Microsoft Advertising and 40+ Channels for WooCommerce Merchant","vendor":"Unknown"}],"aliases":["CVE-2026-87968"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Product Feed for Google Shopping, Microsoft Advertising and 40+ Channels for WooCommerce Merchant WordPress plugin before 5.3.2 does not perform a nonce or capability check on the AJAX action that registers the store with its feed service and exposes it to unauthenticated users, so any visitor can force the store to re-register and overwrite the Product Feed for Google Shopping, Microsoft Advertising and 40+ Channels for WooCommerce Merchant WordPress plugin before 5.3.2's stored shop secret."}],"problemTypes":[{"descriptions":[{"description":"CWE-284 Improper Access Control","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-14T06:00:13.939Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Product Feed for Google Shopping < 5.3.2 - Unauthenticated Forced Store Registration"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"186185ebe715c06135a93c9788ea4c4970173921737a68954a13f1e940e407b3","data_version":"5.2","first_seen_at":"2026-10-14T07:38:52Z","kind":"advisory","last_material_event_at":"2026-10-14T07:38:52Z","native_id":"CVE-2026-87968","provenance":[{"revision":"43fa906da27b3481e0be9ba016dcc3c4c3c118f4","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-87968"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-14T06:00:13Z","record_encoding":{"expanded_bytes":3189,"expanded_sha256":"509975847e2fb3d7cc1a8fb84e4b2fff29f33a8ad
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"7.5.55.7212","status":"affected","version":"7.5.44.7212","versionType":"semver"}],"product":"FV Flowplayer Video Player","vendor":"Unknown"}],"aliases":["CVE-2026-85345"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The FV Flowplayer Video Player WordPress plugin before 7.5.55.7212 does not properly validate a user-supplied URL before performing a server-side fetch, and an existing host-based restriction fails to cover all cases, allowing users with Contributor-level access and above to perform Server-Side Request Forgery (SSRF) attacks. The impact is limited to a semi-blind oracle: the server's fetch reveals whether an internal resource responds and its HTTP status, but the resource's contents are not returned to the attacker."}],"problemTypes":[{"descriptions":[{"description":"CWE-918 Server-Side Request Forgery (SSRF)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-14T06:00:13.060Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"FV Player 7.5.44.7212 - 7.5.54.7212 - Contributor+ SSRF via retrieve_video_data"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"336b9983d00620bcfa9d8f6d5e23d2b78e98dc24ab21a50d3f00ed4e4a944811","data_version":"5.2","first_seen_at":"2026-10-14T07:38:52Z","kind":"advisory","last_material_event_at":"2026-10-14T07:38:52Z","native_id":"CVE-2026-85345","provenance":[{"revision":"43fa906da27b3481e0be9ba016dcc3c4c3c118f4","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-85345"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-14T06:00:13Z","record_encoding":{"expanded_bytes":3175,"expanded_sha256":"84cd3942d5679f5b3c78363e37aff565c1bf2da0339bf010b14ccba380e193c3","for
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"4.2.0","status":"affected","version":"0","versionType":"semver"}],"product":"WP 2FA","vendor":"Unknown"}],"aliases":["CVE-2026-108066"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The WP 2FA  WordPress plugin before 4.2.0 does not perform an object-level capability check before removing a user's two-factor authentication configuration, allowing a site administrator on WordPress Multisite to remove the 2FA configuration of users outside their own site, including accounts they are not permitted to edit. On single-site installs an administrator can already manage all users, so this crosses a trust boundary only on Multisite."}],"problemTypes":[{"descriptions":[{"description":"CWE-639 Authorization Bypass Through User-Controlled Key","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-14T06:00:12.277Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"WP 2FA < 4.2.0 - Admin+ Arbitrary User 2FA Removal via IDOR"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"9e7c23596be9f4b2488c0c237ec6d777aa2be6d972b7045f5eabbc7d0db4b212","data_version":"5.2","first_seen_at":"2026-10-14T07:38:52Z","kind":"advisory","last_material_event_at":"2026-10-14T07:38:52Z","native_id":"CVE-2026-108066","provenance":[{"revision":"43fa906da27b3481e0be9ba016dcc3c4c3c118f4","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-108066"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-14T06:00:12Z","record_encoding":{"expanded_bytes":2973,"expanded_sha256":"27724dc2f4e8e288673a1e1ff2aee101f3da9cb4eda287ab76888e6222fc6a11","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"}
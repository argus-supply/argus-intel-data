{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.9.0","status":"affected","version":"0","versionType":"semver"}],"product":"Robokassa payment gateway for Woocommerce","vendor":"Unknown"}],"aliases":["CVE-2026-91076"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Robokassa payment gateway for Woocommerce WordPress plugin before 1.9.0 does not verify the authenticity of an incoming payment-notification request before acting on the order named in it, allowing unauthenticated attackers to force any WooCommerce order into a failed state. Order identifiers are sequential, so every order in the shop can be taken out of the fulfilment queue one request at a time."}],"problemTypes":[{"descriptions":[{"description":"CWE-862 Missing Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-14T06:00:15.064Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Robokassa payment for WooCommerce < 1.9.0 - Unauthenticated Arbitrary Order Status Change to Failed"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"a5ed74ff72d6eb0099f66809bed424260042f7165d313405bfaab689c7b3554f","data_version":"5.2","first_seen_at":"2026-10-14T07:38:52Z","kind":"advisory","last_material_event_at":"2026-10-14T07:38:52Z","native_id":"CVE-2026-91076","provenance":[{"revision":"43fa906da27b3481e0be9ba016dcc3c4c3c118f4","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-91076"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-14T06:00:15Z","record_encoding":{"expanded_bytes":2967,"expanded_sha256":"3e7e9d56be698c176d4dcbe40e2edf8bb546abf3084fe0951f264faf25f3f9a7","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"}
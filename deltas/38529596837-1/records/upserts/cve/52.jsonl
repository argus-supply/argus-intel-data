{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"7.4","status":"affected","version":"0","versionType":"custom"}],"product":"Guardicore Platform Agent","vendor":"Akamai"}],"aliases":["CVE-2026-50217"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A use-after-free vulnerability in the Windows WFP callout driver of Akamai Guardicore Platform Agent (GPA) allows a local low-privileged user to cause a denial of service (system crash / BSOD) via an outbound ICMPv6 packet containing an IPv6 Hop-by-Hop extension header. When the IPv6 ICMP redirect policy is active, the packet is copied into a buffer that is freed but subsequently passed to a downstream filter. The size of the freed allocation is attacker-controlled (via packet length), enabling kernel pool grooming. Exploitation requires that the non-default IPv6 ICMP capture/redirect policy is enabled for the endpoint."}],"metrics":[{"cvssV3_1":{"baseScore":4.7,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:L/AC:H/PR:L/UI:N/S:U/C:N/I:N/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-416","description":"CWE-416 Use After Free","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-14T05:18:39.774Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"2370e0a545db117bfc48b0f56b2f2f3d6ffcf5eeb00acc853b027f6d5788fab4","data_version":"5.2","first_seen_at":"2026-10-14T07:38:52Z","kind":"advisory","last_material_event_at":"2026-10-14T07:38:52Z","native_id":"CVE-2026-50217","provenance":[{"revision":"43fa906da27b3481e0be9ba016dcc3c4c3c118f4","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-50217"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-14T00:
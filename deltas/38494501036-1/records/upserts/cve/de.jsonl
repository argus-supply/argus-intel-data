{"affected":[{"defaultStatus":"unaffected","modules":["Document Builder (DocBuilder)","FileConverter"],"original_ranges":[{"lessThan":"10.0","status":"affected","version":"0","versionType":"custom"}],"platforms":["Linux"],"product":"Document Server","repo":"https://github.com/ONLYOFFICE/DocumentServer","vendor":"ONLYOFFICE"}],"aliases":["CVE-2026-110385"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A remote code execution vulnerability in ONLYOFFICE Document Server versions before10.0.0 allows an authenticated attacker with a valid Inbox-compatible JWT to execute arbitrary operating system commands as the ds service account. The Document Builder API improperly processes user-controlled converter XML supplied through the optional third argument of builder.SaveFile(). By injecting a duplicate m_sFileTo element, an attacker can override the server-generated output path and write arbitrary content outside the designated job directory. This allows the attacker to overwrite the runtime.json configuration file, modify the Document Builder executable path and arguments, and execute arbitrary commands when a subsequent Document Builder job is processed."}],"metrics":[{"cvssV4_0":{"Automatable":"NOT_DEFINED","Recovery":"NOT_DEFINED","Safety":"NOT_DEFINED","attackComplexity":"LOW","attackRequirements":"NONE","attackVector":"NETWORK","baseScore":8.7,"baseSeverity":"HIGH","privilegesRequired":"LOW","providerUrgency":"NOT_DEFINED","subAvailabilityImpact":"NONE","subConfidentialityImpact":"NONE","subIntegrityImpact":"NONE","userInteraction":"NONE","valueDensity":"NOT_DEFINED","vectorString":"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N","version":"4.0","vulnAvailabilityImpact":"HIGH","vulnConfidentialityImpact":"HIGH","vulnIntegrityImpact":"HIGH","vulnerabilityResponseEffort":"NOT_DEFINED"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-73","description":"CWE-73 External Control of File Name or Path","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-14T00:24:53.582Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"4b131915b548532af9820309afa24bc309ab0a934b4b19ac4fe8f9bc59d535e7","data_version":"5.2","first_seen_at":"2026-10-14T01:14:04Z","kind":"advisory","last_material_event_at":"2026-10-14T01:14:04Z","native_id":"CVE-2026-110385","provenance":[{"revision":"08a8c268f1c76905ed806b4e9ca78f9e22bd9aca","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-110385"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-14T00:24:53Z","record_encoding":{"expanded_bytes":4297,"expanded_sha256":"8819006d061de26ddac2dcab88f298c3540716364050099f9517720cafeafbff","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-110385","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-14T00:24:53.582Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"url":"https://github.com/ONLYOFFICE/DocumentServer/blob/master/CHANGELOG.md"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-14T00:24:53Z","status":"active","title":"CVE-2026-110385"}

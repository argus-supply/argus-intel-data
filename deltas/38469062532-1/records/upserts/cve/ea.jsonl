{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"unknown","version":"consult Xen advisory XSA-520"}],"product":"Xen","vendor":"Xen"}],"aliases":["CVE-2026-102700"],"assertions":[{"affected_indices":[0],"configurations":[{"lang":"en","value":"Xen versions 4.5 through 4.20 are affected.  Xen versions 4.21 and\nnewer as well as 4.4 and older are not affected.\n\nOnly x86 systems are vulnerable.  Arm systems are not vulnerable."}],"datePublic":"2026-10-13T12:00:00.000Z","descriptions":[{"lang":"en","value":"With its original introduction, GNTTAB_cache_flush was made available\nuniformly.  XSA-232 (CVE-2017-14318) then covered an omitted NULL\npointer check, yet the addition of that check failed to adjust the\nsubsequent error path.  That error path fails to drop a page reference in\ncase the specified page is owned by a special system domain (DOM_IO and\nDOM_COW are system domains which can have memory pages assigned to them.)"}],"provider":{"dateUpdated":"2026-10-13T15:45:27.794Z","orgId":"23aa2041-22e1-471f-9209-9b7396fa234f","shortName":"XEN"},"role":"cna","title":"gnttab: cache-flush handling may cause page reference leak"},{"affected_indices":[],"provider":{"dateUpdated":"2026-10-13T16:11:54.099Z","orgId":"af854a3a-2127-422b-91ae-364da2661108","shortName":"CVE"},"role":"adp","title":"CVE Program Container"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"4303907d24d3ca7d9ccd30ed9da8da4add80add967adcf424c18ab81d1aaae44","data_version":"5.2","first_seen_at":"2026-10-13T15:59:25Z","kind":"advisory","last_material_event_at":"2026-10-13T21:15:10Z","native_id":"CVE-2026-102700","provenance":[{"revision":"cd93d2acd85778757a7f13864b668f85463c3e79","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-102700"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"},{"assertion
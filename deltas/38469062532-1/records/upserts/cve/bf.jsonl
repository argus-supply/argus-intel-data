{"affected":[{"original_ranges":[{"lessThan":"2.3.0","status":"affected","version":"1.19.1","versionType":"custom"}],"product":"Komodo","vendor":"Komodo"}],"aliases":["CVE-2026-110005"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The `periphery` agent's container-management functionality of Komodo version 2.2.0 contains an OS command injection vulnerability. An authenticated low-privileged user with `Execute`, or `Read` plus `Logs`, permission on a managed server can supply shell metacharacters in a container name processed by the `DestroyContainer` or `SearchContainerLog` operations. The container name is interpolated without escaping into a command executed using `sh -c`, allowing arbitrary commands to execute as root on the managed host. This permits a user without Komodo's `Terminal` permission to obtain unrestricted host-level command execution."}],"problemTypes":[{"descriptions":[{"description":"CWE-78 Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')","lang":"en"}]}],"provider":{"dateUpdated":"2026-10-13T19:23:52.191Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"role":"cna","title":"Moghtech Komodo contains an OS command injection vulnerability"},{"affected_indices":[],"provider":{"dateUpdated":"2026-10-13T20:08:24.569Z","orgId":"af854a3a-2127-422b-91ae-364da2661108","shortName":"CVE"},"role":"adp","title":"CVE Program Container"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"fea358e7b152003559c7bde380173083e14b9388bb49a404f6ee1b0ade5d177b","data_version":"5.2","first_seen_at":"2026-10-13T21:15:10Z","kind":"advisory","last_material_event_at":"2026-10-13T21:15:10Z","native_id":"CVE-2026-110005","provenance":[{"revision":"cd93d2acd85778757a7f13864b668f85463c3e79","source_id":"cve","url":"https://www.cve.org/CV
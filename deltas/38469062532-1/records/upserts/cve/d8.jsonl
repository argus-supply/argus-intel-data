{"affected":[{"original_ranges":[{"lessThanOrEqual":"*","status":"unaffected","version":"158","versionType":"rpm"}],"product":"Thunderbird","vendor":"Mozilla"}],"aliases":["CVE-2026-110247"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","supportingMedia":[{"base64":false,"type":"text/html","value":"Several buffer-growth sites in libmime performed size arithmetic in 32-bit types without overflow checks. On a sufficiently large message the growth guard could fail open, or the buffer could be reallocated smaller than required, and a subsequent memcpy would then write attacker-controlled data across adjacent heap allocations. This vulnerability was fixed in Thunderbird 158."}],"value":"Several buffer-growth sites in libmime performed size arithmetic in 32-bit types without overflow checks. On a sufficiently large message the growth guard could fail open, or the buffer could be reallocated smaller than required, and a subsequent memcpy would then write attacker-controlled data across adjacent heap allocations. This vulnerability was fixed in Thunderbird 158."}],"provider":{"dateUpdated":"2026-10-13T18:10:20.644Z","orgId":"f16b083a-5664-49f3-a51e-8d479e5ed7fe","shortName":"mozilla"},"role":"cna","title":"Integer overflow in libmime buffer growth could lead to heap corruption"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"53f3ec5716d9abccd7c90c7d03a22f4d655c6513b3cb65f1c6f39ae42ccef52d","data_version":"5.2","first_seen_at":"2026-10-13T21:15:10Z","kind":"advisory","last_material_event_at":"2026-10-13T21:15:10Z","native_id":"CVE-2026-110247","provenance":[{"revision":"cd93d2acd85778757a7f13864b668f85463c3e79","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-110247"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-13T18:08:37Z","record_en
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"4.6.2","status":"affected","version":"4.0.0","versionType":"semver"}],"product":"java-jwt","vendor":"Auth0"}],"aliases":["CVE-2026-85473"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The auth0/java-jwt library may terminate a thread if it receives a JWT with a timestamp claim (exp, nbf, iat) containing an out-of-range value. The condition occurs during token parsing, prior to signature verification. Repeated requests of this nature may lead to degraded availability of the affected service."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"LOW","baseScore":5.3,"baseSeverity":"MEDIUM","confidentialityImpact":"NONE","integrityImpact":"NONE","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:L","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-755","description":"Improper Handling of Exceptional Conditions","lang":"en"}]},{"descriptions":[{"cweId":"CWE-20","description":"Improper Input Validation","lang":"en"}]}],"provider":{"dateUpdated":"2026-10-13T20:15:27.938Z","orgId":"59b22baa-87b2-4371-8e4a-e080df12f74a","shortName":"Okta"},"role":"cna","title":"Out-of-Range Timestamp Claim Handling in auth0/java-jwt"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"a8be796107c147a6a9b09bf16b24453e95b3cbd57cccef70220fefea29c0ab30","data_version":"5.2","first_seen_at":"2026-10-13T21:15:10Z","kind":"advisory","last_material_event_at":"2026-10-13T21:15:10Z","native_id":"CVE-2026-85473","provenance":[{"revision":"cd93d2acd85778757a7f13864b668f85463c3e79","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-85473"},{"assertion_index":0,"independent_evidence":true,"source
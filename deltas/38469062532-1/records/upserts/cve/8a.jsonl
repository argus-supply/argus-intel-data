{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.4.6.0","status":"affected","version":"0","versionType":"semver"}],"product":"Okta Credential Provider for Windows","vendor":"Okta"}],"aliases":["CVE-2026-78628"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Okta Credential Provider for Windows does not validate a serialized credential buffer before interpreting it as a Kerberos logon structure. The buffer size and packed string offsets are not checked. Processing a malformed buffer can cause the credential provider process to terminate unexpectedly or lead to out-of-bounds memory reads and writes, which may result in the disclosure of adjacent process memory into local system logs."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"LOCAL","availabilityImpact":"NONE","baseScore":6,"baseSeverity":"MEDIUM","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"HIGH","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:L/AC:L/PR:H/UI:N/S:U/C:H/I:H/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-20","description":"Improper Input Validation","lang":"en"}]},{"descriptions":[{"cweId":"CWE-125","description":"Out-of-bounds Read","lang":"en"}]},{"descriptions":[{"cweId":"CWE-787","description":"Out-of-bounds Write","lang":"en"}]}],"provider":{"dateUpdated":"2026-10-13T20:17:36.454Z","orgId":"59b22baa-87b2-4371-8e4a-e080df12f74a","shortName":"Okta"},"role":"cna","title":"Improper Input Validation in the Okta Credential Provider for Windows"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"4b51c6e1369829ef049b17e8eeb5ee8c6eb4d3a2e31e2bf8c669199df90fe710","data_version":"5.2","first_seen_at":"2026-10-13T21:15:10Z","kind":"advisory","last_material_event_at":"2026-10-13T21:15:10Z","nativ
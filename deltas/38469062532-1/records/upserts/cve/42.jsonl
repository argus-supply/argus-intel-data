{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-104587"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"blob42 gosuki through commit 6e2bf34 contains a Stored Cross-Site Scripting (XSS) vulnerability. The application uses text/template instead of html/template, failing to perform context-aware auto-escaping on the URL and DisplayURL fields of bookmarks in internal/webui/templates/bookmarks.html. An attacker can craft a malicious bookmark URL containing HTML attribute-breaking payloads that execute arbitrary JavaScript in the victim's browser context when rendered in the local web interface."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-10-13T20:29:47.688Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"4765eb8e6e799a90ff5e07844c7890f48fea15cd34014768f5f45aebbb1876d5","data_version":"5.2","first_seen_at":"2026-10-13T21:15:10Z","kind":"advisory","last_material_event_at":"2026-10-13T21:15:10Z","native_id":"CVE-2026-104587","provenance":[{"revision":"cd93d2acd85778757a7f13864b668f85463c3e79","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-104587"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-13T00:00:00Z","record_encoding":{"expanded_bytes":2925,"expanded_sha256":"1c10a6febcc0546c9f6e84b0ea2ee2706676028f954da08eb595e2c40e1dfaf9","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-104587","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-13T20:29:47.688Z","orgId":"8254265b-2729-46b6-b
{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"unknown","version":"consult Xen advisory XSA-515"}],"product":"Xen","vendor":"Xen"}],"aliases":["CVE-2026-79608"],"assertions":[{"affected_indices":[0],"configurations":[{"lang":"en","value":"Xen versions 4.19.4 and onwards, 4.20.3 and onwards, 4.21.1 and onwards,\nand 4.22 are affected.  Xen versions 4.18, minor versions 4.19.3 and\nearlier, minor versions 4.20.2 and earlier, and 4.21.0 are not affected.\n\nThe vulnerability can only be leveraged on systems running out-of-date\nmicrocode.  Microcode fixing Zenbleed was published in late 2023.\nUpdated firmware subseqeuent to this, or e.g. updated amd-ucode from\nlinux-firmware (for the subset of CPUs covered by linux-firmware) are\nnot vulnerable.\n\nThe original issue and hence the applicability of the workaround is\nspecific to the AMD Zen2 microarchitecture.  AMD do not believe that\nother microarchitectures are affected."}],"datePublic":"2026-10-13T12:00:00.000Z","descriptions":[{"lang":"en","value":"The workaround for XSA-433 (Zenbleed, CVE-2023-20593) was later\nre-worked to better integrate with other manipulations of the same MSR.\nIn this rework an inverted conditional was introduced, resulting in the\nworkaround to not be applied when needed and vice versa.\n\nFor more details, see:\n  http://xenbits.xen.org/xsa/advisory-433.html"}],"provider":{"dateUpdated":"2026-10-13T15:44:08.729Z","orgId":"23aa2041-22e1-471f-9209-9b7396fa234f","shortName":"XEN"},"role":"cna","title":"x86/AMD: ineffectual Zenbleed workaround"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"98dd9967ebe53e30fd69be0b4f84479a2bc18426216e59870d2393856644a7ae","data_version":"5.2","first_seen_at":"2026-10-13T15:59:25Z","kind":"advisory","last_material_event_at":"2026-10-13T15:59:25Z","native_id":"CVE-2026-79608","provenance":[{"revision":"d3d4c352da2af8a616b59f006f2df90ba7d2e379","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-79608"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-13T15:44:08Z","record_encoding":{"expanded_bytes":3248,"expanded_sha256":"7c3f2f81d0f5fd5b0178740dcca4096bdb571389751c84e91d0753c30a12b3f1","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-79608","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-13T15:44:08.729Z","orgId":"23aa2041-22e1-471f-9209-9b7396fa234f","shortName":"XEN"},"url":"https://xenbits.xenproject.org/xsa/advisory-515.html"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-13T15:44:08Z","status":"active","title":"x86/AMD: ineffectual Zenbleed workaround"}

{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"unknown","version":"consult Xen advisory XSA-520"}],"product":"Xen","vendor":"Xen"}],"aliases":["CVE-2026-102700"],"assertions":[{"affected_indices":[0],"configurations":[{"lang":"en","value":"Xen versions 4.5 through 4.20 are affected.  Xen versions 4.21 and\nnewer as well as 4.4 and older are not affected.\n\nOnly x86 systems are vulnerable.  Arm systems are not vulnerable."}],"datePublic":"2026-10-13T12:00:00.000Z","descriptions":[{"lang":"en","value":"With its original introduction, GNTTAB_cache_flush was made available\nuniformly.  XSA-232 (CVE-2017-14318) then covered an omitted NULL\npointer check, yet the addition of that check failed to adjust the\nsubsequent error path.  That error path fails to drop a page reference in\ncase the specified page is owned by a special system domain (DOM_IO and\nDOM_COW are system domains which can have memory pages assigned to them.)"}],"provider":{"dateUpdated":"2026-10-13T15:45:27.794Z","orgId":"23aa2041-22e1-471f-9209-9b7396fa234f","shortName":"XEN"},"role":"cna","title":"gnttab: cache-flush handling may cause page reference leak"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"d60bf8e0b124ea07d981c2e3e0bc0edc53471609b55e2c62ac178d46fc980645","data_version":"5.2","first_seen_at":"2026-10-13T15:59:25Z","kind":"advisory","last_material_event_at":"2026-10-13T15:59:25Z","native_id":"CVE-2026-102700","provenance":[{"revision":"d3d4c352da2af8a616b59f006f2df90ba7d2e379","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-102700"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-13T15:45:27Z","record_encoding":{"expanded_bytes":2949,"expanded_sha256":"f1c33ba870caa0b998dfc8769d9f2530becf0de161b7b3b8e87fc64455ab0b54","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-102700","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-13T15:45:27.794Z","orgId":"23aa2041-22e1-471f-9209-9b7396fa234f","shortName":"XEN"},"url":"https://xenbits.xenproject.org/xsa/advisory-520.html"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-13T15:45:27Z","status":"active","title":"gnttab: cache-flush handling may cause page reference leak"}

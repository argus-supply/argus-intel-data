{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"unknown","version":"consult Xen advisory XSA-516"}],"product":"Xen","vendor":"Xen"}],"aliases":["CVE-2026-79609"],"assertions":[{"affected_indices":[0],"configurations":[{"lang":"en","value":"All versions of Xen with the XPTI work backported to are affected.  In\nupstream these are Xen 4.7.5 and onwards, Xen 4.8.3 and onwards, Xen 4.9.2\nand onwards, Xen 4.10.1 and onwards, and all major releases from 4.11\nonwards.\n\nOnly 64-bit PV guests can leverage the vulnerability.  HVM and PVH guests\ncannot leverage the vulnerability.  32-bit PV guests haven't been security\nsupported anymore.\n\nOnly x86 systems are affected.  Arm systems are not affected.\n\nOnly systems with RAM above the 5 TiB (CONFIG_BIGMEM=y: 3.5 TiB) boundary\nare affected.  Systems with no RAM above the 5 TiB (CONFIG_BIGMEM=y: 3.5\nTiB) boundary are not affected."}],"datePublic":"2026-10-13T12:00:00.000Z","descriptions":[{"lang":"en","value":"XPTI (Xen Page Table Isolation) was introduced to mitigate Meltdown\n(CVE-2017-5754, one aspect of XSA-254).  This involves copying 64-bit PV\nguest page table entries from guest-chosen root page tables to the Xen-\nchosen one which is in actual use by hardware.  To read the guest root\npage table, the directmap is used.  PV guests, however, have a directmap\nwhich may not cover all memory; in particular this is the case if any\nmemory extends beyond the 5 TiB (CONFIG_BIGMEM=y: 3.5 TiB) address\nboundary."}],"provider":{"dateUpdated":"2026-10-13T15:44:24.763Z","orgId":"23aa2041-22e1-471f-9209-9b7396fa234f","shortName":"XEN"},"role":"cna","title":"x86: XPTI may break on huge-memory systems"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"a8ce8c51b4e5697fee4198a0d09481f2246c44bc552e0ef9f888daa4dc728394","data_version":"5.2","first_seen_at":"2026-10-13T15:59:25Z","kind":"advisory","last_material_event_at":"2026-10-13T15:59:25Z","native_id":"CVE-2026-79609","provenance":[{"revision":"d3d4c352da2af8a616b59f006f2df90ba7d2e379","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-79609"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-13T15:44:24Z","record_encoding":{"expanded_bytes":3543,"expanded_sha256":"9fb97349c125ccff26bd6663a9d9c3f27ee5ace45c8070f1fd7cf55b26e2a534","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-79609","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-13T15:44:24.763Z","orgId":"23aa2041-22e1-471f-9209-9b7396fa234f","shortName":"XEN"},"url":"https://xenbits.xenproject.org/xsa/advisory-516.html"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-13T15:44:24Z","status":"active","title":"x86: XPTI may break on huge-memory systems"}

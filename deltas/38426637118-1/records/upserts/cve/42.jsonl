{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"unknown","version":"consult Xen advisory XSA-519"}],"product":"Xen","vendor":"Xen"}],"aliases":["CVE-2026-102702"],"assertions":[{"affected_indices":[0],"configurations":[{"lang":"en","value":"All Xen versions from 4.5 onwards are vulnerable.  Xen versions 4.4 and\nearlier are not vulnerable.\n\nOnly Arm systems are vulnerable.  x86 systems are not vulnerable."}],"datePublic":"2026-10-13T12:00:00.000Z","descriptions":[{"lang":"en","value":"[This CNA information record relates to multiple CVEs; the\ntext explains which aspects/vulnerabilities correspond to which CVE.]\n\n1) XSA-437 (CVE-2023-34321) addressed issues with overflows in\n   calculations involved in guests flushing caches through\n   GNTTABOP_cache_flush.  Unfortunately the fix there introduced a\n   calculation which may underflow, resulting in a loop which would - at\n   least on 64-bit Arm - take excessively long, and which would likely\n   eventually crash the hypervisor.\n\n   This is CVE-2026-102699.\n\n2) GNTTABOP_cache_flush may be issued on memory mapped from another\n   domain using the grant table interface.  However there was no\n   restriction to disallow the use of invalidate-without-clean against\n   read-only grant mappings, which may corrupt the granted memory.\n\n   This is CVE-2026-102702."}],"provider":{"dateUpdated":"2026-10-13T15:45:13.125Z","orgId":"23aa2041-22e1-471f-9209-9b7396fa234f","shortName":"XEN"},"role":"cna","title":"Arm: multiple issues with GNTTABOP_cache_flush"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"2ee1fe08f226699a2734bddafc9df65d9918c86e9109ca9ae13cf19de5b78aea","data_version":"5.2","first_seen_at":"2026-10-13T15:59:25Z","kind":"advisory","last_material_event_at":"2026-10-13T15:59:25Z","native_id":"CVE-2026-102702","provenance":[{"revisi
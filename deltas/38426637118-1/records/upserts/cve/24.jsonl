{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"unknown","version":"consult Xen advisory XSA-517"}],"product":"Xen","vendor":"Xen"}],"aliases":["CVE-2026-79610"],"assertions":[{"affected_indices":[0],"configurations":[{"lang":"en","value":"All Xen versions from 4.0 onwards are vulnerable.  Xen versions 3.4 and\nearlier are not vulnerable.\n\nOnly x86 guests permitted to use grant table version 2 interfaces can\nleverage this vulnerability.  On Arm, grant table v2 use is explicitly\nunsupported.\n\nOnly multi-vCPU guests can leverage this vulnerability.\n\nXen versions 4.13 and newer offer a way to build Xen without grant table\nsupport.  Such hypervisors (CONFIG_GRANT_TABLE turned off) are not\nvulnerable."}],"datePublic":"2026-10-13T12:00:00.000Z","descriptions":[{"lang":"en","value":"XSA-501 was about issues with v1 -> v2 and v2 -> v1 changes racing certain\nother grant table operations.  Sadly a v2 -> v1 -> v2 change has yet\nanother effect which wasn't accounted for: During the first change, status\npages would be freed.  During the second change they would be allocated\nagain.  Hence across the full pair of change the addresses of the status\npages may change, rendering stale previously calculated pointers into the\nstatus array."}],"provider":{"dateUpdated":"2026-10-13T15:44:42.370Z","orgId":"23aa2041-22e1-471f-9209-9b7396fa234f","shortName":"XEN"},"role":"cna","title":"grant-table: double version change race"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"9493d41f42261d747099db5b983e60505a7e6b6594fc561cd931ca870d5f72ba","data_version":"5.2","first_seen_at":"2026-10-13T15:59:25Z","kind":"advisory","last_material_event_at":"2026-10-13T15:59:25Z","native_id":"CVE-2026-79610","provenance":[{"revision":"d3d4c352da2af8a616b59f006f2df90ba7d2e379","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-79610"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-13T15:44:42Z","record_encoding":{"expanded_bytes":3257,"expanded_sha256":"903172c8e3dc0f118a8a315de5f1b27f78afd48bb8e6ebe11e52c5392f4e8cc6","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-79610","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-13T15:44:42.370Z","orgId":"23aa2041-22e1-471f-9209-9b7396fa234f","shortName":"XEN"},"url":"https://xenbits.xenproject.org/xsa/advisory-517.html"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-13T15:44:42Z","status":"active","title":"grant-table: double version change race"}

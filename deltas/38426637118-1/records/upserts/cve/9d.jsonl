{"affected":[{"defaultStatus":"unknown","original_ranges":[{"lessThan":"V31.01.13","status":"affected","version":"0","versionType":"custom"}],"product":"SIMATIC IPC BX-21A","vendor":"Siemens"},{"defaultStatus":"unknown","original_ranges":[{"lessThan":"V1.1.4","status":"affected","version":"0","versionType":"custom"}],"product":"SIMATIC IPC RW-543A","vendor":"Siemens"},{"defaultStatus":"unknown","original_ranges":[{"lessThan":"V28.01.15","status":"affected","version":"0","versionType":"custom"}],"product":"SIMATIC IPC227G / IPC277G / IPC277G PRO / IPC327G / IPC377G","vendor":"Siemens"}],"aliases":["CVE-2026-72895"],"assertions":[{"affected_indices":[0,1,2],"descriptions":[{"lang":"en","value":"A vulnerability has been identified in SIMATIC IPC BX-21A (All versions < V31.01.13), SIMATIC IPC RW-543A (All versions < V1.1.4), SIMATIC IPC227G / IPC277G / IPC277G PRO / IPC327G / IPC377G (All versions < V28.01.15). A BIOS vendor test key is present in the UEFI Secure Boot key database. This could allow a local attacker with physical or administrative access to the device to boot an operating system or UEFI application signed with that test key, bypassing UEFI Secure Boot protections even when Secure Boot is enabled, potentially leading to a full loss of confidentiality, integrity, and availability of the device."}],"metrics":[{"cvssV3_1":{"baseScore":7.7,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:L/AC:H/PR:N/UI:R/S:C/C:H/I:H/A:H","version":"3.1"}},{"cvssV4_0":{"baseScore":8.4,"baseSeverity":"HIGH","vectorString":"CVSS:4.0/AV:L/AC:L/AT:N/PR:N/UI:A/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N","version":"4.0"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-1394","description":"CWE-1394: Use of Default Cryptographic Key","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-13T09:18:54.197Z","orgId":"cec7a2ec-15b4-4faf-bd53-b40f371f3a77","shortName":"siemens"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuratio
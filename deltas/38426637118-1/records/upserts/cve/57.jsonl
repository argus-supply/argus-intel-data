{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"unknown","version":"consult Xen advisory XSA-518"}],"product":"Xen","vendor":"Xen"}],"aliases":["CVE-2026-79611"],"assertions":[{"affected_indices":[0],"configurations":[{"lang":"en","value":"All versions of Xen are affected.\n\nOnly systems supporting VMX hardware virtual extensions (Intel, VIA or\nZhaoxin CPUs) are affected.  Arm as well as AMD and Hygon systems are\nunaffected.\n\nOnly HVM/PVH guests are affected.  PV guests cannot leverage the\nvulnerability."}],"datePublic":"2026-10-13T12:00:00.000Z","descriptions":[{"lang":"en","value":"For XSA-308 logic was introduced, as VMX VMEntry checks do not like the\nexact combination of state which occurs when #DB in intercepted, Single\nStepping is active, and blocked by STI/MovSS is active, despite this being\na legitimate state to be in.  The resulting VMEntry failure is fatal to\nthe guest.\n\nSadly there is another special sub-case of the above, with branch tracing\nenabled.  In that case the prior adjustment would still cause a VMentry\nfailure, as before fatal to the guest."}],"provider":{"dateUpdated":"2026-10-13T15:44:56.361Z","orgId":"23aa2041-22e1-471f-9209-9b7396fa234f","shortName":"XEN"},"role":"cna","title":"VMX: VMentry failure with branch tracing and blocked states"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"29cf388f3b5db9abc6aa0c26aa70d273b60bd1796c67b5f7c0162a53a4e6a09e","data_version":"5.2","first_seen_at":"2026-10-13T15:59:25Z","kind":"advisory","last_material_event_at":"2026-10-13T15:59:25Z","native_id":"CVE-2026-79611","provenance":[{"revision":"d3d4c352da2af8a616b59f006f2df90ba7d2e379","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-79611"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-13T15:44:56Z","record_encoding":{"expanded_bytes":3173,"expanded_sha256":"23ead3fc00256972042f27c3f38b655b2e9a9918ef50f0027d43fa8334050ad8","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-79611","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-13T15:44:56.361Z","orgId":"23aa2041-22e1-471f-9209-9b7396fa234f","shortName":"XEN"},"url":"https://xenbits.xenproject.org/xsa/advisory-518.html"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-13T15:44:56Z","status":"active","title":"VMX: VMentry failure with branch tracing and blocked states"}

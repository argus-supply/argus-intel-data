{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["WebDyne"],"original_ranges":[{"lessThan":"3.022","status":"affected","version":"2.014","versionType":"custom"}],"packageName":"WebDyne","packageURL":"pkg:cpan/WebDyne","programFiles":["lib/WebDyne.pm","lib/WebDyne/HTML/Tiny.pm"],"programRoutines":[{"name":"WebDyne::HTML::Tiny::entity_encode"}],"repo":"https://github.com/aspeer/WebDyne"}],"aliases":["CVE-2026-78190"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"WebDyne versions from 2.014 before 3.022 for Perl reflect request parameters unescaped into form field values, allowing cross-site scripting.\n\nThe textfield, password_field and filefield tags fill their value attribute from the request parameter of the same name. WEBDYNE_CGI_AUTOESCAPE, which controls escaping of these values, defaults to off. From 2.022, WebDyne::HTML::Tiny also replaced its entity_encode method with one that returns its input unchanged, so enabling WEBDYNE_CGI_AUTOESCAPE has no effect.\n\nA remote attacker can inject script into any page using these tags through a crafted link."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-79","description":"CWE-79 Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-31T14:34:14.014Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"WebDyne versions from 2.014 before 3.022 for Perl reflect request parameters unescaped into form field values, allowing cross-site scripting"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"ef0c128ff9d47f3344d958e1aad1679f4ad6d08e4d72d51eaa70a0752ceb3566","data_version":"5.2","first_seen_at":"2026-10-31T18:34:27Z","kind":"advisory","last_material_event_at":
{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["WebDyne"],"original_ranges":[{"lessThan":"3.022","status":"affected","version":"2.031","versionType":"custom"}],"packageName":"WebDyne","packageURL":"pkg:cpan/WebDyne","programFiles":["lib/WebDyne/Constant.pm","lib/WebDyne/Request/PAGI.pm","lib/WebDyne/Request/PSGI.pm"],"repo":"https://github.com/aspeer/WebDyne"}],"aliases":["CVE-2026-78191"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"WebDyne versions from 2.031 before 3.022 for Perl execute files with .psp anywhere in the name as Perl pages.\n\nWebDyne decides whether to run a requested file as a page by matching its name against WEBDYNE_PSP_EXT_RE, which has no end anchor.\n\nAn application that accepts uploads by checking only the final extension lets a remote attacker upload a file such as report.psp.pdf and run its embedded Perl by requesting it."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-777","description":"CWE-777 Regular Expression without Anchors","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-31T14:34:30.167Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"WebDyne versions from 2.031 before 3.022 for Perl execute files with .psp anywhere in the name as Perl pages"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"d3e8561eb59b458a1dbed588649e5d9cb3c12e088cb1205954dc952913f4efb9","data_version":"5.2","first_seen_at":"2026-10-31T18:34:27Z","kind":"advisory","last_material_event_at":"2026-10-31T18:34:27Z","native_id":"CVE-2026-78191","provenance":[{"revision":"5fbb02b0e112c25881cbb406ff6484302babb39e","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-78191"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026
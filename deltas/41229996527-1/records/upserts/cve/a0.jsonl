{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["WebDyne"],"original_ranges":[{"lessThan":"3.022","status":"affected","version":"2.014","versionType":"custom"}],"packageName":"WebDyne","packageURL":"pkg:cpan/WebDyne","programFiles":["lib/WebDyne/Session.pm"],"programRoutines":[{"name":"WebDyne::Session::handler"}],"repo":"https://github.com/aspeer/WebDyne"}],"aliases":["CVE-2026-78188"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"WebDyne versions from 2.014 before 3.022 for Perl issue session cookies without the Secure, HttpOnly and SameSite attributes.\n\nWebDyne::Session sets its session cookie with only a name, value and path.\n\nBrowsers then send the session ID over plain HTTP and with cross-site requests, and expose it to page scripts. A network attacker or an injected script can steal the session, and another site can make requests that carry it."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-614","description":"CWE-614 Sensitive Cookie in HTTPS Session Without 'Secure' Attribute","lang":"en","type":"CWE"}]},{"descriptions":[{"cweId":"CWE-1004","description":"CWE-1004 Sensitive Cookie Without 'HttpOnly' Flag","lang":"en","type":"CWE"}]},{"descriptions":[{"cweId":"CWE-1275","description":"CWE-1275 Sensitive Cookie with Improper SameSite Attribute","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-31T14:33:37.285Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"WebDyne versions from 2.014 before 3.022 for Perl issue session cookies without the Secure, HttpOnly and SameSite attributes"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"9fdc053661a1788a7907dbb1db358b8e3e3348ac8ee702141155dcc9cdcbbea8","data_version":"5.2","first_seen_at":"2026-10-31T18:34:27Z","kind":"advisory","last_material_event_at":"2026-10-31T18:34:27Z","native_id":"CVE-2026-78188","provenance":[{"revision":"5fbb02b0e112c25881cbb406ff6484302babb39e","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-78188"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-31T14:33:37Z","record_encoding":{"expanded_bytes":3554,"expanded_sha256":"7351083efa7ad32d8b3ad4c9a1b39208374896698c27c652715f658cc8c93a9d","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-78188","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-31T14:33:37.285Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"tags":["release-notes"],"url":"https://metacpan.org/release/ASPEER/WebDyne-3.022/changes"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-31T14:33:37Z","status":"active","title":"WebDyne versions from 2.014 before 3.022 for Perl issue session cookies without the Secure, HttpOnly and SameSite attributes"}

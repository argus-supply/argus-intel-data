{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["Google::Auth"],"original_ranges":[{"lessThanOrEqual":"0.12","status":"affected","version":"0.11","versionType":"custom"}],"packageName":"Google-Auth","packageURL":"pkg:cpan/Google-Auth","programFiles":["bin/gcloud-auth.pl"],"repo":"https://github.com/GoogleCloudPlatform/google-auth-library-perl"}],"aliases":["CVE-2026-74760"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Google::Auth versions from 0.11 through 0.12 for Perl accept an authorization code from any local process because the gcloud-auth login callback does not check the OAuth state.\n\nThe gcloud-auth login and application-default login commands send a state parameter with the authorization request, then take the code from the first request to reach their loopback listener without comparing the returned state.\n\nA local attacker can submit an authorization code for their own Google account. The CLI exchanges it and stores the refresh token as the user's credentials, so the user's tools then act as the attacker's account."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-346","description":"CWE-346 Origin Validation Error","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-01T16:43:34.512Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"Google::Auth versions from 0.11 through 0.12 for Perl accept an authorization code from any local process because the gcloud-auth login callback does not check the OAuth state"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"a685ec97bf8d9772ca813564f2c216c82734afffc8ae73b6ba1513ad7b70a779","data_version":"5.2","first_seen_at":"2026-11-01T18:56:49Z","kind":"advisory","last_material_event_at":"2026-11-01T18:56:49Z","native_id":"CVE-2026-74760","provenance":[{"revision":"36ecd50114303c2bd43547f0d485b02e32e9879e","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-74760"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-01T16:43:34Z","record_encoding":{"expanded_bytes":3753,"expanded_sha256":"339f1a11d467ea18c0f3413c2a89da68aaae409dcf9ef3f0d5239fa987b7641b","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-74760","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-01T16:43:34.512Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"tags":["technical-description"],"url":"https://metacpan.org/release/CJCOLLIER/Google-Auth-0.12/source/bin/gcloud-auth.pl"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-11-01T16:43:34Z","status":"active","title":"Google::Auth versions from 0.11 through 0.12 for Perl accept an authorization code from any local process because the gcloud-auth login callback does not check the OAuth state"}

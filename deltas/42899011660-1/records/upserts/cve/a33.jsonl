{"affected":[{"defaultStatus":"affected","original_ranges":[{"lessThan":"*","status":"affected","version":"1.0.0","versionType":"custom"}],"platforms":["Wi-Fi Access Points C-260","Wi-Fi Access Points C-250"],"product":"Wi-Fi Access Point","vendor":"Arista Networks"}],"aliases":["CVE-2026-102166"],"assertions":[{"affected_indices":[0],"configurations":[{"lang":"en","supportingMedia":[{"base64":false,"type":"text/html","value":"<pre>No specific configuration required. Vulnerability is specific to C-260 and C-250 access point hardware models.</pre>"}],"value":"No specific configuration required. Vulnerability is specific to C-260 and C-250 access point hardware models."}],"descriptions":[{"lang":"en","value":"Arista C-260 and C-250 access points ship with fleet-wide static cryptographic keys used for firmware image verification and SSLP authentication. An attacker who is able to access these keys would be able to create modified firmware that will pass verification checks. This vulnerability is specific to the C-260 and C-250 models; other access point models enforce digitally signed upgrade images with secure boot and are not affected by this issue."}],"metrics":[{"cvssV3_1":{"baseScore":8.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:A/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","version":"3.1"}},{"cvssV4_0":{"baseScore":9.4,"baseSeverity":"CRITICAL","vectorString":"CVSS:4.0/AV:A/AC:L/AT:N/PR:N/UI:N/VC:H/VI:H/VA:H/SC:H/SI:H/SA:H","version":"4.0"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-798","description":"CWE-798 Use of Hard-coded Credentials","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-10T20:09:50.306Z","orgId":"c8b34d1a-69ae-45c3-88fe-f3b3d44f39b7","shortName":"Arista"},"role":"cna","title":"Security Advisory 0227"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"f393fc67f84ada5b81cb21b3c6
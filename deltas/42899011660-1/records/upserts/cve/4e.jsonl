{"affected":[{"cpes":["cpe:2.3:a:docker:desktop:*:*:*:*:*:*:*:*"],"defaultStatus":"unaffected","original_ranges":[{"lessThan":"4.94.0","status":"affected","version":"4.43.0","versionType":"semver"},{"status":"unaffected","version":"4.94.0","versionType":"semver"}],"platforms":["Linux","MacOS","Windows"],"product":"Docker Desktop","vendor":"Docker"}],"aliases":["CVE-2026-123082"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Docker Desktop before version 4.94.0 could write the signed-in user's Docker Hub access token (a JWT) in cleartext to application logs and diagnostics bundles. IPC payloads that were bare JSON strings or arrays were not redacted before logging, and a Docker Desktop component logged the token when it requested it from the backend. An attacker with read access to these files could obtain the token and use it to read and modify the user's Docker Hub data as that user while the token remains valid. Docker Desktop 4.94.0 redacts these payloads. The fix does not rewrite logs written by earlier versions, which can still contain tokens after upgrading."}],"metrics":[{"cvssV4_0":{"Automatable":"NOT_DEFINED","Recovery":"NOT_DEFINED","Safety":"NOT_DEFINED","attackComplexity":"LOW","attackRequirements":"PRESENT","attackVector":"LOCAL","baseScore":5.7,"baseSeverity":"MEDIUM","exploitMaturity":"NOT_DEFINED","privilegesRequired":"LOW","providerUrgency":"NOT_DEFINED","subAvailabilityImpact":"NONE","subConfidentialityImpact":"LOW","subIntegrityImpact":"LOW","userInteraction":"NONE","valueDensity":"NOT_DEFINED","vectorString":"CVSS:4.0/AV:L/AC:L/AT:P/PR:L/UI:N/VC:H/VI:N/VA:N/SC:L/SI:L/SA:N","version":"4.0","vulnAvailabilityImpact":"NONE","vulnConfidentialityImpact":"HIGH","vulnIntegrityImpact":"NONE","vulnerabilityResponseEffort":"NOT_DEFINED"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-532","description":"CWE-532: Insertion of Sensitive Information into Log File","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-10T14:37:24.600Z","orgId":"686469e6-3ff6-451b-ab8b-cf5b9e89401e","shortName":"Docker"},"role":"cna","title":"Docker Desktop logs can expose the Docker Hub access token"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"1a03f42ed2eff1f557463a9c255ddefef840b9a0da8e506cc26fddd80626e563","data_version":"5.2","first_seen_at":"2026-11-10T20:50:09Z","kind":"advisory","last_material_event_at":"2026-11-10T20:50:09Z","native_id":"CVE-2026-123082","provenance":[{"revision":"cd87b009c69cb95c2b9f35c35b81e00a7c52601d","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-123082"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-10T14:37:24Z","record_encoding":{"expanded_bytes":4229,"expanded_sha256":"b8942d25bc1cdcb5a80bfbce271659a0d155f9fb7d0b96d60790757116ebbb2a","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-123082","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-10T14:37:24.600Z","orgId":"686469e6-3ff6-451b-ab8b-cf5b9e89401e","shortName":"Docker"},"tags":["release-notes"],"url":"https://docs.docker.com/desktop/release-notes/#4940"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-11-10T14:37:24Z","status":"active","title":"Docker Desktop logs can expose the Docker Hub access token"}

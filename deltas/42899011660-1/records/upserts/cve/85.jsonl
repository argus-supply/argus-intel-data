{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.43.0","status":"affected","version":"1.40","versionType":"custom"}],"product":"Armeria","vendor":"LY Corporation"}],"aliases":["CVE-2026-121819"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A vulnerability has been identified in armeria-xds versions 1.40.0 through 1.42.0, where DataSourcePolicy checks filename containment without resolving symbolic links, allowing a compromised or semi-trusted xDS control plane to cause the xDS client to read files outside configured allowed root directories when a symbolic link inside an allowed directory points outside it. In deployments using a credential injector, header-compatible text secrets may be exposed to an attacker-observable upstream."}],"metrics":[{"cvssV4_0":{"baseScore":5.9,"baseSeverity":"MEDIUM","vectorString":"CVSS:4.0/AV:N/AC:L/AT:P/PR:H/UI:N/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N","version":"4.0"}}],"problemTypes":[{"descriptions":[{"description":"CWE-59","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-06T07:46:45.370Z","orgId":"657f3255-0560-4aed-82e4-7f579ec6acfb","shortName":"LY-Corporation"},"role":"cna"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-121819","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-11-10T17:22:34.642521Z","version":"2.0.3"},"type":"ssvc"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-59","description":"CWE-59 Improper Link Resolution Before File Access ('Link Following')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-10T17:23:02.739Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"55da270
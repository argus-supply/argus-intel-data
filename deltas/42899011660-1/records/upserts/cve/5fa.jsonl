{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.5.0p16","status":"affected","version":"2.5.0","versionType":"semver"}],"product":"Checkmk","vendor":"Checkmk GmbH"}],"aliases":["CVE-2026-103674"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Invocation of the NetApp ONTAP special agent with the login password in the command line in Checkmk version 2.5.0 before 2.5.0p16 allows a local user on the Checkmk server to read the NetApp login password from the process list while the special agent is running. This affects both explicitly configured passwords and passwords from the password store."}],"metrics":[{"cvssV4_0":{"baseScore":2,"baseSeverity":"LOW","vectorString":"CVSS:4.0/AV:L/AC:L/AT:P/PR:L/UI:N/VC:L/VI:N/VA:N/SC:L/SI:L/SA:L","version":"4.0"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-214","description":"CWE-214: Invocation of Process Using Visible Sensitive Information","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-06T09:06:40.803Z","orgId":"f7d6281c-4801-44ce-ace2-493291dedb0f","shortName":"Checkmk"},"role":"cna","title":"NetApp ONTAP special agent exposes password in process list"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-103674","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-11-10T17:40:30.843560Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-11-10T17:42:41.362Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"6efd8067a906c6ca4040d03f2c4284071f349d5c7cea9d5c32a3682c2af706c1","data_version":"5.2","first_seen_at":"2026-11-06T15:55:58Z","kind":"advisory","last_material_event_at":"2
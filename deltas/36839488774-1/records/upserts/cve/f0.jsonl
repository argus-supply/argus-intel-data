{"affected":[{"defaultStatus":"unknown","original_ranges":[{"lessThanOrEqual":"1.8","status":"affected","version":"0","versionType":"semver"}],"product":"BackupSheep WordPress Backup Plugin","vendor":"Unknown"}],"aliases":["CVE-2026-101148"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The BackupSheep WordPress Backup Plugin WordPress plugin through 1.8 does not properly validate its integration key, treating an unset or blank key as valid, which allows unauthenticated attackers to create and download full site backups, including the database with user password hashes, and to delete arbitrary files on the server, leading to sensitive data disclosure and site takeover.\n\nThe BackupSheep WordPress Backup Plugin WordPress plugin through 1.8 has been closed on WordPress.org since July 2024 and no fixed version is available. Remove it from any site where it is installed."}],"problemTypes":[{"descriptions":[{"description":"CWE-73 External Control of File Name or Path","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-01T06:00:23.265Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"BackupSheep <= 1.8 - Unauthenticated Arbitrary File Deletion and Backup Exfiltration via Empty Integration Key"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"e27efcedf497bd0caf04a8eb7ed86ced18709930fee2f2da0cff0dd74552fbe0","data_version":"5.2","first_seen_at":"2026-10-01T08:57:21Z","kind":"advisory","last_material_event_at":"2026-10-01T08:57:21Z","native_id":"CVE-2026-101148","provenance":[{"revision":"2ddf968cb27fd9c4a948ab5c0038c39a95d43ae6","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-101148"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-01T06:00:23Z","record_encoding":{"expanded
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"3.3.71","status":"affected","version":"0","versionType":"semver"}],"product":"Download Manager","vendor":"Unknown"}],"aliases":["CVE-2026-86610"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Download Manager WordPress plugin before 3.3.71 does not sufficiently sanitise and escape a package setting before outputting it back in a page, which could allow users with the Author role and above to perform Stored Cross-Site Scripting attacks against any visitor who opens the package's download dialogue, including administrators. Only sites running PHP below 8.1 are affected, as the sanitisation applied when the setting is saved does not neutralise single quotes there."}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Cross-Site Scripting (XSS)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-01T06:00:24.337Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Download Manager < 3.3.71 - Author+ Stored XSS via Package Icon"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"102d71f14e96c9d591909675e8ee022ccdb742ba32284f8a96a4307e0d3ec1b8","data_version":"5.2","first_seen_at":"2026-10-01T08:57:21Z","kind":"advisory","last_material_event_at":"2026-10-01T08:57:21Z","native_id":"CVE-2026-86610","provenance":[{"revision":"2ddf968cb27fd9c4a948ab5c0038c39a95d43ae6","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-86610"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-01T06:00:24Z","record_encoding":{"expanded_bytes":3029,"expanded_sha256":"dba6fddd0b03738383fedcd9d6ff0a982802ef50a3b8724ec01ee7059df920a7","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_so
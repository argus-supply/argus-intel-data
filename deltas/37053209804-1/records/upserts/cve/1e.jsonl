{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-51915"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"TransformerOptimus SuperAGI v0.0.14 is vulnerable to Incorrect Access Control in the tool controller. In affected source snapshots, get_tool and update_tool in superagi/controllers/tool.py accept a caller-supplied tool_id and fail to verify organization ownership through the associated toolkit. A remote authenticated attacker from one organization can read or modify another organization's tool metadata through /tools/get/{tool_id} and /tools/update/{tool_id}."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-10-02T15:44:17.179Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"1cf37ebab551c79cd83e0279410df29045ac220fd9e7a61a6b44065d694a2e31","data_version":"5.2","first_seen_at":"2026-10-02T19:19:00Z","kind":"advisory","last_material_event_at":"2026-10-02T19:19:00Z","native_id":"CVE-2026-51915","provenance":[{"revision":"49e31d5dfadc44c444b81a413f046cdd5b4f0273","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-51915"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-02T00:00:00Z","record_encoding":{"expanded_bytes":2687,"expanded_sha256":"f8c9e6a83b632483d59143ee1c68e84a64586c15ff0de5f4ec7f16f5e51d4291","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-51915","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-02T15:44:17.179Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mit
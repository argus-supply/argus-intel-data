{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-51904"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"SuperAGI up to v0.0.14 contains an improper access control vulnerability in the agent execution controller. In affected source snapshots, create_agent_execution and create_agent_run in superagi/controllers/agent_execution.py accept a caller-supplied agent_id and fail to verify that the referenced agent belongs to the authenticated user's organization. A remote authenticated attacker from one organization can create or start execution records for agents owned by another organization through /agentexecutions/add or /agentexecutions/add_run."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-10-02T15:36:44.937Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"8c71706c4765342bcb893e25ef94edbc0129f37054cb5eb14b56e94419804c4e","data_version":"5.2","first_seen_at":"2026-10-02T19:19:00Z","kind":"advisory","last_material_event_at":"2026-10-02T19:19:00Z","native_id":"CVE-2026-51904","provenance":[{"revision":"49e31d5dfadc44c444b81a413f046cdd5b4f0273","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-51904"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-02T00:00:00Z","record_encoding":{"expanded_bytes":2849,"expanded_sha256":"53d822613fe7c3f083b8bd163437f354725ac80429cb9326d26819c100a884fa","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-51904","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-
{"affected":[{"defaultStatus":"unknown","modules":["ktls"],"original_ranges":[{"lessThan":"p4","status":"affected","version":"15.1-RELEASE","versionType":"release"},{"lessThan":"p14","status":"affected","version":"15.0-RELEASE","versionType":"release"},{"lessThan":"p1","status":"affected","version":"14.5-RELEASE","versionType":"release"},{"lessThan":"p10","status":"affected","version":"14.4-RELEASE","versionType":"release"}],"product":"FreeBSD","vendor":"FreeBSD"}],"aliases":["CVE-2026-101302"],"assertions":[{"affected_indices":[0],"datePublic":"2026-09-29T20:30:00.000Z","descriptions":[{"lang":"en","value":"TLS 1.3 embeds the actual record type as the last non-zero byte of the decrypted payload, optionally followed by zero padding.  The code which searches for the inner record type had an off-by-one bug which could be triggered by an invalid frame, leading to an underflow followed by an unconditional NULL pointer dereference, causing a kernel panic.\n\nA remote TLS 1.3 peer can send a specially crafted record to trigger a kernel panic, resulting in a Denial of Service (DoS)."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-193","description":"CWE-193: Off-by-one Error","lang":"en","type":"CWE"},{"cweId":"CWE-476","description":"CWE-476: NULL Pointer Dereference","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-15T06:53:12.242Z","orgId":"63664ac6-956c-4cba-a5d0-f46076e16109","shortName":"freebsd"},"role":"cna","title":"Remote DoS via receive-side kernel TLS"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"91d0717f52551671ff97e3fa30088de7af49400974e97d02347b5f9faaec22ae","data_version":"5.2","first_seen_at":"2026-10-15T11:29:28Z","kind":"advisory","last_material_event_at":"2026-10-15T11:29:28Z","native_id":"CVE-2026-101302","provenance":[{"revision":"84c1500b89d4a5d9af483fd5109f4ddedbe1f5a7","sourc
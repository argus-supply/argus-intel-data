{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"2.6.0","status":"affected","version":"0","versionType":"semver"}],"product":"Tracking Code Manager","vendor":"data443"}],"aliases":["CVE-2026-15180"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Tracking Code Manager plugin for WordPress is vulnerable to Reflected Cross-Site Scripting via 'TCM_ErrorMessages' POST Parameter in all versions up to, and including, 2.6.0 due to insufficient input sanitization and output escaping. This makes it possible for unauthenticated attackers to inject arbitrary web scripts in pages that execute if they can successfully trick a user into performing an action such as clicking on a link."}],"metrics":[{"cvssV3_1":{"baseScore":6.1,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-79","description":"CWE-79 Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-15T05:30:23.127Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"Tracking Code Manager <= 2.6.0 - Reflected Cross-Site Scripting via 'TCM_ErrorMessages'"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"3d1816d6a1b10c134cc1a75520d9628c4ebb2b6f0ea679cad630b4c0a1b2673a","data_version":"5.2","first_seen_at":"2026-10-15T11:29:28Z","kind":"advisory","last_material_event_at":"2026-10-15T11:29:28Z","native_id":"CVE-2026-15180","provenance":[{"revision":"84c1500b89d4a5d9af483fd5109f4ddedbe1f5a7","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-15180"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-15T05:30:23Z","record
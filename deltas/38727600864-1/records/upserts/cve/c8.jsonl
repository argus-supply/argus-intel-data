{"affected":[{"defaultStatus":"unknown","modules":["sound"],"original_ranges":[{"lessThan":"p5","status":"affected","version":"15.1-RELEASE","versionType":"release"},{"lessThan":"p2","status":"affected","version":"14.5-RELEASE","versionType":"release"},{"lessThan":"p11","status":"affected","version":"14.4-RELEASE","versionType":"release"}],"product":"FreeBSD","vendor":"FreeBSD"}],"aliases":["CVE-2026-101308"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-14T18:45:00.000Z","descriptions":[{"lang":"en","value":"When an audio channel's buffer needs to be resized, the sound(4) driver checks that the buffer is not memory-mapped and then drops the channel lock to allocate a new buffer.  An mmap(2) call on another thread can complete during this window, after which the resize path frees the now-mapped buffer without rechecking.\n\nAn unprivileged local user with access to a sound device can exploit this race to trigger a use-after-free in the kernel, potentially escalating privileges."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-367","description":"CWE-367: Time-of-check Time-of-use (TOCTOU) Race Condition","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-15T07:08:52.619Z","orgId":"63664ac6-956c-4cba-a5d0-f46076e16109","shortName":"freebsd"},"role":"cna","title":"TOCTOU race between sound(4) buffer resizing and mmap"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"47496e8dbe39095506b1158c3792597d88f04e615396d561403aacb7be1d8c06","data_version":"5.2","first_seen_at":"2026-10-15T11:29:28Z","kind":"advisory","last_material_event_at":"2026-10-15T11:29:28Z","native_id":"CVE-2026-101308","provenance":[{"revision":"84c1500b89d4a5d9af483fd5109f4ddedbe1f5a7","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-101308"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-15T07:08:52Z","record_encoding":{"expanded_bytes":3251,"expanded_sha256":"37a2ac063d97fa17e27c4445021830da5dd1d0b1ab594f2dc4be557c9f9dedec","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-101308","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-15T07:08:52.619Z","orgId":"63664ac6-956c-4cba-a5d0-f46076e16109","shortName":"freebsd"},"tags":["vendor-advisory"],"url":"https://security.freebsd.org/advisories/FreeBSD-SA-26:71.sound.asc"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-15T07:08:52Z","status":"active","title":"TOCTOU race between sound(4) buffer resizing and mmap"}

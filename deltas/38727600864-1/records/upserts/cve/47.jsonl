{"affected":[{"defaultStatus":"unknown","modules":["kqueue"],"original_ranges":[{"lessThan":"p4","status":"affected","version":"15.1-RELEASE","versionType":"release"}],"product":"FreeBSD","vendor":"FreeBSD"}],"aliases":["CVE-2026-58099"],"assertions":[{"affected_indices":[0],"datePublic":"2026-09-29T20:30:00.000Z","descriptions":[{"lang":"en","value":"When copying knotes from a parent kqueue to a child, the copy code did not correctly exclude marker knotes (used internally to track list traversal position) before marking them as in-flux and releasing the kqueue lock.  If another thread freed a marker while the lock was dropped, the subsequent in-flux decrement operated on freed memory.\n\nAn unprivileged local user may be able to exploit these races to escalate privileges."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-362","description":"CWE-362: Concurrent Execution using Shared Resource with Improper Synchronization ('Race Condition')","lang":"en","type":"CWE"},{"cweId":"CWE-416","description":"CWE-416: Use After Free","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-15T06:31:18.042Z","orgId":"63664ac6-956c-4cba-a5d0-f46076e16109","shortName":"freebsd"},"role":"cna","title":"Memory safety bugs in kqueue copy-on-fork implementation"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"c0c2740d3d312087da81bdc92c81236a6e8bed95e72c7bc3d47aac019998b9fa","data_version":"5.2","first_seen_at":"2026-10-15T11:29:28Z","kind":"advisory","last_material_event_at":"2026-10-15T11:29:28Z","native_id":"CVE-2026-58099","provenance":[{"revision":"84c1500b89d4a5d9af483fd5109f4ddedbe1f5a7","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-58099"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-15T06:31:18Z","record_encoding":{"expanded_bytes":3111,"expanded_
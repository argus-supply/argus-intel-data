{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["Text::CSV_XS"],"original_ranges":[{"lessThan":"1.65","status":"affected","version":"0","versionType":"custom"}],"packageName":"Text-CSV_XS","packageURL":"pkg:cpan/Text-CSV_XS","programFiles":["CSV_XS.xs"],"programRoutines":[{"name":"Text::CSV_XS::getline"}],"repo":"https://github.com/cpan-authors/Text-CSV_XS"}],"aliases":["CVE-2026-110754"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Text::CSV_XS versions before 1.65 for Perl leak the parsed fields of a record that fails to parse in getline.\n\ngetline collects the fields of a record into a new array and returns a reference to it only when the parse succeeds. When the record has a syntax error, getline returns undef and never frees the array or the fields parsed before the error.\n\nA long-running process parsing untrusted CSV retains every malformed record it is sent, so repeated malformed input exhausts its memory."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-401","description":"CWE-401 Missing Release of Memory after Effective Lifetime","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-16T22:06:46.839Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"Text::CSV_XS versions before 1.65 for Perl leak the parsed fields of a record that fails to parse in getline"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"9141644dd88f9bfc06dbda37de8130b6f648b684477252d1a123d7f336e5a122","data_version":"5.2","first_seen_at":"2026-10-17T00:29:46Z","kind":"advisory","last_material_event_at":"2026-10-17T00:29:46Z","native_id":"CVE-2026-110754","provenance":[{"revision":"985d3ad8088200f2605e0d49f284dbf170e998fc","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-110754"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-16T22:06:46Z","record_encoding":{"expanded_bytes":3643,"expanded_sha256":"a64c0113d1b50ffea839d98aed7e566918b80a293fa511a221085c7cfb4c77c9","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-110754","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-16T22:06:46.839Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"tags":["patch"],"url":"https://github.com/cpan-authors/Text-CSV_XS/commit/eb4f739ffc605bfb1ab710e5330704faa0e89f08.patch"},{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-16T22:06:46.839Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"tags":["release-notes"],"url":"https://metacpan.org/release/HMBRAND/Text-CSV_XS-1.65/changes"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-16T22:06:46Z","status":"active","title":"Text::CSV_XS versions before 1.65 for Perl leak the parsed fields of a record that fails to parse in getline"}

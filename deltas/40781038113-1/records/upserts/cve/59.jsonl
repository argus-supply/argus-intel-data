{"affected":[{"original_ranges":[{"status":"affected","version":">= 0.1.2, < 0.15.0"}],"product":"langgraph-api","vendor":"langchain-ai"}],"aliases":["CVE-2026-118668"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"langgraph-api implements the LangGraph API for rapid development and testing. From 0.1.2 until 0.15.0, JavaScript or TypeScript custom authentication Store authorization handlers can return a rewritten namespace that is not carried across the runtime boundary and applied before the Store operation. An authenticated user can therefore access another user's Store namespace when a deployment relies on namespace rewriting for isolation, allowing unauthorized reads, overwrites, searches, or deletions. Python custom authentication and handlers that reject unauthorized namespaces instead of rewriting them are not affected. This issue is fixed in version 0.15.0."}],"metrics":[{"cvssV4_0":{"attackComplexity":"LOW","attackRequirements":"NONE","attackVector":"NETWORK","baseScore":8.6,"baseSeverity":"HIGH","privilegesRequired":"LOW","subAvailabilityImpact":"NONE","subConfidentialityImpact":"NONE","subIntegrityImpact":"NONE","userInteraction":"NONE","vectorString":"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:H/VA:N/SC:N/SI:N/SA:N","version":"4.0","vulnAvailabilityImpact":"NONE","vulnConfidentialityImpact":"HIGH","vulnIntegrityImpact":"HIGH"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-639","description":"CWE-639: Authorization Bypass Through User-Controlled Key","lang":"en","type":"CWE"}]},{"descriptions":[{"cweId":"CWE-863","description":"CWE-863: Incorrect Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T21:06:43.157Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"LangGraph JavaScript custom authentication may permit cross-user Store access"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"0180dd26e174d8573f7ab056bc3cb89d1969653b4dcc36bb3ff9f3290870a88b","data_version":"5.2","first_seen_at":"2026-10-28T22:35:26Z","kind":"advisory","last_material_event_at":"2026-10-28T22:35:26Z","native_id":"CVE-2026-118668","provenance":[{"revision":"c761a6804d91658ecbf21ef95ca5f8d12b5ef17c","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-118668"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-28T21:06:43Z","record_encoding":{"expanded_bytes":4092,"expanded_sha256":"d61b61e4fddb557d0a01ecefdb5c3f11ff02b4139813e68004ce1ed8ce77d25f","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-118668","references":[{"assertion_role":"cna","name":"https://github.com/langchain-ai/langgraph/security/advisories/GHSA-4hm6-w6qq-w73v","provider":{"dateUpdated":"2026-10-28T21:06:43.157Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"tags":["x_refsource_CONFIRM"],"url":"https://github.com/langchain-ai/langgraph/security/advisories/GHSA-4hm6-w6qq-w73v"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-28T21:06:43Z","status":"active","title":"LangGraph JavaScript custom authentication may permit cross-user Store access"}

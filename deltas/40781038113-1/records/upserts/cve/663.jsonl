{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["MIME::Field::ParamVal"],"original_ranges":[{"lessThan":"5.521","status":"affected","version":"0","versionType":"custom"}],"packageName":"MIME-tools","packageURL":"pkg:cpan/MIME-tools","programFiles":["lib/MIME/Field/ParamVal.pm","lib/MIME/WordDecoder.pm","lib/MIME/Head.pm"],"programRoutines":[{"name":"MIME::Field::ParamVal::parse_params"},{"name":"MIME::WordDecoder::decode"},{"name":"MIME::Head::recommended_filename"}],"repo":"https://salsa.debian.org/dskoll/mime-tools"}],"aliases":["CVE-2026-116269"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"MIME::Field::ParamVal versions before 5.521 for Perl turn an RFC 2231 filename with a hyphenated language tag into an empty recommended filename.\n\nA parameter such as filename*=utf-8'en-US'payload.exe is converted to an encoded word with the language tag appended to the charset. The decoder strips the language suffix only when it is a single word, so it cannot resolve the charset UTF-8*EN-US and returns an empty string. The recommended_filename() method returns that empty string rather than falling back to the name parameter.\n\nOther mail readers return payload.exe. A remote sender can get an attachment past a policy that checks file extensions on the recommended filename."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-436","description":"CWE-436 Interpretation Conflict","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T17:33:22.332Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"MIME::Field::ParamVal versions before 5.521 for Perl turn an RFC 2231 filename with a hyphenated language tag into an empty recommended filename"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"f36dfa2
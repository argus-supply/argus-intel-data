{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"3.3.0","status":"affected","version":"1","versionType":"semver"}],"product":"PostgreSQL Anonymizer","vendor":"DALIBO"}],"aliases":["CVE-2026-105615"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"PostgreSQL's optimized statistics on a table are visible as long as you have SELECT privilege on said table. A masked role can therefore read a limited subset of the data through the statistics view's histograms and mcvs. The vulnerability is resolved in PostgreSQL Anonymizer 3.3.0 and later versions."}],"metrics":[{"cvssV3_1":{"baseScore":3.5,"baseSeverity":"LOW","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:R/S:U/C:L/I:N/A:N","version":"3.1"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-202","description":"Exposure of Sensitive Information Through Data Queries","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T17:31:46.771Z","orgId":"f86ef6dc-4d3a-42ad-8f28-e6d5547a5007","shortName":"PostgreSQL"},"role":"cna","title":"PostgreSQL Anonymizer: Masked roles can read the statistics of masked columns in pg_stats"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"d40f490fee3ae72c180d0ac050c55520daaa43bc4542666a3dcfb3e4524f1cb5","data_version":"5.2","first_seen_at":"2026-10-28T22:35:26Z","kind":"advisory","last_material_event_at":"2026-10-28T22:35:26Z","native_id":"CVE-2026-105615","provenance":[{"revision":"c761a6804d91658ecbf21ef95ca5f8d12b5ef17c","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-105615"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-28T17:31:46Z","record_encoding":{"expanded_bytes":2878,"expanded_sha256":"6c0415211aaa4e4af2ecda375e0dc3e53da734c3db2487990ef9a2711c67f00d","format":"cve-indexed-assertions-v1","to
{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"8.4.65"}],"product":"Ultralytics","vendor":"Ultralytics"}],"aliases":["CVE-2026-118615"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-28T16:31:12.091Z","descriptions":[{"lang":"en","value":"Ultralytics torch_safe_load Command Injection Remote Code Execution Vulnerability. This vulnerability allows remote attackers to execute arbitrary code on affected installations of Ultralytics. User interaction is required to exploit this vulnerability in that the target must visit a malicious page or open a malicious file.\n\nThe specific flaw exists within the torch_safe_load function. The issue results from the lack of proper validation of a user-supplied string before using it to execute a system call. An attacker can leverage this vulnerability to execute code in the context of the current user. Was ZDI-CAN-30122."}],"metrics":[{"cvssV3_0":{"baseScore":7.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-78","description":"CWE-78: Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T16:54:16.852Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"Ultralytics torch_safe_load Command Injection Remote Code Execution Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"5e8039a6985cd02ab2e727e4aabdbeead309c95de4d4b039fa3cec5b1a52df55","data_version":"5.2","first_seen_at":"2026-10-28T22:35:26Z","kind":"advisory","last_material_event_at":"2026-10-28T22:35:26Z","native_id":"CVE-2026-118615","provenance":[{"revision":"c761a6804d91658ecbf21ef95ca5f8d12b5ef17c","
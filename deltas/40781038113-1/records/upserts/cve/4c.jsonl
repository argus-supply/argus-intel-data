{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["MIME::Parser"],"original_ranges":[{"lessThan":"5.521","status":"affected","version":"0","versionType":"custom"}],"packageName":"MIME-tools","packageURL":"pkg:cpan/MIME-tools","programFiles":["lib/MIME/Parser/Results.pm","lib/MIME/Parser.pm"],"programRoutines":[{"name":"MIME::Parser::Results::indent"}],"repo":"https://salsa.debian.org/dskoll/mime-tools"}],"aliases":["CVE-2026-116267"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"MIME::Parser versions before 5.521 for Perl allow memory exhaustion via indented error messages from a truncated, deeply nested message.\n\nEach stored parser diagnostic is indented by three spaces per nesting level. When a message nested N levels deep ends without its closing boundaries, every level logs an error at its own depth, so the stored diagnostics grow with the square of N. The defaults place no limit on nesting depth."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-407","description":"CWE-407 Inefficient Algorithmic Complexity","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T17:32:45.677Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"MIME::Parser versions before 5.521 for Perl allow memory exhaustion via indented error messages from a truncated, deeply nested message"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"861bdd499f21b8f3e907ec56a9ad62d4dc7a6992fca2c3885b1b2aec98ee57a9","data_version":"5.2","first_seen_at":"2026-10-28T22:35:26Z","kind":"advisory","last_material_event_at":"2026-10-28T22:35:26Z","native_id":"CVE-2026-116267","provenance":[{"revision":"c761a6804d91658ecbf21ef95ca5f8d12b5ef17c","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-116267"},{"assertio
{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"7.0.000"}],"product":"iLX-F511","vendor":"Alpine"}],"aliases":["CVE-2026-118605"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-28T16:44:45.196Z","descriptions":[{"lang":"en","value":"Alpine iLX-F511 prh_sdp_service_search_decode Stack-based Buffer Overflow Remote Code Execution Vulnerability. This vulnerability allows network-adjacent attackers to execute arbitrary code on affected installations of Alpine iLX-F511 devices. An attacker must first obtain the ability to pair a malicious Bluetooth device with the target system in order to exploit this vulnerability.\n\nThe specific flaw exists within the prh_sdp_service_search_decode function. The issue results from the lack of proper validation of the length of user-supplied data prior to copying it to a stack-based buffer. An attacker can leverage this vulnerability to execute code in the context of root. Was ZDI-CAN-29069."}],"metrics":[{"cvssV3_0":{"baseScore":8,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:A/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-121","description":"CWE-121: Stack-based Buffer Overflow","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T16:50:18.217Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"Alpine iLX-F511 prh_sdp_service_search_decode Stack-based Buffer Overflow Remote Code Execution Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"8c319a1506dccab33d412a8b781f8d188087da6203c5d5af676efb3b4154eaea","data_version":"5.2","first_seen_at":"2026-10-28T22:35:26Z","kind":"advisory","last_material_event_at":"2026-10-28T22:35:26Z","native_id":"CVE-2026-118605","provenance":[{"revision":"c761a6804d
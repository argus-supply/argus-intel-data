{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["MIME::Field::ParamVal"],"original_ranges":[{"lessThan":"5.521","status":"affected","version":"0","versionType":"custom"}],"packageName":"MIME-tools","packageURL":"pkg:cpan/MIME-tools","programFiles":["lib/MIME/Field/ParamVal.pm"],"programRoutines":[{"name":"MIME::Field::ParamVal::parse_params"}],"repo":"https://salsa.debian.org/dskoll/mime-tools"}],"aliases":["CVE-2026-116264"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"MIME::Field::ParamVal versions before 5.521 for Perl allow one invalid Content-Type parameter to hide the parameters after it, including the multipart boundary.\n\nParameter parsing stops at the first parameter whose name it cannot read, such as x:y=1 or a name containing an 8-bit byte, and drops every parameter after it. When the boundary is among them, MIME::Parser keeps the multipart body as a single undecoded part without marking the parse as ambiguous.\n\nMail readers that skip the invalid parameter still find the boundary. A remote sender can hide an attachment from a filter that relies on ambiguous_content() while the recipient's mail client shows it."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-436","description":"CWE-436 Interpretation Conflict","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T17:31:52.187Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"MIME::Field::ParamVal versions before 5.521 for Perl allow one invalid Content-Type parameter to hide the parameters after it, including the multipart boundary"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"b789d8f1a1bbb9a3f386653f6dc49cae207bffba3d406a637c8749ec15ed5dcf","data_version":"5.2","first_seen_at":"2026-10-28T22:35:26Z","kind":"advisory","last_material_event_at":"2026-10-28T22:35:26Z","native_id":"CVE-2026-116264","provenance":[{"revision":"c761a6804d91658ecbf21ef95ca5f8d12b5ef17c","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-116264"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-28T17:31:52Z","record_encoding":{"expanded_bytes":3832,"expanded_sha256":"b719838a0c007e85c690cc63e4242c6360661f9de673cd5bacc6037c082e7160","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-116264","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-28T17:31:52.187Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"tags":["release-notes"],"url":"https://metacpan.org/release/DSKOLL/MIME-tools-5.521/changes"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-28T17:31:52Z","status":"active","title":"MIME::Field::ParamVal versions before 5.521 for Perl allow one invalid Content-Type parameter to hide the parameters after it, including the multipart boundary"}

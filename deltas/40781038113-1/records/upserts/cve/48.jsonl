{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["HTTP::Body"],"original_ranges":[{"lessThan":"1.23_01","status":"affected","version":"0","versionType":"custom"}],"packageName":"HTTP-Body","packageURL":"pkg:cpan/HTTP-Body","programFiles":["lib/HTTP/Body.pm"],"programRoutines":[{"name":"HTTP::Body::add"}],"repo":"https://github.com/libwww-perl/HTTP-Body"}],"aliases":["CVE-2026-116285"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"HTTP::Body versions before 1.23_01 for Perl allow CPU exhaustion via quadratic regex backtracking when parsing chunked request bodies.\n\nIn chunked mode, used when no content length is given, add() matches each chunk-size line with `/^([\\da-fA-F]+).*\\x0D\\x0A/`. On a line of hex digits whose first LF has no CR before it, the digits and `.*` backtrack against each other, so a single add() takes time quadratic in the line's length. Nothing limits how long the line can be.\n\nA remote attacker can exhaust CPU in applications that pass chunked request bodies to HTTP::Body."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-1333","description":"CWE-1333 Inefficient Regular Expression Complexity","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T17:16:16.997Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"HTTP::Body versions before 1.23_01 for Perl allow CPU exhaustion via quadratic regex backtracking when parsing chunked request bodies"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"55b206a03eda7a7ad8e6b0a25ad7824a36ac19744e1b58ba58352f919cc9b2ee","data_version":"5.2","first_seen_at":"2026-10-28T22:35:26Z","kind":"advisory","last_material_event_at":"2026-10-28T22:35:26Z","native_id":"CVE-2026-116285","provenance":[{"revision":"c761a6804d91658ecbf21ef9
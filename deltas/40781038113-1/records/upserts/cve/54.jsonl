{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["HTTP::Body"],"original_ranges":[{"lessThan":"1.23_01","status":"affected","version":"0","versionType":"custom"}],"packageName":"HTTP-Body","packageURL":"pkg:cpan/HTTP-Body","programFiles":["lib/HTTP/Body/MultiPart.pm"],"programRoutines":[{"name":"HTTP::Body::MultiPart::parse_header"}],"repo":"https://github.com/libwww-perl/HTTP-Body"}],"aliases":["CVE-2026-116134"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"HTTP::Body versions before 1.23_01 for Perl allow memory exhaustion via an unbounded multipart part header block.\n\nThe multipart parser takes everything up to the first blank line after a boundary as the part's header block, with no limit on its size or number of lines. Every line is stored in the part's header hash, so a block of short lines costs about 60 bytes of memory per input byte.\n\nA remote attacker can exhaust worker memory with a single request."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-770","description":"CWE-770 Allocation of Resources Without Limits or Throttling","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T17:15:31.799Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"HTTP::Body versions before 1.23_01 for Perl allow memory exhaustion via an unbounded multipart part header block"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"0d4c9095c15cd56e4fe9d967f2ac4c50909709a7772d1745a87abdd3b3e78592","data_version":"5.2","first_seen_at":"2026-10-28T22:35:26Z","kind":"advisory","last_material_event_at":"2026-10-28T22:35:26Z","native_id":"CVE-2026-116134","provenance":[{"revision":"c761a6804d91658ecbf21ef95ca5f8d12b5ef17c","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-116134"},{"a
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"3.3.0","status":"affected","version":"1","versionType":"semver"}],"product":"PostgreSQL Anonymizer","vendor":"DALIBO"}],"aliases":["CVE-2026-105614"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"PostgreSQL Anonymizer's `anon.image_blur()` function doesn't check the declared dimension of the provided image, allowing an attacker to provide a small image with enormous declared dimensions. This vulnerability can be exploited to exhaust the memory of a backend and OOM-kill it (when ovecommit is on), which results in a cluster-wide crash recovery. The problem is resolved in PostgreSQL Anonymizer 3.3.0 and later versions."}],"metrics":[{"cvssV3_1":{"baseScore":4.7,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:N/I:N/A:L","version":"3.1"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-789","description":"Memory Allocation with Excessive Size Value","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T17:31:45.821Z","orgId":"f86ef6dc-4d3a-42ad-8f28-e6d5547a5007","shortName":"PostgreSQL"},"role":"cna","title":"PostgreSQL Anonymizer: Unbounded image-decode memory allocation (DoS) in anon.image_blur()"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"77a6d76a86bd8e934394637728f14bc5552274d3cfc4ce714e1e759664d123f7","data_version":"5.2","first_seen_at":"2026-10-28T22:35:26Z","kind":"advisory","last_material_event_at":"2026-10-28T22:35:26Z","native_id":"CVE-2026-105614","provenance":[{"revision":"c761a6804d91658ecbf21ef95ca5f8d12b5ef17c","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-105614"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-28T17:31:45Z","record_encoding":{"expanded_bytes":3122,"expanded_sha256":"1ebd07dcfcc0ca4b8df8ad3b4ceaed3d697c338cb274a533aa2c4338c069a948","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-105614","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-28T17:31:45.821Z","orgId":"f86ef6dc-4d3a-42ad-8f28-e6d5547a5007","shortName":"PostgreSQL"},"url":"https://gitlab.com/dalibo/postgresql_anonymizer/-/issues/691"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-28T17:31:45Z","status":"active","title":"PostgreSQL Anonymizer: Unbounded image-decode memory allocation (DoS) in anon.image_blur()"}
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"3.3.0","status":"affected","version":"1","versionType":"semver"}],"product":"PostgreSQL Anonymizer","vendor":"DALIBO"}],"aliases":["CVE-2026-110181"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"PostgreSQL Anonymizer contains a vulnerability related to anonymization functions defined using SQL-standard function bodies. PostgreSQL analyses such functions at declaration time, while Anonymizer only attempts to check them at execution time. This problem can be exploited by any user with the TEMPORARY privilege. The issue is fixed in PostgreSQL Anonymizer 3.3.0 and later versions."}],"metrics":[{"cvssV3_1":{"baseScore":6.5,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:N/A:N","version":"3.1"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-693","description":"Protection Mechanism Failure","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T17:31:52.642Z","orgId":"f86ef6dc-4d3a-42ad-8f28-e6d5547a5007","shortName":"PostgreSQL"},"role":"cna","title":"PostgreSQL Anonymizer: Function declared with SQL-standard syntax leak anonymized data"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"45fdd1361e2fed1d4d24285492aaafa3dbc20effef75624bce0e5ec6124b3b0b","data_version":"5.2","first_seen_at":"2026-10-28T22:35:26Z","kind":"advisory","last_material_event_at":"2026-10-28T22:35:26Z","native_id":"CVE-2026-110181","provenance":[{"revision":"c761a6804d91658ecbf21ef95ca5f8d12b5ef17c","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-110181"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-28T17:31:52Z","record_encoding":{"expanded_bytes":3019,"expanded_sha256":"8931f8268c49e15b276fd3f741b116b61c03cb5b2f5a433
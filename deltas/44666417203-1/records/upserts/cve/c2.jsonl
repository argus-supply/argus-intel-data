{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"4.0.8","status":"affected","version":"3.0.0","versionType":"semver"}],"product":"Okta .NET SDK Abstractions Library","vendor":"Okta"}],"aliases":["CVE-2026-130179"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Okta .NET SDK Abstractions library systematically writes per-request authentication credentials to a shared HTTP client instance, rather than being isolated to individual outbound request objects. When using scoped child clients, a subsequent scoped request can overwrite the shared client configuration. Because the original parent client credential has not been restored, subsequent outbound requests may be transmitted using the newly written credential, which can result in subsequent actions being executed under the context of an incorrect security principal in the Okta Management API and improper attribution in audit logs."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":8.5,"baseSeverity":"HIGH","confidentialityImpact":"HIGH","integrityImpact":"LOW","privilegesRequired":"LOW","scope":"CHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:C/C:H/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-668","description":"Exposure of Resource to Wrong Sphere","lang":"en"}]},{"descriptions":[{"cweId":"CWE-362","description":"Concurrent Execution Using Shared Resource with Improper Synchronization ('Race Condition')","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-19T21:05:15.601Z","orgId":"59b22baa-87b2-4371-8e4a-e080df12f74a","shortName":"Okta"},"role":"cna","title":"Credential Overwriting in Okta .NET SDK Abstractions Library"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"eea3a165c0d
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"0.1.1","status":"affected","version":"0","versionType":"semver"}],"product":"Okta Swift Management SDK","vendor":"Okta"}],"aliases":["CVE-2026-130234"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Okta Swift Management SDK does not percent-encode forward slash (/) characters during path parameter interpolation. If an application supplies input containing relative path sequences (e.g., ../) to an SDK method, standard URL normalization may direct the outbound request to an alternative Okta Management API endpoint."}],"metrics":[{"cvssV3_1":{"attackComplexity":"HIGH","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":8,"baseSeverity":"HIGH","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"NONE","scope":"CHANGED","userInteraction":"REQUIRED","vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:R/S:C/C:H/I:H/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-116","description":"Improper Encoding or Escaping of Output","lang":"en"}]},{"descriptions":[{"cweId":"CWE-22","description":"Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-19T21:06:17.616Z","orgId":"59b22baa-87b2-4371-8e4a-e080df12f74a","shortName":"Okta"},"role":"cna","title":"Path Parameter Encoding in Okta Swift Management SDK"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"663d1e1f10e47b78ca60b741bb402f23d7e30b5283b58108fd7d8d1914c9698e","data_version":"5.2","first_seen_at":"2026-11-20T03:15:40Z","kind":"advisory","last_material_event_at":"2026-11-20T03:15:40Z","native_id":"CVE-2026-130234","provenance":[{"revision":"c7be644d1db9caaf358a7ed83d23511b4a4d1f10","source_id":"cve","url":"https://www.cve.org/CVERecord?id=
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"0.3.1","status":"affected","version":"0.1.0","versionType":"semver"}],"product":"Okta Client SDK for Python","vendor":"Okta"}],"aliases":["CVE-2026-130153"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Okta Client SDK for Python (okta-client-python) includes client authentication values (client_secret or JWT assertions) as query parameters in the front-channel authorization URL when executing the authorization code flow without Pushed Authorization Requests (PAR). When PAR is disabled, unsupported by the authorization server, or fails, the SDK falls back to standard authorization URL construction, transmitting these parameters via user-agent requests."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":4.7,"baseSeverity":"MEDIUM","confidentialityImpact":"LOW","integrityImpact":"NONE","privilegesRequired":"NONE","scope":"CHANGED","userInteraction":"REQUIRED","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:N/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-598","description":"Use of GET Request Method With Sensitive Query Strings","lang":"en"}]},{"descriptions":[{"cweId":"CWE-522","description":"Insufficiently Protected Credentials","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-19T21:04:36.278Z","orgId":"59b22baa-87b2-4371-8e4a-e080df12f74a","shortName":"Okta"},"role":"cna","title":"Front-Channel Parameter Handling in Okta Client SDK for Python"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"b281333254d8bd92070bb75415440d862190b2370e59c83298d022fce862eeb3","data_version":"5.2","first_seen_at":"2026-11-20T03:15:40Z","kind":"advisory","last_material_event_at":"2026-11-20T03:15:40Z","native_id":"CVE-2026-130153"
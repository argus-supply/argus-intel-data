{"affected":[{"defaultStatus":"unknown","modules":["apcupsd-cgi (upsstats.cgi","multimon.cgi","upsfstats.cgi)"],"original_ranges":[{"lessThanOrEqual":"3.14.14","status":"affected","version":"0","versionType":"semver"}],"product":"apcupsd","programFiles":["src/cgi/upsfetch.c"],"programRoutines":[{"name":"getupsvar"}],"vendor":"apcupsd"}],"aliases":["CVE-2026-103436"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"apcupsd through 3.14.14 discloses uninitialized stack memory in getupsvar() in src/cgi/upsfetch.c (used by upsstats.cgi, multimon.cgi, and upsfstats.cgi. On the single-field path, when the matched STATUS line has fewer than three whitespace-separated tokens, sscanf(\"%*s %*s %s\", answer) performs no assignment but the function returns success, and thus the caller prints the uninitialized destination buffer into the HTTP response."}],"metrics":[{"cvssV3_1":{"attackComplexity":"HIGH","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":3.7,"baseSeverity":"LOW","confidentialityImpact":"LOW","integrityImpact":"NONE","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:L/I:N/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-457","description":"CWE-457 Use of Uninitialized Variable","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-30T15:38:48.231Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"abf8f92b1abee9c266415cc6873b2ab5572a71b03ce222af4bed6aa9fb7d7fd3","data_version":"5.2","first_seen_at":"2026-09-30T16:25:24Z","kind":"advisory","last_material_event_at":"2026-09-30T16:25:24Z","native_id":"CVE-2026-103436","provenance
{"affected":[{"original_ranges":[{"status":"affected","version":"< 0.34.0"}],"product":"fider","vendor":"getfider"}],"aliases":["CVE-2026-65967"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Fider is a feedback portal for feature requests and suggestions. Prior to version 0.34.0, a Server-Side Request Forgery (SSRF) vulnerability exists in Fider due to insufficient validation of webhook URLs. The application allows user-controlled URLs to be fetched by the server without restricting access to internal or external network resources. This enables attackers with administrative privileges to make arbitrary HTTP requests from the server, potentially accessing internal services or cloud metadata endpoints. This issue has been patched in version 0.34.0."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":7.1,"baseSeverity":"HIGH","confidentialityImpact":"HIGH","integrityImpact":"LOW","privilegesRequired":"LOW","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-918","description":"CWE-918: Server-Side Request Forgery","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-11T18:33:09.909Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"Fider: Server-Side Request Forgery (SSRF) via Webhook URL"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"fe6f4ba1ed67c75c40e92d49884f4081dde314d124785ea1c4a87a047796a814","data_version":"5.2","first_seen_at":"2026-11-12T00:44:01Z","kind":"advisory","last_material_event_at":"2026-11-12T00:44:01Z","native_id":"CVE-2026-65967","provenance":[{"revision":"f3cb12bf974f7d4cea05601d2b2d453abeca38ff","source_id":"cve","url":"htt
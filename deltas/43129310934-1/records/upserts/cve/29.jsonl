{"affected":[{"original_ranges":[{"status":"affected","version":"< 0.36.0"}],"product":"fider","vendor":"getfider"}],"aliases":["CVE-2026-65840"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Fider is a feedback portal for feature requests and suggestions. Prior to version 0.36.0, in multi-tenant mode (HOST_MODE=multi), an attacker can use an email verification key issued by Tenant A to authenticate as the same email address on Tenant B. This completely bypasses tenant isolation and allows unauthorized account takeover across tenants. Single-host deployments (HOST_MODE=single, the default) are NOT affected. This issue has been patched in version 0.36.0."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":9.6,"baseSeverity":"CRITICAL","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"LOW","scope":"CHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:C/C:H/I:H/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-639","description":"CWE-639: Authorization Bypass Through User-Controlled Key","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-11T18:32:50.465Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"Fider: Cross-Tenant Authentication Bypass via Missing tenant_id Filter in getVerificationByKey"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"f0d4eac0bec781bd9f560507327ba53472946b70cd8318df4a977a0a55d1d2cf","data_version":"5.2","first_seen_at":"2026-11-12T00:44:01Z","kind":"advisory","last_material_event_at":"2026-11-12T00:44:01Z","native_id":"CVE-2026-65840","provenance":[{"revision":"f3cb12bf974f7d4cea05601d2b2d453abeca38ff","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2
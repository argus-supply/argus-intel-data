{"affected":[{"original_ranges":[{"status":"affected","version":"< 1.0.5"}],"product":"iopress","vendor":"senapati484"}],"aliases":["CVE-2026-65833"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"iopress is a native HTTP server for Node.js with platform-specific async I/O. Prior to version 1.0.5, the chunked-transfer-encoding HTTP request parser in @iopress/core reads past the end of the input buffer when a request declares a chunk size larger than the body actually received. This results in a heap-buffer-over-read. This issue has been patched in version 1.0.5."}],"metrics":[{"cvssV4_0":{"attackComplexity":"LOW","attackRequirements":"NONE","attackVector":"NETWORK","baseScore":6.9,"baseSeverity":"MEDIUM","privilegesRequired":"NONE","subAvailabilityImpact":"NONE","subConfidentialityImpact":"NONE","subIntegrityImpact":"NONE","userInteraction":"NONE","vectorString":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:L/VI:N/VA:L/SC:N/SI:N/SA:N","version":"4.0","vulnAvailabilityImpact":"LOW","vulnConfidentialityImpact":"LOW","vulnIntegrityImpact":"NONE"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-126","description":"CWE-126: Buffer Over-read","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-11T18:23:41.315Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"iopress: buffer over-read in chunked HTTP parser"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"f5a76acc6b08006c104b25eac0ba90110a4eb48943c7156c18ea217b1b979a7a","data_version":"5.2","first_seen_at":"2026-11-12T00:44:01Z","kind":"advisory","last_material_event_at":"2026-11-12T00:44:01Z","native_id":"CVE-2026-65833","provenance":[{"revision":"f3cb12bf974f7d4cea05601d2b2d453abeca38ff","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-65833"},{"assertion_index":0,"indepen
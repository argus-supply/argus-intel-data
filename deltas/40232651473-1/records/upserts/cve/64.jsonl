{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["Starman"],"original_ranges":[{"lessThan":"0.4019","status":"affected","version":"0","versionType":"custom"}],"packageName":"Starman","packageURL":"pkg:cpan/Starman","programFiles":["lib/Starman/Server.pm"],"programRoutines":[{"name":"Starman::Server::_prepare_env"}],"repo":"https://github.com/miyagawa/Starman"}],"aliases":["CVE-2026-115822"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Starman versions before 0.4019 for Perl allow CPU exhaustion via quadratic regex backtracking when parsing chunked request bodies.\n\nStarman decodes chunked request bodies before calling the application, matching each chunk-size line with `s/^(([0-9a-fA-F]+).*\\015\\012)//`. A line of hex digits followed by a bare LF and then CRLF never matches, because `.` does not match LF, and each failed attempt backtracks in time quadratic in the length of the hex run. Nothing limits the length of the line.\n\nA remote attacker can exhaust worker CPU by sending such requests to any route."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-1333","description":"CWE-1333 Inefficient Regular Expression Complexity","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-25T16:51:00.241Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"Starman versions before 0.4019 for Perl allow CPU exhaustion via quadratic regex backtracking when parsing chunked request bodies"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"4190450feca3f754e99f2cb317aca0fb80b317c20cfb9ea6d02abcb65b2ac2ac","data_version":"5.2","first_seen_at":"2026-10-25T20:51:18Z","kind":"advisory","last_material_event_at":"2026-10-25T20:51:18Z","native_id":"CVE-2026-115822","provenance":[{"revision":"3c75459f8d8c2d5f
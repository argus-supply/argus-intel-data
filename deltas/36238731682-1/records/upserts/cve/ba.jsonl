{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.5.8","status":"affected","version":"0","versionType":"semver"}],"product":"WP Directory Kit","vendor":"Unknown"}],"aliases":["CVE-2026-16591"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The WP Directory Kit WordPress plugin before 1.5.8 does not sanitize and escape some of its category and location fields before outputting them in page attributes, allowing users with a WP Directory Kit WordPress plugin before 1.5.8-specific listing-management role (and without the unfiltered_html capability) to perform Stored Cross-Site Scripting attacks that execute for any visitor of the affected page."}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Cross-Site Scripting (XSS)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-26T06:00:18.840Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"WP Directory Kit < 1.5.8 - Listing Admin+ Stored XSS via Category and Location Title and Icon Fields"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"83a766a86d59da2a0848f11ae3b8fd3ab4902c70abc1ba2afd64a0a54624bfaa","data_version":"5.2","first_seen_at":"2026-09-26T11:25:35Z","kind":"advisory","last_material_event_at":"2026-09-26T11:25:35Z","native_id":"CVE-2026-16591","provenance":[{"revision":"ed5232fbf5c98f107d15ac090b5efd591ed99c05","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-16591"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-26T06:00:18Z","record_encoding":{"expanded_bytes":2956,"expanded_sha256":"ce29206b4fc8e7a1e6c15c573ac3bad921493d27e018bee2669f2ae915c1e158","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cv
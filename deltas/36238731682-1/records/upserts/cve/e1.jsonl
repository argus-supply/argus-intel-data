{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"4.2.13","status":"affected","version":"4.0.0","versionType":"semver"}],"product":"Optimole","vendor":"Unknown"}],"aliases":["CVE-2026-96531"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Optimole  WordPress plugin before 4.2.13 does not escape unrecognized attributes of its video-player block before rendering them onto the block's wrapper element, allowing users with the Author role and above to store an event-handler attribute that executes scripts in the browser of any user, such as an administrator, who views the post."}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Cross-Site Scripting (XSS)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-26T06:00:21.129Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Optimole 4.0.0 - 4.2.12 - Author+ Stored XSS via Video Player Block"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"076f9368af1095b5cbe63ca0034c8734b651441a57cbc17f879261b26ad614a9","data_version":"5.2","first_seen_at":"2026-09-26T11:25:35Z","kind":"advisory","last_material_event_at":"2026-09-26T11:25:35Z","native_id":"CVE-2026-96531","provenance":[{"revision":"ed5232fbf5c98f107d15ac090b5efd591ed99c05","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-96531"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-26T06:00:21Z","record_encoding":{"expanded_bytes":2759,"expanded_sha256":"740e834f32773279d9167f8dddfe385caef2e391053cfdb1d5fd2022f59abfac","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-96531","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-26T06:00:
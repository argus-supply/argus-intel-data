{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"8.0.5","status":"affected","version":"0","versionType":"semver"}],"product":"File Manager","vendor":"Unknown"},{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.2.1","status":"affected","version":"0","versionType":"semver"}],"product":"FileOrganizer","vendor":"Unknown"},{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.1.3","status":"affected","version":"0","versionType":"semver"}],"product":"File Manager Pro","vendor":"Unknown"}],"aliases":["CVE-2026-85081"],"assertions":[{"affected_indices":[0,1,2],"descriptions":[{"lang":"en","value":"The File Manager WordPress plugin before 8.0.5, FileOrganizer  WordPress plugin before 1.2.1, File Manager Pro  WordPress plugin before 2.1.3 do not correctly validate the origin of window messages received by the file browser they load on their admin screens, accepting any origin that is a leading string prefix of the site's own address, which allows an unauthenticated attacker to run arbitrary JavaScript in the session of a logged-in administrator who visits a page under their control.\n\nThe defect is in the file-manager library all three bundle, and every version below 2.1.70 carries it. Updating the bundled library closes it."}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Cross-Site Scripting (XSS)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-26T06:00:20.014Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Multiple elFinder Plugins - DOM-based XSS via postMessage Origin Bypass"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"b02a12fb10628189e0f85f5c02d144129a39d3777bb0a9f5e01b9b1765c0abab","data_version":"5.2","first_seen_at":"2026-09-26T11:25:35Z","kind":"advisory","last_material_event_at":"2026-09
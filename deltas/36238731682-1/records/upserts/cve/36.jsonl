{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"8.0.5","status":"affected","version":"7.2.2","versionType":"semver"}],"product":"File Manager","vendor":"Unknown"}],"aliases":["CVE-2026-19708"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The File Manager WordPress plugin before 8.0.5 does not prevent unauthenticated users from downloading its database backup archives, and in some cases writes them under a fixed filename, allowing unauthenticated attackers to retrieve a full database dump including every user's email address and password hash on servers that do not apply the directory's .htaccess file."}],"problemTypes":[{"descriptions":[{"description":"CWE-200 Information Exposure","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-26T06:00:19.030Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"File Manager 7.2.2 - 8.0.4 - Unauthenticated Database Backup Disclosure"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"17dde839222f01db9b2e0c4e93327c9b4728a4bec535ca6b726263bba5747aea","data_version":"5.2","first_seen_at":"2026-09-26T11:25:35Z","kind":"advisory","last_material_event_at":"2026-09-26T11:25:35Z","native_id":"CVE-2026-19708","provenance":[{"revision":"ed5232fbf5c98f107d15ac090b5efd591ed99c05","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-19708"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-26T06:00:19Z","record_encoding":{"expanded_bytes":2817,"expanded_sha256":"ca05ade98048258743cb132918d30ba8bf86a8249e4474150f5a0bbb4baf07c3","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-19708","references":[{"assertion_role":"cna","provider":{"dat
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"12.7.12","status":"affected","version":"0","versionType":"semver"}],"product":"wp-review-slider-pro","vendor":"Unknown"}],"aliases":["CVE-2026-84096"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The wp-review-slider-pro WordPress plugin before 12.7.12 does not perform a capability check on the AJAX handler that saves its review submission forms, and the nonce protecting it is generated for every visitor, allowing any authenticated user, such as a subscriber, to overwrite a live form with field values that are output without escaping on public pages, leading to Stored Cross-Site Scripting."}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Cross-Site Scripting (XSS)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-26T06:00:19.375Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"WP Review Slider Pro < 12.7.12 - Subscriber+ Stored XSS via Review Form Fields"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"fe1f86894bce2b7b7858432a69bce8603d2735fcb76f078a43520103326e73c0","data_version":"5.2","first_seen_at":"2026-09-26T11:25:35Z","kind":"advisory","last_material_event_at":"2026-09-26T11:25:35Z","native_id":"CVE-2026-84096","provenance":[{"revision":"ed5232fbf5c98f107d15ac090b5efd591ed99c05","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-84096"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-26T06:00:19Z","record_encoding":{"expanded_bytes":2902,"expanded_sha256":"9a6abb2107248cc267bd54efa59038fe9b074359c0e3df5b135a8a2b06a32eeb","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-84096","refer
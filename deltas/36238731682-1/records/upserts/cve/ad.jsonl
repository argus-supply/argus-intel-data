{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"12.7.12","status":"affected","version":"0","versionType":"semver"}],"product":"wp-review-slider-pro","vendor":"Unknown"}],"aliases":["CVE-2026-84095"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The wp-review-slider-pro WordPress plugin before 12.7.12 does not perform a capability check on one of its AJAX handlers, and the nonce protecting it is generated for every visitor, allowing any authenticated user, such as a subscriber, to store arbitrary review content which is later output without escaping on public pages, leading to Stored Cross-Site Scripting."}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Cross-Site Scripting (XSS)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-26T06:00:19.203Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"WP Review Slider Pro < 12.7.12 - Subscriber+ Stored XSS via Review Import"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"88cbe9412a79bff8490a4b18654175bfab298ef5a5ab608f5e34da8e49fd6284","data_version":"5.2","first_seen_at":"2026-09-26T11:25:35Z","kind":"advisory","last_material_event_at":"2026-09-26T11:25:35Z","native_id":"CVE-2026-84095","provenance":[{"revision":"ed5232fbf5c98f107d15ac090b5efd591ed99c05","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-84095"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-26T06:00:19Z","record_encoding":{"expanded_bytes":2824,"expanded_sha256":"344177f0858358baa7177bec31f7d706425f70a1ff2628125128efc50ced93eb","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-84095","references":[{"assertion_role":"cna","provid
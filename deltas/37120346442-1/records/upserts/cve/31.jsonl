{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"4.2.3","status":"affected","version":"0","versionType":"semver"}],"product":"MPG","vendor":"Unknown"}],"aliases":["CVE-2026-103293"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The MPG  WordPress plugin before 4.2.3 does not validate that the dataset source supplied when importing a project is a remote URL before treating it as a local filesystem path and copying that file into a publicly accessible uploads folder. This makes it possible for users with the Editor role and above to read the contents of arbitrary files on the server, with the copied file then retrievable by unauthenticated visitors."}],"problemTypes":[{"descriptions":[{"description":"CWE-22 Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-03T06:00:24.965Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"MPG < 4.2.3 - Editor+ Arbitrary File Read via Project Import"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"f4ee7a64666d967171e7b396013a7102e0c969efd4cf1ea0b5085e5844e6a7ce","data_version":"5.2","first_seen_at":"2026-10-03T11:40:02Z","kind":"advisory","last_material_event_at":"2026-10-03T11:40:02Z","native_id":"CVE-2026-103293","provenance":[{"revision":"76db341685347c82b67f7ce70b1a286e94270b43","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-103293"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-03T06:00:24Z","record_encoding":{"expanded_bytes":2957,"expanded_sha256":"40e8098048fae6fcfb7967f94e779bb04e950a436f9acc5f2916692ac1829562","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descripti
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.4.4","status":"affected","version":"0","versionType":"semver"}],"product":"WP Ultimate Review","vendor":"Unknown"}],"aliases":["CVE-2026-101160"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The WP Ultimate Review WordPress plugin before 2.4.4 does not validate that a submitted review rating is numeric before storing it and later using it in numeric operations when rendering reviews, allowing unauthenticated users to make the reviewed content fail with a fatal error for all visitors until the review is removed (a persistent denial of service), when user reviews are enabled."}],"problemTypes":[{"descriptions":[{"description":"CWE-400 Uncontrolled Resource Consumption","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-03T06:00:24.431Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"WP Ultimate Review < 2.4.4 - Unauthenticated DoS via Non-Numeric Review Rating"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"a67defc5723ec6f481c37e52258448e49d391a735ef6cecbdfee5adf9326689a","data_version":"5.2","first_seen_at":"2026-10-03T11:40:02Z","kind":"advisory","last_material_event_at":"2026-10-03T11:40:02Z","native_id":"CVE-2026-101160","provenance":[{"revision":"76db341685347c82b67f7ce70b1a286e94270b43","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-101160"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-03T06:00:24Z","record_encoding":{"expanded_bytes":2888,"expanded_sha256":"03a7347321cb6d5b88c510852f66ed55469201baf8277c1688aefcfdb9082eae","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-101160","referenc
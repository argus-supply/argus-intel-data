{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.0.21","status":"affected","version":"1.5.142","versionType":"semver"}],"product":"Unlimited Elements for Elementor","vendor":"Unknown"}],"aliases":["CVE-2026-92923"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Unlimited Elements for Elementor WordPress plugin before 2.0.21 does not sanitise and escape a parameter before using it in a SQL statement, allowing users with a role as low as subscriber to perform blind SQL injection attacks and read arbitrary data from the database. Version 2.0.18 removed the subscriber-level access, so from 2.0.18 onward the issue requires a Contributor role or above."}],"problemTypes":[{"descriptions":[{"description":"CWE-89 SQL Injection","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-03T06:00:27.523Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Unlimited Elements For Elementor 1.5.142 - 2.0.20 - Subscriber+ SQLi via get_addon_output_data"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"8679bb285f8bbee60bd25559b43e6fb86fd26b665ae4984db24f1429956689d2","data_version":"5.2","first_seen_at":"2026-10-03T11:40:02Z","kind":"advisory","last_material_event_at":"2026-10-03T11:40:02Z","native_id":"CVE-2026-92923","provenance":[{"revision":"76db341685347c82b67f7ce70b1a286e94270b43","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-92923"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-03T06:00:27Z","record_encoding":{"expanded_bytes":2930,"expanded_sha256":"c4dace8e78f81d80b2da531aa1f4ac99772dce080d8beef95b151ecc4fb980d3","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-20
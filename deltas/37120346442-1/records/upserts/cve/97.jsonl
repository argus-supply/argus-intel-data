{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"9.2","status":"affected","version":"7.17","versionType":"semver"}],"product":"WP Ultimate CSV Importer","vendor":"Unknown"}],"aliases":["CVE-2026-80517"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The WP Ultimate CSV Importer  WordPress plugin before 9.2 does not properly validate the file types contained in an uploaded archive nor sanitise their content before storing them in a publicly served location, allowing high privilege users such as administrators to achieve Stored Cross-Site Scripting. On Multisite installations a site Administrator does not hold the unfiltered_html capability, so this lets them run scripts in the session of users who view the file, including Network Super Admins."}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Cross-Site Scripting (XSS)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-03T06:00:25.324Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"WP Ultimate CSV Importer 7.17 - 9.1 - Admin+ Stored XSS via ZIP Import SVG Upload"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"dc29c25a9673ef2e139e5ff0e40f87d852e73593a26f365d4d00b722bd115e69","data_version":"5.2","first_seen_at":"2026-10-03T11:40:02Z","kind":"advisory","last_material_event_at":"2026-10-03T11:40:02Z","native_id":"CVE-2026-80517","provenance":[{"revision":"76db341685347c82b67f7ce70b1a286e94270b43","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-80517"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-03T06:00:25Z","record_encoding":{"expanded_bytes":3115,"expanded_sha256":"0628674564c467fc7a45b1065a31f703de7063e576259761bdc97da87765ec72","format":"cve-indexed-assertions-v1","top_descr
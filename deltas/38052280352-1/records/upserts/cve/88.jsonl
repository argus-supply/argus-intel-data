{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"6.2.5","status":"affected","version":"0","versionType":"semver"}],"product":"Fluent Forms – Customizable Contact Forms, Survey, Quiz, & Conversational Form Builder","vendor":"wpmanageninja"}],"aliases":["CVE-2026-15178"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Fluent Forms plugin for WordPress is vulnerable to authorization bypass in all versions up to, and including, 6.2.5. This is due to the plugin not properly verifying that a user is authorized to perform an action. This makes it possible for authenticated attackers, with Custom-level access and above, to read private form submissions, change submission statuses, permanently delete submissions, and modify global plugin settings."}],"metrics":[{"cvssV3_1":{"baseScore":5.4,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:L/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-862","description":"CWE-862 Missing Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-10T06:40:08.620Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"Fluent Forms <= 6.2.5 - Missing Authorization to Authenticated (Custom+) Sensitive Data Exposure and Modification"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"be86a5181f0b37ef4670f20104bc90947199a7c59b4d98f9794439185c305495","data_version":"5.2","first_seen_at":"2026-10-10T12:32:28Z","kind":"advisory","last_material_event_at":"2026-10-10T12:32:28Z","native_id":"CVE-2026-15178","provenance":[{"revision":"17aab24eea0df415cedff830a7987f8e2ab466a9","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-15178"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_
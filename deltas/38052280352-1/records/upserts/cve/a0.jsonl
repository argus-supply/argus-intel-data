{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"3.28.36","status":"affected","version":"0","versionType":"semver"}],"product":"Frontend Admin by DynamiApps","vendor":"shabti"}],"aliases":["CVE-2026-6243"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Frontend Admin by DynamiApps plugin for WordPress is vulnerable to Stored Cross-Site Scripting via kses bypass / mutation XSS in all versions up to, and including, 3.28.36. This is due to the 'get_dynamic_values' function performing text-level find-and-replace operations on post content without HTML-aware parsing. This makes it possible for authenticated attackers, with Contributor-level access and above, to inject arbitrary web scripts in pages that will execute whenever a user accesses an injected page."}],"metrics":[{"cvssV3_1":{"baseScore":6.4,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:C/C:L/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-79","description":"CWE-79 Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-10T06:40:13.833Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"Frontend Admin by DynamiApps <= 3.28.36 - Authenticated (Contributor+) Stored Cross-Site Scripting via Post Content"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"0630b62ccb167f39d98951cbeffb75dd9aac6ea9060405471bdf5d338b3089ac","data_version":"5.2","first_seen_at":"2026-10-10T12:32:28Z","kind":"advisory","last_material_event_at":"2026-10-10T12:32:28Z","native_id":"CVE-2026-6243","provenance":[{"revision":"17aab24eea0df415cedff830a7987f8e2ab466a9","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-6243"},{"a
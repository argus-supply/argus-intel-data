{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"6.3.9","status":"affected","version":"0","versionType":"semver"}],"product":"WP File Download","vendor":"JoomUnited"}],"aliases":["CVE-2026-94538"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The WP File Download plugin for WordPress is vulnerable to authorization bypass in all versions up to, and including, 6.3.9. This is due to the plugin not properly verifying that a user is authorized to perform an action. This makes it possible for authenticated attackers, with subscriber-level access and above, to permanently delete any file managed by WP File Download, empty the entire trash, move files between categories, and publish or unpublish arbitrary files."}],"metrics":[{"cvssV3_1":{"baseScore":8.1,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:H/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-862","description":"CWE-862 Missing Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-10T06:40:12.227Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"WP File Download <= 6.3.9 - Missing Authorization to Authenticated (Subscriber+) Arbitrary File Deletion/Modification via 'task' Parameter to Multiple Functions"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"f3544276774a080404338133116ec3fbc8149d74d5038b52ed3f394127af1ac8","data_version":"5.2","first_seen_at":"2026-10-10T12:32:28Z","kind":"advisory","last_material_event_at":"2026-10-10T12:32:28Z","native_id":"CVE-2026-94538","provenance":[{"revision":"17aab24eea0df415cedff830a7987f8e2ab466a9","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-94538"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"pu
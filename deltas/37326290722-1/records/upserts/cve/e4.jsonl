{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"4.9.7","status":"affected","version":"4.9.0","versionType":"semver"}],"product":"CoCart","vendor":"Unknown"}],"aliases":["CVE-2026-93549"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The CoCart  WordPress plugin before 4.9.7 does not scope its REST API authentication filter to its own endpoints, which disables WordPress core's REST nonce protection for every route, allowing an attacker to perform a cross-site request forgery attack that creates a new administrator account using a logged-in administrator's session."}],"problemTypes":[{"descriptions":[{"description":"CWE-352 Cross-Site Request Forgery (CSRF)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-04T06:00:23.901Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"CoCart 4.9.0 - 4.9.6 - Administrator Account Creation via REST API Authentication Bypass"},{"affected_indices":[],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"HIGH","baseScore":8.8,"baseSeverity":"HIGH","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"REQUIRED","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H","version":"3.1"}},{"other":{"content":{"id":"CVE-2026-93549","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-10-05T10:50:22.503687Z","version":"2.0.3"},"type":"ssvc"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-352","description":"CWE-352 Cross-Site Request Forgery (CSRF)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-05T10:53:49.170Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configur
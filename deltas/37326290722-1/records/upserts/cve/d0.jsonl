{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-88394"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"WookTeam v1.6.6 and before is vulnerable to a Directory Traversal. The project task export endpoint /api/project/task/export downloads an arbitrary file from the server when the data parameter is supplied with a crafted JSON payload. The file value inside the JSON is concatenated directly into storage_path($file) without any path normalization or directory boundary check, so directory traversal (../) escapes the storage/ directory and response()->download() streams any file readable by the web server process."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-10-05T14:22:29.647Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"939bffe21754f6a4d3aafb60ecb45397de0eccd4f53cd9097efb6e20bec3cf68","data_version":"5.2","first_seen_at":"2026-10-05T14:39:04Z","kind":"advisory","last_material_event_at":"2026-10-05T14:39:04Z","native_id":"CVE-2026-88394","provenance":[{"revision":"c28dd66bd51d5f8a14f16c1c3c10116c82dcd000","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-88394"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-05T00:00:00Z","record_encoding":{"expanded_bytes":2790,"expanded_sha256":"5eefebce7f5f869fef7ee03ef0381d9f02c7df296393e68e4c3c137ec22ebbc2","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-88394","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-05T14:22:29.647Z","orgId":"825
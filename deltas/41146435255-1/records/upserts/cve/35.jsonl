{"affected":[{"collectionURL":"https://wordpress.org/plugins","defaultStatus":"unaffected","original_ranges":[{"lessThan":"5.16.5","status":"affected","version":"5.16.2","versionType":"semver"}],"product":"PDF Invoices & Packing Slips for WooCommerce","vendor":"Unknown"}],"aliases":["CVE-2026-111578"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The PDF Invoices & Packing Slips for WooCommerce WordPress plugin from 5.16.2 before 5.16.5 does not properly escape several customer-supplied order fields — including the billing and shipping address values and the customer order note — before they are output in generated invoice and packing-slip documents, allowing unauthenticated users placing guest orders to store a malicious script that executes when a shop administrator views the document, leading to Stored Cross-Site Scripting."}],"metrics":[{"cvssV3_1":{"baseScore":7.5,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:R/S:U/C:H/I:H/A:H","version":"3.1"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Cross-Site Scripting (XSS)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-30T21:17:55.672Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"PDF Invoices & Packing Slips for WooCommerce 5.16.2 - 5.16.4 - Unauthenticated Stored XSS via Order Address and Customer Note Fields"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"1316be4bae317e38a9d24deb86e619890ae659ae92434b6a0826528506690fb5","data_version":"5.2","first_seen_at":"2026-10-30T23:47:26Z","kind":"advisory","last_material_event_at":"2026-10-30T23:47:26Z","native_id":"CVE-2026-111578","provenance":[{"revision":"74a05cb0352c8472f72aad69817072e95a35b161","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-111578"},{"asser
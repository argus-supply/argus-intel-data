{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.43.0","status":"affected","version":"1.40","versionType":"custom"}],"product":"Armeria","vendor":"LY Corporation"}],"aliases":["CVE-2026-121819"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A vulnerability has been identified in armeria-xds versions 1.40.0 through 1.42.0, where DataSourcePolicy checks filename containment without resolving symbolic links, allowing a compromised or semi-trusted xDS control plane to cause the xDS client to read files outside configured allowed root directories when a symbolic link inside an allowed directory points outside it. In deployments using a credential injector, header-compatible text secrets may be exposed to an attacker-observable upstream."}],"metrics":[{"cvssV4_0":{"baseScore":5.9,"baseSeverity":"MEDIUM","vectorString":"CVSS:4.0/AV:N/AC:L/AT:P/PR:H/UI:N/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N","version":"4.0"}}],"problemTypes":[{"descriptions":[{"description":"CWE-59","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-06T07:46:45.370Z","orgId":"657f3255-0560-4aed-82e4-7f579ec6acfb","shortName":"LY-Corporation"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"a12b58cfc0c81ee39350a5551d9bcfd23cf28bcd54e83f6089eaa9f4591e1f57","data_version":"5.2","first_seen_at":"2026-11-06T15:55:58Z","kind":"advisory","last_material_event_at":"2026-11-06T15:55:58Z","native_id":"CVE-2026-121819","provenance":[{"revision":"675ac52ee255f862381cfc5294abd49f5a8a018b","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-121819"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-06T07:46:45Z","record_encoding":{"expanded_bytes":3278,"expanded_sha256":"2275e85f05a5148e9508e41ea671560af9256116a62cdf1c3440cad6178bd4d3","format":"cve
{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["HTTP::Body"],"original_ranges":[{"lessThan":"1.24_02","status":"affected","version":"0","versionType":"custom"}],"packageName":"HTTP-Body","packageURL":"pkg:cpan/HTTP-Body","programFiles":["lib/HTTP/Body.pm"],"programRoutines":[{"name":"HTTP::Body::add"}],"repo":"https://github.com/libwww-perl/HTTP-Body"}],"aliases":["CVE-2026-121006"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"HTTP::Body versions before 1.24_02 for Perl parse the trailer in quadratic time.\n\nEverything after the last chunk in the same call to add() is parsed with HTTP::Headers, which takes time quadratic in the number of fields of one name.  For example, it takes several seconds to parse 16 KiB of \"a:\" lines.\n\nA remote attackercan exhause the CPU with a single request.\n\nHTTP::Body version 1.25 limits the size and number of lines in the trailer."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-770","description":"CWE-770 Allocation of Resources Without Limits or Throttling","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-06T07:47:23.570Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"HTTP::Body versions before 1.24_02 for Perl parse the trailer in quadratic time"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"5e9c06f428210a4d599424b634c513f67f3802b683094e4a6e1b1aa1079714e6","data_version":"5.2","first_seen_at":"2026-11-06T15:55:58Z","kind":"advisory","last_material_event_at":"2026-11-06T15:55:58Z","native_id":"CVE-2026-121006","provenance":[{"revision":"675ac52ee255f862381cfc5294abd49f5a8a018b","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-121006"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_
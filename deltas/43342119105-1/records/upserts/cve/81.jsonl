{"affected":[{"original_ranges":[{"status":"affected","version":"< 2.12.7"},{"status":"affected","version":"< 2.13.1"}],"product":"icingaweb2","vendor":"Icinga"}],"aliases":["CVE-2026-61637"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Icinga Web 2 is an open source monitoring web interface, framework and command-line interface. Prior to versions 2.12.7 and 2.13.1, an attacker can craft a URL that, once visited by an authenticated user (or one that is able to authenticate), allows to manipulate the backend to redirect the user to any location. For this to succeed, the victim's locale in Icinga Web must be different from en_US. This issue has been patched in versions 2.12.7 and 2.13.1."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":3.5,"baseSeverity":"LOW","confidentialityImpact":"LOW","integrityImpact":"NONE","privilegesRequired":"LOW","scope":"UNCHANGED","userInteraction":"REQUIRED","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:R/S:U/C:L/I:N/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-601","description":"CWE-601: URL Redirection to Untrusted Site","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-11T18:26:59.587Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"Icinga Web 2: Open redirect on login page, under certain circumstances"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-61637","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-11-12T19:40:03.863019Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-11-12T19:40:14.142Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protoco
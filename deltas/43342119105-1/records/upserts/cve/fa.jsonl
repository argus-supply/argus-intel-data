{"affected":[{"original_ranges":[{"status":"affected","version":">= 1.4.0, < 1.4.4"},{"status":"affected","version":">= 1.5.0, < 1.5.1"}],"product":"bacnet-stack","vendor":"bacnet-stack"}],"aliases":["CVE-2026-45341"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"BACnet Stack is a BACnet open source protocol stack C library for embedded systems. From versions 1.4.0 to before 1.4.4, and 1.5.0 to before 1.5.1, a NULL pointer dereference can be triggered in bacnet_device_object_reference_decode() when a WriteProperty request updates OBJECT_STRUCTURED_VIEW / PROP_SUBORDINATE_LIST. This issue has been patched in versions 1.4.4 and 1.5.1."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"HIGH","baseScore":7.5,"baseSeverity":"HIGH","confidentialityImpact":"NONE","integrityImpact":"NONE","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-476","description":"CWE-476: NULL Pointer Dereference","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-12T20:00:08.694Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"BACnet Stack: NULL pointer dereference in bacnet_device_object_reference_decode() when WriteProperty updates Structured View subordinate-list"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"cb9a744d017f6bc70ea2351fc290def28c3939294494aa6577a0dc153d5bae99","data_version":"5.2","first_seen_at":"2026-11-13T01:05:43Z","kind":"advisory","last_material_event_at":"2026-11-13T01:05:43Z","native_id":"CVE-2026-45341","provenance":[{"revision":"55f204c1fe26d24abf5581c31374a6c47b27b6d4","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-
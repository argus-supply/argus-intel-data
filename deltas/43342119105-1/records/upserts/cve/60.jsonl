{"affected":[{"original_ranges":[{"status":"affected","version":"< 6.6.1"}],"product":"tornado","vendor":"tornadoweb"}],"aliases":["CVE-2026-126347"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Tornado is a Python web framework and asynchronous networking library. In versions through 6.6.0, applications using  tornado.web.RedirectHandler  with URL templates that allow attacker-controlled substitutions to influence the destination can be vulnerable to an open redirect using three or more leading slashes. Differences between Python’s URL parsing and browser URL interpretation allow a crafted destination to redirect a user to an attacker-controlled host. The remediation for CVE-2026-116578 in version 6.6.0 did not fully address this case. This issue is fixed in version 6.6.1."}],"metrics":[{"cvssV3_1":{"attackComplexity":"HIGH","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":3.1,"baseSeverity":"LOW","confidentialityImpact":"NONE","integrityImpact":"LOW","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"REQUIRED","vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:R/S:U/C:N/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-601","description":"CWE-601: URL Redirection to Untrusted Site","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-12T21:52:22.374Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"Tornado: Open redirect via triple-slash redirect paths"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"19a74f17dd5f91099e1454971d4768e3c4ecaa291d37baafc4efb7e7ed3bf83b","data_version":"5.2","first_seen_at":"2026-11-13T01:05:43Z","kind":"advisory","last_material_event_at":"2026-11-13T01:05:43Z","native_id":"CVE-2026-126347","provenance":[{"revision":"55f204c1fe26d24abf5581c31374a6c47
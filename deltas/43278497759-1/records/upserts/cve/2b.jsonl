{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"18.7","status":"affected","version":"18","versionType":"rpm"}],"product":"PostgreSQL","vendor":"n/a"}],"aliases":["CVE-2026-116313"],"assertions":[{"affected_indices":[0],"configurations":[{"lang":"en","value":"attacker owns the database; victim runs vacuumdb with --missing-stats-only against that database"}],"descriptions":[{"lang":"en","value":"Untrusted search path in PostgreSQL vacuumdb allows a database owner to execute arbitrary SQL as the database user running vacuumdb, via shadowing operators used in the --missing-stats-only catalog query.  The pg_upgrade documentation recommends an affected vacuumdb invocation.  Within major version 18, minor versions before PostgreSQL 18.7 are affected.  Versions before PostgreSQL 18 are unaffected."}],"metrics":[{"cvssV3_1":{"baseScore":7.2,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:U/C:H/I:H/A:H","version":"3.1"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-426","description":"Untrusted Search Path","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-12T14:15:07.627Z","orgId":"f86ef6dc-4d3a-42ad-8f28-e6d5547a5007","shortName":"PostgreSQL"},"role":"cna","title":"PostgreSQL \"vacuumdb --missing-stats-only\" lets a database owner execute code as the vacuumdb user"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"90f6943f1eaa6742a15d1d80bb481de3da52b5542852bd9b257c1ee2a2a24264","data_version":"5.2","first_seen_at":"2026-11-12T18:19:39Z","kind":"advisory","last_material_event_at":"2026-11-12T18:19:39Z","native_id":"CVE-2026-116313","provenance":[{"revision":"013146d718ad2b1b0f7a60f8b255a8218a1af57e","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-116313"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"
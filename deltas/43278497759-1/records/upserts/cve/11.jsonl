{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"2.1.7","status":"affected","version":"0","versionType":"semver"}],"product":"WP Table Builder – Drag & Drop Table Builder","vendor":"wptb"}],"aliases":["CVE-2026-2982"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The WP Table Builder – Drag & Drop Table Builder plugin for WordPress is vulnerable to Stored Cross-Site Scripting via the 'url' parameter in versions up to, and including, 2.1.7 due to insufficient input sanitization and output escaping. This makes it possible for authenticated attackers, with contributor-level permissions and higher, to inject arbitrary web scripts in pages that will execute whenever a user accesses an injected page. Exploitation by lower-privileged users requires an administrator to explicitly allow those roles in plugin settings. While it is possible to assign subscriber-level roles with the ability to create tables, such privileges are usually assigned to the more appropriate contributor, author, or editor level roles."}],"metrics":[{"cvssV3_1":{"baseScore":5.4,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:R/S:C/C:L/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-79","description":"CWE-79 Improper Neutralization of Input During Web Page Generation","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-12T11:32:16.664Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"WP Table Builder – Drag & Drop Table Builder <= 2.1.7 - Authenticated (Contributor+) Stored Cross-Site Scripting via 'url'"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"a40672b02fb5a13bbe4877b68f19f2c7f11bb74055e1fd873da75cc0bd998b5e","data_version":"5.2","first_seen_at":"2026-11-12T18:19:39Z","kind":"advisory","last_material_event_at":"2026-11-12T18:19:39Z","native_id":"CVE-2026-2982","provenance":[{"revision":"013146d718ad2b1b0f7a60f8b255a8218a1af57e","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-2982"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-12T11:32:16Z","record_encoding":{"expanded_bytes":4137,"expanded_sha256":"a4387008d9b9f662ba44baf12ca835c1489c5e378ff406fc6700424d9f657077","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-2982","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-12T11:32:16.664Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"url":"https://www.wordfence.com/threat-intel/vulnerabilities/id/d07a08ad-c9b7-44fe-a199-fa8bb7f3eea2?source=cve"},{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-12T11:32:16.664Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"url":"https://plugins.trac.wordpress.org/changeset/3469639/wp-table-builder"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-11-12T11:32:16Z","status":"active","title":"WP Table Builder – Drag & Drop Table Builder <= 2.1.7 - Authenticated (Contributor+) Stored Cross-Site Scripting via 'url'"}

{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"1.9.9.8.1","status":"affected","version":"0","versionType":"semver"}],"product":"VibeBP","vendor":"VibeThemes"}],"aliases":["CVE-2026-16135"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The VibeBP plugin for WordPress is vulnerable to Privilege Escalation in all versions up to, and including, 1.9.9.8.1. This is due to the plugin allowing arbitrary user meta updates through the set_email_notification_settings() function. This makes it possible for authenticated attackers, with Subscriber-level access and above, to grant themselves administrator privileges by updating their own 'wp_capabilities' user meta value."}],"metrics":[{"cvssV3_1":{"baseScore":8.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-269","description":"CWE-269 Improper Privilege Management","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-12T11:32:17.038Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"VibeBP <= 1.9.9.8.1 - Authenticated (Subscriber+) Privilege Escalation in set_email_notification_settings()"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"af6d5d5be8279eccc8f40aedd1472b569055f1a513cbd1c6f59fb7ab78904663","data_version":"5.2","first_seen_at":"2026-11-12T18:19:39Z","kind":"advisory","last_material_event_at":"2026-11-12T18:19:39Z","native_id":"CVE-2026-16135","provenance":[{"revision":"013146d718ad2b1b0f7a60f8b255a8218a1af57e","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-16135"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-12T11:32:17Z","record_encoding":{"expanded_bytes":3405,"expanded_sha2
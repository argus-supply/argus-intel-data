{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"18.7","status":"affected","version":"18","versionType":"rpm"},{"lessThan":"17.12","status":"affected","version":"17","versionType":"rpm"},{"lessThan":"16.16","status":"affected","version":"16","versionType":"rpm"},{"lessThan":"15.20","status":"affected","version":"15","versionType":"rpm"}],"product":"PostgreSQL","vendor":"n/a"}],"aliases":["CVE-2026-116312"],"assertions":[{"affected_indices":[0],"configurations":[{"lang":"en","value":"a partitioned table has an AFTER UPDATE statement trigger with a transition table"}],"descriptions":[{"lang":"en","value":"Inconsistent transition-capture state in PostgreSQL MERGE allows a table data modifier to make an AFTER trigger process the wrong new row, via a partitioned table MERGE that performs an INSERT before an UPDATE.  Within major versions 15-18, minor versions before PostgreSQL 18.7, 17.12, 16.16, and 15.20 are affected.  Versions before PostgreSQL 15 are unaffected."}],"metrics":[{"cvssV3_1":{"baseScore":5.4,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:L/I:L/A:N","version":"3.1"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-1250","description":"Improper Preservation of Consistency Between Independent Representations of Shared State","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-12T14:15:06.946Z","orgId":"f86ef6dc-4d3a-42ad-8f28-e6d5547a5007","shortName":"PostgreSQL"},"role":"cna","title":"PostgreSQL MERGE can place the wrong row in a trigger transition table"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"06fc613be70eec40a051bbe9ee5c4064c2a34be31932c08a07e112ed3155af51","data_version":"5.2","first_seen_at":"2026-11-12T18:19:39Z","kind":"advisory","last_material_event_at":"2026-11-12T18:19:39Z","native_id":"CVE-2026-116312","
{"affected":[{"defaultStatus":"unknown","original_ranges":[{"lessThan":"0.53.0","status":"affected","version":"0.7.0","versionType":"semver"},{"lessThan":"*","status":"unaffected","version":"0.53.0","versionType":"semver"}],"platforms":["MacOS","Linux"],"product":"Docker Sandboxes","vendor":"Docker"}],"aliases":["CVE-2026-126329"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Docker Sandboxes reuses existing state and configuration directories without verifying their ownership. If sbx or sandboxd is run as root with HOME or, on Linux, XDG_STATE_HOME pointing to an attacker-controlled location, a local unprivileged user can substitute control-plane sockets and configuration trusted by the root process, potentially executing commands as root. Exploitation requires a privileged invocation with an attacker-influenced environment. The issue affects Linux and macOS and is fixed in version 0.53.0."}],"metrics":[{"cvssV4_0":{"attackComplexity":"LOW","attackRequirements":"PRESENT","attackVector":"LOCAL","baseScore":7.3,"baseSeverity":"HIGH","privilegesRequired":"LOW","subAvailabilityImpact":"NONE","subConfidentialityImpact":"NONE","subIntegrityImpact":"NONE","userInteraction":"NONE","vectorString":"CVSS:4.0/AV:L/AC:L/AT:P/PR:L/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N","version":"4.0","vulnAvailabilityImpact":"HIGH","vulnConfidentialityImpact":"HIGH","vulnIntegrityImpact":"HIGH"},"format":"CVSS","scenarios":[{"lang":"en","value":"A local unprivileged attacker controls a state or configuration directory reused by a root invocation with an attacker-influenced HOME or XDG_STATE_HOME."}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-282","description":"CWE-282: Improper Ownership Management","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-12T15:50:44.926Z","orgId":"686469e6-3ff6-451b-ab8b-cf5b9e89401e","shortName":"Docker"},"role":"cna","title":"Docker Sandboxes privilege escalation through untrusted state directories"}],"assessment":{"a
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"1.5.1","status":"affected","version":"0","versionType":"semver"}],"product":"CourseCure Courses","vendor":"WishList Member"}],"aliases":["CVE-2026-15309"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The CourseCure Courses plugin for WordPress is vulnerable to Privilege Escalation in versions up to, and including, 1.5.1. This is due to a missing capability check in the ajax_save_settings() function, which accepts arbitrary POST parameters and calls update_option() with attacker-controlled keys and values without any authorization verification. This makes it possible for authenticated attackers, with subscriber-level access and above, to elevate their privileges to administrator by setting the default_role WordPress option to 'administrator' and users_can_register to '1', then registering a new account that is automatically granted full administrator access."}],"metrics":[{"cvssV3_1":{"baseScore":8.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-269","description":"CWE-269 Improper Privilege Management","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-12T11:32:16.143Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"CourseCure Courses <= 1.5.1 - Authenticated (Subscriber+) Privilege Escalation to 'ajax_save_settings' Endpoint"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"da12e48c002744820ec565f171e88c14cb1e27c628d44611b0127eba5c5b3813","data_version":"5.2","first_seen_at":"2026-11-12T18:19:39Z","kind":"advisory","last_material_event_at":"2026-11-12T18:19:39Z","native_id":"CVE-2026-15309","provenance":[{"revision":"013146d718ad2b1b0f7a60f8
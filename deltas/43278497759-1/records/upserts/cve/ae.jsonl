{"affected":[{"original_ranges":[{"lessThanOrEqual":"4.0.0","status":"affected","version":"0","versionType":"custom"}],"product":"Promzard","vendor":"Promzard"}],"aliases":["CVE-2026-127109"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A code injection vulnerability in promzard’s template-loading functionality allows an attacker who can control property names in the context object (ctx) to execute arbitrary code with the privileges of the Node.js process. The library inserts context property names into a generated function’s parameter list without validation or escaping and evaluates the resulting source using `vm.runInThisContext()`. A crafted property name can escape the parameter list and inject JavaScript code, even when the template file is fully trusted."}],"problemTypes":[{"descriptions":[{"description":"CWE-94 Improper Control of Generation of Code ('Code Injection')","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-12T15:08:53.202Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"role":"cna","title":"CVE-2026-127109"},{"affected_indices":[],"provider":{"dateUpdated":"2026-11-12T17:05:17.829Z","orgId":"af854a3a-2127-422b-91ae-364da2661108","shortName":"CVE"},"role":"adp","title":"CVE Program Container"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"946777dff00772bb6a7d694096097cdd09e53039664810eeecad0971b0cec5f3","data_version":"5.2","first_seen_at":"2026-11-12T18:19:39Z","kind":"advisory","last_material_event_at":"2026-11-12T18:19:39Z","native_id":"CVE-2026-127109","provenance":[{"revision":"013146d718ad2b1b0f7a60f8b255a8218a1af57e","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-127109"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"},{"assertion_index":1,"independent_evidence":false,"source_id":"cve"}],"publ
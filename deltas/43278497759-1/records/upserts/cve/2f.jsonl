{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"18.7","status":"affected","version":"18","versionType":"rpm"},{"lessThan":"17.12","status":"affected","version":"17","versionType":"rpm"},{"lessThan":"16.16","status":"affected","version":"16","versionType":"rpm"},{"lessThan":"15.20","status":"affected","version":"15","versionType":"rpm"},{"lessThan":"14.25","status":"affected","version":"0","versionType":"rpm"}],"product":"PostgreSQL","vendor":"n/a"}],"aliases":["CVE-2026-14661"],"assertions":[{"affected_indices":[0],"configurations":[{"lang":"en","value":"Superuser previously issued \"CREATE EXTENSION dblink\"."},{"lang":"en","value":"Superuser previously granted pg_create_subscription to non-superuser roles."}],"descriptions":[{"lang":"en","value":"External control of file name in PostgreSQL dblink and CREATE/ALTER SUBSCRIPTION allows a user to achieve persistent denial of service, via appending invalid data to a chosen file.  Specifically, the \"sslkeylogfile\" connection parameter appends data, in NSS keylog format, to a file of the user's choosing.  This \"sslkeylogfile\" mechanism cannot add arbitrary bytes.  Within major version 18, minor versions before PostgreSQL 18.7 are affected.  Versions before PostgreSQL 18 are also affected if libpq version 18 or later is installed and in use by the server."}],"metrics":[{"cvssV3_1":{"baseScore":8.1,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:H/A:H","version":"3.1"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-73","description":"External Control of File Name or Path","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-12T14:15:30.140Z","orgId":"f86ef6dc-4d3a-42ad-8f28-e6d5547a5007","shortName":"PostgreSQL"},"role":"cna","title":"PostgreSQL dblink and subscriptions can append to arbitrary files"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"6647a699c5bd9ad09333e1e5d6d36abe238f40d23858b612b8494e81bf69ddc2","data_version":"5.2","first_seen_at":"2026-11-12T18:19:39Z","kind":"advisory","last_material_event_at":"2026-11-12T18:19:39Z","native_id":"CVE-2026-14661","provenance":[{"revision":"013146d718ad2b1b0f7a60f8b255a8218a1af57e","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-14661"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-12T14:15:30Z","record_encoding":{"expanded_bytes":3820,"expanded_sha256":"43c3fe3eee8adc7b9296c16a5e261b0843827541f749c41c71141ebf2a48c1cb","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-14661","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-12T14:15:30.140Z","orgId":"f86ef6dc-4d3a-42ad-8f28-e6d5547a5007","shortName":"PostgreSQL"},"url":"https://www.postgresql.org/support/security/CVE-2026-14661/"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-11-12T14:15:30Z","status":"active","title":"PostgreSQL dblink and subscriptions can append to arbitrary files"}

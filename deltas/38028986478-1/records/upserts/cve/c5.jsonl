{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.10.6","status":"affected","version":"0","versionType":"semver"}],"product":"W3 Total Cache","vendor":"Unknown"}],"aliases":["CVE-2026-107321"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The W3 Total Cache WordPress plugin before 2.10.6 does not confine a media-import file copy to the document root, nor enforce an effective file-type restriction on it, allowing users with the Author role or higher to plant content that, once an administrator runs the import, copies an arbitrary server-readable file into a publicly served directory, exposing it to unauthenticated retrieval."}],"problemTypes":[{"descriptions":[{"description":"CWE-22 Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-10T06:00:09.213Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"W3 Total Cache < 2.10.6 - Author+ Path Traversal via CDN Media Library Import"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"4ec14735bf43f9cce04b6af3a75016ac9d5fab694e4251140b1d871b192251e7","data_version":"5.2","first_seen_at":"2026-10-10T05:53:19Z","kind":"advisory","last_material_event_at":"2026-10-10T05:53:19Z","native_id":"CVE-2026-107321","provenance":[{"revision":"0642a61659da6a385c55b8f6430d7a5cb0d8a702","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-107321"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-10T06:00:09Z","record_encoding":{"expanded_bytes":2933,"expanded_sha256":"f6e9d22d2bfef43ea6bc3cb70b0e1b0f5f81fe6518db061029125123bf7b52e3","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},
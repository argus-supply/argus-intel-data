{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"2.7.13","status":"affected","version":"0","versionType":"semver"}],"product":"Embed Any Document – Embed PDF, Word, PowerPoint and Excel Files","vendor":"awsmin"}],"aliases":["CVE-2026-18558"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Embed Any Document – Embed PDF, Word, PowerPoint and Excel Files plugin for WordPress is vulnerable to Stored Cross-Site Scripting via the 'embeddoc' shortcode in all versions up to, and including, 2.7.13 due to insufficient input sanitization and output escaping. This makes it possible for authenticated attackers, with contributor-level access and above, to inject arbitrary web scripts in pages that will execute whenever a user accesses an injected page."}],"metrics":[{"cvssV3_1":{"baseScore":6.4,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:C/C:L/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-79","description":"CWE-79 Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-10T05:31:02.386Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"Embed Any Document <= 2.7.13 - Authenticated (Contributor+) Stored Cross-Site Scripting via 'embeddoc' Shortcode"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"75c73b59b68fb60c718e5f87ef91b5eb740698c4cd6903f6c9e4da13133ea25c","data_version":"5.2","first_seen_at":"2026-10-10T05:53:19Z","kind":"advisory","last_material_event_at":"2026-10-10T05:53:19Z","native_id":"CVE-2026-18558","provenance":[{"revision":"0642a61659da6a385c55b8f6430d7a5cb0d8a702","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-18558"},{"assertion_index":
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"3.0.1","status":"affected","version":"0","versionType":"semver"}],"product":"Getwid – Gutenberg Blocks","vendor":"jetmonsters"}],"aliases":["CVE-2026-91862"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Getwid – Gutenberg Blocks plugin for WordPress is vulnerable to Stored Cross-Site Scripting via the 'data-image-points' parameter in all versions up to, and including, 3.0.1 due to insufficient input sanitization and output escaping. This makes it possible for authenticated attackers, with contributor-level access and above, to inject arbitrary web scripts in pages that will execute whenever a user accesses an injected page."}],"metrics":[{"cvssV3_1":{"baseScore":6.4,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:C/C:L/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-79","description":"CWE-79 Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-10T05:31:01.580Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"Getwid <= 3.0.1 - Authenticated (Contributor+) Stored Cross-Site Scripting via 'data-image-points'"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"b7166c4b69b223b03a5f2f1e8185a49bf003cf118036c3dafc9db72b4346cecd","data_version":"5.2","first_seen_at":"2026-10-10T05:53:19Z","kind":"advisory","last_material_event_at":"2026-10-10T05:53:19Z","native_id":"CVE-2026-91862","provenance":[{"revision":"0642a61659da6a385c55b8f6430d7a5cb0d8a702","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-91862"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-10T05:
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"3.2.1","status":"affected","version":"0","versionType":"semver"}],"product":"BuddyBoss App","vendor":"BuddyBoss"}],"aliases":["CVE-2026-76124"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The BuddyBoss App plugin for WordPress is vulnerable to Arbitrary File Upload in all versions up to, and including, 3.2.1 via the send_feedback function. This is due to insufficient file type validation that relies solely on the client-supplied Content-Type header without server-side content inspection or extension validation. This makes it possible for authenticated attackers, with subscriber-level access and above, to upload files that may be executable, which makes remote code execution possible. While uploaded files are deleted after email transmission, a race condition exists during SMTP execution that allows access to the file, and files persist indefinitely when wp_mail() fails."}],"metrics":[{"cvssV3_1":{"baseScore":8.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-434","description":"CWE-434 Unrestricted Upload of File with Dangerous Type","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-03T12:31:54.695Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"BuddyBoss App <= 3.2.1 - Authenticated (Subscriber+) Arbitrary File Upload via Feedback Endpoint"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"fee1a5ba30829b7978db9c1848fa686a9d0c91f0119baddd91a1a0f8e1c5e571","data_version":"5.2","first_seen_at":"2026-11-03T16:15:16Z","kind":"advisory","last_material_event_at":"2026-11-03T16:15:16Z","native_id":"CVE-2026-76124","provenance":[{"revision":"a3d509c
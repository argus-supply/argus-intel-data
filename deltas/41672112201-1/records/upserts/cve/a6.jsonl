{"affected":[{"collectionURL":"https://wordpress.org/plugins","defaultStatus":"unknown","original_ranges":[{"lessThanOrEqual":"3.0.1","status":"affected","version":"3.0.0","versionType":"semver"}],"product":"CryptoCloud","vendor":"Unknown"}],"aliases":["CVE-2026-103327"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The CryptoCloud WordPress plugin from 3.0.0 through 3.0.1 does not verify the authenticity of the payment notifications received by its gateway callback, as the integrity check is skipped while the webhook secret is left at its empty default, allowing unauthenticated attackers to mark arbitrary orders as paid or failed without any payment being made."}],"metrics":[{"cvssV3_1":{"baseScore":5.3,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"description":"CWE-345 Insufficient Verification of Data Authenticity","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-03T08:20:21.840Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"CryptoCloud - Crypto Payment Gateway 3.0.0 - 3.0.1 - Unauthenticated Arbitrary Order Payment Forgery via Empty-Default Webhook Secret"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"cdc4b0cd8742123c640fe27376bc35f5171380b5ef03d8afce854b4f453d1dae","data_version":"5.2","first_seen_at":"2026-11-03T16:15:16Z","kind":"advisory","last_material_event_at":"2026-11-03T16:15:16Z","native_id":"CVE-2026-103327","provenance":[{"revision":"a3d509c250c969eac40397307971498105cfe168","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-103327"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-03T08:20:21Z","record_encoding":{"expanded_bytes":3131,"expanded_sha256":"
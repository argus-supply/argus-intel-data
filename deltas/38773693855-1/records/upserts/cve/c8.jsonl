{"affected":[{"defaultStatus":"unknown","modules":["sound"],"original_ranges":[{"lessThan":"p5","status":"affected","version":"15.1-RELEASE","versionType":"release"},{"lessThan":"p2","status":"affected","version":"14.5-RELEASE","versionType":"release"},{"lessThan":"p11","status":"affected","version":"14.4-RELEASE","versionType":"release"}],"product":"FreeBSD","vendor":"FreeBSD"}],"aliases":["CVE-2026-101308"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-14T18:45:00.000Z","descriptions":[{"lang":"en","value":"When an audio channel's buffer needs to be resized, the sound(4) driver checks that the buffer is not memory-mapped and then drops the channel lock to allocate a new buffer.  An mmap(2) call on another thread can complete during this window, after which the resize path frees the now-mapped buffer without rechecking.\n\nAn unprivileged local user with access to a sound device can exploit this race to trigger a use-after-free in the kernel, potentially escalating privileges."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-367","description":"CWE-367: Time-of-check Time-of-use (TOCTOU) Race Condition","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-15T07:08:52.619Z","orgId":"63664ac6-956c-4cba-a5d0-f46076e16109","shortName":"freebsd"},"role":"cna","title":"TOCTOU race between sound(4) buffer resizing and mmap"},{"affected_indices":[],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"LOCAL","availabilityImpact":"HIGH","baseScore":5.5,"baseSeverity":"MEDIUM","confidentialityImpact":"NONE","integrityImpact":"NONE","privilegesRequired":"LOW","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:N/I:N/A:H","version":"3.1"}},{"other":{"content":{"id":"CVE-2026-101308","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-10-15T15:40:09.578920Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":
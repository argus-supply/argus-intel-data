{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"4.1.2","status":"affected","version":"1.1.8","versionType":"semver"}],"product":"Wheels","repo":"https://github.com/wheels-dev/wheels","vendor":"Wheels"}],"aliases":["CVE-2026-110911"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Wheels 1.1.8 through 4.1.1 allows SQL injection when caller-supplied quoted values are parsed again as SQL by dynamic finders (such as findOneByEmail), the query builder's where(property, value) and where(property, operator, value), string/UUID-key lookup paths (findByKey, updateByKey, deleteByKey and findOrCreateBy...), and validatesUniquenessOf. The parser incorrectly treats a doubled single quote as the end of a literal. Applications passing request data to these APIs can expose authentication, password-reset or token lookups, and data to unauthorized access; numeric-column values are not affected. There is a similar concern for query-builder whereBetween() in 4.0.0 through 4.1.1: string/date bounds can alter SQL on MySQL/MariaDB with backslash escaping enabled. This is fixed in 4.1.2."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"HIGH","baseScore":9.8,"baseSeverity":"CRITICAL","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-89","description":"CWE-89 Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-15T03:03:49.507Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-110911","options":[{"Exploitation":"none"},{"Automatable":"yes"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-10-15T14:04:29.574878Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-10-15T14:04:48.337Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"577d242c974e2e421c477a00d40c77bed8c2734239462260784842ab03312b8f","data_version":"5.2","first_seen_at":"2026-10-15T04:39:29Z","kind":"advisory","last_material_event_at":"2026-10-15T17:01:17Z","native_id":"CVE-2026-110911","provenance":[{"revision":"8d65eb33b53811543e0b55bd9a2dd5e5fb5a337c","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-110911"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"},{"assertion_index":1,"independent_evidence":false,"source_id":"cve"}],"published_at":"2026-10-15T03:03:49Z","record_encoding":{"expanded_bytes":4675,"expanded_sha256":"5b6bc071953c155117091b4509610796d3ba538a1945a69cdeb64f7785d76b2e","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-110911","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-15T03:03:49.507Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"tags":["vendor-advisory"],"url":"https://github.com/wheels-dev/wheels/security/advisories/GHSA-96rm-h22v-925x"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-15T14:04:48Z","status":"active","title":"CVE-2026-110911"}

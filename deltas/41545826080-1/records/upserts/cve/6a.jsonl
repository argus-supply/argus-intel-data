{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-117069"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"An integer truncation vulnerability in the NAS decoder of OpenAirInterface (OAI) CN5G AMF v2.2.1 allows an unauthenticated remote attacker to cause a denial of service (DoS) via crafted NAS Registration Requests containing a malformed IMEISV in the 5GS Mobile Identity IE. The Type6NasIe::Validate() function truncates a 32-bit length value to 16 bits, bypassing length validation and causing an out-of-bounds heap read in DecodeImeisv(), which can crash the AMF process."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-11-02T18:51:32.795Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"21907b28d83c83a85114ea75f2c58bae9b254d931bd151380361612b59edafea","data_version":"5.2","first_seen_at":"2026-11-02T23:30:23Z","kind":"advisory","last_material_event_at":"2026-11-02T23:30:23Z","native_id":"CVE-2026-117069","provenance":[{"revision":"c0390b2e47e72f9a8a194e5f3cd78434c1b184f4","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-117069"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-02T00:00:00Z","record_encoding":{"expanded_bytes":2928,"expanded_sha256":"747d6f3b9e3d1a626df97d25166fddda1638e391d7f438cece1ca32b134ee718","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-117069","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-02T18:51:32.795Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","sho
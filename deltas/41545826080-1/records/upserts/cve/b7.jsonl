{"affected":[{"collectionURL":"https://github.com/konflux-ci/konflux-ci","defaultStatus":"unaffected","original_ranges":[{"status":"affected","version":"0.2.2"},{"status":"affected","version":"0.2.3-rc.0"}],"packageName":"konflux-ci"}],"aliases":["CVE-2026-116964"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-30T00:00:00.000Z","descriptions":[{"lang":"en","value":"A flaw was found in konflux-ci. An attacker with repository write access can achieve arbitrary code execution within the Continuous Integration and Continuous Delivery (CI/CD) workflow environment. By injecting shell commands into environment export scripts, the attacker causes manifest synchronization scripts to dynamically evaluate unvalidated script output. Successful exploitation allows the attacker to compromise CI/CD pipelines, steal sensitive authentication tokens and deployment credentials, and gain unauthorized access to production systems."}],"metrics":[{"other":{"content":{"namespace":"https://access.redhat.com/security/updates/classification/","value":"Important"},"type":"Red Hat severity rating"}},{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"HIGH","baseScore":8.4,"baseSeverity":"HIGH","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"HIGH","scope":"CHANGED","userInteraction":"REQUIRED","vectorString":"CVSS:3.1/AV:N/AC:L/PR:H/UI:R/S:C/C:H/I:H/A:H","version":"3.1"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-94","description":"Improper Control of Generation of Code","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-02T20:58:12.409Z","orgId":"53f830b8-0a3f-465b-8143-3b8a9948e749","shortName":"redhat"},"role":"cna","title":"Konflux-ci: remote code execution via eval() in manifest scripts"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content
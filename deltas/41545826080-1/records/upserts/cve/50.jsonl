{"affected":[{"collectionURL":"https://github.com/konflux-ci/konflux-ci","defaultStatus":"unaffected","original_ranges":[{"status":"affected","version":"0.2.2"},{"status":"affected","version":"0.2.3-rc.0"}],"packageName":"konflux-ci"}],"aliases":["CVE-2026-116086"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-30T00:00:00.000Z","descriptions":[{"lang":"en","value":"A flaw was found in konflux-ci. An attacker with permission to trigger automated workflow runs can cause an information disclosure by providing crafted issue titles to workflow scripts. The affected script incorporates user-provided titles directly into data queries without adequate sanitization, allowing the attacker to inject malicious filter commands. As a result, sensitive information such as API credentials, deployment keys, and internal notes returned from repository queries may be exposed in workflow logs."}],"metrics":[{"other":{"content":{"namespace":"https://access.redhat.com/security/updates/classification/","value":"Important"},"type":"Red Hat severity rating"}},{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"HIGH","baseScore":8.8,"baseSeverity":"HIGH","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"LOW","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","version":"3.1"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-94","description":"Improper Control of Generation of Code","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-02T20:58:07.372Z","orgId":"53f830b8-0a3f-465b-8143-3b8a9948e749","shortName":"redhat"},"role":"cna","title":"Konflux-ci: jq filter injection in github workflow issue management"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"1f3c408afda09dae2d224c755fb39
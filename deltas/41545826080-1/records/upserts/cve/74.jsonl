{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-106806"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A memory exhaustion issue exists in Open5GS v2.8.0 in the HTTP/2 SBI server. Repeated header names cause previously allocated header strings to be leaked, and HPACK compression allows an unauthenticated remote attacker to trigger tens of thousands of duplicate headers with a small request. Repeated crafted requests can cause persistent heap growth, exhaust process memory, and terminate the affected Open5GS network function, resulting in denial of service."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-11-02T17:44:51.954Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"c26e1becf3ff84e6c65567543fceaa60b84e602dff4b7ece53e751e991bfdc1a","data_version":"5.2","first_seen_at":"2026-11-02T23:30:23Z","kind":"advisory","last_material_event_at":"2026-11-02T23:30:23Z","native_id":"CVE-2026-106806","provenance":[{"revision":"c0390b2e47e72f9a8a194e5f3cd78434c1b184f4","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-106806"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-02T00:00:00Z","record_encoding":{"expanded_bytes":3129,"expanded_sha256":"39f43e5357eee3f1b8702ef548f625671432b65a559320e2eb6dcb8e0261d75c","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-106806","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-02T17:44:51.954Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mit
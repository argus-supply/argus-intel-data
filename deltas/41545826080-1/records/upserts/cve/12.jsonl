{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"status":"affected","version":"17"},{"status":"affected","version":"16-qpr2"},{"status":"affected","version":"16"},{"status":"affected","version":"15"},{"status":"affected","version":"14"}],"product":"Android","vendor":"Google"}],"aliases":["CVE-2026-58924"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The vulnerability is a heap out-of-bounds read in the EVS HAL's `getStreamList()` method. An attacker can craft a `CameraDesc.metadata` byte array, which is parsed without validation, leading to an out-of-bounds read at an attacker-controlled offset within the HAL process's heap. The read data is then exfiltrated back to the attacker, potentially leaking sensitive information like pointers and buffer handles."}],"problemTypes":[{"descriptions":[{"description":"Information disclosure","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-02T20:21:10.883Z","orgId":"baff130e-b8d5-4e15-b3d3-c3cf5d5545c6","shortName":"google_android"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"6e5851e4e2fdff050a189a2720a2a02c72757711b2da4ef96de60146d308d40a","data_version":"5.2","first_seen_at":"2026-11-02T23:30:23Z","kind":"advisory","last_material_event_at":"2026-11-02T23:30:23Z","native_id":"CVE-2026-58924","provenance":[{"revision":"c0390b2e47e72f9a8a194e5f3cd78434c1b184f4","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-58924"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-02T20:21:10Z","record_encoding":{"expanded_bytes":2822,"expanded_sha256":"b5077869af87603257fabf8e59cbce0d55248d72dc8be1ea7cf1c09d8275f6db","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-58924","re
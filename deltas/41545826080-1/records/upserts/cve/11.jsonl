{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"status":"affected","version":"17"},{"status":"affected","version":"16-qpr2"},{"status":"affected","version":"16"},{"status":"affected","version":"15"},{"status":"affected","version":"14"}],"product":"Android","vendor":"Google"}],"aliases":["CVE-2026-58915"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A physical occupant on an Android Automotive OS (AAOS) Multi-User Multi-Display (MUMD) passenger display can view sensitive Heads-Up Notification (HUN) content and execute actions for a secure passenger user (User N) without authenticating. This bypasses the PassengerKeyguard because the HUN system only checks the global keyguard state, which is tied to the driver's unlocked display, and the PassengerKeyguard implementation fails to suppress HUNs or intercept action PendingIntents. Consequently, private notification data is disclosed, and user-N actions are executed without credential verification."}],"problemTypes":[{"descriptions":[{"description":"Elevation of privilege","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-02T20:21:09.862Z","orgId":"baff130e-b8d5-4e15-b3d3-c3cf5d5545c6","shortName":"google_android"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"0ab27bb7fde53a84cf75499f2b667c260e3d1e28595088bec69da73b190ae311","data_version":"5.2","first_seen_at":"2026-11-02T23:30:23Z","kind":"advisory","last_material_event_at":"2026-11-02T23:30:23Z","native_id":"CVE-2026-58915","provenance":[{"revision":"c0390b2e47e72f9a8a194e5f3cd78434c1b184f4","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-58915"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-02T20:21:09Z","record_encoding":{"expanded_bytes":3208,"expanded_sha256":"b73742bad7e7144286954fee8
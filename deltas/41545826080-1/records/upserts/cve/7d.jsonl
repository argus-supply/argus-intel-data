{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-106807"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A denial-of-service vulnerability exists in open5GS v2.8.0 in the PFCP transaction handling path. When the PFCP transaction or timer resource pool is exhausted, ogs_pfcp_xact_remote_create() returns NULL, but the failure is not handled properly and leads to an ogs_assert(new) failure in ogs_pfcp_xact_receive(). An attacker able to send PFCP messages to the affected SMF/UPF can exhaust transaction resources and cause the network function process to terminate with SIGABRT, resulting in service disruption and preventing further session establishment until the affected component is restarted."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-11-02T16:15:23.096Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"a08c8d87a4918b4e770340b62be93f37f5f3707f3174696cae9cdcc7bd1420d0","data_version":"5.2","first_seen_at":"2026-11-02T23:30:23Z","kind":"advisory","last_material_event_at":"2026-11-02T23:30:23Z","native_id":"CVE-2026-106807","provenance":[{"revision":"c0390b2e47e72f9a8a194e5f3cd78434c1b184f4","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-106807"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-02T00:00:00Z","record_encoding":{"expanded_bytes":3401,"expanded_sha256":"746d45c33fedef6fbda2ad55340ac1a4f14aa7a471555b31243da3861a8f9bef","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-106807","references":[{"as
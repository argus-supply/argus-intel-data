{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"25.10.1"}],"product":"MindsDB","vendor":"MindsDB"}],"aliases":["CVE-2026-92207"],"assertions":[{"affected_indices":[0],"datePublic":"2026-09-16T15:11:08.010Z","descriptions":[{"lang":"en","value":"MindsDB OpenBBtable Code Injection Remote Code Execution Vulnerability. This vulnerability allows remote attackers to execute arbitrary code on affected installations of MindsDB. Authentication is required to exploit this vulnerability.\n\nThe specific flaw exists within the OpenBBtable class. The issue results from the lack of proper validation of a user-supplied string before using it to execute Python code. An attacker can leverage this vulnerability to execute code in the context of the service account. Was ZDI-CAN-28388."}],"metrics":[{"cvssV3_0":{"baseScore":8.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-94","description":"CWE-94: Improper Control of Generation of Code ('Code Injection')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-21T17:17:42.063Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"MindsDB OpenBBtable Code Injection Remote Code Execution Vulnerability"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-92207","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-10-30T15:35:16.761438Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-10-30T15:36:32.104Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"c2
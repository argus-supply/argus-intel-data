{"affected":[{"original_ranges":[{"status":"affected","version":"< 1.0.8.7"}],"product":"Vvveb","vendor":"givanz"}],"aliases":["CVE-2026-112905"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Vvveb is a powerful and easy to use CMS with page builder to build websites, blogs or ecommerce stores. Prior to version 1.0.8.7, authenticated IDOR on admin/auth-token endpoint allows any administrator to read and overwrite another administrator's API tokens. This issue has been patched in version 1.0.8.7."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"LOW","baseScore":9,"baseSeverity":"CRITICAL","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"HIGH","scope":"CHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:C/C:H/I:H/A:L","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-285","description":"CWE-285: Improper Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-30T14:19:46.201Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"Vvveb: Authenticated IDOR on admin/auth-token Allows Admin Privilege Escalation via API Token Theft"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"de1dba4417cc7ce445860621d689ccf0da783ab0735110946f238d4f03b9e7f7","data_version":"5.2","first_seen_at":"2026-10-30T19:22:40Z","kind":"advisory","last_material_event_at":"2026-10-30T19:22:40Z","native_id":"CVE-2026-112905","provenance":[{"revision":"04e90a1ef682a9ab5cace7e8a968e9bf6b3afdbd","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-112905"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-30T14:19:46Z","record_encoding":{"expanded_bytes":3114,"expanded_sha256":"28d
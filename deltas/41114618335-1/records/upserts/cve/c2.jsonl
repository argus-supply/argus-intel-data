{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"6.27.7","status":"affected","version":"6.27.1","versionType":"semver"},{"lessThan":"7.6.1","status":"affected","version":"7.2.1","versionType":"semver"}],"product":"WarehousePG","repo":"https://github.com/warehouse-pg/warehouse-pg","vendor":"EnterpriseDB"}],"aliases":["CVE-2026-104948"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"WarehousePG (WHPG) 6.27.1 through 6.27.6 and 7.2.1 through 7.6.0 are affected by a missing authorization vulnerability (CWE-862) in the built-in cluster expansion functions gp_expand_lock_catalog() and gp_expand_bump_version(). Any authenticated database role can run them, and neither checks privileges. A low-privileged user can call gp_expand_lock_catalog() inside an open transaction to block all catalog changes across the cluster for every user, superusers included, until that transaction ends, which in practice requires a superuser to terminate the session. Blocked changes include DDL, temporary table creation, GRANT and CREATE ROLE. The same user can call gp_expand_bump_version() repeatedly. Each call disconnects sessions that hold temporary tables, with a FATAL error on their next catalog change, and makes every other session rebuild its segment connections."}],"metrics":[{"cvssV4_0":{"baseScore":7.1,"baseSeverity":"HIGH","vectorString":"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N","version":"4.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-862","description":"CWE-862 Missing Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-21T13:53:54.574Z","orgId":"20be33e2-bf35-4d13-8fad-18bd2f3e3659","shortName":"EDB"},"role":"cna"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-104948","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-10-30T18:02:32.684706Z","version":
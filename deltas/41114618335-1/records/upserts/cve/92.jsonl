{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["CallBackery"],"original_ranges":[{"lessThan":"0.62.0","status":"affected","version":"0","versionType":"custom"}],"packageName":"CallBackery","packageURL":"pkg:cpan/CallBackery","programFiles":["lib/CallBackery/GuiPlugin/Abstract.pm"],"programRoutines":[{"name":"CallBackery::GuiPlugin::Abstract::createRxValidator"}],"repo":"https://github.com/oetiker/callbackery"}],"aliases":["CVE-2026-118995"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"CallBackery versions before 0.62.0 for Perl accept unintended values in form fields checked by createRxValidator.\n\ncreateRxValidator() is documented to anchor the supplied pattern at both ends, but builds /^${rx}$/ without grouping the pattern. An alternation such as yes|no then accepts any value starting with yes or ending with no, and $ also accepts a value with one trailing newline.\n\nAn authenticated user can submit values the pattern was meant to reject, which an application may then write into generated configuration files."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-625","description":"CWE-625 Permissive Regular Expression","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-30T13:10:38.972Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"CallBackery versions before 0.62.0 for Perl accept unintended values in form fields checked by createRxValidator"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"673381d706908956236deb989140079d3c4e9668b73d9d72019be144aacad2c0","data_version":"5.2","first_seen_at":"2026-10-30T19:22:40Z","kind":"advisory","last_material_event_at":"2026-10-30T19:22:40Z","native_id":"CVE-2026-118995","provenance":[{"revision":"04e90a1ef682a9ab5cace7e8a968e9bf6b3afdbd
{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["CallBackery"],"original_ranges":[{"lessThan":"0.62.0","status":"affected","version":"0","versionType":"custom"}],"packageName":"CallBackery","packageURL":"pkg:cpan/CallBackery","programFiles":["lib/CallBackery/Config.pm"],"programRoutines":[{"name":"CallBackery::Config::getConfigBlob"}],"repo":"https://github.com/oetiker/callbackery"}],"aliases":["CVE-2026-118990"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"CallBackery versions before 0.62.0 for Perl leave a world-readable dump of the configuration database in /tmp when taking a configuration backup.\n\ngetConfigBlob() has the sqlite3 shell write the dump to /tmp/cbdump<pid> and never removes it. The file takes the process umask, and a symlink planted at that predictable name is followed.\n\nThe dump holds every user's password hash and every value saved by the application's forms. A local user can read these after any backup, and may redirect the dump to a file of their choosing."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-379","description":"CWE-379 Creation of Temporary File in Directory with Insecure Permissions","lang":"en","type":"CWE"}]},{"descriptions":[{"cweId":"CWE-59","description":"CWE-59 Improper Link Resolution Before File Access","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-30T13:12:29.396Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"CallBackery versions before 0.62.0 for Perl leave a world-readable dump of the configuration database in /tmp when taking a configuration backup"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"f006f1a1b2df3206892e0c3d1679f21dbe7bbcff5d1c45238dc72d6214888795","data_version":"5.2","first_seen_at":"2026-10-30T19:22:40Z"
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"4.0.0","status":"affected","version":"0","versionType":"semver"}],"product":"HireZoot","vendor":"Unknown"}],"aliases":["CVE-2025-15703"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The HireZoot  WordPress plugin before 4.0.0 does not sanitise and escape one of its job specification settings before it is reflected back into an admin-area settings page, allowing users with the HireZoot  WordPress plugin before 4.0.0's management capability (Administrator by default) to store a payload that is executed in the browser of any administrator who later opens that page. As the unfiltered_html capability is not available to administrators on multisite (or where DISALLOW_UNFILTERED_HTML is set), this leads to Stored Cross-Site Scripting."}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Cross-Site Scripting (XSS)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-12T06:00:08.603Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"WP Job Openings < 4.0.0 - Admin+ Stored XSS"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"d1b0499d370c3e7557f05e8d985bb173e421099df9fc56d7f3e04d6adad66a32","data_version":"5.2","first_seen_at":"2026-10-12T05:58:38Z","kind":"advisory","last_material_event_at":"2026-10-12T05:58:38Z","native_id":"CVE-2025-15703","provenance":[{"revision":"c1e5b02929fb6f423d8f8c90b5713223d0e8290c","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2025-15703"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-12T06:00:08Z","record_encoding":{"expanded_bytes":3128,"expanded_sha256":"7070860d8ad539e9cd85e9f696788bde19c2c665dc6d03a90fbbfbf7050d7c92","format":"cve-indexed-assertions-v1","top_descrip
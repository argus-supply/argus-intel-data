{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"8.7.7","status":"affected","version":"0","versionType":"semver"}],"product":"Soledad","vendor":"pencidesign"}],"aliases":["CVE-2026-93902"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Soledad theme for WordPress is vulnerable to Stored Cross-Site Scripting via Social Profile Fields in all versions up to, and including, 8.7.7 due to insufficient input sanitization and output escaping. This makes it possible for authenticated attackers, with subscriber-level access and above, to inject arbitrary web scripts in pages that will execute whenever a user accesses an injected page. The injected payload is scoped to the attacker's own user meta but is exposed publicly on their author archive page at /author/<slug>/, which is accessible to unauthenticated visitors regardless of whether the attacker has published any posts."}],"metrics":[{"cvssV3_1":{"baseScore":6.4,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:C/C:L/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-79","description":"CWE-79 Improper Neutralization of Input During Web Page Generation","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-07T04:27:11.924Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"Soledad <= 8.7.7 - Authenticated (Subscriber+) Stored Cross-Site Scripting via Social Profile Fields"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"a0181657849d0d0d6dc44e62c4d10252e3ba928030e99ab6d76890387bf6581a","data_version":"5.2","first_seen_at":"2026-11-07T08:48:10Z","kind":"advisory","last_material_event_at":"2026-11-07T08:48:10Z","native_id":"CVE-2026-93902","provenance":[{"revision":"54d692da6e063ca3b7ccdd2fc0c2193e3b1d37bb","so
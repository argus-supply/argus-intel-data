{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.0.0","status":"affected","version":"0","versionType":"semver"}],"product":"iLeads SMS Gateway by Exsile","vendor":"Unknown"}],"aliases":["CVE-2026-121866"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The iLeads SMS Gateway by Exsile WordPress plugin before 2.0.0 does not check capabilities or nonces in several AJAX actions that update a site option chosen by the request, allowing any authenticated user, such as a subscriber, to change arbitrary WordPress options and escalate to administrator, for example by enabling registration with administrator as the default role."}],"problemTypes":[{"descriptions":[{"description":"CWE-269 Improper Privilege Management","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-07T06:00:29.219Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Exsile SMS Gateway < 2.0.0 - Subscriber+ Privilege Escalation via Arbitrary Option Update"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"e8c597ecd942541cf2b218398b12075e4b6a8d3bff91550be3b4e940b0f16ca4","data_version":"5.2","first_seen_at":"2026-11-07T08:48:10Z","kind":"advisory","last_material_event_at":"2026-11-07T08:48:10Z","native_id":"CVE-2026-121866","provenance":[{"revision":"54d692da6e063ca3b7ccdd2fc0c2193e3b1d37bb","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-121866"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-07T06:00:29Z","record_encoding":{"expanded_bytes":2886,"expanded_sha256":"25f1713889fc20afb93638df0ddbc4900927eca9766ffc4289095eba510b2519","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-121866","refere
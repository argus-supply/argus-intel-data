{"affected":[{"collectionURL":"https://access.redhat.com/downloads/content/package-browser/","cpes":["cpe:/a:redhat:openshift_ai"],"defaultStatus":"unknown","original_ranges":[],"packageName":"rhoai/odh-trainer-rhel9","product":"Red Hat OpenShift AI (RHOAI)","vendor":"Red Hat"}],"aliases":["CVE-2026-83495"],"assertions":[{"affected_indices":[0],"datePublic":"2026-08-31T15:30:00.000Z","descriptions":[{"lang":"en","value":"A flaw was found in the Trainer v2 TrainJob API. A user with permissions to create TrainJobs can exploit this by injecting `valueFrom.secretKeyRef` into environment variable definitions. This allows them to read and exfiltrate sensitive information (secrets) from the namespace, leading to a privilege escalation. This occurs when the TrainJob Role-Based Access Control (RBAC) is broader than the Secret read RBAC."}],"metrics":[{"other":{"content":{"namespace":"https://access.redhat.com/security/updates/classification/","value":"Low"},"type":"Red Hat severity rating"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-269","description":"Improper Privilege Management","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-07T06:02:17.419Z","orgId":"53f830b8-0a3f-465b-8143-3b8a9948e749","shortName":"redhat"},"role":"cna","title":"Trainer: trainer: trainjob env passthrough enables valuefrom.secretkeyref injection for namespace secret exfiltration"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"404ff6b32111865b3ddaa7c66d266e007e2bed40400c4c34986358177b1aed59","data_version":"5.2","first_seen_at":"2026-11-07T08:48:10Z","kind":"advisory","last_material_event_at":"2026-11-07T08:48:10Z","native_id":"CVE-2026-83495","provenance":[{"revision":"54d692da6e063ca3b7ccdd2fc0c2193e3b1d37bb","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-83495"},{"assertion_index":0,"independent_evidence
{"affected":[{"defaultStatus":"unknown","original_ranges":[{"lessThanOrEqual":"1.5.2","status":"affected","version":"0","versionType":"semver"}],"product":"SAML SSO Login","vendor":"Unknown"}],"aliases":["CVE-2026-108687"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The SAML SSO Login  WordPress plugin through 1.5.2 does not verify that the SAML assertion whose signature it validates is the same assertion it reads the user identity from, allowing unauthenticated attackers who hold a validly signed assertion for any identity to authenticate as any existing user, including an administrator, through XML signature wrapping."}],"problemTypes":[{"descriptions":[{"description":"CWE-287 Improper Authentication","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-19T06:00:06.297Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"SAML SSO Login - Single Sign On <= 1.5.2 - Unauthenticated Authentication Bypass to Administrator via SAML Signature Wrapping"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"75238d0caea61a62182c5c05df784d1b5439c5c489e9bc4b12d7cb84fd02300e","data_version":"5.2","first_seen_at":"2026-11-19T10:21:07Z","kind":"advisory","last_material_event_at":"2026-11-19T10:21:07Z","native_id":"CVE-2026-108687","provenance":[{"revision":"e4abd85c31fbf972b849028f011f2abcd68d9c4b","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-108687"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-19T06:00:06Z","record_encoding":{"expanded_bytes":2914,"expanded_sha256":"88d4dfccde48d30964b92dd43dd700df1bc73da96f97bcc423cd89f33db379b3","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-108687","
{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"1204.204"}],"product":"Cobalt","vendor":"Ashlar-Vellum"}],"aliases":["CVE-2026-121744"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-04T14:16:44.030Z","descriptions":[{"lang":"en","value":"Ashlar-Vellum Cobalt XE File Parsing Stack-based Buffer Overflow Remote Code Execution Vulnerability. This vulnerability allows remote attackers to execute arbitrary code on affected installations of Ashlar-Vellum Cobalt. User interaction is required to exploit this vulnerability in that the target must visit a malicious page or open a malicious file.\n\nThe specific flaw exists within the parsing of XE files. The issue results from the lack of proper validation of the length of user-supplied data prior to copying it to a stack-based buffer. An attacker can leverage this vulnerability to execute code in the context of the current process. Was ZDI-CAN-28172."}],"metrics":[{"cvssV3_0":{"baseScore":7.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-121","description":"CWE-121: Stack-based Buffer Overflow","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-12T02:51:21.092Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"Ashlar-Vellum Cobalt XE File Parsing Stack-based Buffer Overflow Remote Code Execution Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"12aa3fef16db45d71a5c513374b6b82e93b2ba54b100454379c19e198c2c94c5","data_version":"5.2","first_seen_at":"2026-11-12T09:50:52Z","kind":"advisory","last_material_event_at":"2026-11-12T09:50:52Z","native_id":"CVE-2026-121744","provenance":[{"revision":"056a67cf62b12ec6d4db0e777b9bf26d2eabdeda","sour
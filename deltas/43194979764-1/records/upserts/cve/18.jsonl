{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"2071026000"}],"product":"Hue Bridge Pro","vendor":"Philips"}],"aliases":["CVE-2026-122044"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-06T22:17:35.605Z","descriptions":[{"lang":"en","value":"Philips Hue Bridge Pro Protection Mechanism Failure Authentication Bypass Vulnerability. This vulnerability allows network-adjacent attackers to bypass authentication on affected installations of Philips Hue Bridge Pro. Authentication is not required to exploit this vulnerability.\n\nThe specific flaw exists within the HTTP service, which listens on TCP port 443 by default. The issue results from the failure to apply a protection mechanism. An attacker can leverage this vulnerability to bypass authentication on the system. Was ZDI-CAN-33086."}],"metrics":[{"cvssV3_0":{"baseScore":8.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:A/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-693","description":"CWE-693: Protection Mechanism Failure","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-12T02:52:26.244Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"Philips Hue Bridge Pro Protection Mechanism Failure Authentication Bypass Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"67750ee4dae07e77510ed458f6db93261f66337dabcf4173f4ab84623d147f60","data_version":"5.2","first_seen_at":"2026-11-12T09:50:52Z","kind":"advisory","last_material_event_at":"2026-11-12T09:50:52Z","native_id":"CVE-2026-122044","provenance":[{"revision":"056a67cf62b12ec6d4db0e777b9bf26d2eabdeda","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-122044"},{"assertion_index":0,"independent_evidence":true,"sourc
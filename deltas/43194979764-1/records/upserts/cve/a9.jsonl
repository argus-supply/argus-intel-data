{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"10.59"}],"product":"MailEnable","vendor":"MailEnable"}],"aliases":["CVE-2026-114556"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-04T13:47:08.595Z","descriptions":[{"lang":"en","value":"MailEnable Save Directory Traversal Arbitrary File Creation Vulnerability. This vulnerability allows remote attackers to create arbitrary files on affected installations of MailEnable. Authentication is not required to exploit this vulnerability.\n\nThe specific flaw exists within the implementation of the Save method. The issue results from the lack of proper validation of a user-supplied path prior to using it in file operations. An attacker can leverage this in conjunction with other vulnerabilities to execute code in the context of SYSTEM. Was ZDI-CAN-29161."}],"metrics":[{"cvssV3_0":{"baseScore":7.4,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-22","description":"CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-12T02:55:13.755Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"MailEnable Save Directory Traversal Arbitrary File Creation Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"8b9eb4824160644eb2c8062ee5555d6f4ae873a1f7c77bfb779d31e6d56aa859","data_version":"5.2","first_seen_at":"2026-11-12T09:50:52Z","kind":"advisory","last_material_event_at":"2026-11-12T09:50:52Z","native_id":"CVE-2026-114556","provenance":[{"revision":"056a67cf62b12ec6d4db0e777b9bf26d2eabdeda","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-114556"},{"asse
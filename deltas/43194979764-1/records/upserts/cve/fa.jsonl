{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.1.0","status":"affected","version":"0","versionType":"semver"}],"product":"Clockinator Lite","vendor":"Unknown"}],"aliases":["CVE-2026-124815"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Clockinator Lite WordPress plugin before 1.1.0 does not restrict access to several of its record deletion actions, and uses a user-supplied table name in a SQL query without validating or escaping it, allowing unauthenticated users to perform SQL injection attacks, deleting data from any database table and extracting sensitive information such as password hashes."}],"problemTypes":[{"descriptions":[{"description":"CWE-89 SQL Injection","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-12T06:00:09.952Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Clockinator Lite < 1.1.0 - Unauthenticated SQLi via Record Deletion Actions"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"fa64e361e8c3248e3a71ff9cd13a6b5dfadd1e83ee7b21aa4652e8c10b8c7124","data_version":"5.2","first_seen_at":"2026-11-12T09:50:52Z","kind":"advisory","last_material_event_at":"2026-11-12T09:50:52Z","native_id":"CVE-2026-124815","provenance":[{"revision":"056a67cf62b12ec6d4db0e777b9bf26d2eabdeda","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-124815"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-12T06:00:09Z","record_encoding":{"expanded_bytes":2819,"expanded_sha256":"f30900fcc19fe2bdf2972a098748eccce798a6f1f1a6b4580c319ef9d14af7b2","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-124815","references":[{"assertion_role":"cna","provider":{"date
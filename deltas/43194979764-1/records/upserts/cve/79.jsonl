{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"14.0.2.4"}],"product":"NetVault Backup","vendor":"Quest"}],"aliases":["CVE-2026-13270"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-06T22:17:13.546Z","descriptions":[{"lang":"en","value":"Quest NetVault Backup nvpmgr Integer Underflow Denial-of-Service Vulnerability. This vulnerability allows remote attackers to create a denial-of-service condition on affected installations of Quest NetVault Backup. Authentication is not required to exploit this vulnerability.\n\nThe specific flaw exists within the nvpmgr service, which listens on UDP port 20031 by default. The issue results from the lack of proper validation of user-supplied data, which can result in an integer underflow before allocating a buffer. An attacker can leverage this vulnerability to create a denial-of-service condition on the system. Was ZDI-CAN-28744."}],"metrics":[{"cvssV3_0":{"baseScore":7.5,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-191","description":"CWE-191: Integer Underflow (Wrap or Wraparound)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-12T02:49:34.234Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"Quest NetVault Backup nvpmgr Integer Underflow Denial-of-Service Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"4d24f3dc7642db6ee08d7463cb8b932c16dbd0a043ad3b60796cfa0dd8dad7af","data_version":"5.2","first_seen_at":"2026-11-12T09:50:52Z","kind":"advisory","last_material_event_at":"2026-11-12T09:50:52Z","native_id":"CVE-2026-13270","provenance":[{"revision":"056a67cf62b12ec6d4db0e777b9bf26d2eabdeda","source_id":"cve","url":"https://www.cve.org
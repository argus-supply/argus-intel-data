{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.4.2","status":"affected","version":"0","versionType":"semver"}],"product":"Abilities Bridge","vendor":"Unknown"}],"aliases":["CVE-2026-122003"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Abilities Bridge WordPress plugin before 1.4.2 does not require a valid nonce before re-authenticating a REST API request from the logged-in session cookie, allowing attackers to make a logged-in administrator perform any REST API action, including creating a new administrator account and taking over the site, by tricking them into opening a crafted page (CSRF)."}],"problemTypes":[{"descriptions":[{"description":"CWE-352 Cross-Site Request Forgery (CSRF)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-12T06:00:08.273Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Abilities Bridge < 1.4.2 - Administrator Account Creation via CSRF"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"76a02f64767d90af91fd94faa3debe2aa2e3aab429de3826cd7442bd67461f80","data_version":"5.2","first_seen_at":"2026-11-12T09:50:52Z","kind":"advisory","last_material_event_at":"2026-11-12T09:50:52Z","native_id":"CVE-2026-122003","provenance":[{"revision":"056a67cf62b12ec6d4db0e777b9bf26d2eabdeda","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-122003"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-12T06:00:08Z","record_encoding":{"expanded_bytes":2820,"expanded_sha256":"c1931791aad7cd8ffb92b1b047c11a93f2fc49ac273a69ead15242b69a664e7e","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-122003","references":[{"assertion_role":"cna","provi
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.6.6","status":"affected","version":"0","versionType":"semver"}],"product":"Mine CloudVod","vendor":"Unknown"}],"aliases":["CVE-2026-124653"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Mine CloudVod WordPress plugin before 2.6.6 does not restrict who can request cloud storage upload credentials from several of its REST API routes, allowing unauthenticated attackers to obtain signed upload policies and temporary credentials for the site's configured Alibaba Cloud OSS, Tencent Cloud COS and Dogecloud accounts and use them to upload or overwrite files in the site's storage."}],"problemTypes":[{"descriptions":[{"description":"CWE-200 Information Exposure","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-12T06:00:09.357Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Mine CloudVod < 2.6.6 - Unauthenticated Cloud Storage Credential Disclosure"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"b4af4cb51a47c367b8ed00631a27a3d755cb11a15c806096226f7c5600991a40","data_version":"5.2","first_seen_at":"2026-11-12T09:50:52Z","kind":"advisory","last_material_event_at":"2026-11-12T09:50:52Z","native_id":"CVE-2026-124653","provenance":[{"revision":"056a67cf62b12ec6d4db0e777b9bf26d2eabdeda","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-124653"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-12T06:00:09Z","record_encoding":{"expanded_bytes":2878,"expanded_sha256":"bb4386ca16abe21eda8055e31f84019d566fd5879f95078675df0c937c96bc86","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-124653","references":[{"asserti
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.2.0","status":"affected","version":"0","versionType":"semver"}],"product":"Descope","vendor":"Unknown"}],"aliases":["CVE-2026-110959"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Descope WordPress plugin before 1.2.0 does not validate the authentication token it receives before creating a WordPress session, accepting any non-empty token, so an unauthenticated attacker can obtain a session for any existing account, including an administrator, by supplying that account's email address."}],"problemTypes":[{"descriptions":[{"description":"CWE-287 Improper Authentication","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-12T06:00:06.674Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Descope < 1.2.0 - Unauthenticated Account Takeover"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"e33298bcef83c80e415818a88ff57aef3f5c77a23e2d7e9ef105c2ecdc4af6bc","data_version":"5.2","first_seen_at":"2026-11-12T09:50:52Z","kind":"advisory","last_material_event_at":"2026-11-12T09:50:52Z","native_id":"CVE-2026-110959","provenance":[{"revision":"056a67cf62b12ec6d4db0e777b9bf26d2eabdeda","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-110959"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-12T06:00:06Z","record_encoding":{"expanded_bytes":2659,"expanded_sha256":"8289c5d8ee2e0553b907678e293ce5414dee132bbff547a933ce12b96bed8b7c","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-110959","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-12T06:00:06.674Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a
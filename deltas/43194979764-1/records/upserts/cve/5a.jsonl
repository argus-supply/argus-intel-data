{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"6.4.1","status":"affected","version":"4.9.0","versionType":"semver"}],"product":"Defender Security","vendor":"Unknown"}],"aliases":["CVE-2026-119039"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Defender Security  WordPress plugin before 6.4.1 does not verify that the client IP address it derives for its firewall and lockout decisions actually originates from a trusted source, trusting a user-supplied value by default, allowing unauthenticated attackers to spoof their IP address and evade IP-based protections such as login lockout and IP banning, impersonate an allowlisted address, and poison the Defender Security  WordPress plugin before 6.4.1's activity logs."}],"problemTypes":[{"descriptions":[{"description":"CWE-290 Authentication Bypass by Spoofing","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-12T06:00:07.223Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Defender Security 4.9.0 - 6.4.0 - Unauthenticated IP Address Spoofing via Smart IP Detection"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"8daf48ce4051335696bf82a7dbe40786b60bc097112a27bbc0c925cc922a9d04","data_version":"5.2","first_seen_at":"2026-11-12T09:50:52Z","kind":"advisory","last_material_event_at":"2026-11-12T09:50:52Z","native_id":"CVE-2026-119039","provenance":[{"revision":"056a67cf62b12ec6d4db0e777b9bf26d2eabdeda","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-119039"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-12T06:00:07Z","record_encoding":{"expanded_bytes":3097,"expanded_sha256":"3aa593e944fd21eef4dcf506e2d4b8151a9039e1e2c6b0c1b4f77d0e0eed254c","format":"cve-indexed-assertions-v1","top_description
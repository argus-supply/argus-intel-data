{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"3.2.1","status":"affected","version":"0","versionType":"semver"}],"product":"SOES","vendor":"RT-Labs AB"}],"aliases":["CVE-2026-129801"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The FoE DATA frame handler computes the payload length from the master-supplied mailbox length field and passes it directly to FOE_fwrite. The length is checked against the remaining file capacity but not against the physical mailbox buffer size. A master can declare a large length while sending a short frame, causing FOE_fwrite to read past the end of the mailbox buffer."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"ADJACENT_NETWORK","availabilityImpact":"HIGH","baseScore":7.1,"baseSeverity":"HIGH","confidentialityImpact":"LOW","integrityImpact":"NONE","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:A/AC:L/PR:N/UI:N/S:U/C:L/I:N/A:H","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-125","description":"CWE-125 Out-of-bounds Read","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-21T12:03:14.132Z","orgId":"4b71179a-3b92-4a9d-b9fc-af8b8ed579ee","shortName":"rt-labs"},"role":"cna","title":"FoE Data Length Unclamped Out-of-Bounds Read"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-129801","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-11-23T20:35:41.287847Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-11-23T20:35:54.668Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reason
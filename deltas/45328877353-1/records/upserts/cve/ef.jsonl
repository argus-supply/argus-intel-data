{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"3.2.1","status":"affected","version":"0","versionType":"semver"}],"product":"SOES","vendor":"RT-Labs AB"}],"aliases":["CVE-2026-129814"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The SDO Information Get Object Description and Get Entry Description responses copy the object or entry name into the mailbox data area and then write a null terminator byte. The copy loops ran up to the last available byte in the buffer, leaving no room for the terminator. When an object or entry name exactly fills the available space the terminator is written one byte past the end of the mailbox data buffer."}],"metrics":[{"cvssV3_1":{"attackComplexity":"HIGH","attackVector":"ADJACENT_NETWORK","availabilityImpact":"LOW","baseScore":3.1,"baseSeverity":"LOW","confidentialityImpact":"NONE","integrityImpact":"NONE","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:A/AC:H/PR:N/UI:N/S:U/C:N/I:N/A:L","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-787","description":"CWE-787 Out-of-bounds Write","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-21T12:03:27.860Z","orgId":"4b71179a-3b92-4a9d-b9fc-af8b8ed579ee","shortName":"rt-labs"},"role":"cna","title":"CoE Object Name Null Terminator Off-by-One Out-of-Bounds Write"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-129814","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-11-23T20:20:45.066655Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-11-23T20:20:57.878Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuratio
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"3.2.1","status":"affected","version":"0","versionType":"semver"}],"product":"SOES","vendor":"RT-Labs AB"}],"aliases":["CVE-2026-129810"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"ESC_eoeprocess and ESC_eoeprocess_tx can be reached before the application calls EOE_config to supply the callback table pointer. When eoe_cfg is NULL the receive handler dereferenced it while processing an incoming EoE frame, and the transmit polling function dereferenced it on each cycle, causing NULL pointer dereferences."}],"metrics":[{"cvssV3_1":{"attackComplexity":"HIGH","attackVector":"ADJACENT_NETWORK","availabilityImpact":"HIGH","baseScore":5.3,"baseSeverity":"MEDIUM","confidentialityImpact":"NONE","integrityImpact":"NONE","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:A/AC:H/PR:N/UI:N/S:U/C:N/I:N/A:H","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-476","description":"CWE-476 NULL Pointer Dereference","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-21T12:03:23.560Z","orgId":"4b71179a-3b92-4a9d-b9fc-af8b8ed579ee","shortName":"rt-labs"},"role":"cna","title":"EoE Unconfigured Access NULL Pointer Dereference"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-129810","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-11-23T20:29:28.988356Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-11-23T20:29:38.399Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"cont
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"8.22.0","status":"affected","version":"8.22.0","versionType":"semver"},{"lessThanOrEqual":"8.21.0","status":"affected","version":"8.21.0","versionType":"semver"}],"product":"curl","vendor":"curl"}],"aliases":["CVE-2026-94265"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"When processing an HTTP redirect to a URL containing userinfo (a\n`username:password` component), curl might erroneously retain and re-transmit\nthe original host's HTTP Negotiate authentication state. Consequently, a\nmalicious server can trigger a redirect containing arbitrary userinfo to force\ncurl to send a freshly minted Kerberos ticket—generated using the ambient\nidentity of the client process to an untrusted third-party host, effectively\nbypassing the domain-scoping restrictions normally enforced by the absence of\n`--location-trusted`."}],"problemTypes":[{"descriptions":[{"description":"CWE-200 Exposure of Sensitive Information to an Unauthorized Actor","lang":"en"}]}],"provider":{"dateUpdated":"2026-10-20T20:26:18.061Z","orgId":"2499f714-1537-4658-8207-48ae4bb9eae9","shortName":"curl"},"role":"cna","title":"Authorization: Negotiate sent to foreign origin"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"fcda23a669734253778865c5dbb0f3eeae74fcef5054fbeb94cf256942896083","data_version":"5.2","first_seen_at":"2026-10-20T21:37:55Z","kind":"advisory","last_material_event_at":"2026-10-20T21:37:55Z","native_id":"CVE-2026-94265","provenance":[{"revision":"d716fa3f17571e209c2c62f671f30fcc1712acfe","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-94265"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-20T20:26:18Z","record_encoding":{"expanded_bytes":3585,"expanded_sha256":
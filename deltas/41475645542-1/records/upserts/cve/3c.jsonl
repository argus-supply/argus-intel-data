{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2025-62819"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Keyfactor EJBCA through 9.3.3 performs insufficient authorization checks when self-renewing a client certificate via the RA (Registration Authority) User Interface. This allows a remote user, authenticated with a valid client certificate, to renew their certificate even if the end entity status and/or profile settings should deny renewal. The attacker must have a valid TLS client certificate, and must be authorized to use the RA User Interface, either with the certificate, or via a role membership for PublicAccessAuthenticationToken."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-11-02T14:35:31.782Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"3423baba77b6c66b3ce8f0f07d602851161cacdf9f69cee40f5af8f40e23b642","data_version":"5.2","first_seen_at":"2026-11-02T15:52:02Z","kind":"advisory","last_material_event_at":"2026-11-02T15:52:02Z","native_id":"CVE-2025-62819","provenance":[{"revision":"302b8809b4edc1c410015d0a7d058f227383b0c3","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2025-62819"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-02T00:00:00Z","record_encoding":{"expanded_bytes":3095,"expanded_sha256":"2a2e60aa83e8cde495c667578c2826b616388ee7a91955548bc9bc8fd9a7080e","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2025-62819","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-02T14
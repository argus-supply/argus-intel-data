{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"6.8.11","status":"affected","version":"0","versionType":"semver"}],"product":"Advanced Custom Fields (ACF®)","vendor":"Unknown"}],"aliases":["CVE-2026-110813"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Advanced Custom Fields (ACF®) WordPress plugin before 6.8.11 does not properly sanitize a stored field definition that can be modified through its comment handling, allowing unauthenticated users to inject a payload that is emitted as an HTML attribute name and executed as JavaScript in the browser of any visitor or administrator who views a page rendering the affected field."}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Cross-Site Scripting (XSS)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-06T06:00:27.278Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Advanced Custom Fields (ACF®) < 6.8.11 - Unauthenticated Stored XSS via HTML Attribute Name Injection"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"fb8c8310a5778ce3c15b75cda721080725011b18410d41f5c69c589e07de2bb5","data_version":"5.2","first_seen_at":"2026-11-06T06:45:29Z","kind":"advisory","last_material_event_at":"2026-11-06T06:45:29Z","native_id":"CVE-2026-110813","provenance":[{"revision":"a302ad2ad53c8d7f7b5d0a532fda8102fcadff9b","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-110813"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-06T06:00:27Z","record_encoding":{"expanded_bytes":2929,"expanded_sha256":"3a28443dd1b1a2ad9c2f6f4ab3c381b06fcfe083c3bdb110a1bf6ff559ecc8d7","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-20
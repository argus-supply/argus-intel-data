{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"5.1.0","status":"affected","version":"0","versionType":"semver"}],"product":"All-in-One Video Gallery","vendor":"Unknown"}],"aliases":["CVE-2026-119259"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The All-in-One Video Gallery  WordPress plugin before 5.1.0 does not check the type, status or ownership of the target post before writing its view count and duration meta, allowing unauthenticated visitors to create or change that meta on any post, including private and draft posts, and to inflate the view count without limit."}],"problemTypes":[{"descriptions":[{"description":"CWE-862 Missing Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-06T06:00:26.207Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"All-in-One Video Gallery < 5.1.0 - Unauthenticated Views and Duration Post Meta Write"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"e65142b9f1dc4c701971f594858d13731aea23e9f50b8e4793bcb9b0fc6a0d6d","data_version":"5.2","first_seen_at":"2026-11-06T06:45:29Z","kind":"advisory","last_material_event_at":"2026-11-06T06:45:29Z","native_id":"CVE-2026-119259","provenance":[{"revision":"a302ad2ad53c8d7f7b5d0a532fda8102fcadff9b","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-119259"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-06T06:00:26Z","record_encoding":{"expanded_bytes":2776,"expanded_sha256":"8669459bcc9617726e6d5cdc28c868dedb3385b7d6c7c89a794b9b44371618da","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-119259","references":[{"assertion_role":"cna","provider":{"dateUpdated":"202
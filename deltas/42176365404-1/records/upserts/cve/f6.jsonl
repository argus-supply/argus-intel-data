{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.3.3","status":"affected","version":"0","versionType":"semver"}],"product":"Ever Accounting","vendor":"Unknown"}],"aliases":["CVE-2026-118045"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Ever Accounting  WordPress plugin before 2.3.3 does not restrict the file path supplied to its CSV import routine to an allowed directory, allowing users with its custom Accounting Manager role (which does not have administrator privileges) to delete arbitrary files on the server, such as wp-config.php, which takes the entire site offline."}],"problemTypes":[{"descriptions":[{"description":"CWE-73 External Control of File Name or Path","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-06T06:00:25.610Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Ever Accounting < 2.3.3 - Accounting Manager+ Arbitrary File Deletion via CSV Import"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"ae450f57c0e4f2b8a237b8e985bece169913686739c2ffada821e5f3af29356c","data_version":"5.2","first_seen_at":"2026-11-06T06:45:29Z","kind":"advisory","last_material_event_at":"2026-11-06T06:45:29Z","native_id":"CVE-2026-118045","provenance":[{"revision":"a302ad2ad53c8d7f7b5d0a532fda8102fcadff9b","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-118045"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-06T06:00:25Z","record_encoding":{"expanded_bytes":2812,"expanded_sha256":"10923c5536e6edcb1c143bf2ed4a17e5cfde48ed0086c6cf2e23d7d0e9265962","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-118045","references":[{"assertion_role":"cna","provider
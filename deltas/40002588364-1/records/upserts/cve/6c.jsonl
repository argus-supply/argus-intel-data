{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"22.23.3","status":"affected","version":"22.23.3","versionType":"semver"},{"lessThanOrEqual":"24.22.0","status":"affected","version":"24.22.0","versionType":"semver"},{"lessThanOrEqual":"26.12.0","status":"affected","version":"26.12.0","versionType":"semver"}],"product":"node","vendor":"nodejs"}],"aliases":["CVE-2026-106073"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A flaw in Node.js Permission Model filesystem enforcement leaves `fs.realpathSync()` without the required read permission checks. This is an incomplete fix of CVE-2026-21715, which only covered `fs.realpathSync.native()`.\n\nAs a result, code running under `--permission` with restricted `--allow-fs-read` can still use `fs.realpathSync()` to check file existence, resolve symlink targets, and enumerate filesystem paths outside of permitted directories.\n\nThis vulnerability affects Node.js **26.x**, **24.x**, and **22.x**."}],"metrics":[{"cvssV3_0":{"baseScore":3.3,"baseSeverity":"LOW","vectorString":"CVSS:3.0/AV:L/AC:L/PR:L/UI:N/S:U/C:L/I:N/A:N","version":"3.0"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-284","description":"CWE-284 Improper Access Control - Generic","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-23T16:15:05.728Z","orgId":"36234546-b8fa-4601-9d6f-f4e334aa8ea1","shortName":"hackerone"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"751a04b7d52a2ee7933902ec9c0386faa2722a4e837b28f87a58510f1d3970e2","data_version":"5.2","first_seen_at":"2026-10-23T18:22:11Z","kind":"advisory","last_material_event_at":"2026-10-23T18:22:11Z","native_id":"CVE-2026-106073","provenance":[{"revision":"8b16575c39f1e1810c5e863010da073d2d3285e7","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-1060
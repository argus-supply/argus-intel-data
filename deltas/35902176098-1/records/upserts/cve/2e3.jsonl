{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"1.25.2","status":"affected","version":"0","versionType":"semver"}],"product":"PgBouncer","vendor":"n/a"}],"aliases":["CVE-2026-6669"],"assertions":[{"affected_indices":[0],"configurations":[{"lang":"en","value":"PgBouncer authenticates to a backend PostgreSQL server using SCRAM"}],"descriptions":[{"lang":"en","value":"Missing upper bound on the key derivation iteration count accepted during SCRAM authentication to a backend server in PgBouncer through 1.25.2 allows a malicious or compromised PostgreSQL backend to cause uncontrolled CPU consumption in PgBouncer. The resulting key derivation cannot be interrupted in frontend builds such as PgBouncer. Because PgBouncer serves all clients from a single process, one backend can in this way stop it from serving traffic for every other database and client it is pooling, so the failure of a single backend is not contained."}],"metrics":[{"cvssV3_1":{"baseScore":5.9,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:N/A:H","version":"3.1"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-400","description":"Uncontrolled Resource Consumption","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-23T16:04:47.824Z","orgId":"f86ef6dc-4d3a-42ad-8f28-e6d5547a5007","shortName":"PostgreSQL"},"role":"cna","title":"Unbounded SCRAM iteration count causes CPU exhaustion in PgBouncer"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-6669","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-09-23T16:33:29.069636Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-09-23T16:46:13.708Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"e701581a8b4132b6734421c2c897ed7eac397b9c30e9273e375f25ed9e1bdfbd","data_version":"5.2","first_seen_at":"2026-09-23T18:24:52Z","kind":"advisory","last_material_event_at":"2026-09-23T18:24:52Z","native_id":"CVE-2026-6669","provenance":[{"revision":"b0d7e648991d75d3215c2e79d64fac7aec505b6b","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-6669"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"},{"assertion_index":1,"independent_evidence":false,"source_id":"cve"}],"published_at":"2026-09-23T16:04:47Z","record_encoding":{"expanded_bytes":4023,"expanded_sha256":"e429e6499a42dbb6cefbf0ddf853a2918ad1a7e004bf0ba96731763f0bccc70c","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-6669","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-23T16:04:47.824Z","orgId":"f86ef6dc-4d3a-42ad-8f28-e6d5547a5007","shortName":"PostgreSQL"},"url":"https://www.pgbouncer.org/changelog.html"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-09-23T16:46:13Z","status":"active","title":"Unbounded SCRAM iteration count causes CPU exhaustion in PgBouncer"}

{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"3.0.0","status":"affected","version":"1.0.0","versionType":"semver"}],"product":"Approval","vendor":"Nextcloud"}],"aliases":["CVE-2026-82982"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Approval app's approve/reject endpoint is meant to require the file's current etag as a freshness check, preventing an approver from approving or rejecting a file whose contents changed after they reviewed it. The backend only enforced this check when the etag parameter was present and non-empty in the request. An attacker able to intercept and modify the approval request could omit the etag field entirely, bypassing the freshness check and approving or rejecting a file version they never reviewed."}],"metrics":[{"cvssV3_0":{"baseScore":4.3,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.0/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:L/A:N","version":"3.0"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-840","description":"CWE-840 Business Logic Errors","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-18T01:26:04.619Z","orgId":"36234546-b8fa-4601-9d6f-f4e334aa8ea1","shortName":"hackerone"},"role":"cna"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-82982","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-09-18T19:41:50.479115Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-09-18T19:42:03.054Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"86eb28da53d0b6042763d8f2537d31352845fba1d5ddeafd308e43c003de69f0","data_version":"5.2","first_seen_at":"2026-09-23T18:24:52Z","kind":"a
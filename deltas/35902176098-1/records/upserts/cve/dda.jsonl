{"affected":[{"defaultStatus":"affected","original_ranges":[{"lessThanOrEqual":"5.0.0.0","status":"affected","version":"0.0.0.0","versionType":"semver"}],"product":"ALE","vendor":"Hewlett Packard Enterprise (HPE)"}],"aliases":["CVE-2026-76708"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A vulnerability exists in the Analytics and Location Engine (ALE) where the application and underlying operating system use default, hard-coded credentials for several administrative and system accounts. An unauthenticated remote attacker could exploit this vulnerability by attempting to log in using these known default credentials.\n\nSuccessful exploitation could result in an attacker gaining unauthorized access to the application's management interface and the underlying operating system, potentially leading to full system compromise."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"HIGH","baseScore":9.8,"baseSeverity":"CRITICAL","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"provider":{"dateUpdated":"2026-09-22T19:12:25.043Z","orgId":"eb103674-0d28-4225-80f8-39fb86215de0","shortName":"hpe"},"role":"cna","title":"Unauthenticated Remote Unauthorized Access Vulnerability in HPE Networking Analytics and Location Engine (ALE)"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-76708","options":[{"Exploitation":"none"},{"Automatable":"yes"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-09-23T12:03:41.802243Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-09-23T12:03:56.500Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authenti
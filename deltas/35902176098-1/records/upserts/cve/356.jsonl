{"affected":[{"original_ranges":[{"status":"affected","version":"<= 2.10.2-lts"}],"product":"MaxKB","vendor":"1Panel-dev"}],"aliases":["CVE-2026-77519"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"MaxKB is an open-source AI assistant for enterprise. In 2.10.2-lts and earlier, the /chat/api/mcp authentication path looks up an ApplicationApiKey using only its secret and active status, without enforcing the is_permanent and expire_time checks used by the standard chat API. A previously valid, non-permanent application key that remains active after expiration can initialize the MCP endpoint, list the published application's tool metadata, invoke tools/call, and create durable application_chat and application_chat_record state even though /chat/api/open rejects the same key. No fixed version is available as of this review."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":5.4,"baseSeverity":"MEDIUM","confidentialityImpact":"LOW","integrityImpact":"LOW","privilegesRequired":"LOW","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:L/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-613","description":"CWE-613: Insufficient Session Expiration","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-21T20:26:27.820Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"MaxKB: Expired application API keys remain usable on `/chat/api/mcp`"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"d920f0f5dc7d8e96f41ac5b6cc3b52d937be6a440e42b814f1cc536c3ab1f576","data_version":"5.2","first_seen_at":"2026-09-23T18:24:52Z","kind":"advisory","last_material_event_at":"2026-09-23T18:24:52Z","native_id":"CVE-2026-77519","provenance":[{"revision":"b0d7e648991d75d3215c2e79d64fac7aec505b6b","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-77519"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-21T20:26:27Z","record_encoding":{"expanded_bytes":3721,"expanded_sha256":"ab5e2ae5f30926bd89adf83a2898c5f72d5057e61d982dd6fe867d117735fcc1","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-77519","references":[{"assertion_role":"cna","name":"https://github.com/1Panel-dev/MaxKB/security/advisories/GHSA-r6g6-69fh-c39q","provider":{"dateUpdated":"2026-09-21T20:26:27.820Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"tags":["x_refsource_CONFIRM"],"url":"https://github.com/1Panel-dev/MaxKB/security/advisories/GHSA-r6g6-69fh-c39q"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-09-21T20:26:27Z","status":"active","title":"MaxKB: Expired application API keys remain usable on `/chat/api/mcp`"}

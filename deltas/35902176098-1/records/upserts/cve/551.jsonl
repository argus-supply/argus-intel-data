{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-88418"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"CMSimple 5.24 ships with CSRF protection disabled by default, which turns csrfProtection() into a no-op on every state-changing admin request, and it does not send the csrf_token hidden field in admin forms. Because administrator authentication is cookie-only and no CSRF token is enforced, an unauthenticated attacker can induce a logged-in administrator's browser to issue a forged content-save request with a text payload containing a scripting marker. The marker is stored verbatim into content/content.php; on every subsequent page view evaluate_cmsimple_scripting() (functions.php) executes the marker body with PHP eval() — for all visitors, including unauthenticated ones. This yields persistent remote code execution on the web server."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-09-22T19:29:21.204Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"d47da130c4f5e1402c7f6051635be082c1e9e0c2a1c6f7682065412262b09b11","data_version":"5.2","first_seen_at":"2026-09-23T18:24:52Z","kind":"advisory","last_material_event_at":"2026-09-23T18:24:52Z","native_id":"CVE-2026-88418","provenance":[{"revision":"b0d7e648991d75d3215c2e79d64fac7aec505b6b","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-88418"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-22T00:00:00Z","record_encoding":{"expanded_bytes":3234,"expanded_sha256":"28549351f225123c231473d45c4b1ec619ede23c20bc7009a7da4d1af716cd18","format":"cve-indexed-
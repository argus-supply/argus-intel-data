{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-79310"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"webpy web.py 0.76 is vulnerable to server-side template injection (SSTI). The template engine can be tricked into executing attacker-controlled template code that built-in security checks are designed to reject. When an application precompiles templates from a directory the attacker can write to and later renders them through the precompiled template loader, the sandbox is bypassed and the attacker's code runs, resulting in arbitrary Python code execution and OS command execution on the server."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-09-23T15:41:37.302Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"126da3bd03d0247f3f595f01d1776401876172c592aab35619c4f8d230d1b022","data_version":"5.2","first_seen_at":"2026-09-23T18:24:52Z","kind":"advisory","last_material_event_at":"2026-09-23T18:24:52Z","native_id":"CVE-2026-79310","provenance":[{"revision":"b0d7e648991d75d3215c2e79d64fac7aec505b6b","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-79310"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-23T00:00:00Z","record_encoding":{"expanded_bytes":2951,"expanded_sha256":"a6e2ad5cda427dd2134ac8724e927d908cd538c69799c9f44f6b13ba8da75fe5","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-79310","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-23T15:41:37.302Z","orgId":"8254265b-2729-46b6
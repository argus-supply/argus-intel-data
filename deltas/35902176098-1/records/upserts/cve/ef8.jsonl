{"affected":[{"original_ranges":[{"status":"affected","version":"<= 2.11.3"}],"product":"caddy","vendor":"caddyserver"}],"aliases":["CVE-2026-92700"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Caddy is an extensible server platform that uses TLS by default. In version 2.11.3 and earlier, in modules/caddyhttp/fileserver/staticfiles.go, fileHidden() uses case-sensitive filepath.Match checks, so case variants can bypass hide rules on case-insensitive filesystems or when mixed-case paths coexist and expose files intended to be hidden."}],"metrics":[{"cvssV4_0":{"attackComplexity":"LOW","attackRequirements":"PRESENT","attackVector":"NETWORK","baseScore":6.3,"baseSeverity":"MEDIUM","privilegesRequired":"NONE","subAvailabilityImpact":"NONE","subConfidentialityImpact":"NONE","subIntegrityImpact":"NONE","userInteraction":"NONE","vectorString":"CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:L/VI:N/VA:N/SC:N/SI:N/SA:N","version":"4.0","vulnAvailabilityImpact":"NONE","vulnConfidentialityImpact":"LOW","vulnIntegrityImpact":"NONE"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-178","description":"CWE-178: Improper Handling of Case Sensitivity","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-23T17:58:45.844Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"Caddy: fileHidden() case-sensitive pattern bypass — exposes \"hidden\" files via case variation"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"c03f55fc8efd694b710a6cd9f8ce2361a8be25f67c3f61a92778919bbd544d56","data_version":"5.2","first_seen_at":"2026-09-23T18:24:52Z","kind":"advisory","last_material_event_at":"2026-09-23T18:24:52Z","native_id":"CVE-2026-92700","provenance":[{"revision":"b0d7e648991d75d3215c2e79d64fac7aec505b6b","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CV
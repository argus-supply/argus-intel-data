{"affected":[{"original_ranges":[{"status":"affected","version":"6.2.2"}],"product":"Node-convict","vendor":"Mozilla"}],"aliases":["CVE-2026-106550"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Mozilla's Node-convict (version 6.2.2 and later) is vulnerable to a Denial of Service vulnerability caused by incomplete prototype‑pollution protections in config.set(). An attacker controlling the configuration key can write arbitrary properties to constructor.<key>, which walk() resolves to the global Object function. This allows overwriting core JavaScript methods such as Object.assign, leading to persistent process-wide failures and requiring a restart. The issue bypasses existing filters that only block constructor.prototype.* and __proto__.*. Exploitation requires an endpoint that forwards attacker-controlled keys into config.set()."}],"problemTypes":[{"descriptions":[{"description":"CWE-1321: Improperly Controlled Modification of Object Prototype Attributes (‘Prototype Pollution’)","lang":"en"}]},{"descriptions":[{"description":"CWE-915: Improperly Controlled Modification of Dynamically-Determined Object Attributes","lang":"en"}]},{"descriptions":[{"description":"CWE-400: Uncontrolled Resource Consumption (‘Denial of Service’)","lang":"en"}]}],"provider":{"dateUpdated":"2026-10-06T20:09:55.919Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"role":"cna","title":"CVE-2026-106550"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"c08f5fe0a08349fc40442a1bd5799c8b38838b4c2b4d7cc06b91b762dd801127","data_version":"5.2","first_seen_at":"2026-10-06T20:59:29Z","kind":"advisory","last_material_event_at":"2026-10-06T20:59:29Z","native_id":"CVE-2026-106550","provenance":[{"revision":"53e9f236764e0b6e43e99965da97935797ce8eae","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-106550"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-06T20:09:55Z","record_encoding":{"expanded_bytes":3425,"expanded_sha256":"15fe7a3068b5cd1762008a9afe3e42ebbf4adc19263eb37681b7088b6ab0ee37","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-106550","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-06T20:09:55.919Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"url":"https://github.com/mozilla/node-convict"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-06T20:09:55Z","status":"active","title":"CVE-2026-106550"}
{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-88393"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"WookTeam v1.6.6 and before is vulnerable to RCE in the project task export interface /api/project/task/export. The data parameter is base64-decoded and passed directly into the string2array() function in app/Module/Base.php, which executes eval(\"\\$array = $data;\") whenever the decoded string starts with array. An attacker can inject arbitrary PHP code into the eval call and achieve RCE."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-10-05T15:11:57.066Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"},{"affected_indices":[],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"HIGH","baseScore":9.8,"baseSeverity":"CRITICAL","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","version":"3.1"}},{"other":{"content":{"id":"CVE-2026-88393","options":[{"Exploitation":"poc"},{"Automatable":"yes"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-10-06T16:58:03.989439Z","version":"2.0.3"},"type":"ssvc"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-94","description":"CWE-94 Improper Control of Generation of Code ('Code Injection')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-06T17:42:07.665Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"29def58c9064e9f420941d0e3210668d
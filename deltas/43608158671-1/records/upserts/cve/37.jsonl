{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["JSON::XS"],"original_ranges":[{"lessThan":"4.05","status":"affected","version":"0","versionType":"custom"}],"packageName":"JSON-XS","packageURL":"pkg:cpan/JSON-XS","programFiles":["XS.xs"],"programRoutines":[{"name":"decode_hv"}],"repo":"https://cvs.schmorp.de/JSON-XS/"}],"aliases":["CVE-2026-124539"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"JSON::XS versions before 4.05 for Perl leak the decoded key of an object rejected for a missing colon in decode_hv.\n\nUnless it is short plain ASCII, a quoted key is decoded into a new scalar. Nothing frees that scalar when the object is rejected for a missing ':' after the key.\n\nA process that keeps running after a failed decode retains one key per rejected document, with its size chosen by the sender. Repeated requests exhaust process memory."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-401","description":"CWE-401 Missing Release of Memory after Effective Lifetime","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-14T11:52:36.293Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"JSON::XS versions before 4.05 for Perl leak the decoded key of an object rejected for a missing colon in decode_hv"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"7af2ee2b821f5b185b6ecaee4ed3b8a654cf4950654500cc2f065fbeb494a228","data_version":"5.2","first_seen_at":"2026-11-14T15:05:09Z","kind":"advisory","last_material_event_at":"2026-11-14T15:05:09Z","native_id":"CVE-2026-124539","provenance":[{"revision":"fac8b0437fc5a472f8cc1045ee8d051a01024780","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-124539"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_
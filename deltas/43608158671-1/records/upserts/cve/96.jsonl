{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["JSON::XS"],"original_ranges":[{"lessThan":"4.05","status":"affected","version":"0","versionType":"custom"}],"packageName":"JSON-XS","packageURL":"pkg:cpan/JSON-XS","programFiles":["XS.xs"],"programRoutines":[{"name":"JSON::XS::incr_parse"}],"repo":"https://cvs.schmorp.de/JSON-XS/"}],"aliases":["CVE-2026-124536"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"JSON::XS versions before 4.05 for Perl allow memory exhaustion by buffering incremental input past max_size after a NUL byte in incr_parse.\n\nThe parser appends each chunk to its buffer and compares max_size with how far it has progressed, not with the buffer length. It treats a NUL byte as the end of the input, so a NUL within the first max_size bytes keeps it short of the limit. The buffer keeps growing, and incr_skip cannot remove the NUL.\n\nA peer streaming data to an incr_parse consumer can exhaust process memory regardless of max_size."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-770","description":"CWE-770 Allocation of Resources Without Limits or Throttling","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-14T11:51:22.977Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"JSON::XS versions before 4.05 for Perl allow memory exhaustion by buffering incremental input past max_size after a NUL byte in incr_parse"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"f736ba1535481da95fd66c3b79c3dd43d0c8c2b93c78a27a23e5c28c78eb4a6c","data_version":"5.2","first_seen_at":"2026-11-14T15:05:09Z","kind":"advisory","last_material_event_at":"2026-11-14T15:05:09Z","native_id":"CVE-2026-124536","provenance":[{"revision":"fac8b0437fc5a472f8cc1045ee8d051a01024780","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-124536"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-14T11:51:22Z","record_encoding":{"expanded_bytes":3516,"expanded_sha256":"84f0f2c8a25e5b84a9d4c14f02f48238400be3326d2f723386e01fc2a98d88c6","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-124536","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-14T11:51:22.977Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"tags":["release-notes"],"url":"https://metacpan.org/release/MLEHMANN/JSON-XS-4.05/changes"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-11-14T11:51:22Z","status":"active","title":"JSON::XS versions before 4.05 for Perl allow memory exhaustion by buffering incremental input past max_size after a NUL byte in incr_parse"}

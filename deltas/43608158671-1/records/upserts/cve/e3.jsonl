{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["JSON::XS"],"original_ranges":[{"lessThan":"4.05","status":"affected","version":"3.04","versionType":"custom"}],"packageName":"JSON-XS","packageURL":"pkg:cpan/JSON-XS","programFiles":["XS.xs"],"programRoutines":[{"name":"JSON::XS::incr_parse"}],"repo":"https://cvs.schmorp.de/JSON-XS/"}],"aliases":["CVE-2026-129114"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"JSON::XS versions from 3.04 before 4.05 for Perl write one byte past a heap buffer when appending a one-byte chunk in incr_parse.\n\nThe incremental buffer grows to one and a half times the length it must hold, with no room reserved for the terminating NUL. For an empty buffer and a one-byte chunk that request is one byte, which a buffer whose front was removed by earlier decodes can already have, so nothing is reallocated and the NUL lands one byte past the allocation.\n\nA peer streaming data to an incr_parse consumer, choosing how the input is split into reads, can cause a one-byte heap out-of-bounds write."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-193","description":"CWE-193 Off-by-one Error","lang":"en","type":"CWE"}]},{"descriptions":[{"cweId":"CWE-122","description":"CWE-122 Heap-based Buffer Overflow","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-14T11:53:52.483Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"JSON::XS versions from 3.04 before 4.05 for Perl write one byte past a heap buffer when appending a one-byte chunk in incr_parse"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"e08a18c07d94434ef3569c475833372bcce9109f79f06854a14652eea4f8b756","data_version":"5.2","first_seen_at":"2026-11-14T15:05:09Z","kind":"advisory","last_material_event_at":"2026-11-14T15:05:09Z","native_id":"CVE-2026-129114","provenance":[{"revision":"fac8b0437fc5a472f8cc1045ee8d051a01024780","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-129114"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-14T11:53:52Z","record_encoding":{"expanded_bytes":3714,"expanded_sha256":"477ddecd33e633f4d37eeae27cb9f3c7ec660a48e54a64da281a72c62ce0bf57","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-129114","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-14T11:53:52.483Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"tags":["release-notes"],"url":"https://metacpan.org/release/MLEHMANN/JSON-XS-4.05/changes"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-11-14T11:53:52Z","status":"active","title":"JSON::XS versions from 3.04 before 4.05 for Perl write one byte past a heap buffer when appending a one-byte chunk in incr_parse"}

{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"1.8.0","status":"affected","version":"1.6","versionType":"semver"}],"product":"Shipo","vendor":"shipo"}],"aliases":["CVE-2026-19907"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Shipo plugin for WordPress is vulnerable to Authentication Bypass in versions 1.6 through 1.8.0. This is due to the `authenticate_rest_user()` function parsing the `LOGGED_IN_COOKIE` value and authenticating the named user without verifying the cookie's cryptographic signature. The function's intended `/wp-json/shipo/` route restriction can also be bypassed by placing that substring in the query string of an unrelated REST endpoint. This makes it possible for unauthenticated attackers who know an existing username to impersonate that user, including an administrator, and perform authorized actions through the REST API, including creating another administrator account."}],"metrics":[{"cvssV3_1":{"baseScore":9.8,"baseSeverity":"CRITICAL","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-287","description":"CWE-287 Improper Authentication","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-14T12:33:23.699Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"Shipo 1.6 - 1.8.0 - Authentication Bypass to Administrator"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"7af528e3241cf52d51450137995fcc8d91b588f7cc44016085062d1b408535dd","data_version":"5.2","first_seen_at":"2026-11-14T15:05:09Z","kind":"advisory","last_material_event_at":"2026-11-14T15:05:09Z","native_id":"CVE-2026-19907","provenance":[{"revision":"fac8b0437fc5a472f8cc1045ee8d051a01024780","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-19907"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-14T12:33:23Z","record_encoding":{"expanded_bytes":3784,"expanded_sha256":"2e811798ccd23dace1aa6c81da6ae5e8f2d851e148059fa3167303a4648fd1c5","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-19907","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-14T12:33:23.699Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"url":"https://www.wordfence.com/threat-intel/vulnerabilities/id/ce5ea515-5ae1-4771-9bfb-5a0f4b3fce22?source=cve"},{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-14T12:33:23.699Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"url":"https://plugins.trac.wordpress.org/changeset/3701532/shipo"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-11-14T12:33:23Z","status":"active","title":"Shipo 1.6 - 1.8.0 - Authentication Bypass to Administrator"}

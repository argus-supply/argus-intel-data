{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["JSON::XS"],"original_ranges":[{"lessThan":"4.05","status":"affected","version":"0","versionType":"custom"}],"packageName":"JSON-XS","packageURL":"pkg:cpan/JSON-XS","programFiles":["XS.xs"],"programRoutines":[{"name":"decode_str"}],"repo":"https://cvs.schmorp.de/JSON-XS/"}],"aliases":["CVE-2026-124541"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"JSON::XS versions before 4.05 for Perl leak the decoded part of a rejected long string in decode_str.\n\nA string is decoded through a fixed-size buffer (16 KiB in 4.04), and each time the buffer fills its contents move into a new scalar. Nothing frees that scalar when the string is then rejected for a control character, an invalid escape, malformed UTF-8 or the end of the input.\n\nA process that keeps running after a failed decode retains the decoded part of each rejected string, with its size chosen by the sender. Repeated requests exhaust process memory."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-401","description":"CWE-401 Missing Release of Memory after Effective Lifetime","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-14T11:53:12.301Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"JSON::XS versions before 4.05 for Perl leak the decoded part of a rejected long string in decode_str"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"f9f94b640e06fb68797edfa543b617f51c72d673db0c2feac089de18b87b5e12","data_version":"5.2","first_seen_at":"2026-11-14T15:05:09Z","kind":"advisory","last_material_event_at":"2026-11-14T15:05:09Z","native_id":"CVE-2026-124541","provenance":[{"revision":"fac8b0437fc5a472f8cc1045ee8d051a01024780","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-124541"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-14T11:53:12Z","record_encoding":{"expanded_bytes":3458,"expanded_sha256":"84f078997897ca64affac53cbcac892ff3f882e37cc27da792445173e0fe1ba8","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-124541","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-14T11:53:12.301Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"tags":["release-notes"],"url":"https://metacpan.org/release/MLEHMANN/JSON-XS-4.05/changes"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-11-14T11:53:12Z","status":"active","title":"JSON::XS versions before 4.05 for Perl leak the decoded part of a rejected long string in decode_str"}

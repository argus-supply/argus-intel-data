{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"Latest (as of 2025-10-09)"}],"product":"CrewAI","vendor":"CrewAI"}],"aliases":["CVE-2026-92206"],"assertions":[{"affected_indices":[0],"datePublic":"2026-09-16T15:11:00.748Z","descriptions":[{"lang":"en","value":"CrewAI crewAI Framework Agent Loading Unsafe Reflection Remote Code Execution Vulnerability. This vulnerability allows remote attackers to execute arbitrary code on affected installations of CrewAI crewAI. User interaction is required to exploit this vulnerability in that the target must load a malicious agent configuration from the repository.\n\nThe specific flaw exists within the load_agent_from_repository function. The process does not properly restrict a user-supplied argument before using it to import a module. An attacker can leverage this vulnerability to execute code in the context of the service account. Was ZDI-CAN-28387."}],"metrics":[{"cvssV3_0":{"baseScore":8.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:N/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-470","description":"CWE-470: Use of Externally-Controlled Input to Select Classes or Code ('Unsafe Reflection')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-21T17:17:33.262Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"CrewAI crewAI Framework Agent Loading Unsafe Reflection Remote Code Execution Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"064071e749dcfbe06b2e52affe1c7e11d99519264d0ded5e9caa4028abc3dc5d","data_version":"5.2","first_seen_at":"2026-10-21T18:39:58Z","kind":"advisory","last_material_event_at":"2026-10-21T18:39:58Z","native_id":"CVE-2026-92206","provenance":[{"revision":"9c1b53b57bea84a3d9
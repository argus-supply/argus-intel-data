{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"7.6.1","status":"affected","version":"7.2.1","versionType":"semver"}],"product":"WarehousePG","repo":"https://github.com/warehouse-pg/warehouse-pg","vendor":"EnterpriseDB"}],"aliases":["CVE-2026-104947"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"WarehousePG (WHPG) 7.2.1 through 7.6.0 is affected by a missing authorization vulnerability (CWE-862) in the built-in function gp_log_backend_memory_contexts(). Any authenticated database role can run this function without a GRANT. It also gets around the superuser restriction that PostgreSQL places on the underlying pg_log_backend_memory_contexts() function. A low-privileged user can force the segment backends of any other session, superuser sessions included, to write their memory context details to the segment server logs, which the attacker cannot read. Those details can include query text from other users' cached plans, and the call can be repeated to generate large amounts of log output. WarehousePG 6.x is not affected."}],"metrics":[{"cvssV4_0":{"baseScore":5.3,"baseSeverity":"MEDIUM","vectorString":"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:N/VI:N/VA:L/SC:N/SI:N/SA:N","version":"4.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-862","description":"CWE-862 Missing Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-21T13:53:05.640Z","orgId":"20be33e2-bf35-4d13-8fad-18bd2f3e3659","shortName":"EDB"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"22d719a22504a8839909d90c56f248a7cff557a3ed6600198167c89c5001240c","data_version":"5.2","first_seen_at":"2026-10-21T18:39:58Z","kind":"advisory","last_material_event_at":"2026-10-21T18:39:58Z","native_id":"CVE-2026-104947","provenance":[{"revision":"9c1b53b57bea84
{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"9.7.3"}],"product":"NoMachine","vendor":"NoMachine"}],"aliases":["CVE-2026-111184"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-15T20:33:45.449Z","descriptions":[{"lang":"en","value":"NoMachine Named Pipe Incorrect Permission Assignment Local Privilege Escalation Vulnerability. This vulnerability allows local attackers to escalate privileges on affected installations of NoMachine. An attacker must first obtain the ability to execute low-privileged code on the target system in order to exploit this vulnerability.\n\nThe specific flaw exists within the NoMachine Device Service. The issue results from incorrect permissions on a named pipe. An attacker can leverage this vulnerability to escalate privileges and execute arbitrary code in the context of SYSTEM. Was ZDI-CAN-31213."}],"metrics":[{"cvssV3_0":{"baseScore":7.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-732","description":"CWE-732: Incorrect Permission Assignment for Critical Resource","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-21T17:15:43.200Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"NoMachine Named Pipe Incorrect Permission Assignment Local Privilege Escalation Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"9075619804f86239b7bd4c52318b8e0da694d5e7e63d06121a2a06b7ba70ce07","data_version":"5.2","first_seen_at":"2026-10-21T18:39:58Z","kind":"advisory","last_material_event_at":"2026-10-21T18:39:58Z","native_id":"CVE-2026-111184","provenance":[{"revision":"9c1b53b57bea84a3d98cf2ab1eef2d4297713bc8","source_id":"cve","url":"https://www.cve.org/CVERecord?i
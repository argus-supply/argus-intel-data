{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"2026.1.0"}],"product":"KeyShot","vendor":"Luxion"}],"aliases":["CVE-2026-92202"],"assertions":[{"affected_indices":[0],"datePublic":"2026-09-23T22:02:26.155Z","descriptions":[{"lang":"en","value":"Luxion KeyShot BIP File Parsing Uncontrolled Search Path Element Remote Code Execution Vulnerability. This vulnerability allows remote attackers to execute arbitrary code on affected installations of Luxion KeyShot. User interaction is required to exploit this vulnerability in that the target must visit a malicious page or open a malicious file.\n\nThe specific flaw exists within the parsing of BIP files. The issue results from loading a library from an unsecured location. An attacker can leverage this vulnerability to execute code in the context of the current process. Was ZDI-CAN-29268."}],"metrics":[{"cvssV3_0":{"baseScore":7.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-427","description":"CWE-427: Uncontrolled Search Path Element","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-21T17:18:40.948Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"Luxion KeyShot BIP File Parsing Uncontrolled Search Path Element Remote Code Execution Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"6f6538fd0d3c9f1e8b36e4f19bd2f934f0ac051c677aa935189ae193e24deec3","data_version":"5.2","first_seen_at":"2026-10-21T18:39:58Z","kind":"advisory","last_material_event_at":"2026-10-21T18:39:58Z","native_id":"CVE-2026-92202","provenance":[{"revision":"9c1b53b57bea84a3d98cf2ab1eef2d4297713bc8","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-92202"},{"a
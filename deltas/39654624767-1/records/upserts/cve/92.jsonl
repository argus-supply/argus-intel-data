{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"9.8.2_1"}],"product":"NoMachine","vendor":"NoMachine"}],"aliases":["CVE-2026-92208"],"assertions":[{"affected_indices":[0],"datePublic":"2026-09-16T23:51:02.971Z","descriptions":[{"lang":"en","value":"NoMachine mDNS Heap-based Buffer Overflow Remote Code Execution Vulnerability. This vulnerability allows network-adjacent attackers to execute arbitrary code on affected installations of NoMachine. Authentication is not required to exploit this vulnerability.\n\nThe specific flaw exists within the parsing of mDNS resource records. The issue results from the lack of proper validation of the length of user-supplied data prior to copying it to a heap-based buffer. An attacker can leverage this vulnerability to execute code in the context of the service account. Was ZDI-CAN-30982."}],"metrics":[{"cvssV3_0":{"baseScore":8.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:A/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-122","description":"CWE-122: Heap-based Buffer Overflow","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-21T17:16:04.507Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"NoMachine mDNS Heap-based Buffer Overflow Remote Code Execution Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"07e5bb01f323bf0852e85e6f90497b3a49ddc3d704b93680c646eb1e72661515","data_version":"5.2","first_seen_at":"2026-10-21T18:39:58Z","kind":"advisory","last_material_event_at":"2026-10-21T18:39:58Z","native_id":"CVE-2026-92208","provenance":[{"revision":"9c1b53b57bea84a3d98cf2ab1eef2d4297713bc8","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-92208"},{"assertion_index":0,"independent_eviden
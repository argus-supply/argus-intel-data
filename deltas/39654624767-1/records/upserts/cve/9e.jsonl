{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"nomachine_9.8.2_1_amd64.deb"}],"product":"NoMachine","vendor":"NoMachine"}],"aliases":["CVE-2026-92210"],"assertions":[{"affected_indices":[0],"datePublic":"2026-09-16T23:51:24.261Z","descriptions":[{"lang":"en","value":"NoMachine nxhtd Server-Side Request Forgery Information Disclosure Vulnerability. This vulnerability allows remote attackers to initiate arbitrary server-side requests on affected installations of NoMachine. Authentication is not required to exploit this vulnerability.\n\nThe specific flaw exists within the web service, which listens on UDP port 4443 by default. The issue results from the lack of proper validation of a URI prior to accessing resources. An attacker can leverage this vulnerability to initiate requests in the context of the service account. Was ZDI-CAN-31619."}],"metrics":[{"cvssV3_0":{"baseScore":7.2,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:C/C:L/I:L/A:N","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-918","description":"CWE-918: Server-Side Request Forgery (SSRF)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-21T17:16:22.236Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"NoMachine nxhtd Server-Side Request Forgery Information Disclosure Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"d67185ba2396791c6c684b5337789e172eb82334c60c682a86dd47e7a363f83b","data_version":"5.2","first_seen_at":"2026-10-21T18:39:58Z","kind":"advisory","last_material_event_at":"2026-10-21T18:39:58Z","native_id":"CVE-2026-92210","provenance":[{"revision":"9c1b53b57bea84a3d98cf2ab1eef2d4297713bc8","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-92210"},{"assertion_i
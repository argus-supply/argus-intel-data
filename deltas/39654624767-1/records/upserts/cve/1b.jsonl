{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"5903987091bb25e4f549331032cd2e3494cf8dae"}],"product":"GStreamer","vendor":"GStreamer"}],"aliases":["CVE-2026-111183"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-15T20:34:06.544Z","descriptions":[{"lang":"en","value":"GStreamer rtpL16depay Heap-based Buffer Overflow Remote Code Execution Vulnerability. This vulnerability allows remote attackers to execute arbitrary code on affected installations of GStreamer. Interaction with this library is required to exploit this vulnerability but attack vectors may vary depending on the implementation.\n\nThe specific flaw exists within the processing of RTP payload elements. The issue results from the lack of proper validation of the length of user-supplied data prior to copying it to a heap-based buffer. An attacker can leverage this vulnerability to execute code in the context of the current process. Was ZDI-CAN-31143."}],"metrics":[{"cvssV3_0":{"baseScore":9.8,"baseSeverity":"CRITICAL","vectorString":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-122","description":"CWE-122: Heap-based Buffer Overflow","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-21T17:15:23.195Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"GStreamer rtpL16depay Heap-based Buffer Overflow Remote Code Execution Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"17b30bef975d7814eea3f12db357397c8be762c6104808254f09f5660ca9d441","data_version":"5.2","first_seen_at":"2026-10-21T18:39:58Z","kind":"advisory","last_material_event_at":"2026-10-21T18:39:58Z","native_id":"CVE-2026-111183","provenance":[{"revision":"9c1b53b57bea84a3d98cf2ab1eef2d4297713bc8"
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"status":"affected","version":"unknown"}],"product":"Android","vendor":"Google"}],"aliases":["CVE-2026-95460"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"In Phase2SecureConnections::OnPeerPublicKey of phase_2_secure_connections.cc, there is a possible way to learn the passkey used during pairing due to an incomplete check for a reflected public key. This could lead to remote (proximal/adjacent) escalation of privilege with no additional execution privileges needed. User interaction is needed for exploitation."}],"problemTypes":[{"descriptions":[{"description":"Elevation of privilege","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-23T16:24:06.292Z","orgId":"83238938-5644-45f0-9007-c0392bcf6222","shortName":"Google_Devices"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"a1c865d72d977e016e149375dd8de9e839d3c02dfc4f375a1c105d34c9dfaa41","data_version":"5.2","first_seen_at":"2026-11-23T20:14:13Z","kind":"advisory","last_material_event_at":"2026-11-23T20:14:13Z","native_id":"CVE-2026-95460","provenance":[{"revision":"75e43ef1af4c37f05e57ad51e930443ffcc6876e","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-95460"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-23T16:24:06Z","record_encoding":{"expanded_bytes":2564,"expanded_sha256":"7f836cbae213cffe3ca6d5ccefe4802985ea7b9c81d948ea00bc5a23edf968d5","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-95460","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-23T16:24:06.292Z","orgId":"83238938-5644-45f0-9007-c0392bcf6222","shortName":"Google_Devices"},"url":"https://support.google.com/p
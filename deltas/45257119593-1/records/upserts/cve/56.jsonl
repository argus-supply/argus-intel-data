{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2026.11.11","status":"affected","version":"2026.10.10","versionType":"custom"}],"packageURL":"pkg:pypi/mcp-server-fetch","product":"mcp-server-fetch","repo":"https://github.com/modelcontextprotocol/servers","vendor":"Anthropic"}],"aliases":["CVE-2026-134492"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"In mcp-server-fetch from 2026.10.10 and before 2026.11.11, the check that blocks requests to non-public addresses treats IPv6 site-local addresses (fec0::/10) as public. A fetch to such an address passes the server-side request forgery guard. Practical impact is limited because many hosts have no route to this range."}],"metrics":[{"cvssV4_0":{"baseScore":2.3,"baseSeverity":"LOW","vectorString":"CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:P/VC:L/VI:N/VA:N/SC:N/SI:N/SA:N","version":"4.0"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-918","description":"CWE-918 Server-Side Request Forgery (SSRF)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-23T16:00:22.485Z","orgId":"98a01053-8a31-4f6d-9aa9-252be161adc6","shortName":"Anthropic"},"role":"cna","title":"mcp-server-fetch: IPv6 site-local addresses treated as public by SSRF guard"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"fba3125030dff721fea99f0ebaab581c3689fc05edee244eaa774130ff7d333b","data_version":"5.2","first_seen_at":"2026-11-23T20:14:13Z","kind":"advisory","last_material_event_at":"2026-11-23T20:14:13Z","native_id":"CVE-2026-134492","provenance":[{"revision":"75e43ef1af4c37f05e57ad51e930443ffcc6876e","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-134492"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-23T16:00:22Z","r
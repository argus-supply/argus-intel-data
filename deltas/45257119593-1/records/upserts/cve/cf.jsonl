{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2026.10.28","status":"affected","version":"0","versionType":"custom"}],"packageURL":"pkg:pypi/mcp-server-git","product":"mcp-server-git","repo":"https://github.com/modelcontextprotocol/servers","vendor":"Anthropic"}],"aliases":["CVE-2026-134465"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"In mcp-server-git before 2026.10.28, the --repository restriction can be bypassed through a nested directory that contains a .git file with a gitdir pointer to a repository outside the allowed path. A caller who can invoke the server's tools, place such a file in the allowed tree, and knows the outside repository's path can read committed content from that repository and create branches in it."}],"metrics":[{"cvssV4_0":{"baseScore":5.8,"baseSeverity":"MEDIUM","vectorString":"CVSS:4.0/AV:L/AC:L/AT:P/PR:L/UI:N/VC:H/VI:L/VA:N/SC:N/SI:N/SA:N","version":"4.0"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-22","description":"CWE-22 Improper Limitation of a Pathname to a Restricted Directory","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-23T16:00:22.038Z","orgId":"98a01053-8a31-4f6d-9aa9-252be161adc6","shortName":"Anthropic"},"role":"cna","title":"mcp-server-git: nested gitdir file bypasses --repository restriction"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"55e7f6d19e95194c8c7dcf8ebbda1ad6403f3491292f5461c3a8cd4d51d3a6d9","data_version":"5.2","first_seen_at":"2026-11-23T20:14:13Z","kind":"advisory","last_material_event_at":"2026-11-23T20:14:13Z","native_id":"CVE-2026-134465","provenance":[{"revision":"75e43ef1af4c37f05e57ad51e930443ffcc6876e","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-134465"},{"assertion_index":0,"ind
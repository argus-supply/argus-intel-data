{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.3.1","status":"affected","version":"0","versionType":"semver"}],"product":"Dynific Addons for Elementor (formerly Anywhere Elementor)","vendor":"Unknown"}],"aliases":["CVE-2026-117520"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Dynific Addons for Elementor (formerly Anywhere Elementor) WordPress plugin before 1.3.1 does not perform a capability check on an AJAX action that stores a configuration value, allowing any authenticated user, including Subscribers, to store a value that is later output without proper escaping in a quoted attribute on an administrator settings page, resulting in Stored Cross-Site Scripting that executes in the administrator's session."}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Cross-Site Scripting (XSS)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-18T06:00:07.419Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Dynific Addons for Elementor < 1.3.1 - Subscriber+ Stored XSS via aep_save_config AJAX Action"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"631c492f2f6203eec943396fab278db27d0dc7ff4400296fc644458aa3368a88","data_version":"5.2","first_seen_at":"2026-11-18T07:28:29Z","kind":"advisory","last_material_event_at":"2026-11-18T07:28:29Z","native_id":"CVE-2026-117520","provenance":[{"revision":"02059f7f1e963d45ba0ce3a7ba62c6a3b757a5a1","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-117520"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-18T06:00:07Z","record_encoding":{"expanded_bytes":3058,"expanded_sha256":"5a3402aa0222ea0db5044cd958ee0063467ea94c9255bb1821c632cd1a4596a9","format":"cve-indexed-assertions-v1","top_descriptions_ass
{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"b11160 (70c4e1582)"}],"product":"llama.cpp","vendor":"llama.cpp"}],"aliases":["CVE-2026-126974"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-13T21:01:46.288Z","descriptions":[{"lang":"en","value":"llama.cpp GGUF File Parsing Integer Overflow Remote Code Execution Vulnerability. This vulnerability allows remote attackers to execute arbitrary code on affected installations of llama.cpp. User interaction is required to exploit this vulnerability in that the target must visit a malicious page or open a malicious file.\n\nThe specific flaw exists within the parsing of GGUF files. The issue results from the lack of proper validation of user-supplied data, which can result in an integer overflow before writing to memory. An attacker can leverage this vulnerability to execute arbitrary code in the context of the current process. Was ZDI-CAN-34553."}],"metrics":[{"cvssV3_0":{"baseScore":7.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-190","description":"CWE-190: Integer Overflow or Wraparound","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-17T23:15:39.547Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"llama.cpp GGUF File Parsing Integer Overflow Remote Code Execution Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"f3e9a31376debb2faa5aed828bcb01f75120c6d008d6d2cdf0b484078993d4d1","data_version":"5.2","first_seen_at":"2026-11-18T07:28:29Z","kind":"advisory","last_material_event_at":"2026-11-18T07:28:29Z","native_id":"CVE-2026-126974","provenance":[{"revision":"02059f7f1e963d45ba0ce3a7ba62c6a3b757a5a1","source_id":"cve","url":
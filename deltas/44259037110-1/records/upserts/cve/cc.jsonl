{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"1.2.118"}],"product":"eco DC","vendor":"ATEN"}],"aliases":["CVE-2026-126964"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-13T22:08:21.612Z","descriptions":[{"lang":"en","value":"ATEN eco DC fwDeletes.json Directory Traversal Arbitrary File Deletion Vulnerability. This vulnerability allows remote attackers to delete arbitrary files on affected installations of ATEN eco DC. Authentication is required to exploit this vulnerability.\n\nThe specific flaw exists within the handling of JSON request data supplied to the fwDeletes.json endpoint. The issue results from the lack of proper validation of a user-supplied path prior to using it in file operations. An attacker can leverage this vulnerability to delete files in the context of SYSTEM. Was ZDI-CAN-28621."}],"metrics":[{"cvssV3_0":{"baseScore":5.5,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.0/AV:N/AC:L/PR:H/UI:N/S:U/C:N/I:L/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-22","description":"CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-17T23:13:37.846Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"ATEN eco DC fwDeletes.json Directory Traversal Arbitrary File Deletion Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"f8013dabdde68a2cab94d825de6ba99e4cb45b86657c5e37d695c928ac6039ba","data_version":"5.2","first_seen_at":"2026-11-18T07:28:29Z","kind":"advisory","last_material_event_at":"2026-11-18T07:28:29Z","native_id":"CVE-2026-126964","provenance":[{"revision":"02059f7f1e963d45ba0ce3a7ba62c6a3b757a5a1","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE
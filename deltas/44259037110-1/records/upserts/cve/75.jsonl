{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.7.1071","status":"affected","version":"1.7.1067","versionType":"semver"}],"product":"Royal Addons for Elementor","vendor":"Unknown"}],"aliases":["CVE-2026-107099"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Royal Addons for Elementor  WordPress plugin before 1.7.1071 does not restrict or validate the post meta keys used when counting or rendering a filtered grid, and does not reject private (hidden) meta keys, allowing unauthenticated users to disclose the value of arbitrary private post meta one value at a time from the filtered result count. This is an incomplete fix of CVE-2026-17585, whose 1.7.1067 patch covered only a separate search-based path and left the grid filtering path affected."}],"problemTypes":[{"descriptions":[{"description":"CWE-200 Information Exposure","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-18T06:00:06.370Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Royal Elementor Addons 1.7.1067 - 1.7.1070 - Unauthenticated Post Meta Disclosure via Grid Filter Widget"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"c99e9e595fc284746abd21bebf0919c383ef090e4d4c5fcf0b345cc544959722","data_version":"5.2","first_seen_at":"2026-11-18T07:28:29Z","kind":"advisory","last_material_event_at":"2026-11-18T07:28:29Z","native_id":"CVE-2026-107099","provenance":[{"revision":"02059f7f1e963d45ba0ce3a7ba62c6a3b757a5a1","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-107099"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-18T06:00:06Z","record_encoding":{"expanded_bytes":3161,"expanded_sha256":"fe2989d1bd31c3a84d26b3d7b012e20dd2e9aaf248637dada3502c0d9fa29b8a","format":"cve-indexe
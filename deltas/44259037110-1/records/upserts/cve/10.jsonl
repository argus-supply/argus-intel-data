{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"1.73.1973146020"}],"product":"Hue Bridge","vendor":"Philips"}],"aliases":["CVE-2026-126977"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-13T20:15:54.266Z","descriptions":[{"lang":"en","value":"Philips Hue Bridge HomeKit Pair-Setup Default Password Authentication Bypass Vulnerability. This vulnerability allows network-adjacent attackers to bypass authentication on affected installations of Philips Hue Bridge. Authentication is not required to exploit this vulnerability.\n\nThe specific flaw exists within the HomeKit Authentication service, which listens on TCP port 8080 by default. Crafted data in a pairing request can cause the device to allow authentication using a blank password. An attacker can leverage this vulnerability to bypass authentication on the system. Was ZDI-CAN-28323."}],"metrics":[{"cvssV3_0":{"baseScore":8.1,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:A/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:N","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-1393","description":"CWE-1393: Use of Default Password","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-17T23:16:08.637Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"Philips Hue Bridge HomeKit Pair-Setup Default Password Authentication Bypass Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"83e50ed6c642e978ccfee1bd2b90b5c5d77df65a1892f77a813908c9293de082","data_version":"5.2","first_seen_at":"2026-11-18T07:28:29Z","kind":"advisory","last_material_event_at":"2026-11-18T07:28:29Z","native_id":"CVE-2026-126977","provenance":[{"revision":"02059f7f1e963d45ba0ce3a7ba62c6a3b757a5a1","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-126977"},{
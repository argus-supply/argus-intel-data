{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"10.0.5"}],"product":"KiCad","vendor":"KiCad"}],"aliases":["CVE-2026-126972"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-13T19:29:39.173Z","descriptions":[{"lang":"en","value":"KiCad Plugin Directory Traversal Remote Code Execution   Vulnerability. This vulnerability allows remote attackers to execute arbitrary code on affected installations of KiCad. User interaction is required to exploit this vulnerability in that the target must visit a malicious page or open a malicious file.\n\nThe specific flaw exists within the handling of plugin packages. The issue results from the lack of proper validation of a user-supplied path prior to using it in file operations. An attacker can leverage this vulnerability to execute arbitrary code in the context of the current user. Was ZDI-CAN-33085."}],"metrics":[{"cvssV3_0":{"baseScore":7.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-22","description":"CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-17T23:15:05.802Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"KiCad Plugin Directory Traversal Remote Code Execution   Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"ccc65b1c803005a87e70639745d25439017b889584a92495bf74b61031e6a245","data_version":"5.2","first_seen_at":"2026-11-18T07:28:29Z","kind":"advisory","last_material_event_at":"2026-11-18T07:28:29Z","native_id":"CVE-2026-126972","provenance":[{"revision":"02059f7f1e963d45ba0ce3a7ba62c6a3b757a5a1","source_id":"cve","url":"https://www.cve.org/C
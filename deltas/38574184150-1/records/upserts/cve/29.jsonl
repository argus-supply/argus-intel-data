{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"4.15.3","status":"affected","version":"4.10.0","versionType":"semver"}],"product":"NSD","vendor":"NLnet Labs"}],"aliases":["CVE-2026-101337"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-14T12:00:00.000Z","descriptions":[{"lang":"en","value":"When base64 data is split up in pieces, of 3 character or less, tokens were incorrectly calculated to produce 0 bytes. This enables attackers to overwrite the stack with up to 64K of attacker controlled data.  Zone files which are written out by NSD itself, such as for zones for which the NSD instance is secondary, will not be formatted like this. The zone file must be fed to NSD directly, (but it could come, for example, from an operator controlled provisioning system)."}],"metrics":[{"cvssV4_0":{"baseScore":8.7,"baseSeverity":"HIGH","vectorString":"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N","version":"4.0"},"format":"CVSS","scenarios":[{"lang":"en","value":"When reading zone files, a resource record with a base64 RDATA field in a specially crafted presentation format, can cause an out of bounds stack overwrite which can be exploited for execution of arbitrary command."}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-121","description":"CWE-121 Stack-based Buffer Overflow","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-14T10:56:15.073Z","orgId":"206fc3a0-e175-490b-9eaa-a5738056c9f6","shortName":"NLnet Labs"},"role":"cna","title":"Stack overwrite from specially formatted base64 RDATA field"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"4c569361072f6dda8d4a5aa2d6f90a9afb065169bd770cbbba412eaa6fedf49c","data_version":"5.2","first_seen_at":"2026-10-14T13:44:08Z","kind":"advisory","last_material_event_at":"2026-10-14T13:44:08Z","native_id":"CVE-20
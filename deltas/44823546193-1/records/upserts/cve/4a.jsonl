{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"16.0.1"}],"product":"RViz","vendor":"Open Robotics"}],"aliases":["CVE-2026-134052"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-18T15:38:40.632Z","descriptions":[{"lang":"en","value":"Open Robotics RViz fillIndexBuffer Heap-based Buffer Overflow Remote Code Execution Vulnerability. This vulnerability allows network-adjacent attackers to execute arbitrary code on affected installations of Open Robotics RViz. Authentication is not required to exploit this vulnerability.\n\nThe specific flaw exists within the handling of mesh resources in PointCloud and Marker displays. The issue results from the lack of proper validation of the length of user-supplied data prior to copying it to a heap-based buffer. An attacker can leverage this vulnerability to execute code in the context of the service account. Was ZDI-CAN-32652."}],"metrics":[{"cvssV3_0":{"baseScore":8.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:A/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-122","description":"CWE-122: Heap-based Buffer Overflow","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-20T19:47:45.972Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"Open Robotics RViz fillIndexBuffer Heap-based Buffer Overflow Remote Code Execution Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"8157fe7a33f2156aaef8bcfc063904a3de3e462f0244aa177b55e0dc2c5d5544","data_version":"5.2","first_seen_at":"2026-11-20T21:49:20Z","kind":"advisory","last_material_event_at":"2026-11-20T21:49:20Z","native_id":"CVE-2026-134052","provenance":[{"revision":"d26cc7aae53d9389f1ea143e4fc8ad12e957d7c3","source_id":"cve","url":"https://www.c
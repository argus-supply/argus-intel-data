{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"10.6.1","status":"affected","version":"7.3.0","versionType":"custom"}],"product":"Postgres Enterprise Manager","vendor":"EnterpriseDB"}],"aliases":["CVE-2026-132659"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"In Postgres Enterprise Manager (PEM), the row-level security policies on pem.job and pem.jobstep that apply to PEM agents do not limit an agent to its own jobs. An attacker who controls one monitored host, and so its PEM agent certificate, can create, change or delete jobs for every other agent, including the agent on the PEM server. Agents run SQL job steps with the database credentials of the server they monitor, and shell job steps where batch jobs are enabled, so compromising one monitored host can give superuser SQL access to every monitored database and to the PEM backend.\nFrom PEM 10.6.1, PEM agents can no longer create jobs or change job definitions or job steps."}],"metrics":[{"cvssV4_0":{"attackComplexity":"LOW","attackRequirements":"NONE","attackVector":"NETWORK","baseScore":9.4,"baseSeverity":"CRITICAL","privilegesRequired":"HIGH","subAvailabilityImpact":"HIGH","subConfidentialityImpact":"HIGH","subIntegrityImpact":"HIGH","userInteraction":"NONE","vectorString":"CVSS:4.0/AV:N/AC:L/AT:N/PR:H/UI:N/VC:H/VI:H/VA:H/SC:H/SI:H/SA:H","version":"4.0","vulnAvailabilityImpact":"HIGH","vulnConfidentialityImpact":"HIGH","vulnIntegrityImpact":"HIGH"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-863","description":"CWE-863 Incorrect Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-20T14:56:00.974Z","orgId":"20be33e2-bf35-4d13-8fad-18bd2f3e3659","shortName":"EDB"},"role":"cna"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-132659","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-11-20T15:44:51.846776Z","v
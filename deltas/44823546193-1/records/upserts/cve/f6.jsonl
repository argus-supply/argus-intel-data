{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"9.0.0","status":"affected","version":"0","versionType":"semver"}],"product":"Rocket.Chat","vendor":"Rocket.Chat"}],"aliases":["CVE-2026-106075"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Rocket.Chat's POST /api/v1/chat.sendMessage endpoint improperly validates nested message properties, allowing authenticated users with standard privileges to inject arbitrary message metadata that is persisted and trusted by the server and clients. This can lead to persistent room-level denial of service, stored HTML/iframe injection, unauthorized modification of other users' private starred messages, permission bypass and attribution spoofing for pinned messages, forged edit attribution, and invisible user mentions."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-284","description":"CWE-284 Improper Access Control - Generic","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-20T18:07:18.571Z","orgId":"36234546-b8fa-4601-9d6f-f4e334aa8ea1","shortName":"hackerone"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"1f9cef30bd080d188f4630a06e4df8296858e3e8cc27e93b62143e1b7e9cacfa","data_version":"5.2","first_seen_at":"2026-11-20T21:49:20Z","kind":"advisory","last_material_event_at":"2026-11-20T21:49:20Z","native_id":"CVE-2026-106075","provenance":[{"revision":"d26cc7aae53d9389f1ea143e4fc8ad12e957d7c3","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-106075"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-20T18:07:18Z","record_encoding":{"expanded_bytes":2941,"expanded_sha256":"a9efe08e3055179b1901a9db5f5505faa3886c7f4db3161a5b1ba5b7f59c3e6d","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_sourc
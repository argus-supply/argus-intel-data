{"affected":[{"defaultStatus":"affected","original_ranges":[{"lessThan":"*","status":"unaffected","version":"26.19.0","versionType":"custom"}],"product":"LINE client for iOS","vendor":"LY Corporation"}],"aliases":["CVE-2026-102430"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"An uncontrolled recursion vulnerability exists in the LINE iOS app prior to version 26.19.0.\n\nThe Flex Message processing component does not adequately validate the structure of externally supplied message content.\n\nAs a result, an attacker who is able to send a crafted message to a victim could cause the application to crash when the message is received or displayed.\n\nA server-side mitigation has been deployed that also protects existing iOS clients that have not been updated to version 26.19.0."}],"metrics":[{"cvssV4_0":{"baseScore":6.9,"baseSeverity":"MEDIUM","vectorString":"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:P/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N","version":"4.0"}}],"problemTypes":[{"descriptions":[{"description":"CWE-674","lang":"en"}]}],"provider":{"dateUpdated":"2026-11-20T01:57:59.891Z","orgId":"657f3255-0560-4aed-82e4-7f579ec6acfb","shortName":"LY-Corporation"},"role":"cna"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-102430","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-11-20T17:11:54.730939Z","version":"2.0.3"},"type":"ssvc"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-674","description":"CWE-674 Uncontrolled Recursion","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-20T17:12:12.482Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"0b3702556160b5705e273e0cd47
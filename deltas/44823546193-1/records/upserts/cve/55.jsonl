{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"0.*","status":"affected","version":"0.02","versionType":"maven"},{"lessThan":"1.58","status":"affected","version":"1.00","versionType":"maven"}],"product":"Net::DNS","vendor":"NLnet Labs"}],"aliases":["CVE-2026-101340"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-20T12:00:00.000Z","descriptions":[{"lang":"en","value":"Net::DNS uses a 16-bit query ID to match responses to the corresponding requests.  In versions up to and including 1.57, the ID is obtained from Perl's built-in rand() function.  An attacker that can observe the sequence of query IDs is able to expose the internal state of the PNRG and hence predict query IDs before they are transmitted.  The victim Net::DNS instance is then exposed to forged responses injected by the attacker.  Note that the deduplication cache in 1.57 has no impact on the feasibility of this attack."}],"metrics":[{"cvssV4_0":{"baseScore":9.1,"baseSeverity":"CRITICAL","vectorString":"CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:H/VI:H/VA:N/SC:N/SI:N/SA:N","version":"4.0"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-338","description":"CWE-338 Use of Cryptographically Weak Pseudo-Random Number Generator (PRNG)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-20T12:38:22.541Z","orgId":"206fc3a0-e175-490b-9eaa-a5738056c9f6","shortName":"NLnet Labs"},"role":"cna","title":"Query ID predictable from a short sequence of observations"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-101340","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-11-20T18:40:34.720556Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-11-20T18:40:44.447Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":
{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"16.0.1"}],"product":"RViz","vendor":"Open Robotics"}],"aliases":["CVE-2026-134047"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-18T15:38:03.768Z","descriptions":[{"lang":"en","value":"Open Robotics RViz IntensityPCTransformer PointField Out-Of-Bounds Read Denial-of-Service Vulnerability. This vulnerability allows network-adjacent attackers to create a denial-of-service condition on affected installations of Open Robotics RViz. Authentication is not required to exploit this vulnerability.\n\nThe specific flaw exists within the IntensityPCTransformer handling of PointCloud2 messages. The issue results from the lack of proper validation of user-supplied data, which can result in a read past the end of an allocated object. An attacker can leverage this vulnerability to create a denial-of-service condition on the system. Was ZDI-CAN-32645."}],"metrics":[{"cvssV3_0":{"baseScore":6.5,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.0/AV:A/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-125","description":"CWE-125: Out-of-bounds Read","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-20T19:47:17.080Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"Open Robotics RViz IntensityPCTransformer PointField Out-Of-Bounds Read Denial-of-Service Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"a21c86aabbbe95a1c7f7ea235da01c78d8c78aae1544b124b01c522343e3a573","data_version":"5.2","first_seen_at":"2026-11-20T21:49:20Z","kind":"advisory","last_material_event_at":"2026-11-20T21:49:20Z","native_id":"CVE-2026-134047","provenance":[{"revision":"d26cc7aae53d9389f1ea143e4fc8ad12e957d7c3","source_id":"cve
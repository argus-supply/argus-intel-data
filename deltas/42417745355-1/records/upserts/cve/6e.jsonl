{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"10.47","status":"affected","version":"0","versionType":"semver"}],"product":"Subscribe2 – Form, Email Subscribers & Newsletters","vendor":"wedevs"}],"aliases":["CVE-2026-120531"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Subscribe2 – Form, Email Subscribers & Newsletters plugin for WordPress is vulnerable to Stored Cross-Site Scripting via the ‘data[ip]’ parameter in all versions up to, and including, 10.47 due to insufficient input sanitization and output escaping. This makes it possible for unauthenticated attackers to inject arbitrary web scripts in pages that will execute whenever a user accesses an injected page."}],"metrics":[{"cvssV3_1":{"baseScore":7.2,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:L/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-79","description":"CWE-79 Improper Neutralization of Input During Web Page Generation","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-07T21:24:08.525Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"Subscribe2 – Form, Email Subscribers & Newsletters <= 10.47 - Unauthenticated Stored Cross-Site Scripting via 'data[ip]' Parameter"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"d196492e9ba2fe110f0de69a3bdc3835453a21bc3fe8588bdd7c9fe524dea34f","data_version":"5.2","first_seen_at":"2026-11-07T21:51:13Z","kind":"advisory","last_material_event_at":"2026-11-07T21:51:13Z","native_id":"CVE-2026-120531","provenance":[{"revision":"30106a5bcec5a9f42dfeaaef2c81df06014a5cc3","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-120531"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-07
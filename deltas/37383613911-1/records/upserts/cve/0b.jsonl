{"affected":[{"original_ranges":[{"status":"affected","version":">= 6.56.0, < 6.67.0"}],"product":"Ghost","vendor":"TryGhost"}],"aliases":["CVE-2026-105642"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Ghost is a Node.js content management system. From 6.56.0 until 6.67.0, an image processing library bundled with Ghost contained a vulnerability in its SVG handling. Any staff user, including Contributors, could create a bookmark card for an attacker-controlled website, resulting in arbitrary commands being run on the Ghost server. This issue is fixed in version 6.67.0."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"HIGH","baseScore":8.8,"baseSeverity":"HIGH","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"REQUIRED","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-94","description":"CWE-94: Improper Control of Generation of Code ('Code Injection')","lang":"en","type":"CWE"}]},{"descriptions":[{"cweId":"CWE-1395","description":"CWE-1395: Dependency on Vulnerable Third-Party Component","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-05T18:31:05.988Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"Ghost: Remote Code Execution via Bookmark Card Images"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-105642","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-10-05T19:03:59.197785Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-10-05T19:04:08.455Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configur
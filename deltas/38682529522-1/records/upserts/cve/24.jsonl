{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"4.1.2","status":"affected","version":"1.1.8","versionType":"semver"}],"product":"Wheels","repo":"https://github.com/wheels-dev/wheels","vendor":"Wheels"}],"aliases":["CVE-2026-110911"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Wheels 1.1.8 through 4.1.1 allows SQL injection when caller-supplied quoted values are parsed again as SQL by dynamic finders (such as findOneByEmail), the query builder's where(property, value) and where(property, operator, value), string/UUID-key lookup paths (findByKey, updateByKey, deleteByKey and findOrCreateBy...), and validatesUniquenessOf. The parser incorrectly treats a doubled single quote as the end of a literal. Applications passing request data to these APIs can expose authentication, password-reset or token lookups, and data to unauthorized access; numeric-column values are not affected. There is a similar concern for query-builder whereBetween() in 4.0.0 through 4.1.1: string/date bounds can alter SQL on MySQL/MariaDB with backslash escaping enabled. This is fixed in 4.1.2."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"HIGH","baseScore":9.8,"baseSeverity":"CRITICAL","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-89","description":"CWE-89 Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-15T03:03:49.507Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"0569158352888c4f1654fdc7ab7d0399c63db3a99b1f73a19095e43c07b4e2ee","data_version":"5.2","first_seen_at":"2026-10-15T04:39:29Z","kind":"advisory","last_material_event_at":"2026-10-15T04:39:29Z","native_id":"CVE-2026-110911","provenance":[{"revision":"6bff1516c5012bb347835d7dd8c273bd28931c04","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-110911"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-15T03:03:49Z","record_encoding":{"expanded_bytes":4050,"expanded_sha256":"8bc4339ad01ead11dc28d3b8f288a960e2bed05a33e29904dd7bad17f9235a1b","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-110911","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-15T03:03:49.507Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"tags":["vendor-advisory"],"url":"https://github.com/wheels-dev/wheels/security/advisories/GHSA-96rm-h22v-925x"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-15T03:03:49Z","status":"active","title":"CVE-2026-110911"}

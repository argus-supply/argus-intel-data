{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.6.0","status":"affected","version":"1.5.4","versionType":"semver"}],"product":"Event Tickets Manager for WooCommerce","vendor":"Unknown"}],"aliases":["CVE-2026-123129"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Event Tickets Manager for WooCommerce WordPress plugin before 1.6.0 does not validate the ticket-type price sent to one of its unauthenticated AJAX actions when the referenced product has no ticket types configured, and stores the submitted price site-wide, where it is applied to the next event ticket added to any cart, allowing unauthenticated visitors to buy event tickets at an arbitrary price, including for free.\n\nThis is due to an incomplete fix of CVE-2026-34898."}],"problemTypes":[{"descriptions":[{"description":"CWE-284 Improper Access Control","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-09T06:00:28.550Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Event Tickets Manager for WooCommerce 1.5.4 - 1.5.9 - Unauthenticated Site-wide Event Ticket Price Manipulation"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"3dc301c494a35f206034c1fcb5b5d237fec18ee29e991eec9b5b9b8053ea6e5a","data_version":"5.2","first_seen_at":"2026-11-09T09:48:16Z","kind":"advisory","last_material_event_at":"2026-11-09T09:48:16Z","native_id":"CVE-2026-123129","provenance":[{"revision":"5528bbbaee4806c900130383e85ca00f6f4971e5","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-123129"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-09T06:00:28Z","record_encoding":{"expanded_bytes":3145,"expanded_sha256":"455622e3e691262560b2e71588d14a34964c642e3e53783efda88de87f4afb8a","format":"cve-indexed-as
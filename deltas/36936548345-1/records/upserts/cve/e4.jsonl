{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"v74.0.0.878.1682","status":"affected","version":"v0.0.0.0.0","versionType":"semver"}],"product":"Meta Horizon OS","vendor":"Meta Platforms, Inc"}],"aliases":["CVE-2026-92173"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Prior to v74.0.0.878.1682 of Meta Horizon OS, MediaSyncJobReceiver could be induced to send a privileged PendingIntent including a com.oculus.vrshell CallerIdentity to an arbitrary application listening via NotificationListenerService. That would allow the application to impersonate the com.oculus.vrshell package, as well as packages signed with the same key, towards any endpoint within the OS that uses CallerIdentity authentication."}],"problemTypes":[{"descriptions":[{"description":"Improper Restriction of Communication Channel to Intended Endpoints (CWE-923)","lang":"en"}]}],"provider":{"dateUpdated":"2026-09-30T20:26:33.293Z","orgId":"4fc57720-52fe-4431-a0fb-3d2c8747b827","shortName":"Meta"},"role":"cna"},{"affected_indices":[],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":9.1,"baseSeverity":"CRITICAL","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:N","version":"3.1"}},{"other":{"content":{"id":"CVE-2026-92173","options":[{"Exploitation":"none"},{"Automatable":"yes"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-10-01T18:54:54.274370Z","version":"2.0.3"},"type":"ssvc"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-923","description":"CWE-923 Improper Restriction of Communication Channel to Intended Endpoints","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-01T18:56:04.855Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"4.0.6","status":"affected","version":"0","versionType":"semver"}],"product":"Membership Plugin","vendor":"Unknown"}],"aliases":["CVE-2026-114451"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Membership Plugin  WordPress plugin before 4.0.6 does not perform any authorization or CSRF check before running a schema-altering database maintenance routine, allowing unauthenticated users to convert the Membership Plugin  WordPress plugin before 4.0.6's own tables to a narrower character set, which irreversibly replaces every 4-byte character (such as emoji and some CJK characters) in the membership level, discount code and payment records with a question mark."}],"problemTypes":[{"descriptions":[{"description":"CWE-862 Missing Authorization","lang":"en","type":"CWE"}]},{"descriptions":[{"description":"CWE-352 Cross-Site Request Forgery (CSRF)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-15T06:00:07.344Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Kadence Memberships < 4.0.6 - Unauthenticated Table Collation Downgrade via 'rcp-action' Parameter"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"3ad3ad602d9246dbf99062ba7e211bb94719d3a6d19337c18656530aba17a8ea","data_version":"5.2","first_seen_at":"2026-11-15T09:26:17Z","kind":"advisory","last_material_event_at":"2026-11-15T09:26:17Z","native_id":"CVE-2026-114451","provenance":[{"revision":"c8095997fb2232a992282d7f0b48464983604854","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-114451"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-15T06:00:07Z","record_encoding":{"expanded_bytes":3187,"expanded_sha256":"b8d00ec2e9e6bad983841b2eec8437
{"affected":[{"defaultStatus":"unknown","modules":["kqueue"],"original_ranges":[{"lessThan":"p4","status":"affected","version":"15.1-RELEASE","versionType":"release"}],"product":"FreeBSD","vendor":"FreeBSD"}],"aliases":["CVE-2026-58100"],"assertions":[{"affected_indices":[0],"datePublic":"2026-09-29T20:30:00.000Z","descriptions":[{"lang":"en","value":"kqueue_fork_copy_knote() indexed into the child's file descriptor table using a knote's file descriptor number without a bounds check.  Because the child's table is copied before knotes are transferred, a concurrent thread in the parent could grow the parent's table and register knotes with file descriptor numbers beyond the end of the child's table, causing an out-of-bounds read.\n\nAn unprivileged local user may be able to exploit these races to escalate privileges."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-362","description":"CWE-362: Concurrent Execution using Shared Resource with Improper Synchronization ('Race Condition')","lang":"en","type":"CWE"},{"cweId":"CWE-125","description":"CWE-125: Out-of-bounds Read","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-15T06:31:27.858Z","orgId":"63664ac6-956c-4cba-a5d0-f46076e16109","shortName":"freebsd"},"role":"cna","title":"Memory safety bugs in kqueue copy-on-fork implementation"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-58100","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-10-16T03:56:56.154892Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-10-16T14:18:49.468Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"5c280394bb3237096a67643636bc9b0fe9843934bfc9b02f3794357d928427b2","data_version":"5.2","first_seen_at":"2026-10-15T11:29:28Z","kind":"advisory","last_material_event_at":"2026-10-16T18:04:01Z","native_id":"CVE-2026-58100","provenance":[{"revision":"4d718d56c3c6211de71441f817942e95520064ac","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-58100"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"},{"assertion_index":1,"independent_evidence":false,"source_id":"cve"}],"published_at":"2026-10-15T06:31:27Z","record_encoding":{"expanded_bytes":3824,"expanded_sha256":"478650005fc5d7b5a1d661013b531264f22ce28f4c9b51a9cac64383ffeac056","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-58100","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-15T06:31:27.858Z","orgId":"63664ac6-956c-4cba-a5d0-f46076e16109","shortName":"freebsd"},"tags":["vendor-advisory"],"url":"https://security.freebsd.org/advisories/FreeBSD-SA-26:65.kqueue.asc"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-16T14:18:49Z","status":"active","title":"Memory safety bugs in kqueue copy-on-fork implementation"}

{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-79537"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"metatool-ai MetaMCP through 2.4.22 contains an insecure direct object reference (IDOR) in the MCP transport session dispatch. The session store (getSession in session-lifetime-manager.ts) is keyed only by the client-supplied mcp-session-id header with no owner, namespace, or endpoint binding, and the per-endpoint authorization middleware validates only the URL endpoint's owner, never the session. An attacker who supplies another tenant's session id \" obtained without authentication from GET /metamcp/health/sessions, which discloses active session IDs and namespace UUIDs \" can list and execute the victim tenant's private MCP tools and exfiltrate their data using the victim's forwarded credentials."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-09-29T19:17:20.089Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"39e2a07026cb5f99009addc531bbd57c1f67456faeab23720711c97408328dc1","data_version":"5.2","first_seen_at":"2026-09-29T22:15:45Z","kind":"advisory","last_material_event_at":"2026-09-29T22:15:45Z","native_id":"CVE-2026-79537","provenance":[{"revision":"2cf36dafce4f001101ce3793c302fd24a7445293","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-79537"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-29T00:00:00Z","record_encoding":{"expanded_bytes":3366,"expanded_sha256":"d5da0cc676a9d4da1e7d3470f3dca5d8bc1940b0edde9616dabc839ca776ff6c","format":"cve-indexed-assertions-v1","top_descriptions_asse
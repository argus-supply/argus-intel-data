{"affected":[{"collectionURL":"https://github.com/EnterpriseDB/barman","defaultStatus":"unaffected","original_ranges":[{"lessThan":"3.20.1","status":"affected","version":"3.4.0","versionType":"custom"}],"product":"Barman","vendor":"EnterpriseDB"}],"aliases":["CVE-2026-93853"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Unverified ownership in Barman snapshot backup deletion allows a principal who can write the backup catalog to cause Barman to delete unrelated cloud snapshots. When a snapshot backup is deleted, either explicitly or by retention policy enforcement, Barman reads the snapshot identifiers from the backup.info file and passes them to the cloud provider's delete API using Barman's own credentials, without verifying that the snapshots belong to that backup. An attacker who can overwrite backup.info but lacks snapshot delete permissions can substitute the identifiers of other snapshots, causing Barman to delete any snapshot its cloud identity can reach on AWS, Microsoft Azure, or Google Cloud. Exploitation requires a deployment where the principal that writes the backup catalog is separate from the identity Barman uses to delete snapshots. Barman versions from 3.4.0 (Google Cloud), 3.6.0 (Azure), and 3.7.0 (AWS) up to and including 3.20.0 are affected. The issue is fixed in Barman 3.20.1."}],"metrics":[{"cvssV4_0":{"baseScore":7.2,"baseSeverity":"HIGH","vectorString":"CVSS:4.0/AV:N/AC:L/AT:P/PR:L/UI:N/VC:N/VI:H/VA:H/SC:N/SI:H/SA:H","version":"4.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-283","description":"CWE-283 Unverified Ownership","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-29T20:55:51.959Z","orgId":"20be33e2-bf35-4d13-8fad-18bd2f3e3659","shortName":"EDB"},"role":"cna","title":"Barman snapshot backup deletion trusts unverified backup catalog metadata"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"d89e7c8ffc85787f5c1369c0e4be5939feb20284e3e01f8798d6604ad807cea7","data_version":"5.2","first_seen_at":"2026-09-29T22:15:45Z","kind":"advisory","last_material_event_at":"2026-09-29T22:15:45Z","native_id":"CVE-2026-93853","provenance":[{"revision":"2cf36dafce4f001101ce3793c302fd24a7445293","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-93853"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-29T20:55:51Z","record_encoding":{"expanded_bytes":4258,"expanded_sha256":"5738ff3baccc61a305003471b0a8a4f68d2b1181e4df8e9e67109e336375ca8e","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-93853","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-29T20:55:51.959Z","orgId":"20be33e2-bf35-4d13-8fad-18bd2f3e3659","shortName":"EDB"},"url":"https://www.enterprisedb.com/docs/security/advisories/cve202693853/"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-09-29T20:55:51Z","status":"active","title":"Barman snapshot backup deletion trusts unverified backup catalog metadata"}

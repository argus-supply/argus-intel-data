{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-79534"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"mark3labs mcp-filesystem-server v0.11.1 is vulnerable to Directory Traversal due to an improper link resolution in validatePath (filesystemserver/handler/helper.go). When filepath.EvalSymlinks returns os.IsNotExist for a dangling symlink, the fallback validates only the parent directory and returns the unresolved path, so write_file (and modify_file, copy_file, move_file, create_directory) follows a pre-existing dangling symlink located inside an allowed directory and creates a file outside the configured allowed directories."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-09-29T19:28:47.480Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"ca977dd4cce85c39450b814fc9b0d39dbbf468afe8c5cadcbbd53e5a552a75d3","data_version":"5.2","first_seen_at":"2026-09-29T22:15:45Z","kind":"advisory","last_material_event_at":"2026-09-29T22:15:45Z","native_id":"CVE-2026-79534","provenance":[{"revision":"2cf36dafce4f001101ce3793c302fd24a7445293","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-79534"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-29T00:00:00Z","record_encoding":{"expanded_bytes":2821,"expanded_sha256":"7eaa956f4be328d85ce1ba8b10f0655a4811c33a5333892f0151d7e62bf1d548","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-79534","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-29T19:28:47.4
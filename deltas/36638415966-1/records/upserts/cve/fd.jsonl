{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"6.5.1.202602","status":"affected","version":"0","versionType":"semver"}],"packageName":"NetX Duo","product":"NetX Duo","vendor":"Eclipse Foundation"}],"aliases":["CVE-2026-102728"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","supportingMedia":[{"base64":false,"type":"text/html","value":"<p>Two client-side TLS/DTLS handshake parsers in NetX Secure read fields from a server-supplied message before validating that the message is long enough to contain them. Both are bounded out-of-bounds reads on a remotely reachable path, both are reached from a TLS or DTLS client connecting to a malicious or malformed server, and both have the same shape: the bounds check exists and returns the correct status, but it runs after the read it is meant to guard.</p>"}],"value":"Two client-side TLS/DTLS handshake parsers in NetX Secure read fields from a server-supplied message before validating that the message is long enough to contain them. Both are bounded out-of-bounds reads on a remotely reachable path, both are reached from a TLS or DTLS client connecting to a malicious or malformed server, and both have the same shape: the bounds check exists and returns the correct status, but it runs after the read it is meant to guard."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-126","description":"CWE-126 Buffer Over-read","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-29T17:55:18.761Z","orgId":"e51fbebd-6053-4e49-959f-1b94eeb69a2c","shortName":"eclipse"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"3b728f8f328ffffddd4e82470a1d6a1159fc0068f7551bc3eec7b45ea4976942","data_version":"5.2","first_seen_at":"2026-09-29T22:15:45Z","kind":"advisory","last_material_event_at":"2026-09-29T22:15:45Z","native_id"
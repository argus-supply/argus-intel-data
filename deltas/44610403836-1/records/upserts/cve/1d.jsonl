{"affected":[{"original_ranges":[{"lessThan":"8.8.0","status":"affected","version":"0","versionType":"custom"}],"product":"Splunk SOAR","vendor":"Splunk"}],"aliases":["CVE-2026-131288"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-18T00:00:00.000Z","descriptions":[{"lang":"en","value":"In Splunk SOAR versions below 8.8.0, a user with access to the configured load balancer account could replace a load balancer helper that Splunk SOAR later runs with root privileges during cluster lifecycle operations. If a Splunk SOAR administrator performs a cluster lifecycle operation, Splunk SOAR could execute arbitrary code with root privileges on the load balancer.\nThe vulnerability is possible because Splunk SOAR does not verify the integrity or ownership of the load balancer helper before running it with root privileges."}],"metrics":[{"cvssV3_1":{"baseScore":7.3,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:L/AC:L/PR:L/UI:R/S:U/C:H/I:H/A:H","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-269","description":"The software does not properly assign, modify, track, or check privileges for an actor, creating an unintended sphere of control for that actor.","lang":"en","type":"cwe"}]}],"provider":{"dateUpdated":"2026-11-19T19:56:36.644Z","orgId":"d1c1063e-7a18-46af-9102-31f8928bc633","shortName":"cisco"},"role":"cna","title":"[Flashpoint] Privilege Escalation through HAProxy Cluster Operations in Splunk SOAR"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"0e53180ff383eada43c241d42c90a5cced6e4837c39f91334eb605eea529b1f4","data_version":"5.2","first_seen_at":"2026-11-19T20:37:26Z","kind":"advisory","last_material_event_at":"2026-11-19T20:37:26Z","native_id":"CVE-2026-131288","provenance":[{"revision":"97d8b5ddd8ddca029c6f32983f5d5fd
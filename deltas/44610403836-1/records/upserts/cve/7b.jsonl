{"affected":[{"modules":["Splunk Web"],"original_ranges":[{"lessThan":"10.4.5","status":"affected","version":"10.4","versionType":"custom"},{"lessThan":"10.2.9","status":"affected","version":"10.2","versionType":"custom"},{"lessThan":"10.0.12","status":"affected","version":"10.0","versionType":"custom"},{"lessThan":"9.4.17","status":"affected","version":"9.4","versionType":"custom"}],"product":"Splunk Enterprise","vendor":"Splunk"}],"aliases":["CVE-2026-76533"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-18T00:00:00.000Z","descriptions":[{"lang":"en","value":"In Splunk Enterprise versions below 10.4.5, 10.2.9, 10.0.12, and 9.4.17 on Ubuntu and AlmaLinux, an unauthenticated user who obtains a valid Splunk Web session cookie before the affected user logs out could continue using the cookie after logout to access data and perform actions available to that user.\nThe vulnerability is possible because the logout flow does not invalidate the associated session token on affected deployments.\nThe attacker must obtain the valid session cookie before the affected user logs out of Splunk Web. The issue was reproduced in Splunk Enterprise installations on Ubuntu and AlmaLinux."}],"metrics":[{"cvssV3_1":{"baseScore":4.2,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:R/S:U/C:L/I:L/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-613","description":"According to WASC, Insufficient Session Expiration is when a web site permits an attacker to reuse old session credentials or session IDs for authorization.","lang":"en","type":"cwe"}]}],"provider":{"dateUpdated":"2026-11-19T19:55:21.705Z","orgId":"d1c1063e-7a18-46af-9102-31f8928bc633","shortName":"cisco"},"role":"cna","title":"Improper Authentication Handling after Splunk Web Logout in Splunk Enterprise"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"fe385da41481421785da4123d6d19c5ef27a155c4daa053ee4ef427bce2c94df","data_version":"5.2","first_seen_at":"2026-11-19T20:37:26Z","kind":"advisory","last_material_event_at":"2026-11-19T20:37:26Z","native_id":"CVE-2026-76533","provenance":[{"revision":"97d8b5ddd8ddca029c6f32983f5d5fde0031ca04","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-76533"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-19T19:55:21Z","record_encoding":{"expanded_bytes":3887,"expanded_sha256":"da90f6de014e893412f92aca2cfbc81ce8f86e1af1d0fc53673d19b7e7d3de32","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-76533","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-19T19:55:21.705Z","orgId":"d1c1063e-7a18-46af-9102-31f8928bc633","shortName":"cisco"},"url":"https://advisory.splunk.com/advisories/SVD-2026-1103"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-11-19T19:55:21Z","status":"active","title":"Improper Authentication Handling after Splunk Web Logout in Splunk Enterprise"}

{"affected":[{"original_ranges":[{"lessThan":"8.8.0","status":"affected","version":"0","versionType":"custom"}],"product":"Splunk SOAR","vendor":"Splunk"}],"aliases":["CVE-2026-131257"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-18T00:00:00.000Z","descriptions":[{"lang":"en","value":"In Splunk SOAR versions below 8.8.0, a user with permission to view and edit containers and at least one container label could set misleading user and app provenance on containers that the user creates and learn whether user IDs and installed app identifiers exist.\nThe vulnerability is possible because the Representational State Transfer (REST) API accepts client-supplied values for server-managed container fields."}],"metrics":[{"cvssV3_1":{"baseScore":5.4,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:L/I:L/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-915","description":"The software receives input from an upstream component that specifies multiple attributes, properties, or fields that are to be initialized or updated in an object, but it does not properly control which attributes can be modified.","lang":"en","type":"cwe"}]}],"provider":{"dateUpdated":"2026-11-19T19:56:18.746Z","orgId":"d1c1063e-7a18-46af-9102-31f8928bc633","shortName":"cisco"},"role":"cna","title":"Improper Access Control through the REST API in Splunk SOAR"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"c9104947358f75893d238bd3bb68d32c9c1a2bc0f3515a00753336b61491e816","data_version":"5.2","first_seen_at":"2026-11-19T20:37:26Z","kind":"advisory","last_material_event_at":"2026-11-19T20:37:26Z","native_id":"CVE-2026-131257","provenance":[{"revision":"97d8b5ddd8ddca029c6f32983f5d5fde0031ca04","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-131257"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-19T19:56:18Z","record_encoding":{"expanded_bytes":3251,"expanded_sha256":"941e4942143fad923ef442b17c0b364c9fccb0b704d7b87534f4d7faa744f291","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-131257","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-19T19:56:18.746Z","orgId":"d1c1063e-7a18-46af-9102-31f8928bc633","shortName":"cisco"},"url":"https://advisory.splunk.com/advisories/SVD-2026-1108"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-11-19T19:56:18Z","status":"active","title":"Improper Access Control through the REST API in Splunk SOAR"}

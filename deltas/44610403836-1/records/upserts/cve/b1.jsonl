{"affected":[{"original_ranges":[{"lessThan":"8.8.0","status":"affected","version":"0","versionType":"custom"}],"product":"Splunk SOAR","vendor":"Splunk"}],"aliases":["CVE-2026-131251"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-18T00:00:00.000Z","descriptions":[{"lang":"en","value":"In Splunk SOAR versions below 8.8.0, a user with permission to view and modify containers with an allowed label could add artifacts to containers that the user cannot view or modify.\nThe vulnerability is possible because the Representational State Transfer (REST) API artifact-creation workflow does not preserve the authorization boundary for the selected container."}],"metrics":[{"cvssV3_1":{"baseScore":4.3,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:L/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-639","description":"The system's authorization functionality does not prevent one user from gaining access to another user's data or record by modifying the key value identifying the data.","lang":"en","type":"cwe"}]}],"provider":{"dateUpdated":"2026-11-19T19:56:15.209Z","orgId":"d1c1063e-7a18-46af-9102-31f8928bc633","shortName":"cisco"},"role":"cna","title":"Authorization Bypass through Artifact Creation in Splunk SOAR"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"5d20d25ecb28c08fbb1d794a634e6b0fe15812d322f0fb65a2d04f21da816723","data_version":"5.2","first_seen_at":"2026-11-19T20:37:26Z","kind":"advisory","last_material_event_at":"2026-11-19T20:37:26Z","native_id":"CVE-2026-131251","provenance":[{"revision":"97d8b5ddd8ddca029c6f32983f5d5fde0031ca04","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-131251"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"publis
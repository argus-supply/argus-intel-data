{"affected":[{"original_ranges":[{"lessThan":"8.8.0","status":"affected","version":"0","versionType":"custom"}],"product":"Splunk SOAR","vendor":"Splunk"}],"aliases":["CVE-2026-131261"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-18T00:00:00.000Z","descriptions":[{"lang":"en","value":"In Splunk SOAR versions below 8.8.0, a user that holds a role with the Apps edit permission could execute arbitrary code as the user account that runs Splunk SOAR by installing a malicious app.\nThe vulnerability is possible because Splunk SOAR does not restrict app dependencies to validated binary packages before installing them."}],"metrics":[{"cvssV3_1":{"baseScore":8.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-829","description":"The software imports, requires, or includes executable functionality (such as a library) from a source that is outside of the intended control sphere.","lang":"en","type":"cwe"}]}],"provider":{"dateUpdated":"2026-11-19T19:56:21.040Z","orgId":"d1c1063e-7a18-46af-9102-31f8928bc633","shortName":"cisco"},"role":"cna","title":"Remote Code Execution (RCE) through the REST API in Splunk SOAR"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"f99f10cf8f280adc6a68a3facb147a63690272da0dd3bdae78f16fbcbfd20189","data_version":"5.2","first_seen_at":"2026-11-19T20:37:26Z","kind":"advisory","last_material_event_at":"2026-11-19T20:37:26Z","native_id":"CVE-2026-131261","provenance":[{"revision":"97d8b5ddd8ddca029c6f32983f5d5fde0031ca04","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-131261"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-19T19:56:21Z","record_encoding":{"exp
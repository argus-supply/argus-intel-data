{"affected":[{"original_ranges":[{"lessThan":"8.8.0","status":"affected","version":"0","versionType":"custom"}],"product":"Splunk SOAR","vendor":"Splunk"}],"aliases":["CVE-2026-131296"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-18T00:00:00.000Z","descriptions":[{"lang":"en","value":"In Splunk SOAR versions below 8.8.0, a user with permission to author and run playbooks could add messages to a different playbook run log and cause that run to fail, including runs outside the labels that the user could access.\nThe vulnerability is possible because Splunk SOAR does not verify that playbook API requests use the trusted runtime context for the current playbook run."}],"metrics":[{"cvssV3_1":{"baseScore":5.4,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:L/A:L","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-863","description":"The software performs an authorization check when an actor attempts to access a resource or perform an action, but it does not correctly perform the check. This allows attackers to bypass intended access restrictions.","lang":"en","type":"cwe"}]}],"provider":{"dateUpdated":"2026-11-19T19:56:41.555Z","orgId":"d1c1063e-7a18-46af-9102-31f8928bc633","shortName":"cisco"},"role":"cna","title":"Improper Access Control through Playbooks in Splunk SOAR"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"ba8710bb019ba255542bd285f4190daeec12379bfc0e510ff24fdf7c653fa713","data_version":"5.2","first_seen_at":"2026-11-19T20:37:26Z","kind":"advisory","last_material_event_at":"2026-11-19T20:37:26Z","native_id":"CVE-2026-131296","provenance":[{"revision":"97d8b5ddd8ddca029c6f32983f5d5fde0031ca04","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-131296"},{"assertion_inde
{"affected":[{"modules":["REST API"],"original_ranges":[{"lessThan":"10.4.5","status":"affected","version":"10.4","versionType":"custom"},{"lessThan":"10.2.9","status":"affected","version":"10.2","versionType":"custom"},{"lessThan":"10.0.12","status":"affected","version":"10.0","versionType":"custom"},{"lessThan":"9.4.17","status":"affected","version":"9.4","versionType":"custom"}],"product":"Splunk Enterprise","vendor":"Splunk"}],"aliases":["CVE-2026-131191"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-18T00:00:00.000Z","descriptions":[{"lang":"en","value":"In Splunk Enterprise versions below 10.4.5, 10.2.9, 10.0.12, and 9.4.17, a user who does not hold the \"admin\" or \"power\" Splunk roles could read private index configuration values for other users through the deployment server Representational State Transfer (REST) API.\nThe deployment server REST API does not limit a supplied repository location to configured deployment repositories before it reads indexes.conf stanzas."}],"metrics":[{"cvssV3_1":{"baseScore":4.3,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:L/I:N/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-22","description":"The software uses external input to construct a pathname that is intended to identify a file or directory that is located underneath a restricted parent directory, but the software does not properly neutralize special elements within the pathname that can cause the pathname to resolve to a location that is outside of the restricted directory.","lang":"en","type":"cwe"}]}],"provider":{"dateUpdated":"2026-11-19T19:55:38.438Z","orgId":"d1c1063e-7a18-46af-9102-31f8928bc633","shortName":"cisco"},"role":"cna","title":"Sensitive Information Disclosure through the Deployment Server REST API in Splunk Enterprise"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration"
{"affected":[{"original_ranges":[{"lessThan":"8.8.0","status":"affected","version":"0","versionType":"custom"}],"product":"Splunk SOAR","vendor":"Splunk"}],"aliases":["CVE-2026-131281"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-18T00:00:00.000Z","descriptions":[{"lang":"en","value":"In Splunk SOAR versions below 8.8.0, a user with asset edit permission could change the approval requirements and effective automation user for an asset without Splunk SOAR recording field-level audit details for those changes. This could weaken investigation and accountability for changes to security-sensitive asset settings.\nThe vulnerability is possible because Splunk SOAR does not include the asset approval voting fields and effective automation user field in its field-level audit coverage."}],"metrics":[{"cvssV3_1":{"baseScore":4.3,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:L/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-778","description":"When a security-critical event occurs, the software either does not record the event or omits important details about the event when logging it.","lang":"en","type":"cwe"}]}],"provider":{"dateUpdated":"2026-11-19T19:56:32.579Z","orgId":"d1c1063e-7a18-46af-9102-31f8928bc633","shortName":"cisco"},"role":"cna","title":"Insecure Default Audit Logging for Asset Approval and Effective User Changes through the REST API in Splunk SOAR"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"8e299272a5e5b09c0186f7406945359ae2f4f550b3799a68587067afdd8997a5","data_version":"5.2","first_seen_at":"2026-11-19T20:37:26Z","kind":"advisory","last_material_event_at":"2026-11-19T20:37:26Z","native_id":"CVE-2026-131281","provenance":[{"revision":"97d8b5ddd8ddca029c6f32983f5d5fde003
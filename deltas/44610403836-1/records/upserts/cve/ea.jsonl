{"affected":[{"modules":["REST API"],"original_ranges":[{"lessThan":"2.0.0","status":"affected","version":"0","versionType":"custom"}],"product":"Splunk AI Assistant","vendor":"Splunk"}],"aliases":["CVE-2026-131305"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-18T00:00:00.000Z","descriptions":[{"lang":"en","value":"In Splunk AI Assistant versions below 2.0.0, a user who does not hold the \"admin\" or \"power\" Splunk roles could submit client-controlled feature settings through the Representational State Transfer (REST) API. This could modify limited response metadata outside the expected server-side configuration.\nThe vulnerability is possible because the REST API processes client-supplied feature settings without enforcing the expected server-side configuration boundary."}],"metrics":[{"cvssV3_1":{"baseScore":8.1,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-15","description":"One or more system settings or configuration elements can be externally controlled by a user.","lang":"en","type":"cwe"}]}],"provider":{"dateUpdated":"2026-11-19T19:56:49.032Z","orgId":"d1c1063e-7a18-46af-9102-31f8928bc633","shortName":"cisco"},"role":"cna","title":"Improper Input Validation through the REST API in Splunk AI Assistant"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"0b7385a34748b42510a28a383a11062a001e920d2840e011635f022741a8bc9f","data_version":"5.2","first_seen_at":"2026-11-19T20:37:26Z","kind":"advisory","last_material_event_at":"2026-11-19T20:37:26Z","native_id":"CVE-2026-131305","provenance":[{"revision":"97d8b5ddd8ddca029c6f32983f5d5fde0031ca04","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-131305"},{"assertion_inde
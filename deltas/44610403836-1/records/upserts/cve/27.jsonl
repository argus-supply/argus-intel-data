{"affected":[{"modules":["REST API"],"original_ranges":[{"lessThan":"10.4.5","status":"affected","version":"10.4","versionType":"custom"},{"lessThan":"10.2.9","status":"affected","version":"10.2","versionType":"custom"},{"lessThan":"10.0.12","status":"affected","version":"10.0","versionType":"custom"},{"lessThan":"9.4.17","status":"affected","version":"9.4","versionType":"custom"}],"product":"Splunk Enterprise","vendor":"Splunk"}],"aliases":["CVE-2026-131185"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-18T00:00:00.000Z","descriptions":[{"lang":"en","value":"In Splunk Enterprise versions below 10.4.5, 10.2.9, 10.0.12, and 9.4.17, a user who does not hold the \"admin\" or \"power\" Splunk roles could use the apps backup and restore Representational State Transfer (REST) API to prevent subsequent apps backup or restore operations until Splunk Enterprise restarts. This could result in a Denial of Service (DoS).\nThe vulnerability is possible because the apps backup and restore REST API handlers do not correctly enforce authorization."}],"metrics":[{"cvssV3_1":{"baseScore":6.5,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:N/A:H","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-862","description":"The software does not perform an authorization check when an actor attempts to access a resource or perform an action.","lang":"en","type":"cwe"}]}],"provider":{"dateUpdated":"2026-11-19T19:55:35.263Z","orgId":"d1c1063e-7a18-46af-9102-31f8928bc633","shortName":"cisco"},"role":"cna","title":"Denial of Service (DoS) through the Apps Backup and Restore REST API in Splunk Enterprise"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"80e5dc613c2ea86009cc27e4c30316f12a27bed9bb7c1ac07aee5c4e8d814ee5","data_v
{"affected":[{"original_ranges":[{"lessThan":"8.7.0","status":"affected","version":"0","versionType":"custom"}],"product":"Splunk App for PCI Compliance","vendor":"Splunk"}],"aliases":["CVE-2026-131212"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-18T00:00:00.000Z","descriptions":[{"lang":"en","value":"In Splunk Enterprise Security versions below 8.7.0, a user that holds a role with the run_collect capability could store attacker-controlled values in data that populates the Malware Activity report. Another user with access to the report could later click a related row. Splunk Enterprise Security could then run attacker-controlled Search Processing Language (SPL) commands using the permissions of the user who clicked the row. The commands could access data and perform actions available to that user.\nThe vulnerability is possible because the Malware Activity report does not treat values from the Malware data model as literal search values when it builds drilldown searches.\nFor more information see Malware Activity (https://help.splunk.com/en/splunk-enterprise-security-8/splunk-app-for-pci-compliance/installation-and-configuration-manual/8.7/configure-reports/malware-activity) in the Splunk documentation."}],"metrics":[{"cvssV3_1":{"baseScore":4.6,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:R/S:U/C:L/I:L/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-943","description":"The application generates a query intended to access or manipulate data in a data store such as a database, but it does not neutralize or incorrectly neutralizes special elements that can modify the intended logic of the query.","lang":"en","type":"cwe"}]}],"provider":{"dateUpdated":"2026-11-19T19:55:53.197Z","orgId":"d1c1063e-7a18-46af-9102-31f8928bc633","shortName":"cisco"},"role":"cna","title":"Search Processing Language (SPL) Injection through Malware Activity Dashboard Drilldowns in the Splunk Enterprise Security"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"cfde1097a44f4844d87a1b0d1db63d6e6f1478e41851e8e3ecdc2e22cca2434e","data_version":"5.2","first_seen_at":"2026-11-19T20:37:26Z","kind":"advisory","last_material_event_at":"2026-11-19T20:37:26Z","native_id":"CVE-2026-131212","provenance":[{"revision":"97d8b5ddd8ddca029c6f32983f5d5fde0031ca04","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-131212"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-19T19:55:53Z","record_encoding":{"expanded_bytes":4391,"expanded_sha256":"66df9ec2a75cbf0e80623ffc86105fae71d32acb0fb9b9458fabccf6a33e6526","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-131212","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-19T19:55:53.197Z","orgId":"d1c1063e-7a18-46af-9102-31f8928bc633","shortName":"cisco"},"url":"https://advisory.splunk.com/advisories/SVD-2026-1106"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-11-19T19:55:53Z","status":"active","title":"Search Processing Language (SPL) Injection through Malware Activity Dashboard Drilldowns in the Splunk Enterprise Security"}

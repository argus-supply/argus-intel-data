{"affected":[{"modules":["REST API"],"original_ranges":[{"lessThan":"8.7.0","status":"affected","version":"0","versionType":"custom"}],"product":"Splunk Enterprise Security","vendor":"Splunk"}],"aliases":["CVE-2026-131199"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-18T00:00:00.000Z","descriptions":[{"lang":"en","value":"In Splunk Enterprise Security versions below 8.7.0, a user that holds a role with the mc_investigation_read capability could cause the Risk Event Timeline Representational State Transfer (REST) API to run arbitrary Search Processing Language (SPL) commands with elevated permissions. With this access, the user could expose stored credentials and modify indexes and lookup data available to those permissions.\nThe vulnerability is possible because the affected REST API does not validate request values before including them in search macro arguments.\nFor more information see Capability reference for Splunk Enterprise Security (https://help.splunk.com/en/splunk-enterprise-security-8/install/8.7/installation/capability-reference-for-splunk-enterprise-security) and Risk analysis (https://help.splunk.com/en/splunk-enterprise-security-8/user-guide/8.7/analytics/risk-analysis) in the Splunk documentation."}],"metrics":[{"cvssV3_1":{"baseScore":8.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-20","description":"The product does not validate or incorrectly validates input that can affect the control flow or data flow of a program.","lang":"en","type":"cwe"}]}],"provider":{"dateUpdated":"2026-11-19T19:55:45.338Z","orgId":"d1c1063e-7a18-46af-9102-31f8928bc633","shortName":"cisco"},"role":"cna","title":"SPL Injection through the Risk Event Timeline REST API in Splunk Enterprise Security"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"ffce8df71f991a0d526f2f18f6e23f6cbc9829b03b7b119097fb561ae62e660f","data_version":"5.2","first_seen_at":"2026-11-19T20:37:26Z","kind":"advisory","last_material_event_at":"2026-11-19T20:37:26Z","native_id":"CVE-2026-131199","provenance":[{"revision":"97d8b5ddd8ddca029c6f32983f5d5fde0031ca04","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-131199"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-19T19:55:45Z","record_encoding":{"expanded_bytes":4205,"expanded_sha256":"2893f87cd1c766ca7011a6fe41ef94a3336685fc15ae7a09077bbee2692f1634","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-131199","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-19T19:55:45.338Z","orgId":"d1c1063e-7a18-46af-9102-31f8928bc633","shortName":"cisco"},"url":"https://advisory.splunk.com/advisories/SVD-2026-1106"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-11-19T19:55:45Z","status":"active","title":"SPL Injection through the Risk Event Timeline REST API in Splunk Enterprise Security"}

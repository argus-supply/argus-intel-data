{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-106700"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"ELADMIN v2.7 and earlier contains an improper access control vulnerability in the user-management endpoint PUT /api/users/resetPwd of me.zhengjie.modules.system.rest.UserController. The method lacks the method-level authorization check applied to all other user-management endpoints and performs no role-level or ownership validation in UserServiceImpl.resetPwd. Any authenticated user of any role can reset the password of arbitrary users, including the built-in administrator."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"HIGH","baseScore":8.8,"baseSeverity":"HIGH","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"LOW","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AC:L/AV:N/A:H/C:H/I:H/PR:L/S:U/UI:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-10-15T19:20:42.587Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"495579ecb1e4fa2c89a98f22cc0dbb62bceb346eea0dc3cf47d03970f882bea3","data_version":"5.2","first_seen_at":"2026-10-15T21:23:35Z","kind":"advisory","last_material_event_at":"2026-10-15T21:23:35Z","native_id":"CVE-2026-106700","provenance":[{"revision":"a6a5b9ed8b86f15eeac667a6878a2edcf90d7b66","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-106700"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-15T00:00:00Z","record_encoding":{"expanded_bytes":3264,"expanded_sha256":"ff
{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"6.6.2"}],"product":"Telegram","vendor":"Telegram"}],"aliases":["CVE-2026-111105"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-15T16:05:14.992Z","descriptions":[{"lang":"en","value":"Telegram rlottie Numeric Truncation Remote Code Execution Vulnerability. This vulnerability allows remote attackers to execute arbitrary code on affected installations of Telegram. User interaction is required to exploit this vulnerability in that the target must visit a malicious page or open a malicious file.\n\nThe specific flaw exists within the rlottie library. The issue results from the lack of proper validation of user-supplied data, which can result in a write before the start of an allocated buffer. An attacker can leverage this vulnerability to execute code in the context of the current process. Was ZDI-CAN-30207."}],"metrics":[{"cvssV3_0":{"baseScore":7,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:L/AC:H/PR:N/UI:R/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-197","description":"CWE-197: Numeric Truncation Error","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-15T17:42:55.996Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"Telegram rlottie Numeric Truncation Remote Code Execution Vulnerability"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-111105","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-10-15T17:57:29.955577Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-10-15T19:14:57.038Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"prod
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.8.194","status":"affected","version":"0","versionType":"semver"}],"product":"GeoDirectory","vendor":"Unknown"}],"aliases":["CVE-2026-113490"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The GeoDirectory  WordPress plugin before 2.8.194 does not perform any status or ownership check when rendering a listing's map-popup through one of its single-item REST routes, allowing unauthenticated users to read the title, permalink and card fields of non-public (draft, pending, private and trashed) listings by supplying the listing ID."}],"problemTypes":[{"descriptions":[{"description":"CWE-200 Information Exposure","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-24T06:00:19.138Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"GeoDirectory < 2.8.194 - Unauthenticated Non-Public Listing Disclosure via Marker Popup REST Endpoint"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"20c1c17fca54bcd68d457678b7542efc6f2b61796360c572cd703a900947f863","data_version":"5.2","first_seen_at":"2026-10-24T11:00:33Z","kind":"advisory","last_material_event_at":"2026-10-24T11:00:33Z","native_id":"CVE-2026-113490","provenance":[{"revision":"c20bc548b406919defe0e63c1bb66aa77fbe095d","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-113490"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-24T06:00:19Z","record_encoding":{"expanded_bytes":2825,"expanded_sha256":"81ba6449d07c8215ae4d920e511fe6d5ea1337af2ffb8b083364e4e0e03b7122","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-113490","references":[{"assertion_role":"cna","provider":
{"affected":[{"collectionURL":"https://pypi.org/project/ansible-core/","defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.22.0","status":"affected","version":"2.19.0","versionType":"semver"}],"packageName":"ansible-core","product":"ansible-core","vendor":"Red Hat"}],"aliases":["CVE-2026-115622"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A flaw was found in ansible-core. When a task or its parameters are marked no_log: true, sensitive values passed to a module's warn() or deprecate() calls are not redacted and are printed in cleartext to stdout/stderr in warning and deprecation messages. The 'warnings' and 'deprecations' keys are retained in the PRESERVE allow-list in lib/ansible/_internal/_task.py when the task result is censored, so sensitive parameters bypass masking and can be disclosed in output captured in terminal sessions, CI logs, and any automation wrapping ansible-playbook, even though every task touching the secrets is marked no_log: true."}],"metrics":[{"cvssV3_1":{"baseScore":5.5,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:N/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-532","description":"CWE-532 Insertion of Sensitive Information into Log File","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-18T19:10:17.178Z","orgId":"53f830b8-0a3f-465b-8143-3b8a9948e749","shortName":"redhat"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"20b344321d0ea1e7f34165ecfbd7b73f8aba59087fac0042b5ad4c116b4dad12","data_version":"5.2","first_seen_at":"2026-11-19T00:22:51Z","kind":"advisory","last_material_event_at":"2026-11-19T00:22:51Z","native_id":"CVE-2026-115622","provenance":[{"revision":"e85b93d205da98966c46a0515f6125b43290fef0","source_id":"cve","url":"https://www.cve.org/CVERecord?id
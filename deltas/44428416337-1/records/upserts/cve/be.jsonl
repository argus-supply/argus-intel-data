{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"1.73.1973146020"}],"product":"Hue Bridge","vendor":"Philips"}],"aliases":["CVE-2026-126980"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-13T20:16:12.926Z","descriptions":[{"lang":"en","value":"Philips Hue Bridge HomeKit Observable Discrepancy Information Disclosure Vulnerability. This vulnerability allows network-adjacent attackers to disclose sensitive information on affected installations of Philips Hue Bridge. Authentication is not required to exploit this vulnerability.\n\nThe specific flaw exists within the HomeKit Authentication service, which listens on TCP port 8080 by default. When processing crafted pairing requests, the service discloses internal information via an observable discrepancy between possible responses. An attacker can leverage this in conjunction with other vulnerabilities to execute arbitrary code in the context of the device. Was ZDI-CAN-28470."}],"metrics":[{"cvssV3_0":{"baseScore":6.5,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.0/AV:A/AC:L/PR:N/UI:N/S:U/C:H/I:N/A:N","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-203","description":"CWE-203: Observable Discrepancy","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-17T23:16:31.681Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"Philips Hue Bridge HomeKit Observable Discrepancy Information Disclosure Vulnerability"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-126980","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-11-18T17:27:01.963408Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-11-18T17:27:14.097Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifie
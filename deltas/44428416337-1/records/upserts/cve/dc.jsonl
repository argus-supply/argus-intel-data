{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-128668"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"An Unrestricted File Upload vulnerability in the admin panel of PHPGurukul News Portal Project V4.1 allows authenticated attackers to upload files with arbitrary content by bypassing weak filename extension validation in add-post.php and change-image.php. Although files are renamed with an image extension upon storage, the lack of MIME type and content validation enables content spoofing, storage of malicious markup, and creates a vector for Remote Code Execution (RCE) with server misconfigurations or secondary Local File Inclusion."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-11-18T19:48:45.070Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"01cb42ccc9e5879230b5a0b464c5d0c6d4236aa40d4bb41339eb5a401f82ea4a","data_version":"5.2","first_seen_at":"2026-11-19T00:22:51Z","kind":"advisory","last_material_event_at":"2026-11-19T00:22:51Z","native_id":"CVE-2026-128668","provenance":[{"revision":"e85b93d205da98966c46a0515f6125b43290fef0","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-128668"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-18T00:00:00Z","record_encoding":{"expanded_bytes":2866,"expanded_sha256":"e05bae498c08e3f83588ce63b5bd48c96e94a5c45cdd513f0dc833fdf043a790","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-128668","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-18
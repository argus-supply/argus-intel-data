{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-128666"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A Reflected Cross-Site Scripting (XSS) vulnerability exists in PHPGurukul News Portal Project V4.1. The $currenturl variable in news-details.php is constructed using unencoded REQUEST_URI and HTTP_HOST server variables and echoed directly into the href attributes of social share links. An unauthenticated remote attacker can exploit this by crafting a URL containing HTML metacharacters to break out of the href attribute and execute arbitrary HTML or JavaScript in the context of the victim's browser."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-11-18T19:05:58.819Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"ac11387e86f8fc52a6458c9518a66ffa0edb4449e452cfa582fd45be644ec73e","data_version":"5.2","first_seen_at":"2026-11-19T00:22:51Z","kind":"advisory","last_material_event_at":"2026-11-19T00:22:51Z","native_id":"CVE-2026-128666","provenance":[{"revision":"e85b93d205da98966c46a0515f6125b43290fef0","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-128666"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-11-18T00:00:00Z","record_encoding":{"expanded_bytes":2802,"expanded_sha256":"76a34e2b933d1a381dd4182d41827267391dd0ca62c351fecd6743c5649ff3ec","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-128666","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-11-18T19:05:58.819Z","orgId":"8254265b-2
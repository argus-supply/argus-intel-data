{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"1.73.1973146020"}],"product":"Hue Bridge","vendor":"Philips"}],"aliases":["CVE-2026-126977"],"assertions":[{"affected_indices":[0],"datePublic":"2026-11-13T20:15:54.266Z","descriptions":[{"lang":"en","value":"Philips Hue Bridge HomeKit Pair-Setup Default Password Authentication Bypass Vulnerability. This vulnerability allows network-adjacent attackers to bypass authentication on affected installations of Philips Hue Bridge. Authentication is not required to exploit this vulnerability.\n\nThe specific flaw exists within the HomeKit Authentication service, which listens on TCP port 8080 by default. Crafted data in a pairing request can cause the device to allow authentication using a blank password. An attacker can leverage this vulnerability to bypass authentication on the system. Was ZDI-CAN-28323."}],"metrics":[{"cvssV3_0":{"baseScore":8.1,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:A/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:N","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-1393","description":"CWE-1393: Use of Default Password","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-11-17T23:16:08.637Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"Philips Hue Bridge HomeKit Pair-Setup Default Password Authentication Bypass Vulnerability"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-126977","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-11-18T17:24:38.329674Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-11-18T17:24:57.930Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"pr
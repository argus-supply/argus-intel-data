{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"5.6.9","status":"affected","version":"0","versionType":"semver"}],"product":"Appointment Booking Plugin","vendor":"Unknown"}],"aliases":["CVE-2026-105196"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Appointment Booking Plugin  WordPress plugin before 5.6.9 does not enforce per-record authorization on several of its AI Abilities API actions, allowing an authenticated user holding the LatePoint Agent role, normally restricted to their own records, to read and modify other agents' profile data and read other agents' bookings and associated customer details when the Abilities API feature is enabled."}],"problemTypes":[{"descriptions":[{"description":"CWE-639 Authorization Bypass Through User-Controlled Key","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-08T06:00:07.084Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"LatePoint < 5.6.9 - Agent+ Cross-Agent Data Disclosure and Modification via Abilities API"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"a449134f4b7286eb331ca8f941fde905a3ea20789e8f6a60e0f4b7a5455a209e","data_version":"5.2","first_seen_at":"2026-10-08T06:04:35Z","kind":"advisory","last_material_event_at":"2026-10-08T06:04:35Z","native_id":"CVE-2026-105196","provenance":[{"revision":"868d0f1d16d2a11153299f7ce89f7fab4644fbf3","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-105196"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-08T06:00:07Z","record_encoding":{"expanded_bytes":2969,"expanded_sha256":"52947455567ade5fff3093e77f5298f07336f1ce5f627d34d2581a00eda2c2ef","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descri
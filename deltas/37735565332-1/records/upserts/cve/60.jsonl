{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"11.8","status":"affected","version":"0","versionType":"semver"}],"product":"Booking Calendar","vendor":"Unknown"}],"aliases":["CVE-2026-105193"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Booking Calendar WordPress plugin before 11.8 does not generate its per-booking access hashes with sufficient entropy, deriving each from a low-entropy time-seeded value, which can allow unauthenticated attackers who are able to determine a booking's creation time to predict the hash and then read that booking's personal data or modify the booking in place."}],"problemTypes":[{"descriptions":[{"description":"CWE-326 Inadequate Encryption Strength","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-08T06:00:06.554Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Booking Calendar < 11.8 - Unauthenticated Booking Information Disclosure and Modification via Predictable Booking Hash"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"4a09de54f07f51d066756f10d2e95d43532d59e35fac05460b3dc968173f98c7","data_version":"5.2","first_seen_at":"2026-10-08T06:04:35Z","kind":"advisory","last_material_event_at":"2026-10-08T06:04:35Z","native_id":"CVE-2026-105193","provenance":[{"revision":"868d0f1d16d2a11153299f7ce89f7fab4644fbf3","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-105193"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-08T06:00:06Z","record_encoding":{"expanded_bytes":2910,"expanded_sha256":"7755dec24d4379de2931b6720038af530e6b1201b5985ab34b557b8d26465308","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-105193","
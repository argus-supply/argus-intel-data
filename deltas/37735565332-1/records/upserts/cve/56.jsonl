{"affected":[{"defaultStatus":"unknown","modules":["Enhanced app test/livestats (test_config","get_stats)"],"original_ranges":[{"lessThanOrEqual":"2.8.3","status":"affected","version":"0","versionType":"semver"}],"product":"Heimdall","programFiles":["app/SupportedApps.php","app/Http/Controllers/ItemController.php"],"programRoutines":[{"name":"SupportedApps::execute"}],"repo":"https://github.com/linuxserver/Heimdall","vendor":"linuxserver"}],"aliases":["CVE-2026-107449"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"linuxserver Heimdall through 2.8.3 applies its SafeUrlFetcher SSRF protection mechanism only to ItemController; the enhanced-application test and live-stats requests occur via SupportedApps::execute(), a GuzzleHttp client that lacks IP address restrictions. In some realistic installations, the POST /test_config (and GET /get_stats) endpoints are accessible through CSRF, and thus an unauthenticated attacker can force the server to send requests to arbitrary internal hosts and ports (including 169.254.169.254) and read a status/port oracle in addition to partial response data."}],"metrics":[{"cvssV3_1":{"attackComplexity":"HIGH","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":3.4,"baseSeverity":"LOW","confidentialityImpact":"LOW","integrityImpact":"NONE","privilegesRequired":"NONE","scope":"CHANGED","userInteraction":"REQUIRED","vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:R/S:C/C:L/I:N/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-918","description":"CWE-918 Server-Side Request Forgery (SSRF)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-08T04:28:17.619Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":
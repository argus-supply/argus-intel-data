{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"5.6.5","status":"affected","version":"0","versionType":"semver"}],"product":"Appointment Booking Plugin","vendor":"Unknown"}],"aliases":["CVE-2026-105197"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Appointment Booking Plugin  WordPress plugin before 5.6.5 does not verify that a backend staff user is authorized to act on the specific record targeted for deletion, allowing an authenticated user with a record-scoped staff role to irreversibly delete any order, customer, or transaction on the site, including records belonging to other staff and outside their assigned scope."}],"problemTypes":[{"descriptions":[{"description":"CWE-639 Authorization Bypass Through User-Controlled Key","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-08T06:00:07.266Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"LatePoint < 5.6.5 - Agent+ Arbitrary Order, Customer and Transaction Deletion via IDOR"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"7361d4bde7121313e1c522873cd459ed4ef81ddae7750cb427ad57210c14b138","data_version":"5.2","first_seen_at":"2026-10-08T06:04:35Z","kind":"advisory","last_material_event_at":"2026-10-08T06:04:35Z","native_id":"CVE-2026-105197","provenance":[{"revision":"868d0f1d16d2a11153299f7ce89f7fab4644fbf3","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-105197"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-08T06:00:07Z","record_encoding":{"expanded_bytes":2913,"expanded_sha256":"c9ccca27741b49a9a50f4c000dded1993815a89e8ab8ebd0b94356b31eb12fe0","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CV
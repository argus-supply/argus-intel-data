{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.17.0","status":"affected","version":"0","versionType":"semver"}],"product":"Ultimate Multisite","vendor":"Unknown"}],"aliases":["CVE-2026-103646"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Ultimate Multisite  WordPress plugin before 2.17.0 does not require authentication before a logged-out checkout is linked to, and logged in as, an existing WordPress account matching the submitted email address, and its duplicate-account check normalizes that address differently from the lookup used to create the customer, so an unauthenticated attacker can log in as any existing user, including a Network Super Admin, whose email address they know.\nThis bypass is not addressed by the 2.15.1 fix for CVE-2026-75957 and remains exploitable in all versions up to and including 2.16.1, the releases that fix was expected to cover. Exploitation requires a checkout form configured without a password field (auto-generated password) and a target account that has no existing customer record in the Ultimate Multisite  WordPress plugin before 2.17.0."}],"problemTypes":[{"descriptions":[{"description":"CWE-287 Improper Authentication","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-08T06:00:05.353Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Ultimate Multisite < 2.17.0 - Unauthenticated Authentication Bypass via 'email_address' Parameter"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"7a400195d09bc996f8b7e1c52d86408f356d30b285b07916e69f0828f052d217","data_version":"5.2","first_seen_at":"2026-10-08T06:04:35Z","kind":"advisory","last_material_event_at":"2026-10-08T06:04:35Z","native_id":"CVE-2026-103646","provenance":[{"revision":"868d0f1d16d2a11153299f7ce89f7fab4644fbf3","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-103646"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-08T06:00:05Z","record_encoding":{"expanded_bytes":3845,"expanded_sha256":"cf82098e8823e67617bc5ad8873e18e6977a112d69ac26ef3a9ab1d01fbbbc64","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-103646","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-08T06:00:05.353Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"tags":["exploit","vdb-entry","technical-description"],"url":"https://wpscan.com/vulnerability/a05da0ad-5d92-406f-b182-b3ed1f8389f3/"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-08T06:00:05Z","status":"active","title":"Ultimate Multisite < 2.17.0 - Unauthenticated Authentication Bypass via 'email_address' Parameter"}

{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.26.2","status":"affected","version":"0","versionType":"semver"}],"product":"Unbound","vendor":"NLnet Labs"}],"aliases":["CVE-2026-96405"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-21T00:00:00.000Z","descriptions":[{"lang":"en","value":"NLnet Labs Unbound up to and including version 1.26.1 limits compression-pointer traversal for each individual domain-name operation but has no aggregate inbound decompression-work budget. Many chained compression pointers in a message results in a lot of CPU usage following them. A malicious actor with recursive-query access and control of an ordinarily delegated authority that serves specially crafted replies can exploit the vulnerability and degrade Unbound's general performance."}],"metrics":[{"cvssV3_1":{"baseScore":5.3,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:L","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-770","description":"CWE-770: Allocation of Resources Without Limits or Throttling","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-21T08:57:26.986Z","orgId":"206fc3a0-e175-490b-9eaa-a5738056c9f6","shortName":"NLnet Labs"},"role":"cna","title":"Aggregate DNS name chained pointer decompression work leads to degradation of service."}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"76e1fd2478b4752c7b34e26d5b6e2256f1a7b963267c32afddb45a18b23bb0fa","data_version":"5.2","first_seen_at":"2026-10-21T13:48:57Z","kind":"advisory","last_material_event_at":"2026-10-21T13:48:57Z","native_id":"CVE-2026-96405","provenance":[{"revision":"946cca1a5832d28d55fcb60feb1ac22c14e6753c","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-96405"},{"asser
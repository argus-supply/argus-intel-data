{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.26.2","status":"affected","version":"1.22.0","versionType":"semver"}],"product":"Unbound","vendor":"NLnet Labs"}],"aliases":["CVE-2026-97206"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-21T00:00:00.000Z","descriptions":[{"lang":"en","value":"NLnet Labs Unbound, 1.22.0 up to and including version 1.26.1, contains a DNS-over-QUIC (DoQ) lifetime bug reachable by a remote DoQ client under multi-threaded operation. A client-triggered QUIC path migration can enter stream/connection cleanup while a mesh reply still retains a pointer to the DoQ stream. Cleanup frees the DoQ stream and when the pending mesh reply later completes it dereferences a stale pointer leading to a crash."}],"metrics":[{"cvssV3_1":{"baseScore":7.5,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"compiled with DNS-over-QUIC support"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-416","description":"CWE-416: Use After Free","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-21T08:57:41.106Z","orgId":"206fc3a0-e175-490b-9eaa-a5738056c9f6","shortName":"NLnet Labs"},"role":"cna","title":"DNS-over-QUIC (DoQ) path-migration can lead to use-after-free on multi-threaded deployments."}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"74d30164974d364711f235b51fac51c1275c49551acceb8e1302f3a3790adfcc","data_version":"5.2","first_seen_at":"2026-10-21T13:48:57Z","kind":"advisory","last_material_event_at":"2026-10-21T13:48:57Z","native_id":"CVE-2026-97206","provenance":[{"revision":"946cca1a5832d28d55fcb60feb1ac22c14e6753c","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-97206"},{"assertion_index":0,"independent_evidence":true,"source_i
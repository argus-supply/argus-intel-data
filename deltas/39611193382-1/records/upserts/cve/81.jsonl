{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.7.31","status":"affected","version":"0","versionType":"semver"}],"product":"Booking Package","vendor":"Unknown"}],"aliases":["CVE-2026-105996"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Booking Package WordPress plugin before 1.7.31 does not generate booking cancellation tokens using a secure source of randomness, deriving them instead from values it exposes publicly, so an unauthenticated attacker can reconstruct an arbitrary booking's token, disclose that booking's personal data and, where visitor cancellation is enabled, cancel the booking."}],"problemTypes":[{"descriptions":[{"description":"CWE-326 Inadequate Encryption Strength","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-21T06:00:18.712Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Booking Package < 1.7.31 - Unauthenticated Booking PII Disclosure and Cancellation via Predictable Token"},{"affected_indices":[],"metrics":[{"cvssV3_1":{"attackComplexity":"HIGH","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":4.8,"baseSeverity":"MEDIUM","confidentialityImpact":"LOW","integrityImpact":"LOW","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:L/I:L/A:N","version":"3.1"}},{"other":{"content":{"id":"CVE-2026-105996","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-10-21T10:23:33.491475Z","version":"2.0.3"},"type":"ssvc"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-326","description":"CWE-326 Inadequate Encryption Strength","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-21T10:35:07.631Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier
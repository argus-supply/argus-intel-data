{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.26.2","status":"affected","version":"0","versionType":"semver"}],"product":"Unbound","vendor":"NLnet Labs"}],"aliases":["CVE-2026-50106"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-21T00:00:00.000Z","descriptions":[{"lang":"en","value":"When NLnet Labs Unbound up to and including version 1.26.1 is configured with both a root trust anchor and an additional 'trust-anchor:' for an island-of-security zone whose parent is provably insecure under the root chain, a malicious actor who can deliver one forged NXDOMAIN response for a name inside the island, with the NSEC/SOA RRSIG 'SignerName' set to the insecure parent, tricks Unbound's validator to use the root trust anchor instead, and consecutively the insecure parent, thus causing that record to be treated as insecure and denying existence for records in the trust island."}],"metrics":[{"cvssV3_1":{"baseScore":6.5,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:L/A:H","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-807","description":"CWE-807: Reliance on Untrusted Inputs in a Security Decision","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-21T08:57:11.040Z","orgId":"206fc3a0-e175-490b-9eaa-a5738056c9f6","shortName":"NLnet Labs"},"role":"cna","title":"Possible insecure NXDOMAIN for non-existing records under a configured island trust anchor underneath an insecure parent."}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"dcf81ac22a78477f9e86a7f2fc568705736ffbbb54654c755332ab3fddb1b6ba","data_version":"5.2","first_seen_at":"2026-10-21T13:48:57Z","kind":"advisory","last_material_event_at":"2026-10-21T13:48:57Z","native_id":"CVE-2026-50106","provenance":
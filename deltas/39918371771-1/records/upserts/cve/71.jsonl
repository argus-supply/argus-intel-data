{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"0.9.2.8","status":"affected","version":"0.8.9.4","versionType":"semver"}],"product":"Advanced Custom Fields: Extended","vendor":"Unknown"},{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"0.9.2.8","status":"affected","version":"0.8.9.4","versionType":"semver"}],"product":"Advanced Custom Fields: Extended PRO","vendor":"Unknown"}],"aliases":["CVE-2026-94264"],"assertions":[{"affected_indices":[0,1],"descriptions":[{"lang":"en","value":"The Advanced Custom Fields: Extended WordPress plugin before 0.9.2.8, Advanced Custom Fields: Extended PRO WordPress plugin before 0.9.2.8 does not validate or escape some of its form shortcode attributes, which can be pointed at values taken from the visitor's own request and are then output without escaping, allowing users with a role as low as contributor to have arbitrary script run in the browser of anyone led to open a crafted link or page, including a logged-in administrator.\nThis is an incomplete fix for CVE-2023-5292, whose deny-list covers only the three HTML wrapper attributes."}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Cross-Site Scripting (XSS)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-23T06:00:21.070Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Advanced Custom Fields: Extended 0.8.9.4 - 0.9.2.7 - Contributor+ XSS via Form Shortcode Attributes"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"f2095978f8f22e8fe5f8c1974403bf4ab70a72eb8a40ddca53ef49abaeeadcd6","data_version":"5.2","first_seen_at":"2026-10-23T07:32:35Z","kind":"advisory","last_material_event_at":"2026-10-23T07:32:35Z","native_id":"CVE-2026-94264","provenance":[{"revision":"16193240b1ff09ae5dcdf6a0fc1f726949225bce","source_id":"cve","ur
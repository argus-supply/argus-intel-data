{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"3.2.8","status":"affected","version":"3.1.1","versionType":"semver"}],"product":"Otter Blocks","vendor":"Unknown"}],"aliases":["CVE-2026-109934"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Otter Blocks  WordPress plugin before 3.2.8 does not correctly determine whether a post is publicly readable before returning its data through a REST API endpoint, treating any post with the published status as public, allowing unauthenticated users to read manual excerpts of password-protected posts, the content and titles of non-public post types, and, on WooCommerce sites, coupon codes and their descriptions."}],"problemTypes":[{"descriptions":[{"description":"CWE-200 Information Exposure","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-23T06:00:17.759Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Otter Blocks 3.1.1 - 3.2.7 - Unauthenticated Non-Public Content Disclosure via REST API"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"58f7f077f11b3d62f9c2283187b49947dcc2cf58029dcc70d677cd1c065df3f1","data_version":"5.2","first_seen_at":"2026-10-23T07:32:35Z","kind":"advisory","last_material_event_at":"2026-10-23T07:32:35Z","native_id":"CVE-2026-109934","provenance":[{"revision":"16193240b1ff09ae5dcdf6a0fc1f726949225bce","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-109934"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-23T06:00:17Z","record_encoding":{"expanded_bytes":2951,"expanded_sha256":"eca96aba39c066c7a0102827f41214cb65a8497ec9656472a79be539c9668071","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CV
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"7.9.2","status":"affected","version":"0","versionType":"semver"}],"product":"LiteSpeed Cache","vendor":"Unknown"}],"aliases":["CVE-2026-113500"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The LiteSpeed Cache WordPress plugin before 7.9.2 does not limit one of its HTML optimization routines to stylesheet content, so it can delete the markup that closes an attribute in the rendered page, and combined with unescaped comment author output this allows unauthenticated users whose comments are published to inject event-handler attributes that run JavaScript in the browser of any visitor, including a logged-in administrator, viewing front-end pages while the optimization is enabled."}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Cross-Site Scripting (XSS)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-23T06:00:20.249Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"LiteSpeed Cache < 7.9.2 - Unauthenticated Stored XSS via Font Display Optimization"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"2c1ea9dfe6be2bc0f52b0ef404fa65dfbd8cd06325ba0668cfc6c8e0e71d9334","data_version":"5.2","first_seen_at":"2026-10-23T07:32:35Z","kind":"advisory","last_material_event_at":"2026-10-23T07:32:35Z","native_id":"CVE-2026-113500","provenance":[{"revision":"16193240b1ff09ae5dcdf6a0fc1f726949225bce","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-113500"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-23T06:00:20Z","record_encoding":{"expanded_bytes":3097,"expanded_sha256":"6c8e6bb6d3cc91909881fabd10da360016e76bdfa7de007b7df11f343cf3c244","format":"cve-indexed-assertions-v1","top_descriptions_asser
{"affected":[{"original_ranges":[{"status":"affected","version":"0.60.8.2","versionType":"semver"}],"packageURL":"pkg:github/GNUAspell/aspell","product":"Aspell","vendor":"GNU"}],"aliases":["CVE-2026-103658"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"GNU Aspell 0.60.8.2 (first vulnerable version is not known) contains a heap-based buffer overflow write (CWE-122) in its read-only dictionary loader. String::reserve() in common/string.hpp computes its capacity check with a signed int ((int)s + 1), so a requested size of 0x7FFFFFFF wraps negative and the backing buffer is never grown. ReadOnlyDict::load() in modules/speller/default/readonly_ws.cpp passes the unvalidated 32-bit size fields from a .rws dictionary header into this path, so a crafted .rws file with a valid endian marker (12345678) and an oversized length field (e.g. lang_name_size = 0x7FFFFFFF) causes attacker-controlled data to be written out of bounds past an undersized heap allocation. An attacker who induces a victim to load a malicious dictionary — for example via aspell dump master <file> — can corrupt heap memory, resulting in denial of service and potentially code execution. Fixed in b830b6e and will be fixed in release 0.60.8.3."}],"metrics":[{"cvssV3_1":{"baseScore":5.9,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:L/AC:L/PR:N/UI:N/S:U/C:L/I:L/A:L","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-122","description":"CWE-122 Heap-based Buffer Overflow","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-12T22:12:10.457Z","orgId":"98a01053-8a31-4f6d-9aa9-252be161adc6","shortName":"Anthropic"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"5405a879aa271e4552cc47cc585806e52d162d5a772e25baebbcb9eca95eda4e","data_version":"5.2","first_seen_at":"2026-10-12T22:59:55Z","k
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"2.4.68","status":"affected","version":"2.4.0","versionType":"semver"}],"product":"Apache HTTP Server","vendor":"Apache Software Foundation"}],"aliases":["CVE-2026-63045"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","supportingMedia":[{"base64":false,"type":"text/html","value":"Improper validation of FTP PASV reply address in mod_proxy_ftp in Apache Software Foundation Apache HTTP Server through 2.4.68 on all platforms allows, in forward proxy configurations, an untrusted FTP server to cause the proxy to open a data connection to an arbitrary third-party host via a crafted PASV response.<br><br>Users are recommended to upgrade to version 2.4.69, which fixes this issue."}],"value":"Improper validation of FTP PASV reply address in mod_proxy_ftp in Apache Software Foundation Apache HTTP Server through 2.4.68 on all platforms allows, in forward proxy configurations, an untrusted FTP server to cause the proxy to open a data connection to an arbitrary third-party host via a crafted PASV response.\n\nUsers are recommended to upgrade to version 2.4.69, which fixes this issue."}],"metrics":[{"other":{"content":{"text":"low"},"type":"Textual description of severity"},"scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-284","description":"CWE-284 Improper Access Control","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-01T16:09:07.643Z","orgId":"f0158376-9dc2-43b6-827c-5f631a4d8d09","shortName":"apache"},"role":"cna","title":"Apache HTTP Server: mod_proxy_ftp PASV address handling"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"d0d987fc362b949b9e153331d16fb1da4d3ac8826b9e841a4900ef888c4822e7","data_version":"5.2","first_seen_at":"2026-10-01T17:02:52Z","kind":"advi
{"affected":[{"original_ranges":[{"lessThanOrEqual":"0.3.3","status":"affected","version":"0","versionType":"custom"}],"product":"decompress-zip","vendor":"Bower Decompress-Zip"}],"aliases":["CVE-2026-107709"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A path traversal vulnerability exists in Bower decompress-zip through version 0.3.3. The vulnerability located in `lib/decompress-zip.js` improperly validates archive entry paths during ZIP extraction. A crafted ZIP archive containing entries that resolve to prefix-sibling directories can cause files to be written outside the intended extraction directory. Successful exploitation may allow arbitrary file overwrite, application compromise, or remote code execution depending on the target environment and writable sibling paths."}],"problemTypes":[{"descriptions":[{"description":"CWE-22 Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')","lang":"en"}]}],"provider":{"dateUpdated":"2026-10-08T16:59:10.419Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"role":"cna","title":"Bower decompress-zip has a path traversal vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"bbc4662aba366a982fd89c3290376f754bda0a29227268df372089e41216492e","data_version":"5.2","first_seen_at":"2026-10-08T19:57:37Z","kind":"advisory","last_material_event_at":"2026-10-08T19:57:37Z","native_id":"CVE-2026-107709","provenance":[{"revision":"c5621eb2a6a79a273ee3a0e4c7ad7440884ed1db","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-107709"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-08T16:59:10Z","record_encoding":{"expanded_bytes":3296,"expanded_sha256":"9da3d8ac09a6790449a5210d94f0c40446150d0ed5bc2457ce6af7588a088ef0","format":"cve-indexed-
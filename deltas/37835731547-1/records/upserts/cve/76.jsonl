{"affected":[{"original_ranges":[{"lessThanOrEqual":"v0.5.20","status":"affected","version":"0","versionType":"custom"}],"product":"SGLang","vendor":"SGLang"}],"aliases":["CVE-2026-93034"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"SGLang contains an arbitrary code execution vulnerability caused by the ZMQ message decoder unconditionally deserializing PickleWrapper payloads via pickle.loads() in _maybe_unwrap_pickle without type allowlisting or authentication; this vulnerability persists via the msgpack path even when SGLANG_USE_PICKLE_IPC is disabled, and becomes remotely exploitable if data-parallel attention is enabled with a non-loopback --dist-init-addr setting."}],"problemTypes":[{"descriptions":[{"description":"CWE-502 Deserialization of Untrusted Data","lang":"en"}]}],"provider":{"dateUpdated":"2026-10-08T14:00:09.084Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"role":"cna","title":"CVE-2026-93034"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"95a937fab5568db661445531172c35f43fa785595d5638fb79500dda41eff24e","data_version":"5.2","first_seen_at":"2026-10-08T19:57:37Z","kind":"advisory","last_material_event_at":"2026-10-08T19:57:37Z","native_id":"CVE-2026-93034","provenance":[{"revision":"c5621eb2a6a79a273ee3a0e4c7ad7440884ed1db","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-93034"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-08T14:00:09Z","record_encoding":{"expanded_bytes":2973,"expanded_sha256":"772f5b279ebe9c825aac770f1c3c93b4040d79acc7ab90ad570dc37d46c11f87","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-93034","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026
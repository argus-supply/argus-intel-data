{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"6.27.7","status":"affected","version":"6.27.1","versionType":"semver"},{"lessThan":"7.6.1","status":"affected","version":"7.2.1","versionType":"semver"}],"product":"WarehousePG","repo":"https://github.com/warehouse-pg/warehouse-pg","vendor":"EnterpriseDB"}],"aliases":["CVE-2026-104948"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"WarehousePG (WHPG) 6.27.1 through 6.27.6 and 7.2.1 through 7.6.0 are affected by a missing authorization vulnerability (CWE-862) in the built-in cluster expansion functions gp_expand_lock_catalog() and gp_expand_bump_version(). Any authenticated database role can run them, and neither checks privileges. A low-privileged user can call gp_expand_lock_catalog() inside an open transaction to block all catalog changes across the cluster for every user, superusers included, until that transaction ends, which in practice requires a superuser to terminate the session. Blocked changes include DDL, temporary table creation, GRANT and CREATE ROLE. The same user can call gp_expand_bump_version() repeatedly. Each call disconnects sessions that hold temporary tables, with a FATAL error on their next catalog change, and makes every other session rebuild its segment connections."}],"metrics":[{"cvssV4_0":{"baseScore":7.1,"baseSeverity":"HIGH","vectorString":"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N","version":"4.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-862","description":"CWE-862 Missing Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-21T13:53:54.574Z","orgId":"20be33e2-bf35-4d13-8fad-18bd2f3e3659","shortName":"EDB"},"role":"cna"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-104948","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-10-30T18:02:32.684706Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-10-30T18:02:53.219Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"27ecef9be86814bbb4bb7c4f6d1a74ac46c9be9a50de69c16e832e0b43842c6f","data_version":"5.2","first_seen_at":"2026-10-21T18:39:58Z","kind":"advisory","last_material_event_at":"2026-10-30T19:22:40Z","native_id":"CVE-2026-104948","provenance":[{"revision":"04e90a1ef682a9ab5cace7e8a968e9bf6b3afdbd","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-104948"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"},{"assertion_index":1,"independent_evidence":false,"source_id":"cve"}],"published_at":"2026-10-21T13:53:54Z","record_encoding":{"expanded_bytes":4589,"expanded_sha256":"48beeb531baa632ef8d2916892057f7c089f87d65cf37dd1623e33169b3a04be","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-104948","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-21T13:53:54.574Z","orgId":"20be33e2-bf35-4d13-8fad-18bd2f3e3659","shortName":"EDB"},"url":"https://www.enterprisedb.com/docs/security/advisories/cve2026104948/"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-30T18:02:53Z","status":"active","title":"CVE-2026-104948"}

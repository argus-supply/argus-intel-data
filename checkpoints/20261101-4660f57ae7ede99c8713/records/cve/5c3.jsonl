{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.25.14.0000","status":"affected","version":"0","versionType":"semver"}],"platforms":["Windows"],"product":"WatchGuard Agent","vendor":"WatchGuard"}],"aliases":["CVE-2026-115253"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"An incorrect permission assignment vulnerability in the WatchGuard Agent's log directory allows a local, authenticated non-administrative user to create, modify, append to, or delete the agent's log files and write other files into the directory. This allows an attacker to tamper with or destroy the agent's security logs and stage further local attacks by placing executable content in a directory owned by a privileged service."}],"metrics":[{"cvssV4_0":{"baseScore":7.3,"baseSeverity":"HIGH","vectorString":"CVSS:4.0/AV:L/AC:L/AT:P/PR:L/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N","version":"4.0"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-276","description":"CWE-276","lang":"en","type":"CWE"},{"cweId":"CWE-732","description":"CWE-732","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-22T08:39:45.537Z","orgId":"5d1c2695-1a31-4499-88ae-e847036fd7e3","shortName":"WatchGuard"},"role":"cna","title":"WatchGuard Agent Incorrect Permission Assignment in Log Directory Allows Local Log Tampering"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-115253","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-10-22T00:00:00+00:00","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-10-23T03:55:18.131Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"6de347ac35081b5bc
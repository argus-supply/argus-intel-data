{"affected":[{"original_ranges":[{"lessThan":"1.6.0","status":"affected","version":"0","versionType":"custom"}],"product":"container","vendor":"Apple"},{"original_ranges":[{"lessThan":"0.52.1","status":"affected","version":"0","versionType":"custom"}],"product":"containerization","vendor":"Apple"}],"aliases":["CVE-2026-113957"],"assertions":[{"affected_indices":[0,1],"descriptions":[{"lang":"en","value":"An attacker who controls the registry, a mirror, or the network path to it may be able to serve arbitrary image content in response to a pull by digest, so that a user runs an image other than the one they pinned. The fix compares the returned digest to the pinned digest and fails the pull on a mismatch. Tag pulls are exempt, because a tag is mutable by design. The fix also verifies the hash of manifests and blobs when they are fetched. This vulnerability is addressed in container version 1.6.0 and containerization version 0.52.1."}],"problemTypes":[{"descriptions":[{"description":"An attacker who controls the registry, a mirror, or the network path to it may be able to serve arbitrary image content in response to a pull by digest, so that a user runs an image other than the one they pinned.","lang":"en"}]}],"provider":{"dateUpdated":"2026-10-29T00:01:44.984Z","orgId":"286789f9-fbc2-4510-9f9a-43facdede74c","shortName":"apple"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"8007fbe365b799f4c2045bbfc12a71fae2d5870df9657dbe83fa8bc15222366a","data_version":"5.2","first_seen_at":"2026-10-29T05:48:31Z","kind":"advisory","last_material_event_at":"2026-10-29T05:48:31Z","native_id":"CVE-2026-113957","provenance":[{"revision":"85e2ad7730fa91bfbdc5939b9070e9fcdf925fd2","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-113957"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}
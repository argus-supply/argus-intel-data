{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["MIME::Parser"],"original_ranges":[{"lessThan":"5.521","status":"affected","version":"0","versionType":"custom"}],"packageName":"MIME-tools","packageURL":"pkg:cpan/MIME-tools","programFiles":["lib/MIME/Parser.pm"],"programRoutines":[{"name":"MIME::Parser::init"},{"name":"MIME::Parser::process_part"}],"repo":"https://salsa.debian.org/dskoll/mime-tools"}],"aliases":["CVE-2026-116273"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"MIME::Parser versions before 5.521 for Perl set no limit on the number of message parts by default, allowing memory exhaustion.\n\nThe max_parts option defaulted to -1, which disables the limit, so a parser created with default settings builds an entity for every part however many a message has.\n\nVersion 5.521 sets max_parts to 1000 and max_depth to 64 by default. Setting either to -1 still removes the limit."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-1188","description":"CWE-1188 Initialization of a Resource with an Insecure Default","lang":"en","type":"CWE"}]},{"descriptions":[{"cweId":"CWE-770","description":"CWE-770 Allocation of Resources Without Limits or Throttling","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T17:34:44.660Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"MIME::Parser versions before 5.521 for Perl set no limit on the number of message parts by default, allowing memory exhaustion"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"e0c5f1c88323869e08b8798fa3212323ffe1da48eeab01043056f3b16bc59ee2","data_version":"5.2","first_seen_at":"2026-10-28T22:35:26Z","kind":"advisory","last_material_event_at":"2026-10-28T22:35:26Z","native_id":"CVE-2026-116273","provenance":[{"revisi
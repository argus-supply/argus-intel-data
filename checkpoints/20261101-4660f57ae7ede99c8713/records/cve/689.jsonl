{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"3.6.0","status":"affected","version":"0","versionType":"semver"}],"product":"BuddyBoss Platform","vendor":"Boss Media"}],"aliases":["CVE-2026-96554"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The BuddyBoss Platform plugin for WordPress is vulnerable to Stored Cross-Site Scripting via Group Name in all versions up to, and including, 3.6.0 due to insufficient input sanitization and output escaping. This makes it possible for authenticated attackers, with subscriber-level access and above, to inject arbitrary web scripts in pages that will execute whenever a user accesses an injected page. This requires the \"Enable social group creation by all members\" setting to be enabled, which is the default and permits Subscriber-level users to create groups; exploitation is not possible if group creation is restricted to administrators."}],"metrics":[{"cvssV3_1":{"baseScore":6.4,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:C/C:L/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-79","description":"CWE-79 Improper Neutralization of Input During Web Page Generation","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-31T09:29:26.095Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"BuddyBoss Platform <= 3.6.0 - Authenticated (Subscriber+) Stored Cross-Site Scripting via Group Name"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"d8d36568a11664437597a4ed4f1b256829d567044b5e1a1bddda53685b0e0e37","data_version":"5.2","first_seen_at":"2026-10-31T12:29:35Z","kind":"advisory","last_material_event_at":"2026-10-31T12:29:35Z","native_id":"CVE-2026-96554","provenance":[{"revision":"5915baaa1f77c90264ee1d4b1d7beb8b263
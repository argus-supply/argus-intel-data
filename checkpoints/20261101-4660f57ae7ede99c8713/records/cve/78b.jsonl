{"affected":[{"defaultStatus":"affected","original_ranges":[{"lessThan":"*","status":"unaffected","version":"0.15.3","versionType":"semver"}],"product":"Routinator","vendor":"NLnet Labs"}],"aliases":["CVE-2026-72752"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-26T00:00:00.000Z","descriptions":[{"lang":"en","value":"Routinator runs out of memory when the JSON output is requested many times concurrently. This condition can be triggered maliciously by an attacker by opening a large number of connections to the HTTP server. Additionally Routinator runs into a stack overflow and exits when a payload item with too much metadata is discarded at once.\n\nThis only affects users that make their HTTP or RTR server available to untrusted networks."}],"metrics":[{"cvssV3_1":{"baseScore":6.5,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:A/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-755","description":"CWE-755 Improper Handling of Exceptional Conditions","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-26T17:06:15.152Z","orgId":"206fc3a0-e175-490b-9eaa-a5738056c9f6","shortName":"NLnet Labs"},"role":"cna","title":"Routinator exits when requesting the output repeatedly"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-72752","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-10-26T17:47:18.784341Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-10-26T17:57:34.344Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"10b0cb9cbd76662d049335acfaf17f
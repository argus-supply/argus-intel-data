{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["HTTP::Body"],"original_ranges":[{"lessThan":"1.24_01","status":"affected","version":"0","versionType":"custom"}],"packageName":"HTTP-Body","packageURL":"pkg:cpan/HTTP-Body","programFiles":["lib/HTTP/Body.pm"],"programRoutines":[{"name":"HTTP::Body::add"}],"repo":"https://github.com/libwww-perl/HTTP-Body"}],"aliases":["CVE-2026-117501"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"HTTP::Body versions before 1.24_01 for Perl allow memory exhaustion via unbounded buffering of chunked request bodies.\n\nIn chunked mode, used when no content length is given, add() holds each chunk in memory until all of it has arrived. A line that is not a chunk-size line, a size line without CRLF, or a size too large to fit an integer leaves the parser waiting forever, and every later add() grows the buffer.\n\nA remote attacker can exhaust memory in applications that pass chunked request bodies to HTTP::Body."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-770","description":"CWE-770 Allocation of Resources Without Limits or Throttling","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T17:17:28.215Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"HTTP::Body versions before 1.24_01 for Perl allow memory exhaustion via unbounded buffering of chunked request bodies"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"2c523f53ed22f51148e673fb594f5309da3eaba779dcfb726261db237c3ecf31","data_version":"5.2","first_seen_at":"2026-10-28T22:35:26Z","kind":"advisory","last_material_event_at":"2026-10-28T22:35:26Z","native_id":"CVE-2026-117501","provenance":[{"revision":"c761a6804d91658ecbf21ef95ca5f8d12b5ef17c","source_id":"cve","url":"https://www.cve.org/CVE
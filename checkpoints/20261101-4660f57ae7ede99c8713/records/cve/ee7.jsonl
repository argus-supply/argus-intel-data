{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["CallBackery"],"original_ranges":[{"lessThan":"0.62.0","status":"affected","version":"0","versionType":"custom"}],"packageName":"CallBackery","packageURL":"pkg:cpan/CallBackery","programFiles":["lib/CallBackery/User.pm"],"programRoutines":[{"name":"CallBackery::User::cookieConf"}],"repo":"https://github.com/oetiker/callbackery"}],"aliases":["CVE-2026-118987"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"CallBackery versions before 0.62.0 for Perl accept session cookies of any age sent in the X-Session-Cookie header.\n\ncookieConf() rejects a cookie older than 300 seconds only when it arrives in the xsc query parameter. The same cookie sent in the X-Session-Cookie header is accepted however old it is.\n\nA session cookie that leaks through a log, a Referer header or browser history authenticates as its user indefinitely."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-1463","description":"CWE-1463 Insufficient Session Timeout Value","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-30T13:13:11.338Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"CallBackery versions before 0.62.0 for Perl accept session cookies of any age sent in the X-Session-Cookie header"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"8a2027dd338a8bedfaa4b1d5d4dfeed82dc79e79a07cbcfbeea8318cb7e39dcc","data_version":"5.2","first_seen_at":"2026-10-30T19:22:40Z","kind":"advisory","last_material_event_at":"2026-10-30T19:22:40Z","native_id":"CVE-2026-118987","provenance":[{"revision":"04e90a1ef682a9ab5cace7e8a968e9bf6b3afdbd","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-118987"},{"assertion_index":0,"independent_evidence":true,"source_id":"cv
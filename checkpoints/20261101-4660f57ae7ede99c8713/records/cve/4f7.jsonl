{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-51902"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"SuperAGI up to v0.0.14 contains an improper access control vulnerability. The agent controller endpoint /api/agents/get/project/{project_id} allows authenticated users from one organization to retrieve the complete list of agents belonging to a different organization's project. The endpoint accepts a project_id parameter but does not verify that the project belongs to the authenticated user's organization."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-10-29T18:07:12.279Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"8e78a34b6249cc4ead5144f7e30386efc827c6ed6cd2f7a273e08f68062b086f","data_version":"5.2","first_seen_at":"2026-10-29T19:38:40Z","kind":"advisory","last_material_event_at":"2026-10-29T19:38:40Z","native_id":"CVE-2026-51902","provenance":[{"revision":"420a4ed93f3dbc2b6b88a57c9b1feda3ad018699","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-51902"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-29T00:00:00Z","record_encoding":{"expanded_bytes":2792,"expanded_sha256":"92c8757b166fe8427fed93775fc5ffd70c30b237f48ad59e648309c7279f9dc6","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-51902","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-29T18:07:12.279Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"url":"https://github.com/TransformerOptimus/Supe
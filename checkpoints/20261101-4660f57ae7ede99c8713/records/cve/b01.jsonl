{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.26.1","status":"affected","version":"1.20.0","versionType":"semver"}],"product":"PgBouncer","vendor":"n/a"}],"aliases":["CVE-2026-107349"],"assertions":[{"affected_indices":[0],"configurations":[{"lang":"en","value":"ignore_startup_parameters is set to a non-empty value that does not contain options."}],"descriptions":[{"lang":"en","value":"An infinite loop in PgBouncer 1.20.0 through 1.26.0 allows an unauthenticated remote attacker to cause a denial of service. A StartupMessage whose options parameter contains an empty parameter name, such as \"-c=\", makes the ignore_startup_parameters list lookup loop forever. Because PgBouncer serves all clients from a single process, this saturates a CPU core and makes PgBouncer unresponsive to all clients until the process is restarted."}],"metrics":[{"cvssV3_1":{"baseScore":7.5,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","version":"3.1"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-835","description":"Loop with Unreachable Exit Condition ('Infinite Loop')","lang":"en","type":"CWE"}]},{"descriptions":[{"cweId":"CWE-400","description":"Uncontrolled Resource Consumption","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-14T17:34:33.785Z","orgId":"f86ef6dc-4d3a-42ad-8f28-e6d5547a5007","shortName":"PostgreSQL"},"role":"cna","title":"Infinite loop on empty option name in startup options parameter in PgBouncer"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-107349","options":[{"Exploitation":"none"},{"Automatable":"yes"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-10-16T20:19:04.558160Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-10-16T20:19:16.649Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"cl
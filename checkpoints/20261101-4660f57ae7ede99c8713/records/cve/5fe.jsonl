{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["CallBackery"],"original_ranges":[{"lessThan":"0.62.0","status":"affected","version":"0","versionType":"custom"}],"packageName":"CallBackery","packageURL":"pkg:cpan/CallBackery","programFiles":["lib/CallBackery/Config.pm"],"programRoutines":[{"name":"CallBackery::Config::secretFile"},{"name":"CallBackery::Config::reConfigure"}],"repo":"https://github.com/oetiker/callbackery"}],"aliases":["CVE-2026-118986"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"CallBackery versions before 0.62.0 for Perl allow session cookie forgery via a signing secret generated with rand().\n\nThe secret that signs session cookies is built from two calls to the built-in rand(), which is seeded with 32 bits. The secret therefore has at most 2**32 possible values, and one signed cookie is enough to test each candidate offline.\n\nAn attacker who obtains a single session cookie can recover the secret and sign cookies for any user, including an administrator."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-338","description":"CWE-338 Use of Cryptographically Weak Pseudo-Random Number Generator (PRNG)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-30T13:13:32.845Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"CallBackery versions before 0.62.0 for Perl allow session cookie forgery via a signing secret generated with rand()"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"8b6979b5c47679dee3cb38d57cd810d285ed7d70522c8dd19e5e76b00b7e429a","data_version":"5.2","first_seen_at":"2026-10-30T19:22:40Z","kind":"advisory","last_material_event_at":"2026-10-30T19:22:40Z","native_id":"CVE-2026-118986","provenance":[{"revision":"04e90a1ef682a9ab5cace7e8a968e9bf6b3afdbd","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-118986"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-30T13:13:32Z","record_encoding":{"expanded_bytes":3463,"expanded_sha256":"407d648f43b1298cffc38a8c25923693561302c9118e1fa53c69ea3e7292bdc4","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-118986","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-30T13:13:32.845Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"tags":["release-notes"],"url":"https://metacpan.org/release/OETIKER/CallBackery-0.62.0/changes"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-30T13:13:32Z","status":"active","title":"CallBackery versions before 0.62.0 for Perl allow session cookie forgery via a signing secret generated with rand()"}

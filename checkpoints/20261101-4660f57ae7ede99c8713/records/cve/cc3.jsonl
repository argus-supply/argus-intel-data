{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"7.0.000"}],"product":"iLX-F511","vendor":"Alpine"}],"aliases":["CVE-2026-118609"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-28T16:45:04.474Z","descriptions":[{"lang":"en","value":"Alpine iLX-F511 Android Auto Connection Handler Stack-based Buffer Overflow Remote Code Execution Vulnerability. This vulnerability allows physically present attackers to execute arbitrary code on affected installations of Alpine iLX-F511 devices. Authentication is not required to exploit this vulnerability.\n\nThe specific flaw exists within the Android Auto connection handler. The issue results from the lack of proper validation of the length of user-supplied data prior to copying it to a fixed-length stack-based buffer. An attacker can leverage this vulnerability to execute code in the context of root. Was ZDI-CAN-29016."}],"metrics":[{"cvssV3_0":{"baseScore":6.8,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.0/AV:P/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-121","description":"CWE-121: Stack-based Buffer Overflow","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T16:50:39.557Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"Alpine iLX-F511 Android Auto Connection Handler Stack-based Buffer Overflow Remote Code Execution Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"34b11fe4a6427f10687e1bbda3fa5af65007909f7bdad45ae4e5d0ff51017a36","data_version":"5.2","first_seen_at":"2026-10-28T22:35:26Z","kind":"advisory","last_material_event_at":"2026-10-28T22:35:26Z","native_id":"CVE-2026-118609","provenance":[{"revision":"c761a6804d91658ecbf21ef95ca5f8d12b5ef17c","source_id":"cve","url":"https:/
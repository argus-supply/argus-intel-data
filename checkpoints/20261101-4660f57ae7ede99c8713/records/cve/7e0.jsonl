{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.28.0","status":"affected","version":"2.17.5","versionType":"semver"}],"product":"Okta RADIUS Agent","vendor":"Okta"}],"aliases":["CVE-2026-78633"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Okta RADIUS Agent does not validate the sub-attribute length when parsing a Vendor-Specific attribute. A sub-attribute length of zero causes the parser to loop indefinitely, resulting in worker-thread exhaustion and denial of new RADIUS authentication requests."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"ADJACENT_NETWORK","availabilityImpact":"HIGH","baseScore":6.5,"baseSeverity":"MEDIUM","confidentialityImpact":"NONE","integrityImpact":"NONE","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:A/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-835","description":"Loop with Unreachable Exit Condition ('Infinite Loop')","lang":"en"}]}],"provider":{"dateUpdated":"2026-10-13T20:16:34.296Z","orgId":"59b22baa-87b2-4371-8e4a-e080df12f74a","shortName":"Okta"},"role":"cna","title":"Denial of Service in Okta RADIUS Agent Packet Parser"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-78633","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-10-16T15:26:09.166312Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-10-16T15:31:55.280Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"5e3977d3b3366b07bc137cd965c39d6230755a90d1983c79bf1ec213aeefd657","data_version":"5.2","firs
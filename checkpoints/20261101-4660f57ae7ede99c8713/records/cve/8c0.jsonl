{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["CallBackery"],"original_ranges":[{"lessThan":"0.62.0","status":"affected","version":"0","versionType":"custom"}],"packageName":"CallBackery","packageURL":"pkg:cpan/CallBackery","programFiles":["lib/CallBackery/User.pm","lib/CallBackery/GuiPlugin/UserForm.pm"],"programRoutines":[{"name":"CallBackery::User::login"},{"name":"CallBackery::GuiPlugin::UserForm::actionCfg"}],"repo":"https://github.com/oetiker/callbackery"}],"aliases":["CVE-2026-13576"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"CallBackery versions before 0.62.0 for Perl store user passwords as unsalted HMAC-SHA1 hashes.\n\nPasswords are hashed with hmac_sha1_sum() from Mojo::Util with no key, a single fast SHA-1 HMAC. There is no salt, so equal passwords give equal hashes, and no work factor slows down guessing.\n\nAn attacker who obtains the user table can recover passwords by fast offline guessing."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-916","description":"CWE-916 Use of Password Hash With Insufficient Computational Effort","lang":"en","type":"CWE"}]},{"descriptions":[{"cweId":"CWE-759","description":"CWE-759 Use of a One-Way Hash without a Salt","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-30T13:09:47.702Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"CallBackery versions before 0.62.0 for Perl store user passwords as unsalted HMAC-SHA1 hashes"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"ed65de34b623577bfe96175efdb89af3113d3aa4957b809bed0dec2d971208f8","data_version":"5.2","first_seen_at":"2026-10-30T19:22:40Z","kind":"advisory","last_material_event_at":"2026-10-30T19:22:40Z","native_id":"CVE-2026-13576","provenance":[{"revision":"04e90a1ef6
{"affected":[{"original_ranges":[{"status":"affected","version":"2.5.21"}],"product":"GnuPG","vendor":"GnuPG"}],"aliases":["CVE-2026-118131"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"GnuPG (version 2.5.21) for Windows contains a vulnerability where default Discretionary Access Control List (DACL) inheritance on the C:\\ProgramData directory allows members of the BUILTIN\\Users group to create arbitrary subdirectories under this path. An attacker with low-privilege access can create the expected GnuPG configuration directory and inject malicious configuration files consumed by GnuPG components. This can result in code execution within the security context of the victim user."}],"problemTypes":[{"descriptions":[{"description":"CWE-732 Incorrect Permission Assignment for Critical Resource","lang":"en"}]},{"descriptions":[{"description":"CWE-379 Creation of Temporary File in Directory with Insecure Permissions","lang":"en"}]},{"descriptions":[{"description":"CWE-427 Uncontrolled Search Path Element","lang":"en"}]}],"provider":{"dateUpdated":"2026-10-27T17:23:46.474Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"role":"cna","title":"CVE-2026-118131"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"09c3764fb92065639c5672804719f93fa513435f828d55179fc7ddc0f50195c8","data_version":"5.2","first_seen_at":"2026-10-27T20:42:10Z","kind":"advisory","last_material_event_at":"2026-10-27T20:42:10Z","native_id":"CVE-2026-118131","provenance":[{"revision":"fe646e3a61428f130dd99d859242ac93a77858df","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-118131"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-27T17:23:46Z","record_encoding":{"expanded_bytes":3107,"expanded_sha256":"b366834ccda658f16b41250717eddfa561b8cdd
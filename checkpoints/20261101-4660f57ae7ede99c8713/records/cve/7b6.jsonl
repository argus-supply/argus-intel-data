{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"6.8.8","status":"affected","version":"6.6.0","versionType":"semver"}],"product":"Essential Addons for Elementor","vendor":"Unknown"}],"aliases":["CVE-2026-110808"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Essential Addons for Elementor  WordPress plugin before 6.8.8 does not correctly restrict who may set the role assigned to accounts created through its registration form, allowing authenticated users with Author-level access and above to cause newly registered accounts, including those created by unauthenticated visitors through the public registration form, to be granted a higher role such as Editor.\nThis is an incomplete fix of CVE-2026-5193: the role-validation control added in 6.6.0 can be circumvented by a lower-privileged user, so versions 6.6.0 through 6.8.7 remain affected even on sites that are patched against that advisory."}],"problemTypes":[{"descriptions":[{"description":"CWE-269 Improper Privilege Management","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-31T06:00:21.608Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Essential Addons for Elementor 6.6.0 - 6.8.7 - Author+ Privilege Escalation via register_user_role"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"022125bebb0959ed2304f48cd8037d9b7a5d17791f39ebdb5a3bcbd0232b8adf","data_version":"5.2","first_seen_at":"2026-10-31T12:29:35Z","kind":"advisory","last_material_event_at":"2026-10-31T12:29:35Z","native_id":"CVE-2026-110808","provenance":[{"revision":"5915baaa1f77c90264ee1d4b1d7beb8b263e1836","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-110808"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-31T06:00:2
{"affected":[{"original_ranges":[{"status":"affected","version":"8.6"}],"product":"Red Hat Enterprise Linux","vendor":"n/a"}],"aliases":["CVE-2022-1665"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A set of pre-production kernel packages of Red Hat Enterprise Linux for IBM Power architecture can be booted by the grub in Secure Boot mode even though it shouldn't. These kernel builds don't have the secure boot lockdown patches applied to it and can bypass the secure boot validations, allowing the attacker to load another non-trusted code."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-1291","description":"CWE-1291","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2022-06-21T14:23:40.000Z","orgId":"53f830b8-0a3f-465b-8143-3b8a9948e749","shortName":"redhat"},"role":"cna"},{"affected_indices":[],"provider":{"dateUpdated":"2024-08-03T00:10:03.767Z","orgId":"af854a3a-2127-422b-91ae-364da2661108","shortName":"CVE"},"role":"adp","title":"CVE Program Container"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2022-1665","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-10-08T21:01:22.114121Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-10-08T21:03:29.939Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"c85d103f95d3e9de3eac75addb943fa02d7d53bb5095215453af415a59aeea84","data_version":"5.2","first_seen_at":"2026-10-09T00:23:39Z","kind":"advisory","last_material_event_at":"2026-10-09T00:23:39Z","native_id":"CVE-2022-1665","provenance":[{"revision":"d91c48725f6d24a3637b5933f4da0b014bb28ca1","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2
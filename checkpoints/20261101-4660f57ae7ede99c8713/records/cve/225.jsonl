{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"3.3.2","status":"affected","version":"0","versionType":"semver"}],"product":"WooCommerce Extra Product Options Pro","vendor":"ThemeHigh"}],"aliases":["CVE-2026-104926"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The WooCommerce Extra Product Options Pro plugin for WordPress is vulnerable to Reflected Cross-Site Scripting via the '<fieldname>_start / <fieldname>_end' parameter in all versions up to, and including, 3.3.2 due to insufficient input sanitization and output escaping. This makes it possible for unauthenticated attackers to inject arbitrary web scripts in pages that execute if they can successfully trick a user into performing an action such as clicking on a link. This vulnerability is only exploitable on product pages where a Date & Time Range Picker extra field is configured, though the required field name is visible in the product page source and requires no prior knowledge to discover."}],"metrics":[{"cvssV3_1":{"baseScore":6.1,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-79","description":"CWE-79 Improper Neutralization of Input During Web Page Generation","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-31T09:29:28.216Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"WooCommerce Extra Product Options Pro <= 3.3.2 - Reflected Cross-Site Scripting via '<fieldname>_start' / '<fieldname>_end' Parameter"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"043446e26fcdfb16eac8f7e6819bcd6cd4dd3002d04e0f262d2fa7693df49cb9","data_version":"5.2","first_seen_at":"2026-10-31T12:29:35Z","kind":"advisory","last_material_event_at":"2026-1
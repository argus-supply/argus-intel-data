{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"4.2.0","status":"affected","version":"4.0.0","versionType":"semver"}],"product":"Wheels","repo":"https://github.com/wheels-dev/wheels","vendor":"Wheels"}],"aliases":["CVE-2026-111446"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Wheels 4.0.0 through 4.1.2 exposes password-less development tools under /wheels/* to remote clients when enablePublicComponent=true, as it is by default in development. Before 4.1.2 these tools have no local-access restriction; in 4.1.2 the restriction trusts client-supplied headers without checking the connecting peer. Remote clients can obtain application settings, environment/datasource details and routes, and start test runs. Where application tests use the primary datasource, those runs can write to the real application database. The separately protected migrator and CLI endpoints are not affected. This is fixed in 4.2.0."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"LOW","baseScore":8.6,"baseSeverity":"HIGH","confidentialityImpact":"HIGH","integrityImpact":"LOW","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:L/A:L","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-863","description":"CWE-863 Incorrect Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-16T03:37:32.158Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-111446","options":[{"Exploitation":"none"},{"Automatable":"yes"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-10-16T16:20:35.733304Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-10-16T16:20:50.474Z","orgId":"134c704f-9b21-4f2e
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"7.4","status":"affected","version":"0","versionType":"custom"}],"product":"Guardicore Platform Agent","vendor":"Akamai"}],"aliases":["CVE-2026-50218"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Akamai GPA (Guardicore Platform Agent) client on all platforms before 7.4 improperly validates JWT tokens used for seeding. By convincing a user to interact with a malicious link, an attacker can use a spoofed JWT token to inject arbitrary parameters into the client software, resulting in unauthorized reconfiguration and full compromise of the application's functionality. This attack can also be targeted against an already seeded client if the attacker knows the URL of the IDP that the client used for enrollment."}],"metrics":[{"cvssV3_1":{"baseScore":8.5,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:H/PR:L/UI:N/S:C/C:H/I:H/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-99","description":"CWE-99 Improper Control of Resource Identifiers ('Resource Injection')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-14T05:21:46.208Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-50218","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-10-19T18:39:58.222757Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-10-19T18:43:01.530Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"a1291b7d9f62a3a06954b10e15e886d3e5c276c57889d1bb15043e4ae82bbc76","data_version":"5.2","fir
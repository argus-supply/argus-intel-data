{"affected":[],"aliases":["CVE-2026-16487"],"assertions":[{"affected_indices":[],"provider":{"dateUpdated":"2026-10-21T06:20:13.903Z","orgId":"53f830b8-0a3f-465b-8143-3b8a9948e749","shortName":"redhat"},"rejectedReasons":[{"lang":"en","value":"Red Hat Product Security has determined that this is not a vulnerability in bootc or containers-common. bootc fetches images under /etc/containers/policy.json. The shipped default is insecureAcceptAnything for registries without an explicit signature requirement; registry.redhat.io and registry.access.redhat.com require signatures. Updating a mutable tag requires the ability to publish to the reference an administrator has already configured the host to follow. Requiring signatures is available through that policy and through bootc enforce-container-sigpolicy, which is off by default. Persistence of /var across bootc rollback is expected image-mode behavior."}],"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"686d6dbf5c41573dd939d3f893fb0777281b168bc83794672f675bb191ffbb24","data_version":"5.2","first_seen_at":"2026-10-19T13:15:36Z","kind":"advisory","last_material_event_at":"2026-10-21T07:40:14Z","native_id":"CVE-2026-16487","provenance":[{"revision":"61fdd4b530c4f075c3ae7296fd9a9a97088f2086","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-16487"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-19T05:27:30Z","record_encoding":{"expanded_bytes":2606,"expanded_sha256":"d83bd556ec9cad2953ea75e8cfaf0716779d739d447c27c4de502fea27809d63","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"rejectedReasons"},"record_id":"cve/CVE-2026-16487","references":[],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-21T06:20:13Z","status":"rejected
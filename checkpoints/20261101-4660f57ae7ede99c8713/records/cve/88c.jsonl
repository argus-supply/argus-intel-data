{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-36698"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Xovis AG APS-R-POE, APS-R-POE-PP, APS-R, APS-R-POE-USB, and APS-B 2.10.1.1 and earlier contains an OS command injection vulnerability in /sbin/ImportParamSet.sh. The script processes symlinks from uploaded parameter archive files and embeds the symlink target path into a shell command without quoting or sanitization. The command is executed as root via APC_SendMsg IPC."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-10-26T14:24:32.040Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"7ce404c8daae3a48619e51f97f6362b43aff93ee083299c945e7025c1650c2ad","data_version":"5.2","first_seen_at":"2026-10-26T15:12:15Z","kind":"advisory","last_material_event_at":"2026-10-26T15:12:15Z","native_id":"CVE-2026-36698","provenance":[{"revision":"f5902483f5ce9cf87b66595e0677fc7c90961047","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-36698"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-26T00:00:00Z","record_encoding":{"expanded_bytes":2703,"expanded_sha256":"a8c09ebcd0d7cc312687d87cd19006cae728aa47b019ac2662b22f5708afd3cf","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-36698","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-26T14:24:32.040Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"url":"http://xovis.com"},{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-26
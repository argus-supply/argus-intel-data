{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["Starlet"],"original_ranges":[{"lessThan":"0.33","status":"affected","version":"0","versionType":"custom"}],"packageName":"Starlet","packageURL":"pkg:cpan/Starlet","programFiles":["lib/Starlet/Server.pm"],"programRoutines":[{"name":"Starlet::Server::handle_connection"}],"repo":"https://github.com/kazuho/Starlet"}],"aliases":["CVE-2026-115865"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Starlet versions before 0.33 for Perl allow a request declaring a large Content-Length to kill a worker by exhausting memory.\n\nThe request body is read in a loop that asks sysread for all of the remaining declared length at once. Perl grows the read buffer to that size before any data arrives, so a length larger than available memory makes the worker exit with an uncatchable out of memory error before the application is called.\n\nA remote attacker can force a worker restart with each request of a few bytes."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-789","description":"CWE-789 Memory Allocation with Excessive Size Value","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-30T12:44:06.034Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"Starlet versions before 0.33 for Perl allow a request declaring a large Content-Length to kill a worker by exhausting memory"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"25fb9a0ed4ea319d3f13c4128225395c4803a56d71c1d9357ceb4a15ebff5808","data_version":"5.2","first_seen_at":"2026-10-30T12:56:09Z","kind":"advisory","last_material_event_at":"2026-10-30T12:56:09Z","native_id":"CVE-2026-115865","provenance":[{"revision":"cb14bf1b43b0c9f05f7f40eae2246263fd430780","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-115865"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-30T12:44:06Z","record_encoding":{"expanded_bytes":3701,"expanded_sha256":"37c6d2e3873abc615714fee792f69dacfbf1e40bf1aa3abba3184072be3257c8","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-115865","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-30T12:44:06.034Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"tags":["patch"],"url":"https://github.com/kazuho/Starlet/commit/598947ac620fd31b390335c683d79fa244770782.patch"},{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-30T12:44:06.034Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"tags":["release-notes"],"url":"https://metacpan.org/release/KAZUHO/Starlet-0.33/changes"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-30T12:44:06Z","status":"active","title":"Starlet versions before 0.33 for Perl allow a request declaring a large Content-Length to kill a worker by exhausting memory"}

{"affected":[{"collectionURL":"https://wordpress.org/plugins","defaultStatus":"unknown","original_ranges":[{"lessThanOrEqual":"1.2.1","status":"affected","version":"1.0.1","versionType":"semver"}],"product":"TiendaCrypto para WooCommerce","vendor":"Unknown"}],"aliases":["CVE-2026-103325"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The TiendaCrypto para WooCommerce WordPress plugin through 1.2.1 does not correctly verify the authenticity of its payment webhook, validating the request signature against a key that is always empty, which allows unauthenticated attackers to forge webhook notifications and mark arbitrary WooCommerce orders as paid on web servers that preserve request header case."}],"metrics":[{"cvssV3_1":{"baseScore":3.7,"baseSeverity":"LOW","vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"description":"CWE-347 Improper Verification of Cryptographic Signature","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-27T06:42:43.940Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"TiendaCrypto para WooCommerce 1.0.1 - 1.2.1 - Unauthenticated Order Payment Forgery via Webhook HMAC Bypass"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-103325","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-10-28T17:36:03.670890Z","version":"2.0.3"},"type":"ssvc"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-347","description":"CWE-347 Improper Verification of Cryptographic Signature","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T17:36:08.352Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product
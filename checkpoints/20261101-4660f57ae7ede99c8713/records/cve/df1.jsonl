{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"1.7.2","status":"affected","version":"0","versionType":"semver"}],"product":"Aurora Heatmap","vendor":"r3098"}],"aliases":["CVE-2026-94154"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Aurora Heatmap plugin for WordPress is vulnerable to Stored Cross-Site Scripting via the ‘url’ parameter in all versions up to, and including, 1.7.2 due to insufficient input sanitization and output escaping. This makes it possible for unauthenticated attackers to inject arbitrary web scripts in pages that will execute whenever an admin user clicks the injected heatmap link."}],"metrics":[{"cvssV3_1":{"baseScore":6.1,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-79","description":"CWE-79 Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-07T23:27:11.916Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"Aurora Heatmap <= 1.7.2 - Unauthenticated Stored Cross-Site Scripting via 'url' Parameter"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-94154","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-10-08T14:25:28.550606Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-10-08T14:25:35.533Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"7330681e0bfa9c81317de66610c17fc06df8136e53230a96372d547d142f51dc","data_version":"5.2","first_seen_at"
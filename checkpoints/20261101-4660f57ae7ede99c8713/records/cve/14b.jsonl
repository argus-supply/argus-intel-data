{"affected":[{"original_ranges":[{"status":"affected","version":"5.51.0"}],"product":"Strapi Open Source and Enterprise Headless CMS","vendor":"Strapi"}],"aliases":["CVE-2026-118172"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The strapi/strapi (Core Admin / Webhook Runner) package is vulnerable to a semi-blind SSRF via a webhook follow-redirect. The webhook dispatcher automatically follows HTTP redirects without performing post-redirect IP resolution or RFC1918/link-local boundary checks. Non-2xx responses from target endpoints are captured and reflected directly back to the caller."}],"problemTypes":[{"descriptions":[{"description":"CWE-918 Server-Side Request Forgery (SSRF)","lang":"en"}]}],"provider":{"dateUpdated":"2026-10-27T18:04:13.270Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"role":"cna","title":"CVE-2026-118172"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"b537105e7c7e26b5b8b70cb2f3beac7a35fcf1923eacfc00b755ea69e29ce5a9","data_version":"5.2","first_seen_at":"2026-10-27T20:42:10Z","kind":"advisory","last_material_event_at":"2026-10-27T20:42:10Z","native_id":"CVE-2026-118172","provenance":[{"revision":"fe646e3a61428f130dd99d859242ac93a77858df","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-118172"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-27T18:04:13Z","record_encoding":{"expanded_bytes":2591,"expanded_sha256":"843c03f1821a6b7513d4b9aa85b88a9728492c19f6520f76fb076ec0a8ec8fd7","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-118172","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-27T18:04:13.270Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName"
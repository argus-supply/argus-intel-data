{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["MIME::Head"],"original_ranges":[{"lessThan":"5.521","status":"affected","version":"5.518","versionType":"custom"}],"packageName":"MIME-tools","packageURL":"pkg:cpan/MIME-tools","programFiles":["lib/MIME/Head.pm","lib/MIME/Field/ParamVal.pm"],"programRoutines":[{"name":"MIME::Head::multipart_boundary"},{"name":"MIME::Field::ParamVal::parse_params"}],"repo":"https://salsa.debian.org/dskoll/mime-tools"}],"aliases":["CVE-2026-116266"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"MIME::Head versions from 5.518 before 5.521 for Perl decode a partly encoded multipart boundary without flagging the parse as ambiguous.\n\nThe multipart_boundary() method decodes RFC 2047 encoded words anywhere in the boundary, but the ambiguity check only fires when the whole value is one encoded word. A boundary such as abc=?us-ascii?Q?def?= is used as abcdef, and ambiguous_content() returns false.\n\nEncoded words are not allowed in parameters, so other mail readers split the message on the literal value. A remote sender can hide an attachment from a filter that relies on ambiguous_content() while the recipient's mail client shows it."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-436","description":"CWE-436 Interpretation Conflict","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T17:32:28.565Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"MIME::Head versions from 5.518 before 5.521 for Perl decode a partly encoded multipart boundary without flagging the parse as ambiguous"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"92e30985f6ea1acd5ace7a4a5be6e40ed0eabc5b1bc83c68576242f3872a8e4f","data_version":"5.2","first_seen_at":"2026-10-28T22:35:26Z",
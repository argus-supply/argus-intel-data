{"affected":[{"original_ranges":[{"lessThanOrEqual":"2.6.0","status":"affected","version":"0","versionType":"custom"}],"product":"Thelia","vendor":"Thelia"}],"aliases":["CVE-2026-103528"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Thelia 2.6.0 uses Smarty for email templates without properly restricting access to dangerous PHP functions. An authenticated administrator can inject malicious Smarty expressions into email templates via the messages configuration interface, and when the template is previewed or rendered, functions such as system(), exec(), file_put_contents(), and file_get_contents() can be executed with the privileges of the web process. This allows arbitrary OS command execution, file read/write operations, and RCE on the underlying server."}],"problemTypes":[{"descriptions":[{"description":"CWE-1336 Improper Neutralization of Special Elements Used in a Template Engine","lang":"en"}]}],"provider":{"dateUpdated":"2026-10-12T14:55:14.883Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"role":"cna","title":"CVE-2026-103528"},{"affected_indices":[],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":5.4,"baseSeverity":"MEDIUM","confidentialityImpact":"LOW","integrityImpact":"LOW","privilegesRequired":"LOW","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:L/I:L/A:N","version":"3.1"}},{"other":{"content":{"id":"CVE-2026-103528","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-10-15T17:00:27.510535Z","version":"2.0.3"},"type":"ssvc"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-1336","description":"CWE-1336 Improper Neutralization of Special Elements Used in a Template Engine","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-15T17:00:30.807Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortNa
{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"7.0.000"}],"product":"iLX-F511","vendor":"Alpine"}],"aliases":["CVE-2026-118602"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-28T16:44:29.002Z","descriptions":[{"lang":"en","value":"Alpine iLX-F511 Fiv.System Exposed Dangerous Method Local Privilege Escalation Vulnerability. This vulnerability allows local attackers to escalate privileges on affected installations of Alpine iLX-F511. An attacker must first obtain the ability to execute low-privileged code on the target system in order to exploit this vulnerability.\n\nThe specific flaw exists within the Fiv service. The issue results from an exposed dangerous method. An attacker can leverage this vulnerability to escalate privileges and execute arbitrary code in the context of root. Was ZDI-CAN-29095."}],"metrics":[{"cvssV3_0":{"baseScore":7.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-749","description":"CWE-749: Exposed Dangerous Method or Function","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T16:50:03.229Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"Alpine iLX-F511 Fiv.System Exposed Dangerous Method Local Privilege Escalation Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"39bf75e3ace676c1e050b5a61a37ffbc35d6cfb3d791bc96a3ecf6c00b8b33d7","data_version":"5.2","first_seen_at":"2026-10-28T22:35:26Z","kind":"advisory","last_material_event_at":"2026-10-28T22:35:26Z","native_id":"CVE-2026-118602","provenance":[{"revision":"c761a6804d91658ecbf21ef95ca5f8d12b5ef17c","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-118602"},{"assertion_index":0
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"0.7.0","status":"affected","version":"0.3.0","versionType":"semver"}],"product":"mcp-k6","vendor":"Grafana"}],"aliases":["CVE-2026-89039"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-05T14:40:00.000Z","descriptions":[{"lang":"en","value":"A caller who can invoke the convert_playwright_script prompt in mcp-k6 can pass a bare file path as the playwright_script argument and receive the contents of any file readable by the user running the server, including SSH keys and cloud credentials in that user's home directory (path traversal). The working-directory restriction applied to '@'-prefixed paths can also be bypassed with a symbolic link inside the working directory that points outside it."}],"metrics":[{"cvssV3_1":{"baseScore":6.5,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:N/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-22","description":"CWE-22","lang":"en","type":"CWE"}]},{"descriptions":[{"cweId":"CWE-424","description":"CWE-424","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-05T19:36:42.166Z","orgId":"57da9224-a3e2-4646-9d0e-c4dc2e05e7da","shortName":"GRAFANA"},"role":"cna","title":"Arbitrary file read via the convert_playwright_script prompt in mcp-k6"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-89039","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-10-05T15:14:33.272676Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-10-05T15:16:20.045Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"8627a4e8562d82
{"affected":[{"collectionURL":"https://wordpress.org/plugins","defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.0.2","status":"affected","version":"0","versionType":"semver"}],"product":"Smart Popup by Supsystic","vendor":"Unknown"}],"aliases":["CVE-2026-115223"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Smart Popup by Supsystic WordPress plugin before 2.0.2 does not prevent template-injection payloads from being stored in a popup text block and later evaluated by its template engine, because the filter meant to strip template delimiters runs before a decoding step that reconstructs them, allowing an authenticated administrator to execute arbitrary template expressions server-side and read PHP constants such as the site's database credentials and authentication keys."}],"metrics":[{"cvssV3_1":{"baseScore":4.9,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:U/C:H/I:N/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"description":"CWE-1336 Improper Neutralization of Special Elements Used in a Template Engine","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T10:45:14.251Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Smart Popup by Supsystic < 2.0.2 - Admin+ SSTI via Popup Text Block"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-115223","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-10-28T17:36:42.808153Z","version":"2.0.3"},"type":"ssvc"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-1336","description":"CWE-1336 Improper Neutralization of Special Elements Used in a Template Engine","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T17:47:59.351Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":nu
{"affected":[{"original_ranges":[{"lessThan":"1.5.0","status":"affected","version":"0","versionType":"custom"}],"product":"Container","vendor":"Apple"}],"aliases":["CVE-2026-113951"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"If an attacker can write to the filesystem of a container k8s cluster container, they can plant an exec credential plugin in /etc/kubernetes/admin.conf. kubectl will run that plugin as the macOS host user the next time someone pulls the cluster's kubeconfig onto the host with container k8s write-config or create and then runs kubectl against it — turning filesystem access inside an untrusted Linux container into arbitrary command execution on the host. This vulnerability is addressed in Container version 1.5.0."}],"problemTypes":[{"descriptions":[{"description":"If an attacker can write to the filesystem of a container k8s cluster container, they can plant an exec credential plugin in /etc/kubernetes/admin.conf. kubectl will run that plugin as the macOS host user the next time someone pulls the cluster's kubeconfig onto the host with container k8s write-config or create and then runs kubectl against it — turning filesystem access inside an untrusted Linux container into arbitrary command execution on the host.","lang":"en"}]}],"provider":{"dateUpdated":"2026-10-23T20:57:20.150Z","orgId":"286789f9-fbc2-4510-9f9a-43facdede74c","shortName":"apple"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"460ed0ee27f4d87a0a72c028ac41757c615d58dca9e04b67be34e6d3425a3d1d","data_version":"5.2","first_seen_at":"2026-10-23T23:09:12Z","kind":"advisory","last_material_event_at":"2026-10-23T23:09:12Z","native_id":"CVE-2026-113951","provenance":[{"revision":"c21430318b4b48252dd6ba344df26d60e6354f12","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-11
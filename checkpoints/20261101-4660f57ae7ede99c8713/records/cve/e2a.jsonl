{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["WebDyne"],"original_ranges":[{"lessThan":"3.022","status":"affected","version":"3.007","versionType":"custom"}],"packageName":"WebDyne","packageURL":"pkg:cpan/WebDyne","programFiles":["lib/WebDyne/PSGI.pm"],"programRoutines":[{"name":"WebDyne::PSGI::api_filename"}],"repo":"https://github.com/aspeer/WebDyne"}],"aliases":["CVE-2026-78189"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"WebDyne versions from 3.007 before 3.022 for Perl execute .psp files outside the document root via path traversal in the PSGI API route fallback.\n\nWhen a request matches no file, the PSGI handler retries it as an API route through api_filename. That keeps .. segments in the request path and only checks that the joined path starts with the document root, which a request for /../private passes.\n\nA remote attacker can run the embedded Perl in any .psp file the server can read, such as one uploaded to a directory outside the document root."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-22","description":"CWE-22 Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-31T14:33:55.211Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"WebDyne versions from 3.007 before 3.022 for Perl execute .psp files outside the document root via path traversal in the PSGI API route fallback"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"3ee11b177dbe8f5ca04abc7f7accdef0ecf2acd30edf5c0f5f35344e0123a7ec","data_version":"5.2","first_seen_at":"2026-10-31T18:34:27Z","kind":"advisory","last_material_event_at":"2026-10-31T18:34:27Z","native_id":"CVE-2026-78189","provenance":[{"revision":"5fbb02b0e112
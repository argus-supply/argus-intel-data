{"affected":[{"original_ranges":[{"status":"affected","version":"2.16.1"}],"product":"NextChat","vendor":"NextChat"}],"aliases":["CVE-2026-118132"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"NextChat version 2.16.1 contains a client‑side cross‑site scripting (XSS) vulnerability in the Plugin Editor due to unsafe rendering of externally supplied OpenAPI plugin schema content. When a plugin schema is loaded from a remote URL, the returned content is stored in plugin.content and later rendered using React’s dangerouslySetInnerHTML without proper sanitization. An attacker can host a malicious OpenAPI schema containing HTML or JavaScript markup and trick a user into loading it through the Plugin Editor, resulting in arbitrary JavaScript execution in the NextChat origin. Successful exploitation allows access to JavaScript‑readable cookies and other client‑side data associated with the NextChat application."}],"problemTypes":[{"descriptions":[{"description":"CWE-79 Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')","lang":"en"}]}],"provider":{"dateUpdated":"2026-10-27T17:38:13.552Z","orgId":"37e5125f-f79b-445b-8fad-9564f167944b","shortName":"certcc"},"role":"cna","title":"CVE-2026-118132"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"0c6ec06eec04bc8fcdbe255bead78806ad221916675560b010dd891943264fcd","data_version":"5.2","first_seen_at":"2026-10-27T20:42:10Z","kind":"advisory","last_material_event_at":"2026-10-27T20:42:10Z","native_id":"CVE-2026-118132","provenance":[{"revision":"fe646e3a61428f130dd99d859242ac93a77858df","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-118132"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-27T17:38:13Z","record_encoding":{"expanded_bytes":3327,"expanded_sh
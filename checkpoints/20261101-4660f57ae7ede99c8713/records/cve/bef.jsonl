{"affected":[{"defaultStatus":"unknown","modules":["bhyve"],"original_ranges":[{"lessThan":"p5","status":"affected","version":"15.1-RELEASE","versionType":"release"},{"lessThan":"p2","status":"affected","version":"14.5-RELEASE","versionType":"release"},{"lessThan":"p11","status":"affected","version":"14.4-RELEASE","versionType":"release"}],"product":"FreeBSD","vendor":"FreeBSD"}],"aliases":["CVE-2026-101309"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-14T18:45:00.000Z","descriptions":[{"lang":"en","value":"The xHCI (USB 3) device model did not validate or save the event ring size provided by the guest.  The size was re-read from guest memory on each use, and Transfer Request Block (TRB) fields were loaded without protection against concurrent modification by the guest.  This race condition could be triggered by a guest running malicious, privileged code.\n\nA malicious guest can crash the bhyve process or potentially execute arbitrary code in the host userspace context running the virtual machine, subject to bhyve's Capsicum sandbox."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-362","description":"CWE-362: Concurrent Execution using Shared Resource with Improper Synchronization ('Race Condition')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-15T07:17:50.453Z","orgId":"63664ac6-956c-4cba-a5d0-f46076e16109","shortName":"freebsd"},"role":"cna","title":"Multiple vulnerabilities in bhyve device models"},{"affected_indices":[],"metrics":[{"cvssV3_1":{"attackComplexity":"HIGH","attackVector":"LOCAL","availabilityImpact":"HIGH","baseScore":7,"baseSeverity":"HIGH","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"LOW","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:L/AC:H/PR:L/UI:N/S:U/C:H/I:H/A:H","version":"3.1"}},{"other":{"content":{"id":"CVE-2026-101309","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"
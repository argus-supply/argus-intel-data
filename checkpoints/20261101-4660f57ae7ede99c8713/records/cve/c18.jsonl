{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["CallBackery"],"original_ranges":[{"lessThan":"0.62.0","status":"affected","version":"0","versionType":"custom"}],"packageName":"CallBackery","packageURL":"pkg:cpan/CallBackery","programFiles":["lib/CallBackery/User.pm"],"programRoutines":[{"name":"CallBackery::User::login"}],"repo":"https://github.com/oetiker/callbackery"}],"aliases":["CVE-2026-118994"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"CallBackery versions before 0.62.0 for Perl allow log injection via newlines in the login name.\n\nlogin() writes the login name to the application log without escaping control characters. The login RPC method needs no authentication, so a name containing a newline followed by text in the log record format adds a forged record.\n\nAn unauthenticated attacker can forge log records, such as a successful administrator login from an address of their choosing."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-117","description":"CWE-117 Improper Output Neutralization for Logs","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-30T13:10:57.452Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"CallBackery versions before 0.62.0 for Perl allow log injection via newlines in the login name"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"78453432e0a2888e2c323cdb0358e8d0802a653fcbd6f87081610f8afaa2753d","data_version":"5.2","first_seen_at":"2026-10-30T19:22:40Z","kind":"advisory","last_material_event_at":"2026-10-30T19:22:40Z","native_id":"CVE-2026-118994","provenance":[{"revision":"04e90a1ef682a9ab5cace7e8a968e9bf6b3afdbd","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-118994"},{"assertion_index":0,"independent_evidence":true,"
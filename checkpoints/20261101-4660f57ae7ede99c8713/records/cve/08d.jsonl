{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"7.0.000"}],"product":"iLX-F511","vendor":"Alpine"}],"aliases":["CVE-2026-118607"],"assertions":[{"affected_indices":[0],"datePublic":"2026-10-28T16:44:53.937Z","descriptions":[{"lang":"en","value":"Alpine iLX-F511 diagapp Command Injection Vulnerability. This vulnerability allows physically present attackers to execute arbitrary code on affected installations of Alpine iLX-F511 devices. Authentication is not required to exploit this vulnerability.\n\nThe specific flaw exists within the diagapp component. The issue results from the lack of proper validation of a user-supplied string before using it to execute a system call. An attacker can leverage this vulnerability to execute code in the context of root. Was ZDI-CAN-28750."}],"metrics":[{"cvssV3_0":{"baseScore":6.8,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.0/AV:P/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-78","description":"CWE-78: Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T16:50:30.502Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"Alpine iLX-F511 diagapp Command Injection Vulnerability"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"b15a1550b6b12d26bead1ba9f519238b21c6e842319cb22c50fc6fbb106fa79a","data_version":"5.2","first_seen_at":"2026-10-28T22:35:26Z","kind":"advisory","last_material_event_at":"2026-10-28T22:35:26Z","native_id":"CVE-2026-118607","provenance":[{"revision":"c761a6804d91658ecbf21ef95ca5f8d12b5ef17c","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-118607"},{"assertion_index":0,"independent_evidence":tru
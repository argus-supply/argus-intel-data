{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"2.0.0","status":"affected","version":"0.8.1","versionType":"semver"}],"product":"Tables","vendor":"Nextcloud"}],"aliases":["CVE-2026-82983"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Tables app's share-listing endpoint (GET /apps/tables/share/table/{tableId}) did not verify that the requesting user has manage-level permission on the table before returning the full list of share recipients (users, groups, and teams) along with their permission levels. A user who was only granted read-data access to a table, and who is correctly prevented from seeing this information in the web UI, could call the endpoint directly to enumerate everyone the table is shared with and their access levels.\n\nThis does not expose the table's data itself beyond what the read-data grant already permits, only the list of share recipients and their permission levels."}],"metrics":[{"cvssV3_0":{"baseScore":3.3,"baseSeverity":"LOW","vectorString":"CVSS:3.0/AV:L/AC:L/PR:L/UI:N/S:U/C:L/I:N/A:N","version":"3.0"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-200","description":"CWE-200 Information Disclosure","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-27T16:15:34.683Z","orgId":"36234546-b8fa-4601-9d6f-f4e334aa8ea1","shortName":"hackerone"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"399a115b80609ff39c9016caf94252e151e0201638591e189cd02b93a0a50210","data_version":"5.2","first_seen_at":"2026-10-27T20:42:10Z","kind":"advisory","last_material_event_at":"2026-10-27T20:42:10Z","native_id":"CVE-2026-82983","provenance":[{"revision":"fe646e3a61428f130dd99d859242ac93a77858df","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-82983"},{"assertion_index":0,"independent_evidence":true
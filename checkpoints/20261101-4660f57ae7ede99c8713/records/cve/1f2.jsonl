{"affected":[{"collectionURL":"https://cpan.org/modules","defaultStatus":"unaffected","modules":["MIME::Field::ParamVal"],"original_ranges":[{"lessThan":"5.521","status":"affected","version":"0","versionType":"custom"}],"packageName":"MIME-tools","packageURL":"pkg:cpan/MIME-tools","programFiles":["lib/MIME/Field/ParamVal.pm"],"programRoutines":[{"name":"MIME::Field::ParamVal::parse_params"}],"repo":"https://salsa.debian.org/dskoll/mime-tools"}],"aliases":["CVE-2026-116265"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"MIME::Field::ParamVal versions before 5.521 for Perl do not flag an ambiguous multipart boundary written as RFC 2231 continuations.\n\nThe boundary ambiguity checks look only at a plain boundary= parameter, and a boundary split into RFC 2231 sections (boundary*0=, boundary*1= and so on) is joined after they have run. A repeated section number is concatenated rather than reported as a duplicate. From version 5.518, an encoded word or trailing whitespace in such a boundary also goes unflagged, although multipart_boundary() decodes or strips it.\n\nA remote sender can make MIME::Parser split a message on a different boundary than other mail readers, hiding an attachment from a filter that relies on ambiguous_content() while the recipient's mail client shows it."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-436","description":"CWE-436 Interpretation Conflict","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-28T17:32:11.827Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"role":"cna","title":"MIME::Field::ParamVal versions before 5.521 for Perl do not flag an ambiguous multipart boundary written as RFC 2231 continuations"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"fca45c32f463a1986b5a5798ccccc1a5d6f8d5c6919625bd86f2a62754448db8","data_version":"5.2","first_seen_at":"2026-10-28T22:35:26Z","kind":"advisory","last_material_event_at":"2026-10-28T22:35:26Z","native_id":"CVE-2026-116265","provenance":[{"revision":"c761a6804d91658ecbf21ef95ca5f8d12b5ef17c","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-116265"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-10-28T17:32:11Z","record_encoding":{"expanded_bytes":3978,"expanded_sha256":"a95aafd1f1fd7213573199d74dec84884d6f1d523fcb26da8c4ea090c47db8ee","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-116265","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-10-28T17:32:11.827Z","orgId":"9b29abf9-4ab0-4765-b253-1875cd9b441e","shortName":"CPANSec"},"tags":["release-notes"],"url":"https://metacpan.org/release/DSKOLL/MIME-tools-5.521/changes"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-10-28T17:32:11Z","status":"active","title":"MIME::Field::ParamVal versions before 5.521 for Perl do not flag an ambiguous multipart boundary written as RFC 2231 continuations"}
{"affected":[{"defaultStatus":"affected","original_ranges":[{"status":"affected","version":"01.07.20","versionType":"custom"}],"platforms":["BMC"],"product":"MBD-X12SPI","vendor":"SMCI"}],"aliases":["CVE-2026-18451"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","supportingMedia":[{"base64":false,"type":"text/html","value":"The HTML5 KVM-over-IP console authenticates with a token returned by the web interface. Weaknesses in token generation may allow an attacker to guess the session token and take control of the KVM session."}],"value":"The HTML5 KVM-over-IP console authenticates with a token returned by the web interface. Weaknesses in token generation may allow an attacker to guess the session token and take control of the KVM session."}],"metrics":[{"cvssV3_1":{"attackComplexity":"HIGH","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":3.1,"baseSeverity":"LOW","confidentialityImpact":"LOW","integrityImpact":"NONE","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"REQUIRED","vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:R/S:U/C:L/I:N/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-337","description":"CWE-337: Predictable Seed in a Pseudo-Random Number Generator (PRNG)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-10-27T07:51:10.336Z","orgId":"def9a96e-e099-41a9-bfac-30fd4f82c411","shortName":"Supermicro"},"role":"cna","title":"Supermicro BMC's iKVM feature is vulnerable to KVM session hijacking due to a predictable time-seeded launch token"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"923635bb9ab8799171adb8072ea2f0c6577562a9d31d075e45f60772e1668f96","data_version":"5.2","first_seen_at":"2026-10-27T14:32:13Z","kind":"advisory","last_material_event_at":"2026-10-2
{"affected":[{"original_ranges":[{"lessThanOrEqual":"3.8.2","status":"affected","version":"0","versionType":"custom"}],"product":"Prefect","vendor":"PrefectHQ"}],"aliases":["CVE-2026-72538"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"An argument injection vulnerability in PrefectHQ Prefect through 3.8.2 allows authenticated users to achieve remote code execution via the git_clone pull step branch field. The branch parameter is passed directly to git pull without sanitization, enabling injection of arbitrary git arguments. This represents a distinct code path from the incomplete fix applied for CVE-2026-5366 and allows command execution on the Prefect server."}],"metrics":[{"cvssV3_1":{"baseScore":8.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-88","description":"CWE-88: Argument Injection","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-08-11T11:07:35.410Z","orgId":"309f9ea4-e3e9-4c6c-b79d-e8eb01244f2c","shortName":"TuranSec"},"role":"cna","title":"PrefectHQ Prefect - Argument Injection"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-72538","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-08-11T12:38:06.639285Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-08-11T12:38:17.275Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"23fb96da716d16dc49b2b0a45621fd2a15a53488e8df1cd011944d58d046b105","data_version":"5.2","first_seen_at":"2026-09-10T17:06:28Z","kind":"advisory
{"affected":[{"defaultStatus":"unknown","modules":["ktimer"],"original_ranges":[{"lessThan":"p2","status":"affected","version":"15.1-RELEASE","versionType":"release"},{"lessThan":"p12","status":"affected","version":"15.0-RELEASE","versionType":"release"}],"product":"FreeBSD","vendor":"FreeBSD"}],"aliases":["CVE-2026-58084"],"assertions":[{"affected_indices":[0],"datePublic":"2026-07-29T22:40:00.000Z","descriptions":[{"lang":"en","value":"To retrieve the previous timer value, the kernel calls realtimer_gettime(), which obtains the current time for the timer's clock.  For a timer using CLOCK_TAI this can fail when no TAI offset has been configured, but the error return was not checked, so the uninitialized output buffer was copied to userspace.\n\nAn unprivileged local user can obtain uninitialized kernel stack memory by creating a POSIX timer with CLOCK_TAI and calling timer_settime(2), potentially disclosing sensitive kernel data."}],"problemTypes":[{"descriptions":[{"cweId":"CWE-908","description":"CWE-908: Use of Uninitialized Resource","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-08-19T07:31:42.001Z","orgId":"63664ac6-956c-4cba-a5d0-f46076e16109","shortName":"freebsd"},"role":"cna","title":"Kernel stack disclosure via timer_settime(2)"},{"affected_indices":[],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"LOCAL","availabilityImpact":"NONE","baseScore":5.5,"baseSeverity":"MEDIUM","confidentialityImpact":"HIGH","integrityImpact":"NONE","privilegesRequired":"LOW","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:N/A:N","version":"3.1"}},{"other":{"content":{"id":"CVE-2026-58084","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-08-26T19:45:49.244510Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-08-26T19:46:10.266Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-
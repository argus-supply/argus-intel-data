{"affected":[{"original_ranges":[{"lessThanOrEqual":"2026-07-10","status":"affected","version":"0","versionType":"custom"}],"product":"Handesk","vendor":"BadChoice"}],"aliases":["CVE-2026-72563"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A broken access control vulnerability in BadChoice Handesk as of 2026-07-10 allows any authenticated agent to overwrite lead records belonging to other teams via the LeadsController@update endpoint. The endpoint performs no authorization check, and the Lead model has guarded set to an empty array making all columns mass-assignable. An attacker with any agent account can corrupt lead data across team boundaries."}],"metrics":[{"cvssV3_1":{"baseScore":8.1,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-284","description":"CWE-284: Improper Access Control","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-08-11T11:13:15.327Z","orgId":"309f9ea4-e3e9-4c6c-b79d-e8eb01244f2c","shortName":"TuranSec"},"role":"cna","title":"BadChoice Handesk - Broken Access Control"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-72563","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-08-11T12:16:57.768328Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-08-11T12:17:06.149Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"93485be9e7acc95f874b7f47335f446a8593a6f2f3178ff3de2cd4ba7e34d116","data_version":"5.2","first_seen_at":"2026-09-10T17:06:28Z","kind":"advisory","
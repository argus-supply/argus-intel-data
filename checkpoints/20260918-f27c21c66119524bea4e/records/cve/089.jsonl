{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-25826"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"An issue was discovered in Keyfactor SignServer before 7.6.0. The attribute ATTRIBUTESFILE in PKCS11CryptoToken can be set to a readable file but not an accepted file (i.e., recognized with attributes). In this case, an error is thrown which - together with the error - also prints the content of the file to the application server log. This gives a user that has both SignServer admin access and access to read the output of the server log (i.e., if remote syslog shipping is configured), the possibility to read the content of files accessible by the local user JBoss."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-09-15T14:17:33.691Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"f54f1a76e06463741920c4753353501d2e8247050f9badeb4f8ef60326b49757","data_version":"5.2","first_seen_at":"2026-09-15T16:57:40Z","kind":"advisory","last_material_event_at":"2026-09-15T16:57:40Z","native_id":"CVE-2026-25826","provenance":[{"revision":"bc10268344f07a6ab0fa1ee4e3836e7a62597bd4","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-25826"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-15T00:00:00Z","record_encoding":{"expanded_bytes":3162,"expanded_sha256":"60a0fe4584c269fb13922be48e147417adfe0915e95fe7b546c1693c7e578f8c","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-25826","references":[{"assertion_role":"cna","provider
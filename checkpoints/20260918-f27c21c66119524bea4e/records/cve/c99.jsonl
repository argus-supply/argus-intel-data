{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.0.15","status":"affected","version":"0","versionType":"semver"}],"product":"FluentBoards","vendor":"Unknown"}],"aliases":["CVE-2026-89328"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The FluentBoards  WordPress plugin before 2.0.15 does not properly verify that a user holds board-manager privileges before performing several board-management operations, checking only board membership. This allows any member of a board to carry out manager-only actions on it, including adding or removing members and enabling public access to a private board."}],"problemTypes":[{"descriptions":[{"description":"CWE-284 Improper Access Control","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-16T06:00:17.895Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"FluentBoards < 2.0.15 - Board Member+ Board Membership and Public Access Modification"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"09a21ff323fffabbac84dbc45d2ab802f8d5452d7799dfdbdaf60c0088d6bff7","data_version":"5.2","first_seen_at":"2026-09-16T07:40:51Z","kind":"advisory","last_material_event_at":"2026-09-16T07:40:51Z","native_id":"CVE-2026-89328","provenance":[{"revision":"d1e0d8ab6cab86c1e3795edf282b95f943b7fd97","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-89328"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-16T06:00:17Z","record_encoding":{"expanded_bytes":2829,"expanded_sha256":"1c4865575afb54a5800863d48b8c7a04083a937438a0dca2266bea9e7853c06a","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-89328","references":[{"assertion_role":"cna","provider"
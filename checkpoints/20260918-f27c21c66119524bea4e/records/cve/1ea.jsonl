{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"7.2.0"}],"product":"Fabric.js","vendor":"Fabric.js"}],"aliases":["CVE-2026-19504"],"assertions":[{"affected_indices":[0],"datePublic":"2026-08-24T21:14:49.712Z","descriptions":[{"lang":"en","value":"Fabric.js loadFromJSON Server-Side Request Forgery Vulnerability. This vulnerability allows remote attackers to disclose sensitive information on affected installations of Fabric.js. Interaction with this library is required to exploit this vulnerability but attack vectors may vary depending on the implementation.\n\nThe specific flaw exists within the implementation of the loadFromJSON method. The issue results from the lack of proper validation of a URI prior to accessing resources. An attacker may be able to leverage this vulnerability to gain improper access to network resources. Was ZDI-CAN-29318."}],"metrics":[{"cvssV3_0":{"baseScore":4,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.0/AV:L/AC:H/PR:N/UI:N/S:U/C:L/I:L/A:N","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-918","description":"CWE-918: Server-Side Request Forgery (SSRF)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-15T18:00:46.945Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"Fabric.js loadFromJSON Server-Side Request Forgery Vulnerability"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-19504","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-09-15T19:19:55.606453Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-09-15T19:20:06.949Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null
{"affected":[{"defaultStatus":"affected","original_ranges":[{"lessThan":"*","status":"unaffected","version":"2.580","versionType":"maven"},{"lessThan":"2.447","status":"unaffected","version":"0","versionType":"maven"},{"lessThan":"2.568.*","status":"unaffected","version":"2.568.3","versionType":"maven"}],"product":"Jenkins","vendor":"Jenkins Project"}],"aliases":["CVE-2026-84649"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"In Stapler 1839.ved17667b_a_eb_5 through 2107.v8dfcb_e8ed317 (both inclusive), except 2088.2093.vd7c3e58008a_6, included in Jenkins 2.447 through 2.579 (both inclusive), LTS 2.452.1 through 2.568.2 (both inclusive), an HTTP endpoint serving dynamically generated JavaScript resources embeds the user's cross-site request forgery (CSRF) token (crumb) as a string literal, allowing attackers with control over a page hosted on the same site as Jenkins to obtain a valid crumb for the targeted user's session and perform actions on their behalf."}],"provider":{"dateUpdated":"2026-09-02T16:00:58.760Z","orgId":"39769cd5-e6e2-4dc8-927e-97b3aa056f5b","shortName":"jenkins"},"role":"cna"},{"affected_indices":[],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"HIGH","baseScore":8.8,"baseSeverity":"HIGH","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"REQUIRED","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H","version":"3.1"}},{"other":{"content":{"id":"CVE-2026-84649","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-09-02T17:38:27.819685Z","version":"2.0.3"},"type":"ssvc"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-352","description":"CWE-352 Cross-Site Request Forgery (CSRF)","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-02T17:38:30.836Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortNam
{"affected":[{"original_ranges":[{"lessThanOrEqual":"ba6e217","status":"affected","version":"0","versionType":"custom"}],"product":"Peppermint","vendor":"Peppermint Lab"}],"aliases":["CVE-2026-72555"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A broken access control vulnerability in Peppermint Lab Peppermint through commit ba6e217 exists because the Config.roles_active flag defaults to false, causing all permission checks on ticket, client, and user handlers to behave as no-ops on default installations. All authenticated users bypass ownership and administrative access controls. An attacker with any user account can read, modify, or delete tickets, clients, and users belonging to any other account."}],"metrics":[{"cvssV3_1":{"baseScore":8.1,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-284","description":"CWE-284: Improper Access Control","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-08-11T11:11:27.080Z","orgId":"309f9ea4-e3e9-4c6c-b79d-e8eb01244f2c","shortName":"TuranSec"},"role":"cna","title":"Peppermint Lab Peppermint - Broken Access Control"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-72555","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-08-11T15:17:32.749641Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-08-11T15:17:45.232Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"8f60e64425ac1defc5c088fae7adc8966d2b729b7c71e7c74de984e9fd93d555","data_version":"
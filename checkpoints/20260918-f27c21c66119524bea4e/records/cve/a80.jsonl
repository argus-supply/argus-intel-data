{"affected":[{"original_ranges":[{"lessThanOrEqual":"6.18.alpha1","status":"affected","version":"0","versionType":"custom"}],"product":"CiviCRM","vendor":"CiviCRM"}],"aliases":["CVE-2026-72558"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"An SQL injection vulnerability in CiviCRM through 6.18.alpha1 allows authenticated staff to read the entire database via the contact search RLIKE clause. The clause concatenates a user-supplied value into the SQL query without sanitization. An attacker with staff-level access can exfiltrate all database contents including donor and member records."}],"metrics":[{"cvssV3_1":{"baseScore":8.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-89","description":"CWE-89: SQL Injection","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-08-11T11:12:15.097Z","orgId":"309f9ea4-e3e9-4c6c-b79d-e8eb01244f2c","shortName":"TuranSec"},"role":"cna","title":"CiviCRM CiviCRM - SQL Injection"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-72558","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-08-11T12:22:37.122582Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-08-11T12:23:07.453Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"a2983b0b5c5493063634f0df4a73a5984e1d9f05ec0ddf31b06557908cc6333a","data_version":"5.2","first_seen_at":"2026-09-10T17:06:28Z","kind":"advisory","last_material_event_at":"2026-09-10T17:06:28Z","native_id":"CVE-2026-72558","provenance"
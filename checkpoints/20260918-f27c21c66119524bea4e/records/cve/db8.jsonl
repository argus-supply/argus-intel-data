{"affected":[{"original_ranges":[{"lessThanOrEqual":"3.0.0","status":"affected","version":"0","versionType":"custom"}],"product":"Swing Music","vendor":"Swing Music"}],"aliases":["CVE-2026-72605"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A missing authentication vulnerability in Swing Music 3.0.0 allows unauthenticated remote attackers to create arbitrary user accounts via the POST /auth/profile/create endpoint. The endpoint is allowlisted from JWT verification, permitting unauthenticated account creation. An attacker can register an account and use it to access protected functionality on the server."}],"metrics":[{"cvssV3_1":{"baseScore":7.5,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:H/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-306","description":"CWE-306: Missing Authentication for Critical Function","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-08-11T11:15:37.721Z","orgId":"309f9ea4-e3e9-4c6c-b79d-e8eb01244f2c","shortName":"TuranSec"},"role":"cna","title":"Swing Music Swing Music - Missing Authentication"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-72605","options":[{"Exploitation":"none"},{"Automatable":"yes"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-08-11T12:11:19.340516Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-08-11T12:11:27.558Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"fc87f12d9c80e2cfac512128be6d738f51410ba1b94e032576fc469bb13843a3","data_version":"5.2","first_seen_at":"2026-09-10T17:06:28Z","kind":"advisory","last_material
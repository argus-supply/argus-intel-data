{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.5.0p10","status":"affected","version":"2.5.0","versionType":"semver"}],"product":"Checkmk","vendor":"Checkmk GmbH"}],"aliases":["CVE-2026-15576"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Improper authentication in the agent receiver of Checkmk <2.5.0p10 allows an unauthenticated remote attacker to bypass mutual TLS client certificate verification of relay endpoints by supplying a fixed placeholder identity in the request URL, resulting in limited impact on integrity and availability. Only the Cloud, Ultimate and Ultimate MT editions are affected, as other editions do not expose relay endpoints."}],"metrics":[{"cvssV4_0":{"baseScore":6.9,"baseSeverity":"MEDIUM","vectorString":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:L/VA:L/SC:N/SI:N/SA:N","version":"4.0"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-306","description":"CWE-306: Missing Authentication for Critical Function","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-08-21T11:10:00.856Z","orgId":"f7d6281c-4801-44ce-ace2-493291dedb0f","shortName":"Checkmk"},"role":"cna","title":"Agent receiver accepts mTLS requests without a client certificate"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-15576","options":[{"Exploitation":"none"},{"Automatable":"yes"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-08-21T11:53:35.618102Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-08-21T11:53:45.355Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"b88adb5e41bf625c0a6fd42eaa8eb5bfbbd1d550325629f92ac2ee3eb92cbb50","data_version":"5.2","first_seen_at":"2026-09-
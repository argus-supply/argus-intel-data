{"affected":[{"original_ranges":[{"lessThanOrEqual":"46dfdd1","status":"affected","version":"0","versionType":"custom"}],"product":"Chaskiq","vendor":"Chaskiq"}],"aliases":["CVE-2026-72536"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A missing authentication vulnerability in Chaskiq through commit 46dfdd1 allows unauthenticated remote attackers to manipulate any tenant Stripe subscription via the stripeCreateIntent GraphQL mutation. The mutation lacks authentication and authorization checks, exposing Stripe payment intent creation to unauthenticated callers. An attacker can create payment intents and alter billing for any tenant without credentials."}],"metrics":[{"cvssV3_1":{"baseScore":8.2,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:L/I:H/A:L","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-306","description":"CWE-306: Missing Authentication for Critical Function","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-08-11T11:07:07.035Z","orgId":"309f9ea4-e3e9-4c6c-b79d-e8eb01244f2c","shortName":"TuranSec"},"role":"cna","title":"Chaskiq Chaskiq - Missing Authentication"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-72536","options":[{"Exploitation":"none"},{"Automatable":"yes"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-08-11T12:41:25.782257Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-08-11T12:41:57.693Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"b9db8fdfcea5864a7a67fb07cbc28fa7d88407fe374bda196efa28360c7995ee","data_version":"5.2","first_seen_at":"2026-09-10T17:
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"3.9.33","status":"affected","version":"0","versionType":"semver"}],"product":"WP Import Export Lite","vendor":"Unknown"}],"aliases":["CVE-2026-76555"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The WP Import Export Lite WordPress plugin before 3.9.33 does not validate a user-supplied file path before reading it and copying it into a publicly accessible directory, allowing any user whose role an administrator has granted the WP Import Export Lite WordPress plugin before 3.9.33's import permission to disclose sensitive files from the server, including files located outside the web root. The same code path also relaxes the file-system permissions of any path it is given, whether or not the copy succeeds."}],"problemTypes":[{"descriptions":[{"description":"CWE-22 Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-16T06:00:11.083Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"WP Import Export Lite < 3.9.33 - Authenticated Sensitive File Disclosure via Existing File Import Path Traversal"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"808fbc918e7bd5a866fd3622b7891b087dde884ba5b651d84b200659ea2d3d46","data_version":"5.2","first_seen_at":"2026-09-16T07:40:51Z","kind":"advisory","last_material_event_at":"2026-09-16T07:40:51Z","native_id":"CVE-2026-76555","provenance":[{"revision":"d1e0d8ab6cab86c1e3795edf282b95f943b7fd97","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-76555"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-16T06:00:11Z","record_encoding":{"expanded_bytes":3254,"expanded_sha256":"147a2a534758aa1f053
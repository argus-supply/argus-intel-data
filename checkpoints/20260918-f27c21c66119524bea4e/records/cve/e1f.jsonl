{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"4.1.24","status":"affected","version":"4.1.5","versionType":"semver"}],"product":"Eventin","vendor":"Unknown"}],"aliases":["CVE-2026-84907"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Eventin  WordPress plugin before 4.1.24 does not properly authorise order finalisation when its offline (local) payment method is enabled, relying on a nonce that is exposed to unauthenticated visitors and never checking that the caller owns the order, allowing unauthenticated attackers to reset any existing order and its attendees to a pending state and thereby invalidate paid tickets."}],"problemTypes":[{"descriptions":[{"description":"CWE-862 Missing Authorization","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-16T06:00:13.789Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Eventin < 4.1.24 - Unauthenticated Order and Attendee Status Reset via Payment REST Endpoint"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"2edbd081bf50b4128a797e9907b04c8eccb04f717f12b2a388c7109ba1b0f555","data_version":"5.2","first_seen_at":"2026-09-16T07:40:51Z","kind":"advisory","last_material_event_at":"2026-09-16T07:40:51Z","native_id":"CVE-2026-84907","provenance":[{"revision":"d1e0d8ab6cab86c1e3795edf282b95f943b7fd97","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-84907"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-16T06:00:13Z","record_encoding":{"expanded_bytes":2902,"expanded_sha256":"fd826a35c21bb5d457d2b13bcc5b99dbc6d5d4662ddd168dc455a2005eae9e46","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-84907","references":
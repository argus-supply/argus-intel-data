{"affected":[{"original_ranges":[{"lessThanOrEqual":"4.2.1","status":"affected","version":"0","versionType":"custom"}],"product":"Subrion CMS","vendor":"Intelliants"}],"aliases":["CVE-2026-72604"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A path traversal vulnerability in Intelliants Subrion CMS through 4.2.1 allows authenticated administrators to delete arbitrary files on the server via the admin panel file deletion endpoint. The endpoint passes a user-supplied file path directly to unlink() without sanitization or path canonicalization. An authenticated administrator can delete sensitive system files outside the web root, potentially causing server instability or facilitating further attacks."}],"metrics":[{"cvssV3_1":{"baseScore":6.5,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:U/C:N/I:H/A:H","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-22","description":"CWE-22: Path Traversal","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-08-11T11:15:25.006Z","orgId":"309f9ea4-e3e9-4c6c-b79d-e8eb01244f2c","shortName":"TuranSec"},"role":"cna","title":"Intelliants Subrion CMS - Path Traversal"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-72604","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-08-11T12:11:37.421617Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-08-11T12:11:53.699Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"42b922971af6d0c90263341062785edad41128b89b25b99e694c06f5abc05634","data_version":"5.2","first_seen_at"
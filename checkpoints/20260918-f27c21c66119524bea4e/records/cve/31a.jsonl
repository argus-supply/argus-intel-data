{"affected":[{"original_ranges":[{"lessThanOrEqual":"2026.08-dev","status":"affected","version":"0","versionType":"custom"}],"product":"Friendica","vendor":"Friendica"}],"aliases":["CVE-2026-72550"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"An SQL injection vulnerability in Friendica through the 2026.08-dev branch allows unauthenticated remote attackers to execute arbitrary SQL statements via the photo-view order parameter. The parameter is concatenated unescaped into a SHOW COLUMNS query via a bare PDO::query() call, enabling stacked statement injection. An unauthenticated attacker can read, modify, or delete the entire database."}],"metrics":[{"cvssV3_1":{"baseScore":9.8,"baseSeverity":"CRITICAL","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-89","description":"CWE-89: SQL Injection","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-08-11T11:10:22.212Z","orgId":"309f9ea4-e3e9-4c6c-b79d-e8eb01244f2c","shortName":"TuranSec"},"role":"cna","title":"Friendica Friendica - SQL Injection"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-72550","options":[{"Exploitation":"none"},{"Automatable":"yes"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-08-11T15:11:40.581875Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-08-11T15:12:00.244Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"95b70676ab34c8cddc25c92b326ee872b76f26b076dac74cbac937cf4c20b4c6","data_version":"5.2","first_seen_at":"2026-09-10T17:06:28Z","kind":"advisory","last_material_event_at":"20
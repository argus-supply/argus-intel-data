{"affected":[{"collectionURL":"https://wordpress.org/plugins","defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.11.33","status":"affected","version":"0","versionType":"semver"}],"product":"Welcart e-Commerce","vendor":"Unknown"}],"aliases":["CVE-2026-15213"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Welcart e-Commerce WordPress plugin before 2.11.33 does not verify the authenticity of its convenience-store / bank-transfer settlement callback: an unauthenticated request can flip an order from unpaid to settled purely from an order number and a status flag, with no signature, amount, or origin check. Because these are pay-later methods, an attacker can mark their own unpaid order as settled and obtain fulfilment without paying."}],"metrics":[{"cvssV3_1":{"baseScore":5.3,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"description":"CWE-345 Insufficient Verification of Data Authenticity","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-08-12T11:23:58.523Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Welcart e-Commerce < 2.11.33 - Unauthenticated Payment Bypass via Forged Settlement Callback"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-15213","options":[{"Exploitation":"none"},{"Automatable":"yes"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-08-12T12:15:26.071746Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-08-12T12:15:36.791Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"973add8627545e70b80324d91cd0af72d648116a0cce9db61
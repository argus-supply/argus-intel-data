{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.26.1","status":"affected","version":"1.12.0","versionType":"semver"}],"product":"Unbound","vendor":"NLnet Labs"}],"aliases":["CVE-2026-82720"],"assertions":[{"affected_indices":[0],"datePublic":"2026-09-16T00:00:00.000Z","descriptions":[{"lang":"en","value":"NLnet Labs Unbound 1.12.0 up to and including 1.26.0 has a use-after-free vulnerability when compiled for DNS-over-HTTPs support with '--with-libnghttp2'. During failure code paths (i.e., RPZ drop query, jostle due to heavy traffic), a dropped DoH stream brings down the whole DoH session and does not account properly for other DoH streams in the same session. This leads to use-after-free in those code paths. If the prerequisites are satisfied (possible RPZ drop or heavy client traffic), a malicious actor can trigger the vulnerability with a single DoH connection and the appropriate traffic. Impact is limited as the reads are not user controlled and the use-after-free leads to early returns. However, a hardened allocator can catch the use-after-free and controllably terminate the process resulting to denial of service."}],"metrics":[{"cvssV3_1":{"baseScore":5.9,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:N/A:H","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"Compiled with DNS-over-HTTPs support"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-416","description":"CWE-416: Use After Free","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-16T08:32:10.359Z","orgId":"206fc3a0-e175-490b-9eaa-a5738056c9f6","shortName":"NLnet Labs"},"role":"cna","title":"Use-after-free in DoH stream cleanup code path"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-82720","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-09-16T14:13:03.616721Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-09-16T14:14:25.720Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"ed8443492a4fcecd5f59247f6d1563e67a02af2b5d050d231b87c28ca19cf2d5","data_version":"5.2","first_seen_at":"2026-09-16T13:29:46Z","kind":"advisory","last_material_event_at":"2026-09-16T18:11:44Z","native_id":"CVE-2026-82720","provenance":[{"revision":"c638f5d53cff61a195b9014770c197610f1d60d3","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-82720"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"},{"assertion_index":1,"independent_evidence":false,"source_id":"cve"}],"published_at":"2026-09-16T08:32:10Z","record_encoding":{"expanded_bytes":4578,"expanded_sha256":"1dcf13b22e162e1f673a74f21156cfdb7304ada7fa8762a5309c9477890003a8","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-82720","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-16T08:32:10.359Z","orgId":"206fc3a0-e175-490b-9eaa-a5738056c9f6","shortName":"NLnet Labs"},"tags":["vendor-advisory"],"url":"https://www.nlnetlabs.nl/downloads/unbound/CVE-2026-82720.txt"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-09-16T14:14:25Z","status":"active","title":"Use-after-free in DoH stream cleanup code path"}

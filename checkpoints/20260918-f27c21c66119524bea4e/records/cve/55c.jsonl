{"affected":[{"defaultStatus":"unaffected","modules":["remote packet capture server"],"original_ranges":[{"status":"affected","version":"1.9.x"},{"lessThan":"1.10.7","status":"affected","version":"1.10.x","versionType":"semver"}],"product":"libpcap","programFiles":["rpcapd/daemon.c"],"programRoutines":[{"name":"daemon_unpackapplyfilter()"}],"repo":"https://github.com/the-tcpdump-group/libpcap/","vendor":"The Tcpdump Group"}],"aliases":["CVE-2026-18313"],"assertions":[{"affected_indices":[0],"configurations":[{"lang":"en","value":"The problem is specific to the remote packet capture code, which is not enabled in the default build configuration."}],"descriptions":[{"lang":"en","value":"rpcapd can allocate up to 65536 bytes per each RPCAP_MSG_UPDATEFILTER_REQ or RPCAP_MSG_STARTCAP_REQ message received from the client, but it never frees the memory, so it leaks memory even under normal use.  A malicious client can cause the server to leak memory substantially faster."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"LOW","baseScore":4.3,"baseSeverity":"MEDIUM","confidentialityImpact":"NONE","integrityImpact":"NONE","privilegesRequired":"LOW","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:N/A:L","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-401","description":"CWE-401 Missing Release of Memory after Effective Lifetime","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-05T18:51:32.438Z","orgId":"cfdbb673-b408-4d03-89c1-c3d73ed80896","shortName":"Tcpdump"},"role":"cna","title":"rpcapd memory leak in libpcap before 1.10.7"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-18313","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-09-08T15:16:35.323875Z","version":"2.0.3"},"type":"
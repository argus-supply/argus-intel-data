{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2025-56565"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"DD-WRT firmware, as deployed on TP-Link TL-WR740N v1 through v4 hardware, stores sensitive authentication credentials in cleartext within non-volatile memory. The exposed material includes SSH private keys, dynamic DNS passwords, email notification credentials and administrative passwords. An attacker with physical access to the device can extract these credentials from an SPI flash dump, leading to device compromise, infiltration of the connected network and unauthorised access to dependent third-party services."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-09-16T20:11:16.674Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"e519c68979eb5317dbd5e412d53fd03fb81b439a7230a90de7438e04b7abee90","data_version":"5.2","first_seen_at":"2026-09-16T21:17:07Z","kind":"advisory","last_material_event_at":"2026-09-16T21:17:07Z","native_id":"CVE-2025-56565","provenance":[{"revision":"7f116b9b78c8ea12847e1cb5d7c08e31bcb21f12","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2025-56565"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-16T00:00:00Z","record_encoding":{"expanded_bytes":3037,"expanded_sha256":"c00b3ebb8a22804b42099dc08d256c184f8c114a1c9fc54e3d9780360de45410","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2025-56565","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-16T20:11:16.674Z","orgId":
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"6.35","status":"affected","version":"6.34","versionType":"semver"}],"product":"Formidable Forms","vendor":"Unknown"}],"aliases":["CVE-2026-85641"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Formidable Forms  WordPress plugin before 6.35 does not restrict who can set the identifier recording which user last edited a form entry, and relies on that identifier when deciding whether to strip HTML from stored entry values, allowing unauthenticated visitors to have markup rendered in the admin entry view that would otherwise be removed, and to attribute their submission to an administrator who never made it."}],"problemTypes":[{"descriptions":[{"description":"CWE-345 Insufficient Verification of Data Authenticity","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-16T06:00:14.817Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Formidable Forms 6.34 - Unauthenticated Stored Content Injection via 'updated_by' Parameter"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"21b3058ffdaef081f39c5f1b87d5864ed4fdfec257c45aacb3d9f827b1db1a87","data_version":"5.2","first_seen_at":"2026-09-16T07:40:51Z","kind":"advisory","last_material_event_at":"2026-09-16T07:40:51Z","native_id":"CVE-2026-85641","provenance":[{"revision":"d1e0d8ab6cab86c1e3795edf282b95f943b7fd97","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-85641"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-16T06:00:14Z","record_encoding":{"expanded_bytes":2989,"expanded_sha256":"e6ce65d554f323b41190e05bf54b75a114c6d478ab7d2ebbe89aa936cc073047","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"de
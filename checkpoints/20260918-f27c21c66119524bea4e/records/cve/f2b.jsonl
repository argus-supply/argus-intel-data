{"affected":[{"original_ranges":[{"lessThanOrEqual":"1.0.3","status":"affected","version":"1.0.1","versionType":"custom"}],"product":"BME690 SensorAPI (C)","vendor":"Bosch Sensortec"}],"aliases":["CVE-2026-42806"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"An out-of-bounds read vulnerability was discovered in the Bosch BME690 SensorAPI (C-driver) in version v1.0.3 and prior, specifically within the field data parsing logic in read_all_field_data (bme69x.c).\r\n\r\nThe driver prefetches heater configuration registers into a contiguous 30-byte stack buffer (set_val) mapping IDAC, RES_HEAT, and GAS_WAIT tables.\r\n\r\nWhen parsing sensor field data, the gas_index is extracted using a 4-bit mask (0..15) but lacks boundary verification against the valid range (0..9).\r\n\r\nAn attacker or a compromised peripheral mimicking a sensor on the I2C/SPI bus could return a payload with a gas index value of 10 or higher.\r\n\r\nThis causes the driver to perform an out-of-bounds array access (set_val[20 + gas_index]), reading up to 6 bytes past the stack buffer.\r\n\r\nThe leaked out-of-bounds byte is then written into the public gas_wait field, which may lead to measurement corruption or leak adjacent stack memory when telemetered or logged."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"PHYSICAL","availabilityImpact":"LOW","baseScore":4.3,"baseSeverity":"MEDIUM","confidentialityImpact":"LOW","integrityImpact":"LOW","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:P/AC:L/PR:N/UI:N/S:U/C:L/I:L/A:L","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-125","description":"CWE-125 Out-of-bounds Read","lang":"en-US"}]}],"provider":{"dateUpdated":"2026-09-10T09:04:44.607Z","orgId":"c95f66b2-7e7c-41c5-8f09-6f86ec68659c","shortName":"bosch"},"role":"cna"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-42806","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-09-10T15:00:33.822497Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-09-10T15:00:50.874Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"0a83d38827778a0220bcce54be5280c29e1b62d3f6171bc51a45e5225ec07af5","data_version":"5.2","first_seen_at":"2026-09-10T18:46:07Z","kind":"advisory","last_material_event_at":"2026-09-10T18:46:07Z","native_id":"CVE-2026-42806","provenance":[{"revision":"6d403fb6d79a26f352d8596d90121c8c91def8e7","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-42806"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"},{"assertion_index":1,"independent_evidence":false,"source_id":"cve"}],"published_at":"2026-09-10T09:04:44Z","record_encoding":{"expanded_bytes":4929,"expanded_sha256":"0848268dad0357fe8f9e3e9ab877f2a1dbd2b80f11d7637bc503249ddde564b4","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-42806","references":[{"assertion_role":"cna","name":"https://psirt.bosch.com/security-advisories/BOSCH-SA-223618.html","provider":{"dateUpdated":"2026-09-10T09:04:44.607Z","orgId":"c95f66b2-7e7c-41c5-8f09-6f86ec68659c","shortName":"bosch"},"tags":["vendor-advisory"],"url":"https://psirt.bosch.com/security-advisories/BOSCH-SA-223618.html"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-09-10T15:00:50Z","status":"active","title":"CVE-2026-42806"}

{"affected":[{"original_ranges":[{"lessThanOrEqual":"2.0 Beta 1","status":"affected","version":"0","versionType":"custom"}],"product":"ElkArte","vendor":"ElkArte Forum"}],"aliases":["CVE-2026-72553"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A stored cross-site scripting vulnerability in ElkArte Forum 2.0 Beta 1 allows any registered member to inject persistent JavaScript into the profile fields cust_blurb and cust_locate. The fields are saved without HTML encoding and rendered unescaped in profile views visible to administrators. An attacker can craft a payload that executes in an administrator session, enabling session hijacking or privilege escalation."}],"metrics":[{"cvssV3_1":{"baseScore":5.4,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:R/S:C/C:L/I:L/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-79","description":"CWE-79: Cross-site Scripting","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-08-11T11:11:01.806Z","orgId":"309f9ea4-e3e9-4c6c-b79d-e8eb01244f2c","shortName":"TuranSec"},"role":"cna","title":"ElkArte Forum ElkArte - Cross-Site Scripting"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-72553","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-08-11T15:16:12.388460Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-08-11T15:16:23.690Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"abbcbfadd79737a36ff69b95d23098e9d3434e2b838ffb61219d1453dec5cee8","data_version":"5.2","first_seen_at":"2026-09-10T17:06:28Z","kind"
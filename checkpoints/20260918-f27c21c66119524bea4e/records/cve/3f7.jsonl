{"affected":[{"original_ranges":[{"lessThanOrEqual":"8.8.3","status":"affected","version":"0","versionType":"custom"}],"product":"Fusio","vendor":"Apioo"}],"aliases":["CVE-2026-72551"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A remote code execution vulnerability in Apioo Fusio 8.8.3 allows authenticated users with the Developer role to execute arbitrary OS commands by exploiting a PHP-Sandbox allow-list bypass. The sandbox allow-list permits functions that transitively invoke system(), enabling a developer to escape the sandbox and gain OS command execution on the server. An attacker with a Developer-role account can achieve full server compromise."}],"metrics":[{"cvssV3_1":{"baseScore":8.8,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-78","description":"CWE-78: OS Command Injection","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-08-11T11:10:35.424Z","orgId":"309f9ea4-e3e9-4c6c-b79d-e8eb01244f2c","shortName":"TuranSec"},"role":"cna","title":"Apioo Fusio - Remote Code Execution"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-72551","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-08-11T15:12:37.210576Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-08-11T15:13:19.293Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"f1a32bfbb5659379ab720a78dcd1b777844ae8a04d35070b1ad70f57ed1f1691","data_version":"5.2","first_seen_at":"2026-09-10T17:06:28Z","kind":"advisory","last_
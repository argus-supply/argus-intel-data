{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"1.7","status":"affected","version":"0","versionType":"semver"}],"product":"Mane","vendor":"Elated-Themes"}],"aliases":["CVE-2026-78478"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Mane theme for WordPress is vulnerable to Local File Inclusion in all versions up to, and including, 1.7. This makes it possible for unauthenticated attackers to include and execute arbitrary files on the server, allowing the execution of any PHP code in those files. This can be used to bypass access controls, obtain sensitive data, or achieve code execution in cases where images and other “safe” file types can be uploaded and included."}],"metrics":[{"cvssV3_1":{"baseScore":8.1,"baseSeverity":"HIGH","vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-98","description":"CWE-98 Improper Control of Filename for Include/Require Statement in PHP Program ('PHP Remote File Inclusion')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-08-25T05:31:28.313Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"Måne <= 1.7 - Unauthenticated Local File Inclusion"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-78478","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-08-25T12:00:19.981418Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-08-25T12:02:00.193Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"0c83e21b29c752a4beb77a0c06b6a6fbfabfd1e2f923019a1912cff5e9ec818c","
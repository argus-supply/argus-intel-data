{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"4.0.6","status":"affected","version":"0","versionType":"semver"}],"product":"Tutor LMS","vendor":"Unknown"}],"aliases":["CVE-2026-19093"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Tutor LMS  WordPress plugin before 4.0.6 does not validate a stored file path before using it to stream media, allowing users with the instructor role to read arbitrary files on the server, including files outside the web root.\n\nThe readable files include the WordPress configuration file, which exposes the database credentials and the authentication keys and salts, so authentication cookies can be forged."}],"problemTypes":[{"descriptions":[{"description":"CWE-552 Files or Directories Accessible to External Parties","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-08-22T06:00:16.665Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Tutor LMS < 4.0.6 - Instructor+ Arbitrary File Read via Video Path"},{"affected_indices":[],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":6.8,"baseSeverity":"MEDIUM","confidentialityImpact":"HIGH","integrityImpact":"NONE","privilegesRequired":"HIGH","scope":"CHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:C/C:H/I:N/A:N","version":"3.1"}},{"other":{"content":{"id":"CVE-2026-19093","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-08-23T15:27:00.442286Z","version":"2.0.3"},"type":"ssvc"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-552","description":"CWE-552 Files or Directories Accessible to External Parties","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-08-23T15:33:42.017Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"asses
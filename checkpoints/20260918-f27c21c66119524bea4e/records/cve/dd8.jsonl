{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.3.1","status":"affected","version":"2.0","versionType":"semver"}],"product":"Dimension","vendor":"WatchGuard"}],"aliases":["CVE-2026-78103"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"WatchGuard Dimension provides a client-side lock/unlock UI control for management changes. The server-side configuration endpoint does not enforce this lock/unlock workflow state, allowing an authenticated administrator to submit configuration changes directly to the endpoint without first completing the UI unlock step. This allows an authenticated read-write administrator session to bypass the intended editing workflow and overwrite configuration changes being made by another concurrent administrator session."}],"metrics":[{"cvssV4_0":{"baseScore":5.1,"baseSeverity":"MEDIUM","vectorString":"CVSS:4.0/AV:N/AC:L/AT:N/PR:H/UI:N/VC:N/VI:L/VA:N/SC:N/SI:N/SA:N","version":"4.0"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-841","description":"CWE-841","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-08-27T23:26:31.432Z","orgId":"5d1c2695-1a31-4499-88ae-e847036fd7e3","shortName":"WatchGuard"},"role":"cna","title":"Dimension Log Server Configuration Lock Bypass Vulnerability"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-78103","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-08-28T16:28:01.383469Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-08-28T16:28:30.798Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"ea2923bf3e0aad5966e884b750d17655312bf21f95254c6e4f0302aa37d087f5"
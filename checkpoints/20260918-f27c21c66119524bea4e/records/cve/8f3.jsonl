{"affected":[{"defaultStatus":"unknown","original_ranges":[{"lessThanOrEqual":"16.0.4","status":"affected","version":"13.0.0","versionType":"semver"}],"product":"Forgejo","repo":"https://codeberg.org/forgejo/forgejo","vendor":"Forgejo"}],"aliases":["CVE-2026-90679"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"Forgejo 13.0.0 through 16.0.4, when \"[federation] ENABLED = true\" is set, has a spoofing issue that affects identity integrity but does not allow account takeover or content modification. It does not verify that the HTTP Signature on an incoming ActivityPub activity was produced by the key belonging to the actor named in the activity body. The signature verification in routers/api/v1/activitypub/reqsignature.go validates the request signature, but the inbox activity handlers subsequently read the acting identity from the attacker-controlled JSON body without binding it to the verified signing key. Additionally, the signed Digest header is not recomputed against the received request body. A remote attacker who hosts a single valid ActivityPub actor and keypair can therefore submit signature-valid activities attributed to any actor identity they name."}],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":4.3,"baseSeverity":"MEDIUM","confidentialityImpact":"NONE","integrityImpact":"LOW","privilegesRequired":"LOW","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:L/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-348","description":"CWE-348 Use of Less Trusted Source","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-13T04:06:57.862Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-90679","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-09-15T17:17:23.327706Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-09-15T17:17:34.738Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"a3ce66a4ed536f58b174cd51656d5a649485d8390821d44e8f2ee3204166f14b","data_version":"5.2","first_seen_at":"2026-09-13T04:45:00Z","kind":"advisory","last_material_event_at":"2026-09-15T21:19:32Z","native_id":"CVE-2026-90679","provenance":[{"revision":"cefc986ea549943957f44c19b77329ad9d3c889d","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-90679"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"},{"assertion_index":1,"independent_evidence":false,"source_id":"cve"}],"published_at":"2026-09-13T03:55:04Z","record_encoding":{"expanded_bytes":4714,"expanded_sha256":"8e8bc59e15c3915652f2d6f64ce875d2f45bec30c41de8adfcc472065b6e10dc","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-90679","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-13T04:06:57.862Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"url":"https://codeberg.org/forgejo/forgejo/issues/14271#issuecomment-22548004"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-09-15T17:17:34Z","status":"active","title":"CVE-2026-90679"}

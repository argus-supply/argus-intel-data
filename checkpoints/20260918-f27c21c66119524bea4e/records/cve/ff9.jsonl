{"affected":[{"original_ranges":[{"lessThanOrEqual":"5.9","status":"affected","version":"0","versionType":"custom"}],"product":"HortusFox","vendor":"Daniel Brendel"}],"aliases":["CVE-2026-72559"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A stored cross-site scripting vulnerability in HortusFox 5.9 allows authenticated workspace members to inject persistent JavaScript into plant notes via Parsedown rendered without safe mode. Notes are rendered unescaped in the browser of every user who views the affected plant. An attacker can use this to steal session cookies or perform actions in the context of other users including administrators."}],"metrics":[{"cvssV3_1":{"baseScore":5.4,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:R/S:C/C:L/I:L/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-79","description":"CWE-79: Cross-site Scripting","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-08-11T11:12:26.794Z","orgId":"309f9ea4-e3e9-4c6c-b79d-e8eb01244f2c","shortName":"TuranSec"},"role":"cna","title":"Daniel Brendel HortusFox - Cross-Site Scripting"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-72559","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-08-11T12:20:39.674591Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-08-11T12:21:35.275Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"ecd774b77b013ee94cfbd4072b911040649d678d10b95fcf50284b3cab7d4835","data_version":"5.2","first_seen_at":"2026-09-10T17:06:28Z","kind":"advisory","last_m
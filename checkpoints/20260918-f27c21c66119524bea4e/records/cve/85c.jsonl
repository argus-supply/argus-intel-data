{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"22.22.3","status":"affected","version":"22.22.3","versionType":"semver"},{"lessThanOrEqual":"24.16.0","status":"affected","version":"24.16.0","versionType":"semver"},{"lessThanOrEqual":"26.3.0","status":"affected","version":"26.3.0","versionType":"semver"}],"product":"node","vendor":"nodejs"}],"aliases":["CVE-2026-48932"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A flaw in Node.js HTTP client can cause a request desynchronization for Node.js-based forwarding proxies that rebuild outbound headers from the visible `IncomingMessage` headers while piping the original body to a reused backend connection.\r\n\r\nNode.js can omit headers beyond `maxHeadersCount` / `maxHeaderPairs` from `req.headers`, `req.rawHeaders`, and `req.headersDistinct`, while still using those omitted headers internally for HTTP message framing. In particular, `Content-Length` can be hidden from userland while the request body is still delivered.\r\n\r\nThis vulnerability affects all supported release lines: **Node.js 22**, **Node.js 24**, and **Node.js 26**."}],"metrics":[{"cvssV3_0":{"baseScore":3.7,"baseSeverity":"LOW","vectorString":"CVSS:3.0/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:L/A:N","version":"3.0"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-444","description":"CWE-444 HTTP Request Smuggling","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-01T02:08:29.536Z","orgId":"36234546-b8fa-4601-9d6f-f4e334aa8ea1","shortName":"hackerone"},"role":"cna"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-48932","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-09-01T14:48:10.503227Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-09-01T14:48:23.428Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnr
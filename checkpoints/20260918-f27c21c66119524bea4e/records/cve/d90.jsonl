{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"3.3.9.2","status":"affected","version":"3.1.0","versionType":"semver"}],"product":"Pods","vendor":"Unknown"}],"aliases":["CVE-2026-74853"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Pods  WordPress plugin before 3.3.9.2 does not restrict which functions a display callback may resolve to, allowing users with the author role and above to read arbitrary files from the server, including files outside the web root. Only sites using the restricted display-callback mode are affected, which is the automatic default on installations whose first Pods version predates 3.1."}],"problemTypes":[{"descriptions":[{"description":"CWE-552 Files or Directories Accessible to External Parties","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-04T06:00:03.283Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"Pods < 3.3.9.2 - Author+ Arbitrary File Read via Shortcode Display Callback"},{"affected_indices":[],"metrics":[{"cvssV3_1":{"attackComplexity":"LOW","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":6.8,"baseSeverity":"MEDIUM","confidentialityImpact":"HIGH","integrityImpact":"NONE","privilegesRequired":"HIGH","scope":"CHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:C/C:H/I:N/A:N","version":"3.1"}},{"other":{"content":{"id":"CVE-2026-74853","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-09-04T12:54:34.295404Z","version":"2.0.3"},"type":"ssvc"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-552","description":"CWE-552 Files or Directories Accessible to External Parties","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-04T12:54:43.071Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authe
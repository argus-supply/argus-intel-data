{"affected":[{"original_ranges":[{"lessThanOrEqual":"2.0.3","status":"affected","version":"0","versionType":"custom"}],"product":"Faveo Helpdesk","vendor":"Ladybird Web Solution"}],"aliases":["CVE-2026-72554"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"A broken access control vulnerability in Ladybird Web Solution Faveo Helpdesk 2.0.3 allows any self-registered customer to read ticket conversations belonging to other customers via the v1 REST API. The API verifies the existence of the requested ticket but not ownership, enabling any authenticated user to access arbitrary ticket threads including internal agent notes containing sensitive information."}],"metrics":[{"cvssV3_1":{"baseScore":6.5,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:N/A:N","version":"3.1"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-284","description":"CWE-284: Improper Access Control","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-08-11T11:11:15.328Z","orgId":"309f9ea4-e3e9-4c6c-b79d-e8eb01244f2c","shortName":"TuranSec"},"role":"cna","title":"Ladybird Web Solution Faveo Helpdesk - Broken Access Control"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-72554","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-08-11T15:16:51.677292Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-08-11T15:17:06.829Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"ce780b911aaea313a15926cb8846835e65764e40e5f4dd04d541fa70c8b917a9","data_version":"5.2","first_seen_at":"2026-09-10T17:
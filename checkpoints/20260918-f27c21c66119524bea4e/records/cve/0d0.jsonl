{"affected":[{"defaultStatus":"unknown","original_ranges":[{"status":"affected","version":"25.03.01.21"}],"product":"Database Proxy","vendor":"Heimdall Data"}],"aliases":["CVE-2026-18274"],"assertions":[{"affected_indices":[0],"datePublic":"2026-07-29T21:42:52.754Z","descriptions":[{"lang":"en","value":"Heimdall Data Database Proxy uploadJar Directory Traversal Remote Code Execution Vulnerability. This vulnerability allows remote attackers to execute arbitrary code on affected installations of Heimdall Data Database Proxy. Authentication is required to exploit this vulnerability.\n\nThe specific flaw exists within the uploadJar method. The issue results from the lack of proper validation of a user-supplied path prior to using it in file operations. An attacker can leverage this vulnerability to execute code in the context of root. Was ZDI-CAN-28603."}],"metrics":[{"cvssV3_0":{"baseScore":7.2,"baseSeverity":"HIGH","vectorString":"CVSS:3.0/AV:N/AC:L/PR:H/UI:N/S:U/C:H/I:H/A:H","version":"3.0"},"format":"CVSS"}],"problemTypes":[{"descriptions":[{"cweId":"CWE-22","description":"CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-08-20T16:15:48.152Z","orgId":"99f1926a-a320-47d8-bbb5-42feb611262e","shortName":"zdi"},"role":"cna","title":"Heimdall Data Database Proxy uploadJar Directory Traversal Remote Code Execution Vulnerability"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-18274","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-08-21T19:55:03.748330Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-08-21T20:08:42.055Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_pro
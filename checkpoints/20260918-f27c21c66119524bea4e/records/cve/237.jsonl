{"affected":[{"original_ranges":[{"status":"affected","version":"n/a"}],"product":"n/a","vendor":"n/a"}],"aliases":["CVE-2026-88592"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"kkFileView >= 4.2.0 is vulnerable to Server-Side Request Forgery (SSRF). The cross-origin file proxy endpoint /getCorsFile is protected by TrustHostFilter against the trust.host whitelist. However, the URL parameter validated by the filter is not the same parameter the controller actually fetches: the filter validates the first non-empty parameter in a fixed priority order, while the controller only reads and fetches urlPath. By supplying both urlPath=<real target> and url=<whitelisted decoy address> in the same request, the decoy passes validation while the unvalidated real target is fetched server-side — and the response body is echoed back to the attacker."}],"problemTypes":[{"descriptions":[{"description":"n/a","lang":"en","type":"text"}]}],"provider":{"dateUpdated":"2026-09-16T19:43:23.977Z","orgId":"8254265b-2729-46b6-b9e3-3dfca2d5bfca","shortName":"mitre"},"role":"cna"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"b229d2039f3fba2c81ee481082d144d7172cd96999521ca006f777671753a186","data_version":"5.2","first_seen_at":"2026-09-16T21:17:07Z","kind":"advisory","last_material_event_at":"2026-09-16T21:17:07Z","native_id":"CVE-2026-88592","provenance":[{"revision":"7f116b9b78c8ea12847e1cb5d7c08e31bcb21f12","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-88592"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"}],"published_at":"2026-09-16T00:00:00Z","record_encoding":{"expanded_bytes":3078,"expanded_sha256":"5de5d01d5e1ba235fee1d90a4630c047a224b7994eaf9c81dc427260caff21f2","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source"
{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"1.5.4","status":"affected","version":"0","versionType":"semver"}],"product":"WP Directory Kit","vendor":"wpdirectorykit"}],"aliases":["CVE-2026-16588"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The WP Directory Kit plugin for WordPress is vulnerable to blind SQL Injection via the 'order_by' parameter in all versions up to, and including, 1.5.4 due to insufficient escaping on the user supplied parameter and lack of sufficient preparation on the existing SQL query. This makes it possible for authenticated attackers, with custom-level access and above, to append additional SQL queries into already existing queries that can be used to extract sensitive information from the database."}],"metrics":[{"cvssV3_1":{"baseScore":6.5,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:N/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-89","description":"CWE-89 Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-16T03:28:18.256Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"WP Directory Kit <= 1.5.4 - Authenticated (Custom+) SQL Injection via 'order_by' Parameter"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"b927f84cc934b23e2274284746980098ebe75e1acee1baed411da7565f616438","data_version":"5.2","first_seen_at":"2026-09-16T07:40:51Z","kind":"advisory","last_material_event_at":"2026-09-16T07:40:51Z","native_id":"CVE-2026-16588","provenance":[{"revision":"d1e0d8ab6cab86c1e3795edf282b95f943b7fd97","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-16588"},{"assertion_index":0,"independent_evidence":true,"so
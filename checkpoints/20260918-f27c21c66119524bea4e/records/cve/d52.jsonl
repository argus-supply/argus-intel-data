{"affected":[{"original_ranges":[{"status":"affected","version":"< 2.145.0"}],"product":"node-opcua","vendor":"node-opcua"}],"aliases":["CVE-2026-69200"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"node-opcua is an OPC UA implementation for TypeScript and Node.js. Prior to node-opcua-client 2.145.0, the internal fieldsToJson method in packages/node-opcua-client/source/alarms_and_conditions/client_alarm.ts directly assigns unsanitized field names and allows a __proto__.pollutedKey path to modify Object.prototype. Successful exploitation requires an application to expose attacker-controlled event fields to fieldsToJson and may cause denial of service or application logic corruption. This vulnerability is fixed in 2.145.0."}],"metrics":[{"cvssV3_1":{"attackComplexity":"HIGH","attackVector":"NETWORK","availabilityImpact":"LOW","baseScore":3.7,"baseSeverity":"LOW","confidentialityImpact":"NONE","integrityImpact":"NONE","privilegesRequired":"NONE","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:N/A:L","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-1321","description":"CWE-1321: Improperly Controlled Modification of Object Prototype Attributes ('Prototype Pollution')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-16T16:15:58.656Z","orgId":"a0819718-46f1-4df5-94e2-005712e83aaa","shortName":"GitHub_M"},"role":"cna","title":"node-opcua: Prototype Pollution via internal `fieldsToJson()` implementation (Related to CVE-2024-57086)"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"dc08f4b1eba712e1621549dfddfea0d433bc0883e5f29492af9e66e3928f0e0e","data_version":"5.2","first_seen_at":"2026-09-16T18:11:44Z","kind":"advisory","last_material_event_at":"2026-09-16T18:11:44Z","native_id":"CVE-2026-69200","provenance
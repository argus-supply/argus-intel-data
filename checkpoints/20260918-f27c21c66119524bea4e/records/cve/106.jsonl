{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"1.26.1","status":"affected","version":"0","versionType":"semver"}],"product":"Unbound","vendor":"NLnet Labs"}],"aliases":["CVE-2026-82717"],"assertions":[{"affected_indices":[0],"datePublic":"2026-09-16T00:00:00.000Z","descriptions":[{"lang":"en","value":"In NLnet Labs Unbound up to and including 1.26.0, a vulnerability was found in that can progressively corrupt heap memory and under certain systems and compilation options could lead to remote code execution. The vulnerability starts when CNAME synthesis during an upstream response needs to enforce(rewrite) a max TTL value in the packet buffer. Coupled with a compression pointer that points to the overwritten value and invalidates the domain name, it leads to an error path that does not properly move the buffer position and allows for the heap buffer overflow. Since this is heavily reliant on heap memory layout, results are memory corruption that eventually leads to a crash and under specific systems and compilation options remote code execution."}],"metrics":[{"cvssV4_0":{"baseScore":8.4,"baseSeverity":"HIGH","vectorString":"CVSS:4.0/AV:N/AC:H/AT:N/PR:N/UI:N/VC:H/VI:H/VA:H/SC:H/SI:H/SA:H/E:U","version":"4.0"},"format":"CVSS","scenarios":[{"lang":"en","value":"GENERAL"}]}],"problemTypes":[{"descriptions":[{"cweId":"CWE-122","description":"CWE-122: Heap-based Buffer Overflow","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-16T08:31:59.417Z","orgId":"206fc3a0-e175-490b-9eaa-a5738056c9f6","shortName":"NLnet Labs"},"role":"cna","title":"CNAME synthesis could lead to heap corruption"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-82717","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-09-16T14:15:46.463136Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-09-16T14:15:55.295Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"1c5419ca42f63bc0f0ccd33bec9ae7294120504cb10b6a108b533262472e92d3","data_version":"5.2","first_seen_at":"2026-09-16T13:29:46Z","kind":"advisory","last_material_event_at":"2026-09-16T18:11:44Z","native_id":"CVE-2026-82717","provenance":[{"revision":"c638f5d53cff61a195b9014770c197610f1d60d3","source_id":"cve","url":"https://www.cve.org/CVERecord?id=CVE-2026-82717"},{"assertion_index":0,"independent_evidence":true,"source_id":"cve"},{"assertion_index":1,"independent_evidence":false,"source_id":"cve"}],"published_at":"2026-09-16T08:31:59Z","record_encoding":{"expanded_bytes":4427,"expanded_sha256":"6f6d982e2695bf7d3ee4510288604aa2d46889f8bc0812be824c06aaf9ceb74a","format":"cve-indexed-assertions-v1","top_descriptions_assertion_index":0,"top_descriptions_source":"descriptions"},"record_id":"cve/CVE-2026-82717","references":[{"assertion_role":"cna","provider":{"dateUpdated":"2026-09-16T08:31:59.417Z","orgId":"206fc3a0-e175-490b-9eaa-a5738056c9f6","shortName":"NLnet Labs"},"tags":["vendor-advisory"],"url":"https://www.nlnetlabs.nl/downloads/unbound/CVE-2026-82717.txt"}],"schema_version":"1.0","source_id":"cve","source_modified_at":"2026-09-16T14:15:55Z","status":"active","title":"CNAME synthesis could lead to heap corruption"}

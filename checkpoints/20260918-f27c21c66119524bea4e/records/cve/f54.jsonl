{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThan":"2026.9.1","status":"affected","version":"0","versionType":"semver"}],"product":"Okta Access Gateway","vendor":"Okta"}],"aliases":["CVE-2026-78620"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Okta Access Gateway Kerberos configuration handler does not validate file paths specified in event payloads before writing file contents. The path from the event payload is used directly as the write destination, resulting in files being written to unintended locations on the appliance filesystem."}],"metrics":[{"cvssV3_1":{"attackComplexity":"HIGH","attackVector":"NETWORK","availabilityImpact":"NONE","baseScore":5.9,"baseSeverity":"MEDIUM","confidentialityImpact":"HIGH","integrityImpact":"HIGH","privilegesRequired":"HIGH","scope":"UNCHANGED","userInteraction":"NONE","vectorString":"CVSS:3.1/AV:N/AC:H/PR:H/UI:N/S:U/C:H/I:H/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-73","description":"External Control of File Name or Path","lang":"en"}]}],"provider":{"dateUpdated":"2026-09-08T20:13:23.266Z","orgId":"59b22baa-87b2-4371-8e4a-e080df12f74a","shortName":"Okta"},"role":"cna","title":"Improper Path Validation in Okta Access Gateway Kerberos Configuration Handling"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-78620","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"total"}],"role":"CISA Coordinator","timestamp":"2026-09-10T14:47:51.803109Z","version":"2.0.3"},"type":"ssvc"}}],"provider":{"dateUpdated":"2026-09-10T14:49:41.141Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"e31fe66f36a318ffff5968bbf9ca10b01073b4a0125b1aefc7c7accf7
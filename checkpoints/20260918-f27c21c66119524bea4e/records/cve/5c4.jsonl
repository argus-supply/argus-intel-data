{"affected":[{"defaultStatus":"unaffected","original_ranges":[{"lessThanOrEqual":"2.15.22","status":"affected","version":"0","versionType":"semver"}],"product":"Better Messages – Chat Rooms, Group Chat, Private Messages & AI Chat Bots","vendor":"wordplus"}],"aliases":["CVE-2026-18555"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The Better Messages – Chat Rooms, Group Chat, Private Messages & AI Chat Bots plugin for WordPress is vulnerable to Reflected Cross-Site Scripting via the 'icn' parameter in all versions up to, and including, 2.15.22 due to insufficient input sanitization and output escaping. This makes it possible for unauthenticated attackers to inject arbitrary web scripts in pages that execute if they can successfully trick a user into performing an action such as clicking on a link."}],"metrics":[{"cvssV3_1":{"baseScore":6.1,"baseSeverity":"MEDIUM","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-79","description":"CWE-79 Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-16T04:28:03.363Z","orgId":"b15e7b5b-3da4-40ae-a43c-f7aa60e62599","shortName":"Wordfence"},"role":"cna","title":"Better Messages – Chat Rooms, Group Chat, Private Messages & AI Chat Bots plugin for WordPress <= 2.15.22 - Reflected Cross-Site Scripting via 'icn' Parameter"}],"assessment":{"authentication":null,"classifier_version":"1.0","confidence":"unknown","configuration":null,"entry_protocol":null,"product_class":null,"reasons":[],"relevance":"unknown"},"content_hash":"ec245be96ac4c4a8c76aec87981c6baf74a9fc4f44cadcf08f8ecadadfb841f5","data_version":"5.2","first_seen_at":"2026-09-16T07:40:51Z","kind":"advisory","last_material_event_at":"2026-09-16T07:40:51Z","native_id":"CVE-2026-18555","provenance":[{"revision":"d1e0d8ab6cab86c1e3795edf282b95f943b7fd97","source_id":"cve","url":
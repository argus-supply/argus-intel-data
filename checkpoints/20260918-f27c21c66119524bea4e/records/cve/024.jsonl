{"affected":[{"collectionURL":"https://wordpress.org/plugins","defaultStatus":"unaffected","original_ranges":[{"lessThan":"2.5.1","status":"affected","version":"0","versionType":"semver"}],"product":"GutenKit","vendor":"Unknown"}],"aliases":["CVE-2026-19698"],"assertions":[{"affected_indices":[0],"descriptions":[{"lang":"en","value":"The GutenKit WordPress plugin before 2.5.1 does not validate or escape style settings saved against a post before using them to build the CSS it outputs on the front end, allowing users with the Contributor role and above to inject arbitrary CSS into pages served to other users and to anonymous visitors. JavaScript execution is not possible at that role, so the impact is limited to defacement, interface redressing and forcing external resources to load."}],"metrics":[{"cvssV3_1":{"baseScore":3.5,"baseSeverity":"LOW","vectorString":"CVSS:3.1/AV:N/AC:L/PR:H/UI:R/S:U/C:L/I:L/A:N","version":"3.1"}}],"problemTypes":[{"descriptions":[{"description":"CWE-74 Improper Neutralization of Special Elements in Output Used by a Downstream Component ('Injection')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-02T14:16:47.097Z","orgId":"1bfdd5d7-9bf6-4a53-96ea-42e2716d7a81","shortName":"WPScan"},"role":"cna","title":"GutenKit < 2.5.1 - Contributor+ Stored CSS Injection"},{"affected_indices":[],"metrics":[{"other":{"content":{"id":"CVE-2026-19698","options":[{"Exploitation":"none"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-09-02T14:47:56.667727Z","version":"2.0.3"},"type":"ssvc"}}],"problemTypes":[{"descriptions":[{"cweId":"CWE-74","description":"CWE-74 Improper Neutralization of Special Elements in Output Used by a Downstream Component ('Injection')","lang":"en","type":"CWE"}]}],"provider":{"dateUpdated":"2026-09-02T14:57:38.255Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"role":"adp","title":"CISA ADP Vulnrichment"}],"assessment":{"authentication":null
log"}],"published_at":"2021-11-03T00:00:00Z","record_id":"kev/CVE-2020-0601","references":[],"schema_version":"1.0","source_id":"kev","source_modified_at":"2021-11-03T00:00:00Z","status":"active","title":"Microsoft Windows CryptoAPI Spoofing Vulnerability"}
